{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyo.local/catalog/section.schema.json",
  "title": "Lyo catalog section",
  "$defs": {
    "listItem": {
      "oneOf": [
        {
          "type": "string",
          "description": "Flat list bullet (markdown inline allowed)."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "description": "Optional bold label for the bullet."
            },
            "text": {
              "type": "string",
              "description": "Bullet body when not using a bare string."
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/listItem"
              },
              "description": "Nested sub-bullets."
            }
          },
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "title"
              ]
            },
            {
              "required": [
                "items"
              ]
            }
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "list"
        },
        "title": {
          "type": "string"
        },
        "ordered": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "language",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "code"
        },
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "headers",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "table"
        },
        "title": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "lead": {
          "type": "string"
        },
        "trail": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "details"
        },
        "title": {
          "type": "string",
          "description": "Summary label shown on the collapsed block."
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listItem"
          }
        },
        "body": {
          "type": "string",
          "description": "Optional markdown inside the details block after the list."
        },
        "ordered": {
          "type": "boolean"
        },
        "open": {
          "type": "boolean",
          "description": "When true, the details block is expanded by default."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "markdown"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    }
  ]
}

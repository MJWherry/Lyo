# Internal Comic API base URL (server-only; never exposed to the browser).
LYO_COMIC_API_BASE_URL=http://localhost:5000

# Browser-facing Comic API origin for Google OIDC 302s. Locally this is :5000.
# On the combined app host, use the public API URL (or the Caddy origin that proxies /auth).
LYO_COMIC_PUBLIC_AUTH_URL=http://localhost:5000

# Secret used to seal the httpOnly session cookie (32+ random characters).
AUTH_COOKIE_SECRET=change-me-to-a-long-random-string

{
  "id": "Lyo.Diagnostic.Web.Components",
  "name": "Lyo.Diagnostic.Web.Components",
  "area": "Core",
  "tagline": "Blazor (Server / Interactive) workbench for analyzing and triaging .NET stack traces and exception payloads with `Lyo.Diagnostic`.",
  "description": "Blazor (Server / Interactive) workbench for analyzing and triaging .NET stack traces and exception payloads with [`Lyo.Diagnostic`](../Lyo.Diagnostic/README.md). The workbench is\ndeliberately pure-UI — paste, view, and classify; nothing is persisted by the components themselves.",
  "features": [],
  "examples": [],
  "sections": [
    {
      "type": "table",
      "title": "Components",
      "headers": [
        "Component",
        "Purpose"
      ],
      "rows": [
        [
          "**`DiagnosticWorkbench`**",
          "Top-level shell. Composes the panels below into a side-by-side input/output review layout."
        ],
        [
          "**`StackTraceDecodePanel`**",
          "Paste raw stack trace text. Decodes via `IStackTraceDecoder` and renders structured frames."
        ],
        [
          "**`DecodedStackTraceSummary`**",
          "Compact summary chip with top frame, exception type, framework signature."
        ],
        [
          "**`StackFrameTable`**",
          "Tabular view of decoded frames (`method`, `file`, `line`, `assembly`) with row-level highlighting for user-code frames."
        ],
        [
          "**`SanitisedStackTracePanel`**",
          "Renders the sanitised stack trace (paths/PII trimmed) suitable for inclusion in customer-facing error pages."
        ],
        [
          "**`ExceptionTypeClassifierPanel`**",
          "Runs the pasted exception type through `IExceptionTypeClassifier` and displays the resulting category (`Transient`, `Programming`, `Validation`, `Security`, …)."
        ]
      ]
    },
    {
      "type": "paragraph",
      "title": "Host integration",
      "text": "The workbench resolves `IStackTraceDecoder` and `IExceptionTypeClassifier` from DI — register them via `Lyo.Diagnostic` extensions before mounting `<DiagnosticWorkbench />`. MudBlazor is used for layout (via `Lyo.Web.Components`)."
    }
  ],
  "links": [],

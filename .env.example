# Copy to .env and adjust. Used by docker-compose.yml.
#
#   cp .env.example .env

# ---- Resource limits for the runner container ------------------------------
# Number of CPUs the runner may use (fractional allowed, e.g. 1.5).
CPU_LIMIT=4
# Memory cap for the runner container (e.g. 2g, 4g, 512m).
MEM_LIMIT=8g

# ---- Result ownership ------------------------------------------------------
# docs/benchmarks/data is the only path written back to the host. The runner is
# root (needed for the Docker socket), so it chowns that dir to these IDs on
# exit. Set them to your user so the manifests aren't root-owned:
#   echo "HOST_UID=$(id -u)" >> .env && echo "HOST_GID=$(id -g)" >> .env
HOST_UID=1000
HOST_GID=1000

# ---- Target selection ------------------------------------------------------
# What the `run` service builds AND runs. A space/comma list of:
#   benchmarks | tests | all   - a whole group
#   Lyo.Lock.Benchmarks        - an exact project name
#   Lyo.Csv.Tests Lyo.Lock.Benchmarks   - a list
# Prefer the wrapper, which sets TARGET + a per-target image tag for you:
#   scripts/docker/run.sh Lyo.Lock.Benchmarks
# Tesseract OCR native libs are installed automatically only when the OCR
# project is in the selection (no manual flag needed).
TARGET=all
# Image tag for the `run` service. Set a distinct value per target so builds
# don't clobber each other (the wrapper derives this automatically).
RUN_IMAGE=lyo-runner-all

# ---- Benchmark options -----------------------------------------------------
# BenchmarkDotNet --filter glob applied to every selected suite.
BENCH_FILTER=*
# Set to 1 to skip Testcontainers-backed benchmark classes (Redis/Postgres).
NO_DOCKER=0

# ---- Test options ----------------------------------------------------------
# Optional xUnit --filter expression applied to every selected test project.
TEST_FILTER=

# ---- Testcontainers networking ---------------------------------------------
# Host that Testcontainers advertises for sibling containers reached over the
# mounted Docker socket. host.docker.internal works on Docker Desktop and, via
# the compose extra_hosts host-gateway mapping, on Linux too.
TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal

# ---- Caveats ----------------------------------------------------------------
# * The source is baked into the image and compiled at build time, so code
#   changes need a rebuild to take effect (scripts/docker/run.sh --build-only
#   <target>, or `docker compose build run`). Only docs/benchmarks/data is
#   mounted back to the host.
# * Containers Testcontainers spawns via the mounted Docker socket run on the
#   host and are NOT limited by CPU_LIMIT / MEM_LIMIT (those bound only the
#   runner container).
# * Constraining CPU changes absolute BenchmarkDotNet numbers; keep the limits
#   fixed for run-to-run comparability.

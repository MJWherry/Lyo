#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker awscli jq cronie amazon-ssm-agent
systemctl enable --now docker crond amazon-ssm-agent
usermod -aG docker ec2-user || true

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.32.4/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/lyo/comic/postgres/data /opt/lyo/comic/postgres/backups
cd /opt/lyo/comic

SSM_PREFIX="${ssm_param_prefix}"
fetch_param() {
  local name="$1"
  aws ssm get-parameter --region "${aws_region}" --name "$${SSM_PREFIX}/$${name}" --with-decryption --query 'Parameter.Value' --output text
}

POSTGRES_PASSWORD="$(fetch_param postgres_password)"

env_set() {
  local key="$1" val="$2"
  printf "%s=" "$key"
  printf "%s" "$val" | sed "s/'/'\\\\''/g" | sed "s/.*/'&'/"
  printf "\n"
}

{
  env_set POSTGRES_DB "${postgres_db}"
  env_set POSTGRES_USER "${postgres_user}"
  env_set POSTGRES_PASSWORD "$${POSTGRES_PASSWORD}"
  env_set BACKUP_BUCKET "${backup_bucket_name}"
  env_set AWS_REGION "${aws_region}"
  env_set BACKUP_RETENTION_DAYS "${backup_retention_days}"
} > /opt/lyo/comic/.env

cat > /opt/lyo/comic/docker-compose.yml <<'COMPOSE'
services:
  postgres:
    image: postgres:16
    container_name: lyo-comic-postgres
    hostname: postgres
    restart: unless-stopped
    ports:
      - "5432:5432"
    env_file: .env
    volumes:
      - ./postgres/data:/var/lib/postgresql/data
      - ./postgres/backups:/backups
COMPOSE

docker compose -f /opt/lyo/comic/docker-compose.yml up -d

cat > /opt/lyo/comic/backup-postgres.sh <<'SCRIPT'
#!/bin/bash
set -euxo pipefail
cd /opt/lyo/comic
set -a
source .env
set +a
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
FILE="/opt/lyo/comic/postgres/backups/pg_$${STAMP}.sql.gz"
docker exec lyo-comic-postgres pg_dump -U "$${POSTGRES_USER}" "$${POSTGRES_DB}" | gzip > "$${FILE}"
aws s3 cp "$${FILE}" "s3://$${BACKUP_BUCKET}/postgres/$(basename "$${FILE}")"
find /opt/lyo/comic/postgres/backups -name 'pg_*.sql.gz' -mtime +"$${BACKUP_RETENTION_DAYS}" -delete || true
SCRIPT
chmod +x /opt/lyo/comic/backup-postgres.sh

echo "30 5 * * * root /opt/lyo/comic/backup-postgres.sh >> /var/log/lyo-comic-pg-backup.log 2>&1" > /etc/cron.d/lyo-comic-pg-backup
chmod 644 /etc/cron.d/lyo-comic-pg-backup

echo "db ready" > /opt/lyo/comic/READY

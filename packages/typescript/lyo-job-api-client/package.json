{
  "name": "lyo-job-api-client",
  "version": "0.1.0",
  "description": "Job API client: definitions, runs, workers, schedules, workflows, and query builders for Lyo APIs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lyo-api-client": "file:../lyo-api-client",
    "lyo-query": "file:../lyo-query"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }

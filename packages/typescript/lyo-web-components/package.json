{
  "name": "lyo-web-components",
  "version": "0.1.0",
  "description": "MUI-based Lyo component library for Next.js: theme, query UI, DataGrid, forms, and editors.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/x-date-pickers": "^8.19.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/react": "^3.4.4",
    "@tiptap/starter-kit": "^3.4.4",
    "@uiw/react-codemirror": "^4.25.2",
    "dayjs": "^1.11.18",
    "diff": "^8.0.2",
    "ksuid": "^3.0.0",
    "lyo-api-client": "file:../lyo-api-client",
    "lyo-query": "file:../lyo-query",
    "nanoid": "^5.1.5",
    "ulid": "^2.4.0",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  }
}

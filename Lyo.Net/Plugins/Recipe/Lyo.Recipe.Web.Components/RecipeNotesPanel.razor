<MudStack Spacing="1">
    <MudText Typo="Typo.subtitle2">Notes</MudText>
    @foreach (var note in _notes) {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudText Typo="Typo.body2">@note.Content</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => Delete(note.Id))"/>
        </MudStack>
    }
    <MudStack Row="true" Spacing="1">
        <MudTextField @bind-Value="_draft" Label="New note" Margin="Margin.Dense"/>
        <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="Add" Disabled="@string.IsNullOrWhiteSpace(_draft)">Add</MudButton>
    </MudStack>
</MudStack>

<MudStack Spacing="1">
    <MudText Typo="Typo.subtitle2">Attachments</MudText>
    @foreach (var row in _rows) {
        <MudStack Spacing="1">
            @if (row.Role == RecipeAttachmentRole.Image) {
                <img src="@DownloadUrl(row.FileId, true)" alt="@(row.Caption ?? "Image")" style="max-width: 100%; max-height: 6rem; object-fit: contain;"/>
            }
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <LyoChip Label="@row.Role.ToString()" Hue="@RecipeColorHelper.ForRole(row.Role)" Size="Size.Small"/>
                @if (row.Role != RecipeAttachmentRole.Image) {
                    <MudLink Href="@DownloadUrl(row.FileId, true)" Target="_blank">@(row.Caption ?? row.FileId.ToString("D")[..8])</MudLink>
                }
                <MudTextField T="string" Value="@row.Caption" ValueChanged="@(value => SaveCaption(row, value))" Label="Caption" Margin="Margin.Dense"/>
                <MudCheckBox T="bool" Value="row.IsPrimary" ValueChanged="@(value => SavePrimary(row, value))" Label="Primary" Dense="true" Size="Size.Small"/>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => Delete(row.Id))"/>
            </MudStack>
        </MudStack>
    }
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
        <MudSelect T="RecipeAttachmentRole" @bind-Value="_role" Label="Role" Margin="Margin.Dense" Dense="true" Style="min-width: 8rem;">
            @foreach (var role in Enum.GetValues<RecipeAttachmentRole>()) {
                <MudSelectItem Value="role">@role</MudSelectItem>
            }
        </MudSelect>
        <LyoFileUpload InlineLayout="true"
                       MaxFiles="1"
                       ButtonText="Attach file"
                       ShowFiles="true"
                       OnClientFileReady="OnClientFileReadyAsync"/>
    </MudStack>
</MudStack>

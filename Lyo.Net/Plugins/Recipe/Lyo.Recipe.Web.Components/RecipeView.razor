@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudGrid Spacing="1">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_req.Title" Label="Title" Required="true" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_req.Slug" Label="Slug" Margin="Margin.Dense" HelperText="Filled from the title when left blank"/>
                </MudItem>
                <MudItem xs="6" sm="4" md="2">
                    <MudNumericField @bind-Value="_req.Servings" Label="Servings" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="6" sm="4" md="2">
                    <MudNumericField @bind-Value="_req.PrepMinutes" Label="Prep min" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="6" sm="4" md="2">
                    <MudNumericField @bind-Value="_req.CookMinutes" Label="Cook min" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="6" sm="4" md="2">
                    <MudTextField @bind-Value="_req.YieldLabel" Label="Yield" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="6" sm="4" md="2">
                    <MudSelect T="RecipeDifficulty" @bind-Value="_req.Difficulty" Label="Difficulty" Margin="Margin.Dense" Dense="true">
                        @foreach (var d in Enum.GetValues<RecipeDifficulty>()) {
                            <MudSelectItem Value="d">@d</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="4" md="2">
                    <MudSelect T="RecipeStatus" @bind-Value="_req.Status" Label="Status" Margin="Margin.Dense" Dense="true">
                        @foreach (var s in Enum.GetValues<RecipeStatus>()) {
                            <MudSelectItem Value="s">@s</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="Guid?" @bind-Value="_req.CategoryId" Label="Category" Clearable="true" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">(none)</MudSelectItem>
                        @foreach (var cat in _categories) {
                            <MudSelectItem T="Guid?" Value="@cat.Id">@cat.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_req.SourceName" Label="Source" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_req.SourceUrl" Label="Source URL" Margin="Margin.Dense"/>
                </MudItem>
            </MudGrid>
            <MudTextField @bind-Value="_req.Description" Label="Description" Lines="2" Margin="Margin.Dense" AutoGrow="true"/>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <RecipeIngredientLinesPanel Lines="_lines" Ingredients="_ingredients" Units="_units" Steps="_steps" Changed="Refresh"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <RecipeStepsPanel Steps="_steps"
                                      Lines="_lines"
                                      Ingredients="_ingredients"
                                      ApiClient="ApiClient"
                                      RecipeClient="RecipeClient"
                                      AttachmentsRoute="@_attachmentsRoute"
                                      FileStorageApiRoutePrefix="@FileStorageApiRoutePrefix"
                                      ApiOrigin="@ApiOrigin"
                                      AllowAttachments="@(_savedId != null)"
                                      SavedStepIds="_savedStepIds"
                                      Changed="Refresh"/>
                </MudItem>
            </MudGrid>
            @if (_savedId is Guid recipeId) {
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Files, notes, and tags">
                        <RecipeAttachmentPanel ApiClient="ApiClient"
                                               RecipeClient="RecipeClient"
                                               AttachmentsRoute="@_attachmentsRoute"
                                               FileStorageApiRoutePrefix="@FileStorageApiRoutePrefix"
                                               EntityType="@RecipeEntityTypes.Recipe"
                                               EntityId="recipeId"
                                               ApiOrigin="@ApiOrigin"/>
                        <RecipeNotesPanel RecipeClient="RecipeClient" ParentRoute="@NotesParentRoute" EntityId="recipeId"/>
                        <RecipeTagsPanel RecipeClient="RecipeClient" ParentRoute="@NotesParentRoute" EntityId="recipeId"/>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_savedId != null) {
            <MudButton OnClick="Cook">Cook</MudButton>
        }
        <MudButton OnClick="Cancel">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveClick" Disabled="@string.IsNullOrWhiteSpace(_req.Title)">Save</MudButton>
    </DialogActions>
</MudDialog>

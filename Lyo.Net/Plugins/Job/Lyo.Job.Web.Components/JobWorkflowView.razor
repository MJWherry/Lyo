@inject ISnackbar Snackbar

<MudStack Spacing="2" Class="pa-2">
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect T="Guid?" Label="Workflow" Value="_selectedWorkflowId" ValueChanged="OnWorkflowSelectedAsync" Dense Style="min-width: 280px;"
                   aria-label="Select workflow to visualize">
            @foreach (var workflow in _workflows) {
                <MudSelectItem T="Guid?" Value="workflow.Id">@workflow.Name</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Outlined" OnClick="LoadWorkflowAsync" StartIcon="@Icons.Material.Filled.Refresh" aria-label="Reload selected workflow">Refresh</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartWorkflowAsync" StartIcon="@Icons.Material.Filled.PlayArrow"
                   Disabled="@(_starting || _selectedWorkflow is null || !_selectedWorkflow.Enabled)" aria-label="Start a run of the selected workflow">
            Run now
        </MudButton>
    </MudStack>

    @if (_loading) {
        <MudProgressLinear Indeterminate="true"/>
    }
    else if (_selectedWorkflow is null) {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Select a workflow to visualize its steps.</MudText>
    }
    else {
        <MudPaper Class="pa-4" Elevation="1">
            <MudText Typo="Typo.h6">@_selectedWorkflow.Name</MudText>
            @if (!string.IsNullOrWhiteSpace(_selectedWorkflow.Description)) {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@_selectedWorkflow.Description</MudText>
            }

            <JobWorkflowGraphView Steps="@GraphSteps" Definitions="@GraphDefinitions"/>
        </MudPaper>
    }
</MudStack>

@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="JobDefinitionGrid"
                      Route="@_definitionRoute"
                      KeySelector="@(i => ProjectedGridKeys.GuidId(i))"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      Features="@LyoDataGridFeatureFlags.All">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <LeftControls>
        <MudButton OnClick="@OpenCreateRunDialog"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   Variant="Variant.Outlined"
                   Color="Color.Default">
            Create Job Run
        </MudButton>
    </LeftControls>
    <BulkMenuItems>
        <MudMenuItem OnClick="@(() => BulkToggle(true))">Enable</MudMenuItem>
        <MudMenuItem OnClick="@(() => BulkToggle(false))">Disable</MudMenuItem>
    </BulkMenuItems>
    <Columns>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false"
                        HeaderStyle="@LyoDataGridColumnStyles.QuickActionsHeaderStyle"
                        CellStyle="@LyoDataGridColumnStyles.QuickActionsCellStyle">
            <CellTemplate Context="cell">
                <MudStack Row Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" title="Run now" aria-label="Run job definition now"
                                   OnClick="@(() => RunJob(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit definition" aria-label="Edit job definition"
                                   OnClick="@(() => ViewDefinition(cell.Item))"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <LyoProjectedColumn Field="Enabled" Title="Enabled" Align="Align.Center" HeaderStyle="width: 110px;">
            <CellContent Context="item">
                @{
                    var enabled = GetEnabled(item);
                }
                <LyoChip Spec="@LyoChips.FromBool(enabled, "Enabled", "Disabled", Color.Success, Color.Default)"
                         Style="cursor: pointer;"
                         OnClick="@(() => ToggleDefinition(item))"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 140px;" CellStyle="white-space: nowrap;">
            <CellContent Context="item">
                <LyoIdField Compact="true" Text="@ProjectedValueHelper.GetDisplayValue(item, "Id")"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Name" Title="Name" QuickSearchPropertyName="Name" MaxDisplayLength="@ChipLabelHelper.DefaultGridCellMaxLength"/>
        <LyoProjectedColumn Field="Description" Title="Description" QuickSearchPropertyName="Description" MaxDisplayLength="@ChipLabelHelper.DefaultGridCellMaxLength"/>
        <LyoProjectedColumn Field="Type" Title="Type" QuickSearchPropertyName="Type"/>
        <LyoProjectedColumn Field="WorkerType" Title="Worker Type"/>
        <LyoProjectedColumn Field="JobRuns.CreatedTimestamp" Title="Last Run" Sortable="false" CellStyle="white-space: nowrap;"
                            Timestamp="LyoTimestampKind.Absolute" TimestampLatest="true"/>
        <LyoProjectedColumn Field="JobSchedules.Count" Title="Schedules" Align="Align.Center" HeaderStyle="width: 90px;"/>
        <LyoProjectedColumn Field="JobParameters.Count" Title="Parameters" Align="Align.Center" HeaderStyle="width: 90px;"/>
        <LyoProjectedColumn Field="CreatedTimestamp" Title="Created" HiddenByDefault="true" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Absolute"/>
        <LyoProjectedColumn Field="UpdatedTimestamp" Title="Updated" HiddenByDefault="true" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Absolute"/>
        <LyoProjectedColumn Field="MaxRetryCount" Title="Max Retries" Align="Align.Center" HeaderStyle="width: 90px;" HiddenByDefault="true"/>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => ViewDefinition(item))">Edit</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => RunJob(item))">Run</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.History" OnClick="@(() => ViewRuns(item))">View Runs</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.ToggleOn" OnClick="@(() => ToggleDefinition(item))">Toggle Enabled</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

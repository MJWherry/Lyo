{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Billing.Seed",
  "name": "Lyo.Billing.Seed",
  "area": "Plugins",
  "tagline": "EF seed of billing clients, contact payloads, a biller profile, and draft plus issued invoices.",
  "description": "`BillingEfSeedContributor` writes one biller profile, one invoice sequence, and `options.Count` clients with no tax id and no ciphertext. Each client gets a person, phone, email, and address payload, one draft invoice, and one issued invoice with a line, a charge, and a payment. `JournalId` stays null. `OnClear` deletes children before clients so `--replace` can run.",
  "features": [
    "**Draft only.** Invoices stay in draft. Tax id columns stay empty.",
    "**Replace.** `OnClear` deletes payments, lines, charges, invoices, links, then clients."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "services.AddLyoSeed();\nservices.AddSeedContributor<BillingEfSeedContributor>();"
    }
  ],

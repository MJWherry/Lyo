{
  "id": "Lyo.Billing.Postgres",
  "name": "Lyo.Billing.Postgres",
  "area": "Plugins",
  "tagline": "EF Core implementation of `IBillingStore` in PostgreSQL schema `billing`.",
  "description": "PostgreSQL storage for Lyo.Billing. Issue/pay/void wrap `ILedgerStore` in a `TransactionScope`. Bill-to clients live in `billing.client`. Cipher columns hold client/invoice tax snapshots and biller remittance. Schema constant: `PostgresBillingOptions.Schema = \"billing\"`.",
  "features": [],
  "examples": [
    {
      "title": "Register the store",
      "language": "csharp",
      "code": "services.AddPostgresLedgerStore(ledgerOptions);\nservices.AddPostgresBillingStore(new PostgresBillingOptions {\n    ConnectionString = \"...\",\n    EnableAutoMigrations = true\n});\nservices.AddBillingFieldEncryption(BillingEncryptionKeys.Fields);"
    },
    {
      "title": "Migrations",
      "language": "bash",
      "code": "export BILLING_CONNECTION_STRING=\"Host=localhost;Database=lyo;Username=postgres;Password=postgres\"\ndotnet ef migrations add MigrationName --project Plugins/Billing/Lyo.Billing.Postgres"
    }
  ],
  "sections": [
    {
      "type": "list",
      "title": "See also",
      "items": [

@inject ISnackbar Snackbar

<LyoDialog Busy="@_saving" OnSave="SaveAsync" SaveDisabled="@(!_canSave)" DebugData="@DebugModel()">
    <TitleContent>
        <MudText Typo="Typo.h6">@_edit.Key</MudText>
    </TitleContent>
    <TitleChips>
        <LyoChip Spec="@LyoChips.FromBool(IsNew, "New binding", "Existing binding", Color.Info, Color.Success)"/>
        <LyoChip Spec="@LyoChips.FromBool(Definition.IsRequired, "Required", "Optional", ConfigColorHelper.ForRequired(true), Color.Default)"/>
        <LyoChip Spec="@LyoChips.FromBool(Definition.IsEncrypted, "Encrypted", "Plain", Color.Warning, Color.Default)"/>
    </TitleChips>
    <ChildContent>
        <MudGrid Spacing="2" Class="pa-1">
            @if (!IsNew) {
                <MudItem xs="12" sm="4">
                    <LyoIdField Label="Binding ID" Value="@_edit.Id"/>
                </MudItem>
            }
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Label="Key" Value="@_edit.Key" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Label="Subject entity type" Value="@_edit.SubjectEntityType" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Label="Subject entity id" Value="@_edit.SubjectEntityId" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12">
                <ConfigValueEditor Value="_edit.Value"
                                   ValueChanged="OnValueChanged"
                                   ParseErrorChanged="OnParseErrorChanged"
                                   IsEncrypted="Definition.IsEncrypted"
                                   EditorSurfaceHeight="180px"/>
            </MudItem>
        </MudGrid>
        @if (!IsNew) {
            <MudDivider Class="my-3"/>
            <MudText Typo="Typo.subtitle2">Value history</MudText>
            <ConfigRevisionList Store="Store"
                                BindingId="_edit.Id"
                                DataVersion="_historyVersion"
                                Compact="true"
                                MaskValues="Definition.IsEncrypted"
                                OnChanged="OnBindingRevertedAsync"/>
        }
    </ChildContent>
</LyoDialog>

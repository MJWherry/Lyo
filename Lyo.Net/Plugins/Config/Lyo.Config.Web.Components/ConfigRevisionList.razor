@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudStack Spacing="2" Class="@(Compact ? null : "mt-3")">
    @if (BindingId is null) {
        @if (!Compact) {
            <MudAlert Severity="Severity.Info" Dense="true">Open History on a resolved binding to inspect and revert value revisions.</MudAlert>
        }
    }
    else if (_loadError != null) {
        <MudAlert Severity="Severity.Error" Dense="true">@_loadError</MudAlert>
    }
    else {
        @if (!Compact) {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_items.Count revision(s) for binding</MudText>
                <LyoIdField Compact="true" Value="@BindingId"/>
            </MudStack>
            <MudAlert Severity="Severity.Info" Dense="true">Revert copies that snapshot and appends a new revision so history stays linear. Value history is empty until the first binding save.</MudAlert>
        }
        <LyoResponsiveTable>
            <TableContent>
                <MudTable Items="_items" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Elevation="0" Loading="_loading">
                    <HeaderContent>
                        <MudTh></MudTh>
                        <MudTh>Revision</MudTh>
                        <MudTh>Created</MudTh>
                        <MudTh>Value</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Actions">
                            @RevertButton(context)
                        </MudTd>
                        <MudTd DataLabel="Revision">@context.Revision</MudTd>
                        <MudTd DataLabel="Created">
                            <LyoTimestamp Value="@context.CreatedTimestamp" Kind="LyoTimestampKind.Absolute"/>
                        </MudTd>
                        <MudTd DataLabel="Value">
                            <LyoTruncatedText Text="@ConfigDisplay.Json(context.Value.Json, MaskValues)"/>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No value revisions for this binding.</MudText>
                    </NoRecordsContent>
                </MudTable>
            </TableContent>
            <CardContent>
                @if (_loading) {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
                }
                else if (_items.Count == 0) {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No value revisions for this binding.</MudText>
                }
                else {
                    @foreach (var revision in _items) {
                        <LyoRecordCard Title="@($"Revision {revision.Revision}")">
                            <Actions>
                                @RevertButton(revision)
                            </Actions>
                            <ChildContent>
                                <LyoRecordField Label="Created">
                                    <LyoTimestamp Value="@revision.CreatedTimestamp" Kind="LyoTimestampKind.Absolute"/>
                                </LyoRecordField>
                                <LyoRecordField Label="Value">
                                    <LyoTruncatedText Text="@ConfigDisplay.Json(revision.Value.Json, MaskValues)"/>
                                </LyoRecordField>
                            </ChildContent>
                        </LyoRecordCard>
                    }
                }
            </CardContent>
        </LyoResponsiveTable>
    }
</MudStack>

@code {

    private RenderFragment<ConfigBindingRevisionRecord> RevertButton => revision => @<text>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                   Disabled="@_busy" OnClick="@(() => RevertAsync(revision))">
            Revert
        </MudButton>
    </text>;

}

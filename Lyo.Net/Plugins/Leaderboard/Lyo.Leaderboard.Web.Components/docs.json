  "id": "Lyo.Leaderboard.Web.Components",
  "name": "Lyo.Leaderboard.Web.Components",
  "area": "Plugins",
  "tagline": "Blazor board, standings, submit, verify, and invite UI.",
  "description": "Pass `ILeaderboardApiClient` into `LeaderboardManagement`. The property editor writes discrete-map, range-band, linear, and expression children onto the board algorithm. Enums use MudSelect.",
  "features": [
    "`LeaderboardManagement` tabs: Board, Standings, Submit, Verify, Invite.",
    "`LeaderboardFishingBoard` seeds the derby used by the Postgres fixture.",
    "No DI registration and no sibling test project."
  ],
  "examples": [
    {
      "title": "Host the management surface",
      "language": "razor",
      "code": "<LeaderboardManagement Client=\"Client\" />"
    }
  ],

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>PostgreSQL persistence for Lyo.Leaderboard (boards, scoring properties, members, invites, entries, standings).</Description>
        <PackageTags>leaderboard postgres postgresql entityframework ef</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Leaderboard\Lyo.Leaderboard.csproj"/>
        <ProjectReference Include="..\..\..\Apps\Api\Lyo.Api\Lyo.Api.csproj"/>
        <ProjectReference Include="..\..\..\Data\Algorithms\Lyo.Algorithms\Lyo.Algorithms.csproj"/>
        <ProjectReference Include="..\..\..\Data\Algorithms\Lyo.Algorithms.Postgres\Lyo.Algorithms.Postgres.csproj"/>
        <ProjectReference Include="..\..\..\Core\Health\Lyo.Health\Lyo.Health.csproj"/>
        <ProjectReference Include="..\..\..\Core\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
        <ProjectReference Include="..\..\..\Data\Postgres\Lyo.Postgres\Lyo.Postgres.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Leaderboard.Postgres.Tests"/>
        <InternalsVisibleTo Include="Lyo.Leaderboard.Seed"/>
        <InternalsVisibleTo Include="Lyo.Leaderboard.Seed.Tests"/>
    </ItemGroup>
</Project>

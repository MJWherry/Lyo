{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Leaderboard",
  "name": "Lyo.Leaderboard",
  "area": "Plugins",
  "tagline": "Boards, membership, invites, entries, and standings.",
  "description": "Domain for user-created games. Each board has one score formula. Choice options store a key and a number the formula can read. This package aggregates approved entry totals (sum, best, best-N, average, count, latest).",
  "features": [
    "`LeaderboardAggregator` collapses approved entry scores into a member total.",
    "`ILeaderboardStore` is the persistence and policy boundary. Board roles stay on the member row.",
    "Global scopes `leaderboard.read` / `leaderboard.write` / `leaderboard.admin` via `AddLeaderboardScopes`.",
    "Invite tokens are plaintext once; only the SHA-256 hash is stored."
  ],
  "examples": [
    {
      "title": "Aggregate approved scores",
      "language": "csharp",
      "code": "var total = LeaderboardAggregator.Aggregate(AggregationKind.Sum, null, SortDirection.Desc, scores);"
    }
  ],

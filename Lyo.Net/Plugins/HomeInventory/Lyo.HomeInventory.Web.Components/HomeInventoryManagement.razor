@inject IApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudTabs @bind-ActivePanelIndex="_tabIndex" Color="Color.Primary" SliderColor="Color.Secondary" Class="mt-2">
    <MudTabPanel Text="Items">
        <HomeItemGrid ApiClient="ApiClient"
                      BaseRoute="@BaseRoute"
                      FileStorageApiRoutePrefix="@FileStorageApiRoutePrefix"/>
    </MudTabPanel>
    <MudTabPanel Text="Locations">
        <HomeLocationTree ApiClient="ApiClient" BaseRoute="@BaseRoute" FileStorageApiRoutePrefix="@FileStorageApiRoutePrefix"/>
    </MudTabPanel>
    <MudTabPanel Text="Categories">
        <HomeCategoryGrid ApiClient="ApiClient" BaseRoute="@BaseRoute"/>
    </MudTabPanel>
    <MudTabPanel Text="Movements">
        <HomeMovementGrid ApiClient="ApiClient" BaseRoute="@BaseRoute"/>
    </MudTabPanel>
</MudTabs>

{
  "id": "Lyo.HomeInventory.FileStorage",
  "name": "Lyo.HomeInventory.FileStorage",
  "area": "Plugins",
  "tagline": "Optional FileStorage helper that stores inventory photos and documents and writes attachment rows.",
  "description": "Optional composition of `IFileStorageService` and `IHomeInventoryStore`. `AddHomeInventoryFileStorage` registers `IHomeInventoryAttachmentFiles` when the host already has `IFileStorageService`. Path prefixes come from `HomeInventoryFilePaths`.",
  "features": [
    "`SaveAsync` writes bytes under `home-inventory/{items|locations|categories}/{id}` and inserts a `HomeAttachmentRecord`.",
    "`DeleteAsync` removes the attachment row and optionally the stored file."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "services.AddHomeInventoryFileStorage();"
    }
  ],

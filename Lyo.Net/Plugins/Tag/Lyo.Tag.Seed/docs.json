{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Tag.Seed",
  "name": "Lyo.Tag.Seed",
  "area": "Plugins",
  "tagline": "EF seed of tags on a fixed seed subject.",
  "description": "`TagEfSeedContributor` writes `options.Count` public tags (type `tag`, unique slug) for tenant `TagEfSeedContributor.TenantId` and subject `seed` / `seed`. `OnClear` deletes tags so `--replace` can run.",
  "features": [
    "**Fixed subject.** Every row uses the same tenant, subject, and actor.",
    "**Replace.** `OnClear` deletes tags."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "services.AddLyoSeed();\nservices.AddSeedContributor<TagEfSeedContributor>();"
    }
  ],

@code {
    private RenderFragment RenderSectionNode(Section section, int depth) => @<text>
        @{
            var sectionKey = ReportDesignTreeExpand.SectionKey(section);
            var expanded = IsExpanded(sectionKey);
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Style="@($"padding-left:{8 + depth * 12}px")" Class="@TreeRowClass(CurrentSelection().Matches(section))" data-lyo-design="@sectionKey">
            @RenderExpandToggle(sectionKey, expanded)
            <MudListItem T="string" OnClick="@(() => SelectSection(section))" Icon="@Icons.Material.Filled.ViewAgenda">
                @(section.Title ?? "Section")
            </MudListItem>
        </MudStack>
        <MudDropZone T="DesignBodyDrop" Identifier="@ReportDesignTreeExpand.LiveKey(section)" AllowReorder="true" Style="@(expanded ? null : "min-height: 8px;")"/>
    </text>;

    private RenderFragment RenderBodyDrop(DesignBodyDrop drop) => @<text>
        @if (IsExpanded(ReportDesignTreeExpand.SectionKey(drop.Section))) {
            @switch (drop.Item.Kind) {
                case SectionBodyKind.Control when drop.Item.Control is not null:
                    @RenderControlNode(drop.Section, drop.Item.Control, 24)
                    break;
                case SectionBodyKind.Subsection when drop.Item.Subsection is not null:
                    @RenderSectionNode(drop.Item.Subsection, 2)
                    break;
            }
        }
    </text>;

    private RenderFragment RenderControlNode(Section section, Control control, int indent) => @<text>
        @switch (control) {
            case Card card:
                <MudListItem T="string" OnClick="@(() => SelectCard(section, card))" Icon="@Icons.Material.Filled.CreditCard" Style="@($"padding-left: {indent}px;")" Class="@TreeRowClass(CurrentSelection().Matches(card))"
                             data-lyo-design="@ReportDesignTreeExpand.CardKey(section, card)">
                    @(card.Label ?? "Card")
                </MudListItem>
                break;
            case Lyo.Reporting.Models.Controls.Block block:
                <MudListItem T="string" OnClick="@(() => SelectBlock(section, block))" Icon="@Icons.Material.Filled.Notes" Style="@($"padding-left: {indent}px;")" Class="@TreeRowClass(CurrentSelection().Matches(block))"
                             data-lyo-design="@ReportDesignTreeExpand.BlockKey(section, block)">
                    @block.ContentType
                </MudListItem>
                break;
            case Table table:
                @RenderTableNode(section, table, indent)
                break;
            case Grid grid:
                @RenderGridNode(section, grid, indent)
                break;
        }
    </text>;

    private RenderFragment RenderTableNode(Section section, Table table, int indent) => @<text>
        @{
            var tableKey = ReportDesignTreeExpand.TableKey(section, table);
            var tableOpen = IsExpanded(tableKey);
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Style="@($"padding-left: {indent}px;")" Class="@TreeRowClass(CurrentSelection().Matches(table))" data-lyo-design="@tableKey">
            @RenderExpandToggle(tableKey, tableOpen)
            <MudListItem T="string" OnClick="@(() => SelectTable(section, table))" Icon="@Icons.Material.Filled.TableChart">
                @(table.Title ?? "Table")
            </MudListItem>
        </MudStack>
        @if (tableOpen) {
            @foreach (var col in table.Columns) {
                var capturedCol = col;
                <MudListItem T="string" OnClick="@(() => SelectTableColumn(section, table, capturedCol))" Style="@($"padding-left: {indent + 28}px;")" Class="@TreeRowClass(CurrentSelection().Matches(capturedCol))"
                             data-lyo-design="@ReportDesignTreeExpand.TableColumnKey(section, table, capturedCol)">
                    Col: @(col.Header)
                </MudListItem>
            }
            @foreach (var rowEntry in table.Rows.Select((r, i) => (Row: r, Index: i))) {
                var capturedRow = rowEntry.Row;
                var label = rowEntry.Index + 1;
                <MudListItem T="string" OnClick="@(() => SelectTableRow(section, table, capturedRow))" Style="@($"padding-left: {indent + 28}px;")" Class="@TreeRowClass(CurrentSelection().Matches(capturedRow))"
                             data-lyo-design="@ReportDesignTreeExpand.TableRowKey(section, table, capturedRow)">
                    Row @label
                </MudListItem>
            }
        }
    </text>;

    private RenderFragment RenderGridNode(Section section, Grid grid, int indent) => @<text>
        @{
            var gridKey = ReportDesignTreeExpand.GridKey(section, grid);
            var gridOpen = IsExpanded(gridKey);
        }
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Style="@($"padding-left: {indent}px;")" Class="@TreeRowClass(_target == DesignTarget.Grid && ReferenceEquals(_grid, grid))" data-lyo-design="@gridKey">
            @RenderExpandToggle(gridKey, gridOpen)
            <MudListItem T="string" OnClick="@(() => SelectGrid(section, grid))" Icon="@Icons.Material.Filled.GridView">
                @(grid.Title ?? "Grid")
            </MudListItem>
        </MudStack>
        @if (gridOpen) {
            @foreach (var child in grid.Controls) {
                var captured = child;
                @RenderControlNode(section, captured, indent + 28)
            }
        }
    </text>;

    private RenderFragment RenderExpandToggle(string key, bool expanded) => @<text>
        <span @onpointerdown:stopPropagation="true" @onclick:stopPropagation="true" draggable="false">
            <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)" Size="Size.Small"
                           OnClick="@(() => ToggleExpanded(key))" title="@(expanded ? "Collapse" : "Expand")"/>
        </span>
    </text>;
}

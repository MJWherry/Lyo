@using Lyo.Parameters
@using Lyo.Web.Components.ParamTable
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject IDialogService DialogService

<LyoDialog DebugData="@Generation">
    <TitleContent>
        <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(Generation.OriginalFileName) ? "Report Generation" : Generation.OriginalFileName)</MudText>
    </TitleContent>
    <TitleChips>
        <LyoChip Spec="@ReportColorHelper.ForFormatChip(Generation.Format)"/>
        <LyoChip Label="@Generation.Status.ToString()" Color="@ReportColorHelper.ForStatus(Generation.Status)"/>
        @if (Generation.StartedTimestamp is not null) {
            <LyoChip Color="@ReportColorHelper.ForDuration(Generation.StartedTimestamp, Generation.FinishedTimestamp)"
                     Icon="@(Generation.FinishedTimestamp is null ? Icons.Material.Filled.Timer : null)"
                     Label="@DurationText"/>
        }
        @if (!string.IsNullOrWhiteSpace(Generation.ContentType)) {
            <LyoChip Variant="Variant.Outlined" Label="@Generation.ContentType"/>
        }
    </TitleChips>
    <ExtraActions>
        <MudButton OnClick="ViewAsync" StartIcon="@Icons.Material.Filled.OpenInNew" Disabled="@(!CanView)">View</MudButton>
        <MudButton OnClick="DownloadAsync" StartIcon="@Icons.Material.Filled.Download" Disabled="@(!CanDownload)">Download</MudButton>
    </ExtraActions>
    <ChildContent>
        <MudGrid Class="pa-1" Spacing="2">
            <MudItem xs="12" sm="6" md="3">
                <LyoIdField Label="ID" Value="@Generation.Id"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <LyoIdField Label="Definition ID" Value="@Generation.ReportDefinitionId"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string" Label="Created By" Value="@Generation.CreatedBy" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string" Label="Created" Value="@Generation.CreatedTimestamp.ToString("g")" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <LyoIdField Label="File Id" Value="@Generation.OutputFileId"/>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField T="string" Label="Path Prefix" Value="@(Generation.PathPrefix ?? "-")" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="File Name" Value="@(Generation.OriginalFileName ?? "-")" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
            @if (!string.IsNullOrWhiteSpace(Generation.ErrorMessage)) {
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Error" Dense="true">@Generation.ErrorMessage</MudAlert>
                </MudItem>
            }
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Class="mb-1">Parameters</MudText>
                <LyoKeyedValueTable Items="@Parameters" SortByKey="false"/>
            </MudItem>
        </MudGrid>
    </ChildContent>
</LyoDialog>

<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Lyo.Reporting.Web</RootNamespace>
        <Description>Blazor report viewer and HTML/PDF report renderers for Lyo Reporting.</Description>
        <PackageTags>blazor reporting reports html pdf</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Also embedded so file exports can inline it; the static web asset copy covers interactive hosting. -->
        <EmbeddedResource Include="wwwroot\scripts\chart.umd.min.js"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Reporting.Models\Lyo.Reporting.Models.csproj"/>
        <ProjectReference Include="..\..\..\Apps\Web\Renderer\Lyo.Web.WebRenderer\Lyo.Web.WebRenderer.csproj"/>
        <ProjectReference Include="..\..\..\Core\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
        <ProjectReference Include="..\..\..\Core\Common\Lyo.Common.Metadata\Lyo.Common.Metadata.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    </ItemGroup>

</Project>

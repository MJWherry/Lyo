@inject IDialogService DialogService

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="LawNodeGrid"
                      Route="@_nodesRoute"
                      KeySelector="@(i => ProjectedGridKeys.GuidId(i))"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      KeySelectFields="@_keySelectFields"
                      Features="@(LyoDataGridFeatureFlags.Filterable | LyoDataGridFeatureFlags.Searchable)">
    <Columns>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false"
                        HeaderStyle="@LyoDataGridColumnStyles.QuickActionsHeaderStyle"
                        CellStyle="@LyoDataGridColumnStyles.QuickActionsCellStyle">
            <CellTemplate Context="cell">
                <MudIconButton Icon="@Icons.Material.Filled.Article" Size="Size.Small" title="Open" OnClick="@(() => OpenNode(cell.Item))"/>
            </CellTemplate>
        </TemplateColumn>
        <LyoProjectedColumn Field="Citation" Title="Citation" QuickSearchPropertyName="Citation"/>
        <LyoProjectedColumn Field="Heading" Title="Heading" QuickSearchPropertyName="Heading"/>
        <LyoProjectedColumn Field="Label" Title="Label"/>
        <LyoProjectedColumn Field="Kind" Title="Kind"/>
        <LyoProjectedColumn Field="Code.Key" Title="Code"/>
        <LyoProjectedColumn Field="Code.Jurisdiction.Key" Title="State"/>
        <LyoProjectedColumn Field="IsRepealed" Title="Repealed"/>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.Article" OnClick="@(() => OpenNode(item))">Open</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

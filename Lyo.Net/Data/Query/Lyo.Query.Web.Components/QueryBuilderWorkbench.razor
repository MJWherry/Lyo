@using Lyo.Web.Components.QueryRequestBuilder
<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudStack Spacing="4">
        <MudText Typo="Typo.h4">@Title</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            Build a <strong>/QueryConcrete</strong> (
            <c>QueryConcreteReq</c>
            ), <strong>/QueryProject</strong> (
            <c>ProjectionQueryReq</c>
            ), or root <strong>/Query</strong> (
            <c>QueryReq</c>
            — From/Joins) request. Shared paging/filter fields stay in sync when switching Concrete ↔ Project.
            For root Query, pick the dynamic CRUD <em>base</em> route (no entity type segment).
        </MudText>

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Query Builder" Icon="@Icons.Material.Filled.Build">
                <MudPaper Elevation="0" Class="pa-4">
                    <MudStack Spacing="3">
                        <MudButtonGroup OverrideStyles="false" Variant="Variant.Outlined" Size="Size.Small">
                            <MudButton OnClick="@(() => OnWorkbenchModeChanged(QueryWorkbenchRunMode.Query))"
                                       Variant="@(_runConfig.RunMode == QueryWorkbenchRunMode.Query ? Variant.Filled : Variant.Outlined)"
                                       Color="@(_runConfig.RunMode == QueryWorkbenchRunMode.Query ? Color.Primary : Color.Default)">/QueryConcrete
                            </MudButton>
                            <MudButton OnClick="@(() => OnWorkbenchModeChanged(QueryWorkbenchRunMode.QueryProject))"
                                       Variant="@(_runConfig.RunMode == QueryWorkbenchRunMode.QueryProject ? Variant.Filled : Variant.Outlined)"
                                       Color="@(_runConfig.RunMode == QueryWorkbenchRunMode.QueryProject ? Color.Primary : Color.Default)">/QueryProject
                            </MudButton>
                            <MudButton OnClick="@(() => OnWorkbenchModeChanged(QueryWorkbenchRunMode.RootQuery))"
                                       Variant="@(_runConfig.RunMode == QueryWorkbenchRunMode.RootQuery ? Variant.Filled : Variant.Outlined)"
                                       Color="@(_runConfig.RunMode == QueryWorkbenchRunMode.RootQuery ? Color.Primary : Color.Default)">/Query
                            </MudButton>
                        </MudButtonGroup>

                        @if (_runConfig.RunMode == QueryWorkbenchRunMode.Query) {
                            <QueryReqForm Request="@_entityQuery"
                                          RequestChanged="@OnEntityFormRequestChanged"
                                          IncludeAll="@_includeAll"
                                          IncludeAllChanged="@OnIncludeAllChanged"
                                          KeysAll="@(_keysAll.Count > 0 ? _keysAll : null)"
                                          KeysAllChanged="@OnKeysAllChanged"
                                          PropertyDefinitions="@_propertyDefinitions"/>
                        }
                        else if (_runConfig.RunMode == QueryWorkbenchRunMode.QueryProject) {
                            <QueryRequestBuilder Request="@_projectionQuery"
                                                 RequestChanged="@OnProjectionFormRequestChanged"
                                                 SelectAll="@_selectAll"
                                                 SelectAllChanged="@OnSelectAllChanged"
                                                 KeysAll="@(_keysAll.Count > 0 ? _keysAll : null)"
                                                 KeysAllChanged="@OnKeysAllChanged"
                                                 PropertyDefinitions="@_propertyDefinitions"/>
                        }
                        else {
                            <QueryRootForm Request="@_rootQuery"
                                           RequestChanged="@OnRootFormRequestChanged"
                                           SelectAll="@_selectAll"
                                           SelectAllChanged="@OnSelectAllChanged"
                                           PropertyDefinitions="@_propertyDefinitions"/>
                        }
                    </MudStack>
                </MudPaper>
            </MudTabPanel>
            <MudTabPanel Text="JSON + Run" Icon="@Icons.Material.Filled.Code">
                <QueryRunPanel EntityRequest="@_entityQuery"
                               EntityRequestChanged="@OnRunPanelEntityRequestChanged"
                               ProjectionRequest="@_projectionQuery"
                               ProjectionRequestChanged="@OnRunPanelProjectionRequestChanged"
                               RootRequest="@_rootQuery"
                               RootRequestChanged="@OnRunPanelRootRequestChanged"
                               Run="@_runConfig"
                               RunChanged="@OnRunConfigurationChanged"
                               RunRestoreKey="@_runRestoreKey"/>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>

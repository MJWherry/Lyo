{
  "id": "Lyo.IO.FileSystem.Web.Components",
  "name": "Lyo.IO.FileSystem.Web.Components",
  "area": "Data",
  "tagline": "Blazor folder tree over `IFileTreeSource` (local `IFileSystem` or HTTP).",
  "description": "MudBlazor tree that lazy-lists folders through `IFileTreeSource`. It does not know FileStorage. Wrap `IFileSystem` with `FileSystemTreeSource`, or supply an HTTP source.",
  "features": [
    "**Lazy expand.** Children load from `IFileTreeSource.ListChildrenAsync` when a directory is opened.",
    "**Optional filter, selection, and trailing content.** Search filters loaded nodes. Multi-select is opt-in. Hosts supply `ItemTrailing` (FileStorage draws Store / Physical / Both chips); raw property dumps are not rendered."
  ],
  "examples": [
    {
      "title": "Memory file system",
      "language": "csharp",
      "code": "<LyoFileTree Source=\"_source\" RootPath=\"@_fs.RootPath\" />\n\n@code {\n    private readonly MemoryFileSystem _fs = new();\n    private IFileTreeSource _source = default!;\n    protected override void OnInitialized() => _source = new FileSystemTreeSource(_fs);\n}"
    }
  ],

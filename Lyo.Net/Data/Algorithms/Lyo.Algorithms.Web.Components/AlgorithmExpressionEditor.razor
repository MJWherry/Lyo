@implements IAsyncDisposable

<div class="algorithm-expression">
    <div class="algorithm-wrap" @ref="_wrap">
        <div class="algorithm-frame">
            <pre class="algorithm-highlight" aria-hidden="true">@foreach (var segment in Segments(_text, _chips)) { @if (segment.Mark) { <mark>@segment.Text</mark> } else { @segment.Text } }<span> </span></pre>
            <textarea @ref="_area"
                      class="algorithm-source"
                      value="@_text"
                      @oninput="OnInput"
                      @onkeyup="OnCaret"
                      @onclick="OnCaret"
                      @onblur="OnBlur"
                      spellcheck="false"
                      autocomplete="off"
                      role="combobox"
                      aria-autocomplete="list"
                      aria-expanded="@(_suggestions.Count > 0)"></textarea>
        </div>
    </div>
    @if (_suggestions.Count > 0) {
        <ul @ref="_suggest" class="algorithm-suggest" role="listbox">
            @for (var i = 0; i < _suggestions.Count; i++) {
                var index = i;
                var item = _suggestions[i];
                <li role="option" class="@(_activeIndex == index ? "is-active" : null)" aria-selected="@(_activeIndex == index)" @onmousedown:preventDefault="true" @onclick="() => InsertSuggestionAsync(item)">
                    <code>@item</code>
                </li>
            }
        </ul>
    }
    @if (_chips.Count > 0) {
        <div class="algorithm-chips">
            @foreach (var name in _chips) {
                <button type="button" class="@(name == Focused ? "algorithm-chip is-focused" : "algorithm-chip")" @onclick="() => SelectChipAsync(name)">@name</button>
            }
        </div>
    }
</div>

<style>
    .algorithm-expression { display: flex; flex-direction: column; min-width: 0; }
    .algorithm-wrap { max-height: 10rem; overflow: auto; border: 1px solid var(--mud-palette-lines-default); border-radius: var(--mud-default-borderradius); background: var(--mud-palette-surface); }
    .algorithm-frame { display: grid; grid-template-columns: 1fr; min-height: 4.5rem; }
    .algorithm-highlight, .algorithm-source {
        grid-area: 1 / 1; box-sizing: border-box; margin: 0; padding: 8px 12px; border: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.875rem; line-height: 1.5;
        white-space: pre-wrap; overflow-wrap: break-word; tab-size: 4; min-height: 100%;
    }
    .algorithm-highlight { pointer-events: none; user-select: none; color: var(--mud-palette-text-primary); }
    .algorithm-highlight mark { background: color-mix(in srgb, var(--mud-palette-primary) 28%, transparent); color: inherit; border-radius: 2px; }
    .algorithm-source { background: transparent; color: transparent; caret-color: var(--mud-palette-text-primary); resize: none; outline: none; overflow: hidden; width: 100%; }
    .algorithm-source::selection { background: color-mix(in srgb, var(--mud-palette-primary) 28%, transparent); color: transparent; }
    .algorithm-suggest {
        position: fixed; top: -9999px; left: 0; z-index: 1400; list-style: none; margin: 0; padding: 4px 0;
        min-width: 12rem; max-height: 12rem; overflow: auto; border: 1px solid var(--mud-palette-lines-default);
        border-radius: var(--mud-default-borderradius); background: var(--mud-palette-surface); box-shadow: var(--mud-elevation-8);
    }
    .algorithm-suggest li { padding: 4px 12px; cursor: pointer; font-size: 0.8125rem; }
    .algorithm-suggest li.is-active, .algorithm-suggest li:hover { background: color-mix(in srgb, var(--mud-palette-primary) 16%, var(--mud-palette-surface)); }
    .algorithm-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .algorithm-chip { border: 0; border-radius: 999px; padding: 2px 10px; font: inherit; font-size: 0.75rem; cursor: pointer; color: var(--mud-palette-text-primary); background: color-mix(in srgb, var(--mud-palette-primary) 28%, var(--mud-palette-surface)); }
    .algorithm-chip.is-focused { outline: 2px solid var(--mud-palette-primary); }
</style>

@code {
    private readonly List<string> _suggestions = [];
    private ElementReference _area;
    private ElementReference _suggest;
    private ElementReference _wrap;
    private int _activeIndex;
    private int _blurGeneration;
    private int _caret;
    private IReadOnlyList<string> _chips = [];
    private string _text = string.Empty;
    private DotNetObjectReference<AlgorithmExpressionEditor>? _self;
    private IJSObjectReference? _module;

    [Inject]
    private IJSRuntime Js { get; set; } = null!;

    [Parameter]
    public string Source { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SourceChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> BagNames { get; set; } = [];

    [Parameter]
    public IReadOnlyList<string> CatalogKeys { get; set; } = [];

    [Parameter]
    public string? Focused { get; set; }

    [Parameter]
    public EventCallback<string?> FocusedChanged { get; set; }

    [Parameter]
    public EventCallback<string> ChipSelected { get; set; }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null) {
            try {
                await _module.InvokeVoidAsync("unbindKeys", _area);
                await _module.InvokeVoidAsync("unbindView", _wrap);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) {
            }
        }

        _self?.Dispose();
    }

    protected override void OnParametersSet()
    {
        _text = Source ?? string.Empty;
        _chips = AlgorithmExpressionHelp.Identifiers(_text);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) {
            try {
                _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Lyo.Algorithms.Web.Components/scripts/algorithmCaret.js");
                _self = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("bindKeys", _area, _self);
                await _module.InvokeVoidAsync("bindView", _wrap, _self);
            }
            catch (JSDisconnectedException) {
                return;
            }
        }

        await PlaceSuggest();
    }

    [JSInvokable]
    public bool HandleSuggestKey(string key)
    {
        if (_suggestions.Count == 0)
            return false;

        switch (key) {
            case "ArrowDown":
                _activeIndex = Math.Min(_activeIndex + 1, _suggestions.Count - 1);
                _ = InvokeAsync(StateHasChanged);
                return true;
            case "ArrowUp":
                _activeIndex = Math.Max(_activeIndex - 1, 0);
                _ = InvokeAsync(StateHasChanged);
                return true;
            case "Enter":
            case "Tab":
                _ = InsertSuggestionAsync(_suggestions[_activeIndex]);
                return true;
            case "Escape":
                _suggestions.Clear();
                _ = InvokeAsync(StateHasChanged);
                return true;
            default:
                return false;
        }
    }

    [JSInvokable]
    public async Task PlaceSuggest()
    {
        if (_module is null || _suggestions.Count == 0)
            return;

        try {
            await _module.InvokeVoidAsync("placeSuggest", _suggest, _area, _caret);
            await _module.InvokeVoidAsync("scrollItemIntoView", _suggest, _activeIndex);
        }
        catch (JSException) {
        }
        catch (JSDisconnectedException) {
        }
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        _text = args.Value?.ToString() ?? string.Empty;
        await SourceChanged.InvokeAsync(_text);
        var caret = await ReadCaretAsync();
        Refresh(_text, caret);
        await FocusedChanged.InvokeAsync(FullName(_text, caret));
    }

    private async Task OnCaret(KeyboardEventArgs args)
    {
        if (args.Key is "ArrowDown" or "ArrowUp" or "Enter" or "Tab" or "Escape")
            return;

        await PublishCaretAsync();
    }

    private async Task OnCaret(MouseEventArgs _) => await PublishCaretAsync();

    private async Task OnBlur()
    {
        var generation = ++_blurGeneration;
        await Task.Delay(150);
        if (generation != _blurGeneration)
            return;

        _suggestions.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PublishCaretAsync()
    {
        var caret = await ReadCaretAsync();
        Refresh(_text, caret);
        await FocusedChanged.InvokeAsync(FullName(_text, caret));
    }

    private async Task SelectChipAsync(string name)
    {
        await FocusedChanged.InvokeAsync(name);
        await ChipSelected.InvokeAsync(name);
    }

    private async Task InsertSuggestionAsync(string suggestion)
    {
        var caret = await ReadCaretAsync();
        var (start, end, _) = TokenAt(_text, caret);
        var token = Completion(_text, start, suggestion);
        _text = AlgorithmDraftRules.Insert(_text, start, end, token);
        _suggestions.Clear();
        await SourceChanged.InvokeAsync(_text);
        _chips = AlgorithmExpressionHelp.Identifiers(_text);
        if (_module is not null)
            await _module.InvokeVoidAsync("place", _area, start + token.Length);
    }

    private void Refresh(string source, int caret)
    {
        _caret = caret;
        var (_, _, prefix) = TokenAt(source, caret);
        var next = AlgorithmExpressionHelp.Suggestions(prefix, BagNames, CatalogKeys);
        _suggestions.Clear();
        _suggestions.AddRange(next);
        _activeIndex = 0;
        _chips = AlgorithmExpressionHelp.Identifiers(source);
    }

    private async Task<int> ReadCaretAsync()
    {
        if (_module is null)
            return _text.Length;

        var caret = await _module.InvokeAsync<Caret>("caret", _area);
        return caret.Start;
    }

    private static string Completion(string source, int start, string suggestion)
    {
        if (suggestion.StartsWith('.') && start > 0 && source[start - 1] == '.')
            return suggestion[1..];

        var dot = suggestion.LastIndexOf('.');
        if (dot > 0) {
            var head = suggestion[..(dot + 1)];
            if (start >= head.Length && string.CompareOrdinal(source, start - head.Length, head, 0, head.Length) == 0)
                return suggestion[(dot + 1)..];
        }

        return suggestion;
    }

    private static string? FullName(string source, int caret)
    {
        var (start, end, _) = TokenAt(source, caret);
        if (end <= start)
            return null;

        var name = source[start..end];
        return AlgorithmDraftRules.IsIdentifier(name) ? name : null;
    }

    private static (int Start, int End, string Prefix) TokenAt(string source, int caret)
    {
        var index = Math.Clamp(caret, 0, source.Length);
        var start = index;
        while (start > 0 && IsId(source[start - 1]))
            start--;

        var end = index;
        while (end < source.Length && IsId(source[end]))
            end++;

        return (start, end, source[start..index]);
    }

    private static bool IsId(char value) => char.IsLetterOrDigit(value) || value == '_';

    private static bool IsIdStart(char value) => char.IsLetter(value) || value == '_';

    private static IEnumerable<(string Text, bool Mark)> Segments(string source, IReadOnlyList<string> names)
    {
        var marked = new HashSet<string>(names, StringComparer.Ordinal);
        var index = 0;
        while (index < source.Length) {
            if (source[index] == '"') {
                var end = index + 1;
                while (end < source.Length && source[end] != '"') {
                    if (source[end] == '\\' && end + 1 < source.Length)
                        end += 2;
                    else
                        end++;
                }

                if (end < source.Length)
                    end++;

                yield return (source[index..end], false);
                index = end;
                continue;
            }

            if (IsIdStart(source[index])) {
                var end = index + 1;
                while (end < source.Length && IsId(source[end]))
                    end++;

                var token = source[index..end];
                yield return (token, marked.Contains(token));
                index = end;
                continue;
            }

            var start = index;
            while (index < source.Length && source[index] != '"' && !IsIdStart(source[index]))
                index++;

            yield return (source[start..index], false);
        }
    }

    private sealed class Caret
    {
        public int Start { get; set; }

        public int End { get; set; }
    }
}

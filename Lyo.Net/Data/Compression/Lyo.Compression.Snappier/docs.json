{
  "id": "Lyo.Compression.Snappier",
  "name": "Lyo.Compression.Snappier",
  "area": "Data",
  "tagline": "Snappy support for `Lyo.Compression` via a Snappier `ICompressorFactory`.",
  "description": "Snappy support for `Lyo.Compression` via a Snappier `ICompressorFactory`.",
  "features": [],
  "examples": [
    {
      "title": "Register in the container",
      "language": "csharp",
      "code": "using Lyo.Compression;\nusing Lyo.Compression.Models;\nusing Lyo.Compression.Snappier;\nusing Microsoft.Extensions.Configuration;\nusing Microsoft.Extensions.DependencyInjection;\n\nservices.AddSnappierCompressor();\nservices.AddCompressionService(options => options.DefaultAlgorithm = SnappierCompressionAlgorithm.Instance);\nservices.AddDefaultCompressionService<CompressionService>();\n\n// Or from appsettings (CompressionOptions section)\nservices.AddSnappierCompressor();\nservices.AddCompressionServiceFromConfiguration(configuration, CompressionServiceOptions.SectionName);\nservices.AddDefaultCompressionService<CompressionService>();"
    }
  ],
  "sections": [
    {
      "type": "paragraph",
      "title": "DI registration",
      "text": "DI, ICompressionResolver, and configuration live in [`Lyo.Compression`](../Lyo.Compression/README.md). Register AddSnappierCompressor() if stored metadata might name Snappy. ICompressionResolver, not just the service default codec, is what decompresses those reads."
    }
  ],

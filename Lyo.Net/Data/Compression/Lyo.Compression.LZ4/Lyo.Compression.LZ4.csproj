<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>LZ4 compression addon for Lyo.Compression. Registers an LZ4 ICompressorFactory backed by EasyCompressor.LZ4.</Description>
        <PackageTags>compression lz4</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Compression\Lyo.Compression.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="EasyCompressor.LZ4" Version="[2.1,)"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>

        <ProjectReference Include="..\..\Postgres\Lyo.Postgres\Lyo.Postgres.csproj"/>
        <ProjectReference Include="..\Lyo.FileSystemWatcher\Lyo.FileSystemWatcher.csproj"/>
        <ProjectReference Include="..\Lyo.FileSystemWatcher.Models\Lyo.FileSystemWatcher.Models.csproj"/>
    </ItemGroup>

</Project>

{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.FileSystemWatcher.Postgres",
  "name": "Lyo.FileSystemWatcher.Postgres",
  "area": "Data",
  "tagline": "PostgreSQL store for FileSystemWatcher snapshots and change events. Service layer only — no HTTP.",
  "description": "EF Core persistence for Lyo.FileSystemWatcher models. Schema `filesystem_watcher` holds watch, snapshot (tree jsonb + content_hash + content_hash_algorithm), and change rows. Hashes use Lyo.Hashing (SHA-256 by default). `FileSystemWatcherPersister` copies DTOs on ScanCompleted and writes them off the debounce thread. Register with AddPostgresFileSystemWatcherStore / FromConfiguration.",
  "features": [
    "**Store only.** No Lyo.Api reference. Drift HTTP lives in Lyo.Drift.Postgres.",
    "**Named hash.** Dedupe compares content_hash_algorithm and content_hash together.",
    "**Persister.** Maps ScanCompleted on the timer thread, writes through IFileSystemWatcherStore on a background channel."
  ],
  "examples": [
    {
      "title": "Register the store",
      "language": "csharp",
      "code": "services.AddPostgresFileSystemWatcherStoreFromConfiguration(configuration);"
    }
  ],

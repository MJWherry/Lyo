<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>PC/SC driver for Lyo.Nfc. Reads and writes Type 2 pages through an ACR122U-style reader. Linux needs pcscd and libpcsclite. This driver does not speak ISO 15693.</Description>
        <PackageTags>nfc pcsc acr122u ntag</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="PCSC"/>
        <PackageReference Include="PCSC.Iso7816"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Core\Common\Lyo.Common.Core\Lyo.Common.Core.csproj"/>
        <ProjectReference Include="..\..\..\Core\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
        <ProjectReference Include="..\Lyo.Nfc\Lyo.Nfc.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Nfc.Pcsc.Tests"/>
    </ItemGroup>

</Project>

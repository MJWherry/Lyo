        <Description>SFTP-backed IFileStorageService using Lyo.Sftp.Client (physical IO only; no multipart/presign in v1).</Description>
        <PackageTags>file-storage sftp ssh storage</PackageTags>
        <RootNamespace>Lyo.FileStorage.Sftp</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.FileStorage\Lyo.FileStorage.csproj"/>
        <ProjectReference Include="..\..\Sftp\Lyo.Sftp.Client\Lyo.Sftp.Client.csproj"/>
        <ProjectReference Include="..\..\Compression\Lyo.Compression\Lyo.Compression.csproj"/>
        <ProjectReference Include="..\..\..\Security\Encryption\Lyo.Encryption\Lyo.Encryption.csproj"/>
        <ProjectReference Include="..\..\..\Core\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
        <ProjectReference Include="..\..\FileMetadataStore\Lyo.FileMetadataStore\Lyo.FileMetadataStore.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.FileStorage.Sftp.Tests"/>
    </ItemGroup>
</Project>

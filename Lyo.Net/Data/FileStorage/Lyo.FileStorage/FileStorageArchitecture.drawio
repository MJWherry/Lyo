<mxfile host="app.diagrams.net" agent="cursor" version="24.7.17" type="device">
  <diagram id="FileStorageArchitecture" name="File storage overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Lyo file storage&lt;/b&gt; — IFileStorageService orchestrates split abstractions over three persisted concerns (keys · metadata · bytes)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1620" height="36" as="geometry" />
        </mxCell>

        <!-- Hosts (top-left) -->
        <mxCell id="hosts" value="&lt;b&gt;Hosts / callers&lt;/b&gt;&#xa;· Lyo.TestApi (ASP.NET Minimal API)&#xa;· Lyo.Gateway (HTTP proxy → TestApiFileStorageService)&#xa;· Lyo.FileStorage.Web.Components — FileStorageManagement Blazor UI&#xa;· app services consuming IFileStorageService directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="68" width="460" height="120" as="geometry" />
        </mxCell>

        <!-- Tests (top-right) -->
        <mxCell id="tests" value="&lt;b&gt;Test projects&lt;/b&gt;&#xa;· Lyo.FileStorage.Tests — Local backend, multipart, direct upload, &lt;b&gt;staged upload&lt;/b&gt;, scan/policy/dup matrices, audit + FileHelpers&#xa;· Lyo.FileMetadataStore.*.Tests — Postgres/Sqlite &lt;b&gt;StagedFileUploadStore&lt;/b&gt; CRUD + status transitions&#xa;· Lyo.FileStorage.S3.Tests — FakeAmazonS3, S3UploadStream, &lt;b&gt;S3StagedFileUploadService&lt;/b&gt;, SSE, CloudObjectKeyBuilder&#xa;· Lyo.FileStorage.Blob.Tests — BlobFileStorageOptions, &lt;b&gt;BlobStagedFileUploadService&lt;/b&gt; (offline SAS), CloudObjectKeyBuilder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;dashed=1;fontStyle=0;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1100" y="68" width="560" height="120" as="geometry" />
        </mxCell>

        <!-- Central orchestrator (wide, two-column inside) -->
        <mxCell id="orc_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="1620" height="340" as="geometry" />
        </mxCell>
        <mxCell id="orc_hdr" value="IFileStorageService &amp; FileStorageServiceBase (Lyo.FileStorage)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1a4d80;" vertex="1" parent="1">
          <mxGeometry x="54" y="220" width="900" height="26" as="geometry" />
        </mxCell>

        <!-- Public surface block -->
        <mxCell id="orc_public" value="&lt;b&gt;Public surface (IFileStorageService + IStagedFileUploadService)&lt;/b&gt;&#xa;· SaveStreamAsync · SaveBytesAsync · SaveFileAsync · CopyFileAsync · MoveFileAsync · RenameFileAsync&#xa;· GetMetadataAsync · GetFileStreamAsync · GetFileAsync · ExistsAsync&#xa;· DeleteAsync (Soft | HardDelete) · UpdateFileHeaderAsync&#xa;· MultipartBegin / UploadPart / Complete / Abort&#xa;· BeginDirectUpload / CompleteDirectUpload&#xa;· &lt;b&gt;Staged:&lt;/b&gt; Begin / Complete / Commit / Abort / Get (IStagedFileUploadService)&#xa;· GetPreSignedReadUrlAsync (with PreSignedReadUrlOptions)&#xa;· MigrateDeksAsync · RotateDeksAsync · GetStorageSizeAsync · HealthCheckAsync&#xa;&#xa;&lt;b&gt;Events&lt;/b&gt; (redacted FileStoreSnapshot payload):&#xa;FileSaved · FileMetadataRetrieved · FileRetrieved · FileDeleted · FileMoved · FileRenamed&#xa;Staged: PresignedCreated · UploadCompleted · UploadFailed · Committed&#xa;FileAuditOccurred (multipart · direct · staged · DEK migrate/rotate · move · rename · scan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="256" width="790" height="280" as="geometry" />
        </mxCell>

        <!-- Internal helpers / abstractions block -->
        <mxCell id="orc_internals" value="&lt;b&gt;Split abstractions (Lyo.FileStorage/Abstractions)&lt;/b&gt;&#xa;· IFileStoragePhysicalIo — backend byte plumbing&#xa;· IFileStorageMetadataLookup — read-side metadata access&#xa;· IFileStorageMetadataNormalization — name / MIME / suffix resolution&#xa;· IFileStorageDiagnosticsService — operator key listing&#xa;· IFileAuditPublisher — fan-out to IFileAuditEventHandler[s]&#xa;&#xa;&lt;b&gt;Shared helpers (Lyo.FileStorage)&lt;/b&gt;&#xa;· CloudObjectKeyBuilder · StagedObjectKeyBuilder (.stage/{id}/object)&#xa;· FileStorageStreamingPipelines — compose hash → compress → encrypt&#xa;· PlainDirectUploadCoordinator — Begin/Complete direct-PUT lifecycle&#xa;· StagedUploadCoordinator + IStagedFilePhysicalIo — staged begin/complete/commit&#xa;· FileStorageDekOperations — MigrateDeksAsync / RotateDeksAsync&#xa;· HashVerifyingReadStream · MaxBytesWriteStream · MaxDecompressedBytesReadStream · PipelineFileReadStream&#xa;&#xa;&lt;b&gt;Input guard&lt;/b&gt; (Lyo.Exceptions)&#xa;· FileHelpers.ThrowIfPathPrefixTraversal / NormalizeAndValidatePathPrefix — shared by every save / direct-upload / diagnostics entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="870" y="256" width="780" height="280" as="geometry" />
        </mxCell>

        <!-- Edge hosts → orchestrator -->
        <mxCell id="e_hosts_orc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#444444;" edge="1" parent="1" source="hosts" target="orc_bg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Column 1: Keystore -->
        <mxCell id="col1_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="500" height="500" as="geometry" />
        </mxCell>
        <mxCell id="col1_hdr" value="1 · Keystore &amp;amp; crypto (KEK)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#994c00;" vertex="1" parent="1">
          <mxGeometry x="54" y="590" width="480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="kek" value="&lt;b&gt;IKeyStore&lt;/b&gt; · Lyo.Keystore&#xa;KEKs by key id + version&#xa;(current for new writes · historical for decrypt of legacy files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="626" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="twokey" value="&lt;b&gt;ITwoKeyEncryptionService&lt;/b&gt;&#xa;Two-key encrypt pipeline. Generates a per-file DEK, encrypts file bytes with it,&#xa;then WRAP/UNWRAP the DEK via IKeyStore. The wrapped DEK + algorithm id + IV are&#xa;bundled into the file-encryption header that prefixes each ciphertext stream." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9b6;strokeColor=#cc8500;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="716" width="460" height="120" as="geometry" />
        </mxCell>
        <mxCell id="dekops" value="&lt;b&gt;FileStorageDekOperations&lt;/b&gt; (Lyo.FileStorage)&#xa;In-place wrapped DEK maintenance (no bulk decrypt/re-encrypt):&#xa;· MigrateDeksAsync — bring legacy headers to current schema/algorithm&#xa;· RotateDeksAsync — re-wrap DEKs under a newer KEK version&#xa;Returns DekMigrationResult (Migrated · Skipped · Failed counters; throws on missing blob, validates short headers)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffc999;strokeColor=#b06500;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="846" width="460" height="135" as="geometry" />
        </mxCell>
        <mxCell id="keyimpl" value="&lt;b&gt;Implementations&lt;/b&gt;&#xa;e.g. LocalKeyStore (dev) · host-supplied IKeyStore for production KMS bridging&#xa;(keyed registration supports multi-tenant key isolation)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffc0;strokeColor=#ffc400;size=14;fontStyle=0;align=left;spacingLeft=6;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="991" width="460" height="80" as="geometry" />
        </mxCell>

        <!-- Column 2: Metadata -->
        <mxCell id="col2_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f9e8;strokeColor=#2d7600;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="560" y="580" width="500" height="500" as="geometry" />
        </mxCell>
        <mxCell id="col2_hdr" value="2 · Metadata store (OLTP)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#1c5c02;" vertex="1" parent="1">
          <mxGeometry x="574" y="590" width="480" height="28" as="geometry" />
        </mxCell>
        <mxCell id="meta" value="&lt;b&gt;IFileMetadataStore&lt;/b&gt; · FileStoreResult&#xa;Canonical Guid file identity · hash (dup lookup) · MIME · sizes (original / stored)&#xa;Encryption key id + version refs · &lt;b&gt;persisted storage suffix&lt;/b&gt; (no Find*Key N+1)&#xa;Availability state · multipart pointers · soft-delete tombstones&#xa;&lt;b&gt;FileStoreSnapshot&lt;/b&gt; record provides the redacted projection used in events." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="626" width="460" height="155" as="geometry" />
        </mxCell>
        <mxCell id="metaimpl" value="&lt;b&gt;Concrete stores&lt;/b&gt;&#xa;· PostgresFileMetadataStore (prod) — EF Core, hash index, tombstone column&#xa;· LocalFileMetadataStore (dev / single-host) — JSON sidecars per file id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b8dfb8;strokeColor=#5b9f5c;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="791" width="460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="adjunct" value="&lt;b&gt;Postgres adjuncts&lt;/b&gt; (same package, opt-in via DI)&#xa;· PostgresMultipartUploadSessionStore → IMultipartUploadSessionStore&#xa;· PostgresStagedFileUploadStore → IStagedFileUploadStore (staged_file_upload table)&#xa;· PostgresFileDownloadAccessService — direct-PUT access tracking&#xa;· PostgresFileAuditSink → IFileAuditEventHandler&#xa;Dev/in-process default: InMemory* stores for multipart + staged sessions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#94d694;strokeColor=#447f44;dashed=1;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="580" y="891" width="460" height="120" as="geometry" />
        </mxCell>

        <!-- Column 3: Blob / object storage -->
        <mxCell id="col3_bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0eef9;strokeColor=#5947a3;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1080" y="580" width="580" height="500" as="geometry" />
        </mxCell>
        <mxCell id="col3_hdr" value="3 · Blob / object storage (bytes)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#472c99;" vertex="1" parent="1">
          <mxGeometry x="1094" y="590" width="560" height="28" as="geometry" />
        </mxCell>
        <mxCell id="blobs" value="&lt;b&gt;IFileStoragePhysicalIo&lt;/b&gt; (Lyo.FileStorage/Abstractions)&#xa;Backend byte plumbing wired in FileStorageServiceBase:&#xa;CreateOutputStreamAsync · ReadFromStorageAsync (stream + range) · DeleteFromStorageAsync&#xa;CopyServerSideAsync · GetStorageSizeAsync · ProbeExistenceAsync · SSE rule hooks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1100" y="626" width="540" height="120" as="geometry" />
        </mxCell>
        <mxCell id="blobimpl" value="&lt;b&gt;Backends&lt;/b&gt;&#xa;· LocalFileStorageService → disk (sharded /xx/yy/&lt;id&gt; paths, atomic rename, EnsureUnderRoot)&#xa;· S3FileStorageService → IAmazonS3 (S3UploadStream PUT≤5 MiB / multipart; S3GetObjectResponseStream wrapper)&#xa;· BlobFileStorageService (Lyo.FileStorage.Blob, renamed from .Azure) → Azure BlockBlobClient (encryption scope / CPK)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfb3eb;strokeColor=#5947a3;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1100" y="756" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="multipart" value="&lt;b&gt;IMultipartUploadService&lt;/b&gt; per-backend implementations&#xa;LocalMultipartUploadService · S3MultipartUploadService · BlobMultipartUploadService&#xa;Session state via IMultipartUploadSessionStore (in-memory or Postgres adjunct).&#xa;&#xa;&lt;b&gt;IStagedFileUploadService&lt;/b&gt; — Local / S3 / Blob staged services&#xa;Staging key: …/.stage/{stageId}/object · state in IStagedFileUploadStore until CommitAsync writes file_metadata." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eae4ff;strokeColor=#8670c4;dashed=1;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="1100" y="896" width="540" height="170" as="geometry" />
        </mxCell>

        <!-- Edges orchestrator ↔ pillars -->
        <mxCell id="e_orc_crypto" value="encrypt / decrypt (+ DEK wrap)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#b06500;fontSize=11;endArrow=block;" edge="1" parent="1" source="orc_bg" target="twokey">
          <mxGeometry relative="1" x="-0.6" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="570" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_orc_meta" value="SaveMetadata · Get · FindByHash · MarkDeleted · suffix lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#3d8539;fontSize=11;endArrow=block;" edge="1" parent="1" source="orc_bg" target="meta">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="810" y="570" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_orc_blob" value="PUT / GET streams · presigned · direct upload · server-side copy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=0;strokeColor=#5947a3;fontSize=11;endArrow=block;" edge="1" parent="1" source="orc_bg" target="blobs">
          <mxGeometry relative="1" x="0.6" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="570" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_two_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;dashed=0;endArrow=block;" edge="1" parent="1" source="twokey" target="kek">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Workflows footer -->
        <mxCell id="wf_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#888888;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="1620" height="260" as="geometry" />
        </mxCell>
        <mxCell id="wf_title" value="Representative workflows — see dedicated tabs: Save (compress·encrypt) · Staged upload · Read · Copy · DEK migrate · DEK rotate · Upload (general) · Delete" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="54" y="1120" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="wf_upload" value="&lt;b&gt;Save upload&lt;/b&gt; — see &lt;i&gt;Save upload (compress · encrypt)&lt;/i&gt; tab&#xa;SaveStreamAsync/SaveFileAsync with compress + encrypt flags&#xa;hash → compress (ICompressionService) → encrypt (ITwoKeyEncryptionService) → backend sink&#xa;duplicate strategy → SaveMetadataAsync → FileSaved audit&#xa;&#xa;&lt;b&gt;Staged upload&lt;/b&gt; — see &lt;i&gt;Staged upload flow&lt;/i&gt; tab&#xa;Begin → client PUT to .stage/{id}/object → Complete (hash) → Commit (optional compress/encrypt)&#xa;State in staged_file_upload until commit; worker handoff via UploadCompleted events." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#4386c9;verticalAlign=top;spacingTop=6;spacingLeft=8;fontStyle=0;align=left;" vertex="1" parent="1">
          <mxGeometry x="54" y="1150" width="520" height="200" as="geometry" />
        </mxCell>

        <mxCell id="wf_read" value="&lt;b&gt;Read&lt;/b&gt; — see &lt;i&gt;Read flow&lt;/i&gt; tab&#xa;GetMetadataAsync → availability gate → backend read →&#xa;decrypt (unwrap DEK) → decompress → HashVerifyingReadStream&#xa;GetPreSignedReadUrlAsync for direct-from-storage reads.&#xa;&#xa;&lt;b&gt;Copy&lt;/b&gt; — see &lt;i&gt;Copy flow&lt;/i&gt; tab&#xa;CopyFileAsync: metadata clone + server-side copy (S3 CopyObject / Blob sync copy / local fs copy).&#xa;&#xa;&lt;b&gt;Move / Rename&lt;/b&gt;&#xa;MoveFileAsync: same file id, relocate PathPrefix (local File.Move; S3/Blob copy-then-delete).&#xa;RenameFileAsync: OriginalFileName metadata only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#558b54;verticalAlign=top;spacingTop=6;spacingLeft=8;fontStyle=0;align=left;" vertex="1" parent="1">
          <mxGeometry x="590" y="1150" width="500" height="200" as="geometry" />
        </mxCell>

        <mxCell id="wf_delete" value="&lt;b&gt;Delete&lt;/b&gt; — see &lt;i&gt;Delete flow&lt;/i&gt; tab&#xa;Tombstone metadata first → DeleteFromStorageAsync → optional hard purge.&#xa;&#xa;&lt;b&gt;DEK migrate&lt;/b&gt; — see &lt;i&gt;DEK migrate&lt;/i&gt; tab&#xa;FindByKeyIdAndVersion → ReEncryptDek (re-wrap only) → UpdateFileHeaderAsync → SaveMetadataAsync.&#xa;Ciphertext unchanged; header + metadata key refs updated.&#xa;&#xa;&lt;b&gt;DEK rotate&lt;/b&gt; — see &lt;i&gt;DEK rotate&lt;/i&gt; tab&#xa;Full decrypt → fresh DEK + re-encrypt payload → rewrite blob + metadata hashes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#b54848;verticalAlign=top;spacingTop=6;spacingLeft=8;fontStyle=0;align=left;" vertex="1" parent="1">
          <mxGeometry x="1106" y="1150" width="540" height="200" as="geometry" />
        </mxCell>

        <!-- Consistency note -->
        <mxCell id="consistency" value="&lt;b&gt;Consistency / ordering rules&lt;/b&gt;&#xa;· Save: bytes → metadata; metadata failure → CleanupPartialFileAsync.&#xa;· Multipart complete: SaveMetadataAsync &lt;b&gt;before&lt;/b&gt; server-side commit.&#xa;· Staged: staged_file_upload row on Begin; file_metadata only on Commit; TryTransitionStatus Uploaded→Committing for worker claims.&#xa;· Delete: tombstone metadata &lt;b&gt;before&lt;/b&gt; backend delete.&#xa;· Direct PUT complete: HEAD verify → SaveMetadataAsync (plaintext only on edge PUT).&#xa;· All failure paths emit FileAuditOccurred(…, Outcome.Failure) with sanitized error." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffd0;strokeColor=#cbb300;size=18;fontStyle=0;verticalAlign=top;spacingTop=6;spacingLeft=8;align=left;" vertex="1" parent="1">
          <mxGeometry x="510" y="68" width="580" height="120" as="geometry" />
        </mxCell>

        <!-- Bottom legend -->
        <mxCell id="legend" value="Solid = primary flow · Dashed = optional adjunct / per-host implementation. Companion docs: Lyo.FileStorage/README.md, Lyo.FileStorage.S3/README.md, Lyo.FileStorage.Blob/README.md, Lyo.Exceptions/README.md." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=2;fontColor=#777777;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="1378" width="1620" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="UploadFlow" name="Upload flow (save · multipart · direct PUT)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="u_title" value="&lt;b&gt;Upload flow&lt;/b&gt; — single-call save, multipart, and direct PUT all share the same validation / hash / encrypt / audit core" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=15;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1620" height="32" as="geometry" />
        </mxCell>

        <!-- Swim columns -->
        <mxCell id="u_lane1" value="Caller / Host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="240" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="u_lane2" value="FileStorageServiceBase pipeline (Lyo.FileStorage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#4386c9;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="560" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="u_lane3" value="Backend I/O (Local · S3 · Blob)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0eef9;strokeColor=#5947a3;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="60" width="400" height="1280" as="geometry" />
        </mxCell>
        <mxCell id="u_lane4" value="Metadata · Audit · Crypto sidecars" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf6e8;strokeColor=#5b9f5c;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="60" width="360" height="1280" as="geometry" />
        </mxCell>

        <!-- Entry node -->
        <mxCell id="u_start" value="HTTP / RPC handler&#xa;invokes IFileStorageService:&#xa;· SaveBytesAsync&#xa;· SaveStreamAsync&#xa;· SaveFileAsync(path)&#xa;· MultipartBegin/Part/Complete&#xa;· BeginDirectUpload / CompleteDirectUpload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="200" height="170" as="geometry" />
        </mxCell>

        <!-- Step 1: validation -->
        <mxCell id="u_s1" value="&lt;b&gt;1 · Argument &amp; path validation&lt;/b&gt;&#xa;FileHelpers.ThrowIfPathPrefixTraversal&#xa;ArgumentHelpers.ThrowIf* on size/MIME/keyId&#xa;Generate Guid fileId (or accept caller&apos;s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="520" height="80" as="geometry" />
        </mxCell>

        <!-- Step 2: content policy -->
        <mxCell id="u_s2" value="&lt;b&gt;2 · IFileContentPolicy.Validate&lt;/b&gt;&#xa;Allowlist of MIME types · per-type max-size · declared length sanity&#xa;DefaultFileContentPolicy: empty allowlist = deny (fail-closed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e0f5;strokeColor=#5d7ec0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="210" width="520" height="80" as="geometry" />
        </mxCell>

        <!-- Step 3: scan -->
        <mxCell id="u_s3" value="&lt;b&gt;3 · Malware scan&lt;/b&gt;&#xa;IFileMalwareScanner (Composite · ContentThreat · ClamAV adapter)&#xa;RequireScanBeforeAvailable: spool non-seekable input to temp;&#xa;scan first, then re-read for the rest of the pipeline (fail-closed if scanner unreachable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="310" width="520" height="100" as="geometry" />
        </mxCell>

        <!-- Step 4: streaming pipeline -->
        <mxCell id="u_s4" value="&lt;b&gt;4 · SaveCoreAsync streaming pipeline&lt;/b&gt;&#xa;FileStorageStreamingPipelines composes inner streams &lt;i&gt;in order&lt;/i&gt;:&#xa;&#xa;a) HashingStream (SHA-256) — duplicate detection &amp; integrity&#xa;b) Optional CompressingStream (GZip via ICompressionService)&#xa;c) Optional EncryptingStream — generate DEK, wrap with KEK,&#xa;   prepend file-encryption header (algo · keyId · keyVersion · IV · wrappedDek)&#xa;d) Optional MaxBytesWriteStream — enforces declared/configured ceiling&#xa;e) Sink = backend CreateOutputStreamAsync (column 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbd0ee;strokeColor=#4d6caa;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="430" width="520" height="200" as="geometry" />
        </mxCell>

        <!-- Step 5: duplicate strategy -->
        <mxCell id="u_s5" value="&lt;b&gt;5 · Duplicate strategy resolution&lt;/b&gt;&#xa;After hash is known: FindByHashAsync on metadata store.&#xa;· Allow (default) — write&#xa;· ReuseExisting — short-circuit; return existing FileStoreResult, abort backend write&#xa;· ThrowIfExists — throw before metadata commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="650" width="520" height="115" as="geometry" />
        </mxCell>

        <!-- Step 6: metadata commit -->
        <mxCell id="u_s6" value="&lt;b&gt;6 · SaveMetadataAsync&lt;/b&gt;&#xa;Persist FileStoreSnapshot: id · originalFileName · MIME · originalSize · storedSize&#xa;hash · keyId/version (if encrypted) · pathPrefix · &lt;b&gt;storage suffix&lt;/b&gt; (avoids N+1 probes on reads)&#xa;availability state · multipart pointer (if applicable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5dec5;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="785" width="520" height="100" as="geometry" />
        </mxCell>

        <!-- Step 7: audit -->
        <mxCell id="u_s7" value="&lt;b&gt;7 · Audit + result&lt;/b&gt;&#xa;Emit FileAuditOccurred(FileSaved, Outcome.Success) via IFileAuditPublisher.&#xa;Raise IFileStorageService.FileSaved event with redacted FileStoreSnapshot.&#xa;Return FileStoreResult (or FileSavedResult on streaming overloads)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="905" width="520" height="100" as="geometry" />
        </mxCell>

        <!-- Failure handling -->
        <mxCell id="u_fail" value="&lt;b&gt;Failure path&lt;/b&gt;&#xa;Any exception &lt;i&gt;before&lt;/i&gt; metadata commit:&#xa;· CleanupPartialFileAsync deletes the orphan blob/object&#xa;· emit FileAuditOccurred(FileSaved, Outcome.Failure) with sanitized error&#xa;· rethrow to caller&#xa;Metadata-commit failure also triggers the same blob cleanup → no orphan blobs." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#b54848;size=14;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="1025" width="520" height="120" as="geometry" />
        </mxCell>

        <!-- Backend column nodes -->
        <mxCell id="u_b_local" value="&lt;b&gt;LocalFileStorageService&lt;/b&gt;&#xa;Write to temp under ContentRootPath, fsync, atomic rename into&#xa;sharded path. EnsureUnderRoot guards against escape." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="430" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="u_b_s3" value="&lt;b&gt;S3FileStorageService&lt;/b&gt;&#xa;S3UploadStream: ≤5 MiB body → PutObject; larger → multipart&#xa;(InitiateMultipart → UploadPart… → CompleteMultipart, AbortMultipart on failure).&#xa;BuildRequiredPutHeaders applies SSE (KMS · AES256 · SSE-C) and signed Content-Type." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfb3eb;strokeColor=#5947a3;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="520" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="u_b_blob" value="&lt;b&gt;BlobFileStorageService&lt;/b&gt;&#xa;OpenWriteAsync into BlockBlobClient; encryption scope or customer-provided&#xa;key threaded through every stage (initial PUT, multipart staging, header range update)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a89bda;strokeColor=#4a3892;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="650" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="u_b_mpu" value="&lt;b&gt;IMultipartUploadService&lt;/b&gt;&#xa;Per-backend part staging (Local temp folder · S3 UploadPart · Blob StageBlock).&#xa;Session state via IMultipartUploadSessionStore (in-memory or Postgres adjunct).&#xa;Complete = SaveMetadataAsync &lt;b&gt;before&lt;/b&gt; backend commit (server-side copy / CommitBlockList) so a failed commit cannot leak a half-published file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eae4ff;strokeColor=#8670c4;dashed=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="770" width="360" height="135" as="geometry" />
        </mxCell>
        <mxCell id="u_b_direct" value="&lt;b&gt;Direct PUT (PlainDirectUploadCoordinator)&lt;/b&gt;&#xa;BeginDirectUpload → presigned PUT URL with signed content-type + required headers.&#xa;Client uploads bytes straight to S3/Blob (bypasses service host CPU/network).&#xa;CompleteDirectUpload: backend HEAD probe → hash verify (if required) → metadata commit → audit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0e6ff;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="900" y="925" width="360" height="140" as="geometry" />
        </mxCell>

        <!-- Sidecar column nodes -->
        <mxCell id="u_x_crypto" value="&lt;b&gt;ITwoKeyEncryptionService&lt;/b&gt;&#xa;Generate fresh DEK · wrap with KEK from&#xa;IKeyStore (current keyId / version) · build&#xa;file-encryption header." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="430" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="u_x_dedupe" value="&lt;b&gt;IFileMetadataStore.FindByHashAsync&lt;/b&gt;&#xa;Hash-keyed lookup used by ReuseExisting and&#xa;ThrowIfExists duplicate strategies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="650" width="320" height="95" as="geometry" />
        </mxCell>
        <mxCell id="u_x_meta" value="&lt;b&gt;IFileMetadataStore.SaveMetadataAsync&lt;/b&gt;&#xa;Postgres (prod) or LocalFileMetadataStore (dev).&#xa;Includes persisted storage suffix so later reads&#xa;skip the &quot;try .gz / .lyo.gz / …&quot; probes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b8dfb8;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="775" width="320" height="105" as="geometry" />
        </mxCell>
        <mxCell id="u_x_audit" value="&lt;b&gt;IFileAuditPublisher&lt;/b&gt;&#xa;FileAuditOccurred(FileSaved · MultipartBegin · MultipartComplete · MultipartAbort · DirectUploadBegin · DirectUploadComplete) with Outcome.Success|Failure&#xa;and sanitized error/correlation id." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe9fa;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="905" width="320" height="125" as="geometry" />
        </mxCell>

        <!-- Edges down the central pipeline -->
        <mxCell id="u_e_start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#444444;" edge="1" parent="1" source="u_start" target="u_s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="u_s1" target="u_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="u_s2" target="u_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="u_s3" target="u_s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="u_s4" target="u_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="u_s5" target="u_s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="u_s6" target="u_s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-lane edges -->
        <mxCell id="u_e_4_crypto" value="wrap DEK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="u_s4" target="u_x_crypto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_4_blocal" value="write bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5947a3;fontSize=11;" edge="1" parent="1" source="u_s4" target="u_b_local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_4_bs3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5947a3;fontSize=11;" edge="1" parent="1" source="u_s4" target="u_b_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_4_bblob" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5947a3;fontSize=11;" edge="1" parent="1" source="u_s4" target="u_b_blob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_5_dedupe" value="hash lookup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#5b9f5c;fontSize=11;" edge="1" parent="1" source="u_s5" target="u_x_dedupe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_6_meta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5b9f5c;fontSize=11;" edge="1" parent="1" source="u_s6" target="u_x_meta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_7_audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;fontSize=11;" edge="1" parent="1" source="u_s7" target="u_x_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Multipart / Direct PUT side flows -->
        <mxCell id="u_e_start_mpu" value="multipart variant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#8670c4;fontSize=11;" edge="1" parent="1" source="u_start" target="u_b_mpu">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="820" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="u_e_start_direct" value="direct PUT variant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#7a5abf;fontSize=11;" edge="1" parent="1" source="u_start" target="u_b_direct">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="160" y="975" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="u_e_mpu_meta" value="SaveMetadata &lt;b&gt;before&lt;/b&gt; commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#5b9f5c;fontSize=11;" edge="1" parent="1" source="u_b_mpu" target="u_x_meta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_direct_meta" value="HEAD probe → metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#5b9f5c;fontSize=11;" edge="1" parent="1" source="u_b_direct" target="u_x_meta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Failure → cleanup edge -->
        <mxCell id="u_e_fail_blob" value="CleanupPartialFileAsync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#b54848;fontSize=11;" edge="1" parent="1" source="u_fail" target="u_b_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="u_e_fail_audit" value="failure audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#b54848;fontSize=11;" edge="1" parent="1" source="u_fail" target="u_x_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="u_legend" value="Solid arrow = synchronous control flow.&#xa;Dashed arrow = optional / side-channel call (crypto, dedupe lookup, alternative entry point, failure compensation).&#xa;Multipart and direct-PUT variants share steps 1–3 + step 6 (metadata) + step 7 (audit); they only differ in how the bytes reach the backend." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontStyle=2;fontColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="1170" width="1300" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="DeleteFlow" name="Delete flow (tombstone-first)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="d_title" value="&lt;b&gt;Delete flow&lt;/b&gt; — tombstone-first ordering: metadata is marked deleted &lt;i&gt;before&lt;/i&gt; the blob is removed so a failure leaves a recoverable orphan blob, never orphan metadata" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1420" height="40" as="geometry" />
        </mxCell>

        <!-- Swim columns -->
        <mxCell id="d_lane1" value="Caller / Host" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="240" height="980" as="geometry" />
        </mxCell>
        <mxCell id="d_lane2" value="FileStorageServiceBase.DeleteAsync" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdecec;strokeColor=#b54848;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="540" height="980" as="geometry" />
        </mxCell>
        <mxCell id="d_lane3" value="IFileMetadataStore" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf6e8;strokeColor=#5b9f5c;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="60" width="280" height="980" as="geometry" />
        </mxCell>
        <mxCell id="d_lane4" value="Backend (Local · S3 · Blob)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0eef9;strokeColor=#5947a3;verticalAlign=top;align=center;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="60" width="320" height="980" as="geometry" />
        </mxCell>

        <!-- Entry -->
        <mxCell id="d_start" value="HTTP / RPC handler invokes&#xa;IFileStorageService.DeleteAsync(fileId, FileDeletionMode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Step 1: load metadata -->
        <mxCell id="d_s1" value="&lt;b&gt;1 · Load metadata&lt;/b&gt;&#xa;GetMetadataAsync(fileId).&#xa;Missing / already tombstoned → return idempotently (no audit failure)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcdcdc;strokeColor=#b54848;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="500" height="80" as="geometry" />
        </mxCell>

        <!-- Step 2: tombstone -->
        <mxCell id="d_s2" value="&lt;b&gt;2 · Tombstone metadata FIRST&lt;/b&gt;&#xa;IFileMetadataStore.MarkDeletedAsync(fileId).&#xa;Persists deletedAt + makes file invisible to&#xa;FindByHashAsync / availability gates &lt;i&gt;before&lt;/i&gt; the bytes go away.&#xa;Tombstone failure → fail-fast, no backend mutation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbcfcf;strokeColor=#a83a3a;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="210" width="500" height="120" as="geometry" />
        </mxCell>

        <!-- Step 3: backend delete -->
        <mxCell id="d_s3" value="&lt;b&gt;3 · DeleteFromStorageAsync&lt;/b&gt;&#xa;Resolve key via persisted storage suffix (no Find*Key probes).&#xa;Local: File.Delete &amp; prune empty shard dirs.&#xa;S3: DeleteObjectAsync (idempotent on 404).&#xa;Blob: DeleteIfExistsAsync.&#xa;Narrow catch — only swallow NotFound; any other error bubbles up but tombstone stays." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9c2c2;strokeColor=#993333;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="500" height="135" as="geometry" />
        </mxCell>

        <!-- Step 4: hard-delete branch -->
        <mxCell id="d_s4" value="&lt;b&gt;4 · Hard-delete branch&lt;/b&gt; &lt;i&gt;(FileDeletionMode.HardDelete only)&lt;/i&gt;&#xa;IFileMetadataStore.DeleteAsync(fileId) removes the metadata row entirely.&#xa;Default mode keeps the tombstone row so audits/dedupe history are preserved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;strokeColor=#b07a00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="505" width="500" height="95" as="geometry" />
        </mxCell>

        <!-- Step 5: audit -->
        <mxCell id="d_s5" value="&lt;b&gt;5 · Audit + event&lt;/b&gt;&#xa;Emit FileAuditOccurred(FileDeleted, Outcome.Success) on the audit publisher.&#xa;Raise IFileStorageService.FileDeleted event with redacted FileStoreSnapshot.&#xa;Return.&#xa;&#xa;On backend-delete failure: emit FileAuditOccurred(FileDeleted, Outcome.Failure)&#xa;with sanitized error; tombstone is preserved so the file stays logically deleted&#xa;and the orphan blob can be reaped by a janitor job." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe1e1;strokeColor=#b54848;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="620" width="500" height="170" as="geometry" />
        </mxCell>

        <!-- Sidecar nodes -->
        <mxCell id="d_meta_get" value="GetMetadataAsync(fileId)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="125" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_meta_mark" value="MarkDeletedAsync(fileId)&#xa;(soft delete · tombstone row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5dec5;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="240" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d_meta_hard" value="DeleteAsync(fileId)&#xa;(hard delete · removes row)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b8dfb8;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="525" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Backend sidecars -->
        <mxCell id="d_b_local" value="LocalFileStorageService&#xa;File.Delete + prune dirs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1180" y="360" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_b_s3" value="S3FileStorageService&#xa;DeleteObjectAsync (NoSuchKey ignored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bfb3eb;strokeColor=#5947a3;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1180" y="420" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_b_blob" value="BlobFileStorageService&#xa;DeleteIfExistsAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a89bda;strokeColor=#4a3892;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1180" y="480" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- Audit -->
        <mxCell id="d_audit" value="IFileAuditPublisher&#xa;FileAuditOccurred(FileDeleted · Outcome.Success|Failure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe9fa;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="650" width="240" height="70" as="geometry" />
        </mxCell>

        <!-- Note: orphan recovery -->
        <mxCell id="d_note" value="&lt;b&gt;Orphan blob recovery&lt;/b&gt;&#xa;If step 3 fails after step 2 succeeded, the metadata row is tombstoned but the blob still exists.&#xa;A janitor job can enumerate tombstones whose blob still resolves and re-issue DeleteFromStorageAsync.&#xa;The reverse situation (orphan metadata pointing at a missing blob) is &lt;i&gt;impossible&lt;/i&gt; under the tombstone-first ordering." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffd0;strokeColor=#cbb300;size=18;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="810" width="800" height="115" as="geometry" />
        </mxCell>

        <!-- Edges down the pipeline -->
        <mxCell id="d_e_start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#444444;" edge="1" parent="1" source="d_start" target="d_s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b54848;" edge="1" parent="1" source="d_s1" target="d_s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b54848;" edge="1" parent="1" source="d_s2" target="d_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b07a00;dashed=1;" edge="1" parent="1" source="d_s3" target="d_s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b54848;" edge="1" parent="1" source="d_s4" target="d_s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-lane edges -->
        <mxCell id="d_e_1_get" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#5b9f5c;fontSize=11;" edge="1" parent="1" source="d_s1" target="d_meta_get">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_2_mark" value="tombstone" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5b9f5c;fontSize=11;" edge="1" parent="1" source="d_s2" target="d_meta_mark">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_3_local" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5947a3;fontSize=11;" edge="1" parent="1" source="d_s3" target="d_b_local">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_3_s3" value="DELETE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5947a3;fontSize=11;" edge="1" parent="1" source="d_s3" target="d_b_s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_3_blob" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5947a3;fontSize=11;" edge="1" parent="1" source="d_s3" target="d_b_blob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_4_hard" value="row drop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#5b9f5c;fontSize=11;" edge="1" parent="1" source="d_s4" target="d_meta_hard">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_e_5_audit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;fontSize=11;" edge="1" parent="1" source="d_s5" target="d_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="d_legend" value="Solid arrow = synchronous control flow.&#xa;Dashed arrow = optional / mode-gated step (e.g. hard-delete branch only fires for FileDeletionMode.HardDelete).&#xa;Lane order matters: metadata tombstone &lt;b&gt;always&lt;/b&gt; precedes backend delete." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontStyle=2;fontColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="950" width="1140" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="SaveCompressEncryptFlow" name="Save upload (compress · encrypt)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sce_title" value="&lt;b&gt;Save upload (compress · encrypt)&lt;/b&gt; — SaveStreamAsync / SaveFileAsync with compress=true and encrypt=true (same pipeline as buffered saves; distinct from plaintext direct PUT)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1620" height="36" as="geometry" />
        </mxCell>
        <mxCell id="sce_l1" value="Caller" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="sce_l2" value="FileStorageServiceBase" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#4386c9;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="560" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="sce_l3" value="Crypto · Compression" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="60" width="360" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="sce_l4" value="Backend · Metadata" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf6e8;strokeColor=#5b9f5c;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="60" width="420" height="1080" as="geometry" />
        </mxCell>
        <mxCell id="sce_start" value="POST files/save-stream&#xa;or SaveFileAsync(path)&#xa;compress=true&#xa;encrypt=true&#xa;keyId=…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="180" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sce_s1" value="&lt;b&gt;1 · Validate&lt;/b&gt;&#xa;Path prefix guard · MaxUploadSizeBytes · keyId required when encrypt=true · content policy · optional malware scan (RequireScanBeforeAvailable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sce_s2" value="&lt;b&gt;2 · Hash plaintext&lt;/b&gt;&#xa;HashingStream (configured HashAlgorithm, default SHA-256)&#xa;Captures originalFileHash for duplicate detection &amp; read verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e0f5;strokeColor=#5d7ec0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sce_s3" value="&lt;b&gt;3 · Compress (optional flag)&lt;/b&gt;&#xa;ICompressionService.Resolver compresses stream&#xa;Algorithm from policy selector or default (LZ4/GZip/Zstd…)&#xa;Records CompressionAlgorithm + compressed sizes on metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sce_s4" value="&lt;b&gt;4 · Encrypt (optional flag)&lt;/b&gt;&#xa;ITwoKeyEncryptionService: generate per-file DEK · encrypt payload&#xa;Wrap DEK with KEK from IKeyStore (keyId + current version)&#xa;Prepend file-encryption header (algo · wrappedDek · IV · key refs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbd0ee;strokeColor=#4d6caa;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="435" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sce_s5" value="&lt;b&gt;5 · Write backend&lt;/b&gt;&#xa;CreateOutputStreamAsync → Local temp+rename · S3UploadStream · Blob OpenWrite&#xa;Persist storage suffix (.gz · .lyo.gz · etc.) on metadata for suffix-resolved reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="565" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sce_s6" value="&lt;b&gt;6 · Duplicate strategy&lt;/b&gt;&#xa;FindByHashAsync on plaintext hash&#xa;ReturnExisting / Overwrite / AllowDuplicate (profile-aware)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="680" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sce_s7" value="&lt;b&gt;7 · SaveMetadataAsync + audit&lt;/b&gt;&#xa;FileStoreResult: original + stored sizes/hashes · IsCompressed · IsEncrypted · keyId/version · pathPrefix · availability&#xa;FileAuditOccurred(FileSaved) · FileSaved event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5dec5;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="780" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sce_note" value="&lt;b&gt;Contrast: direct PUT&lt;/b&gt;&#xa;BeginDirectUploadAsync issues a plaintext presigned URL — compress/encrypt are &lt;i&gt;not&lt;/i&gt; applied on the edge PUT.&#xa;Use staged CommitAsync or in-band SaveStreamAsync when transforms are required." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffd0;strokeColor=#cbb300;size=16;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="900" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sce_comp" value="ICompressionService&#xa;Resolver.CompressAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="330" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sce_enc" value="ITwoKeyEncryptionService&#xa;+ IKeyStore wrap DEK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffd9b6;strokeColor=#cc8500;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="880" y="450" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sce_meta" value="IFileMetadataStore.SaveMetadataAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b8dfb8;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="800" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sce_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="sce_start" target="sce_s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="sce_s1" target="sce_s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="sce_s2" target="sce_s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="sce_s3" target="sce_s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="sce_s4" target="sce_s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="sce_s5" target="sce_s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="sce_s6" target="sce_s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_ec" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="sce_s3" target="sce_comp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_ee" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;" edge="1" parent="1" source="sce_s4" target="sce_enc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="sce_em" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5b9f5c;" edge="1" parent="1" source="sce_s7" target="sce_meta"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="StagedUploadFlow" name="Staged upload flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="st_title" value="&lt;b&gt;Staged upload flow&lt;/b&gt; — bytes land in a staging key; canonical file_metadata is written only on Commit (sync API or async worker after UploadCompleted)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1620" height="36" as="geometry" />
        </mxCell>
        <mxCell id="st_l1" value="Client / Browser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="220" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="st_l2" value="IStagedFileUploadService · StagedUploadCoordinator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf2fb;strokeColor=#4386c9;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="520" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="st_l3" value="Staging I/O (IStagedFilePhysicalIo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0eef9;strokeColor=#5947a3;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="60" width="400" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="st_l4" value="IStagedFileUploadStore · IFileStorageService (commit)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eaf6e8;strokeColor=#5b9f5c;verticalAlign=top;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1240" y="60" width="420" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="st_s1" value="&lt;b&gt;1 · BeginAsync&lt;/b&gt;&#xa;Validate declared size · content policy · create stageId&#xa;Insert staged_file_upload row (status=PendingUpload)&#xa;Issue presigned/SAS PUT URL → …/.stage/{stageId}/object&#xa;Local: API receive URL when DirectUploadReceiveBaseUri set&#xa;Audit StagedUploadBegin · PresignedCreated event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="st_s2" value="&lt;b&gt;2 · Client PUT (out of band)&lt;/b&gt;&#xa;Upload raw bytes to PresignedPutUrl with RequiredPutHeaders&#xa;S3/Blob: direct to cloud · Local: PUT …/stage/{stageId}/put (TestApi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st_s3" value="&lt;b&gt;3 · CompleteAsync&lt;/b&gt;&#xa;ObjectExists + size check · optional ExpectedByteLength&#xa;Spool stage object · hash · optional malware scan&#xa;Update staged row → status=Uploaded&#xa;Audit StagedUploadComplete · UploadCompleted event&#xa;(Worker may subscribe here instead of immediate Commit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e0f5;strokeColor=#5d7ec0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="260" width="480" height="140" as="geometry" />
        </mxCell>
        <mxCell id="st_s4" value="&lt;b&gt;4 · CommitAsync&lt;/b&gt; (sync or worker)&#xa;TryTransitionStatus Uploaded → Committing (optimistic claim)&#xa;OpenReadStream from staging key → IFileStorageService.SaveFromStreamAsync&#xa;  with StagedUploadCommitRequest (compress · encrypt · keyId · pathPrefix)&#xa;Delete staging object · update staged row → Committed + committedFileId&#xa;SaveMetadataAsync on canonical file · StagedUploadCommit audit · Committed event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbd0ee;strokeColor=#4d6caa;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="430" width="480" height="160" as="geometry" />
        </mxCell>
        <mxCell id="st_s5" value="&lt;b&gt;AbortAsync (alternate path)&lt;/b&gt;&#xa;Best-effort DeleteStageObject · status=Aborted&#xa;Not allowed when Committing or Committed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#b54848;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="610" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_io" value="Local: {Root}/.stage/{id}/object&#xa;S3: presigned PUT + Head/Get/Delete&#xa;Blob: SAS PUT + Exists/Download/Delete&#xa;(SSE-C Blob: Begin throws — no staged SAS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="840" y="120" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="st_store" value="staged_file_upload table&#xa;(Postgres/Sqlite/InMemory)&#xa;NOT file_metadata until commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5dec5;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="120" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st_commit" value="Commit runs full Save pipeline&#xa;(see Save upload tab for compress/encrypt detail)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b8dfb8;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="460" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="st_e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="st_s1" target="st_s2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="160" y="165" /></Array></mxGeometry></mxCell>
        <mxCell id="st_e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="st_s2" target="st_s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="st_e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#4386c9;" edge="1" parent="1" source="st_s3" target="st_s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="st_e1io" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#5947a3;" edge="1" parent="1" source="st_s1" target="st_io"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="st_e1db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#5b9f5c;" edge="1" parent="1" source="st_s1" target="st_store"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="st_e4save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#5b9f5c;" edge="1" parent="1" source="st_s4" target="st_commit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="st_legend" value="Two tables: staged_file_upload tracks the in-flight session; file_metadata is created only when CommitAsync succeeds. IStagedFileUploadEventHandler enables RabbitMQ/worker handoff after UploadCompleted." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=2;fontColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="720" width="1340" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="DekMigrateFlow" name="DEK migrate (re-wrap KEK)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dm_title" value="&lt;b&gt;DEK migrate (MigrateDeksAsync)&lt;/b&gt; — re-wrap wrapped DEKs under a new KEK id/version; &lt;i&gt;ciphertext bytes unchanged&lt;/i&gt; (header + metadata only)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1420" height="36" as="geometry" />
        </mxCell>
        <mxCell id="dm_start" value="Operator / job invokes&#xa;MigrateDeksAsync(sourceKeyId, sourceKeyVersion?, targetKeyId?, targetKeyVersion?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dm_s1" value="&lt;b&gt;1 · Discover candidates&lt;/b&gt;&#xa;IFileMetadataStore.FindByKeyIdAndVersionAsync(sourceKeyId, sourceKeyVersion)&#xa;Skips tombstoned rows · empty set → DekMigrationResult(0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dm_s2" value="&lt;b&gt;2 · Per file (batched)&lt;/b&gt;&#xa;Skip if already on target keyId+version&#xa;Skip if not encrypted / missing wrapped DEK metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e0f5;strokeColor=#5d7ec0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="680" height="75" as="geometry" />
        </mxCell>
        <mxCell id="dm_s3" value="&lt;b&gt;3 · ReEncryptDekAsync&lt;/b&gt;&#xa;ITwoKeyEncryptionService unwraps DEK with old KEK · re-wraps with target KEK/version&#xa;Returns new wrapped DEK blob (same plaintext DEK, new envelope)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="365" width="680" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dm_s4" value="&lt;b&gt;4 · UpdateFileHeaderAsync&lt;/b&gt;&#xa;IFileStoragePhysicalIo patches in-place encryption header on stored blob&#xa;(range update on S3/Blob · local file header rewrite)&#xa;Fails if blob missing or header truncated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="680" height="95" as="geometry" />
        </mxCell>
        <mxCell id="dm_s5" value="&lt;b&gt;5 · SaveMetadataAsync&lt;/b&gt;&#xa;Update EncryptedDataEncryptionKey · DataEncryptionKeyId/Version · KeyEncryptionKeySalt&#xa;Original/stored ciphertext hashes unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5dec5;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="680" height="85" as="geometry" />
        </mxCell>
        <mxCell id="dm_s6" value="&lt;b&gt;6 · Aggregate result + audit&lt;/b&gt;&#xa;DekMigrationResult: migrated · skipped · failed counts + failed file ids&#xa;FileAuditOccurred(MigrateDeks) — partial failures → Outcome.Failure detail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="695" width="680" height="85" as="geometry" />
        </mxCell>
        <mxCell id="dm_note" value="&lt;b&gt;Migrate vs Rotate&lt;/b&gt;&#xa;Migrate = KEK rotation on existing ciphertext (cheap, in-place header patch).&#xa;Rotate = full decrypt + re-encrypt with fresh DEK (see DEK rotate tab)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffd0;strokeColor=#cbb300;size=18;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="170" width="640" height="90" as="geometry" />
        </mxCell>
        <mxCell id="dm_e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b06500;" edge="1" parent="1" source="dm_start" target="dm_s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dm_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dm_s1" target="dm_s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dm_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dm_s2" target="dm_s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dm_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dm_s3" target="dm_s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dm_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dm_s4" target="dm_s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dm_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dm_s5" target="dm_s6"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="DekRotateFlow" name="DEK rotate (re-encrypt)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dr_title" value="&lt;b&gt;DEK rotate (RotateDeksAsync)&lt;/b&gt; — decrypt each file fully, re-seal with a fresh DEK (optional new KEK id/version); rewrites stored blob + metadata hashes" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1420" height="36" as="geometry" />
        </mxCell>
        <mxCell id="dr_start" value="Operator invokes&#xa;RotateDeksAsync(fileIds[], targetKeyId?, targetKeyVersion?)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="dr_s1" value="&lt;b&gt;1 · Load + validate metadata&lt;/b&gt;&#xa;GetMetadataAsync per fileId · must be encrypted with complete DEK fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dr_s2" value="&lt;b&gt;2 · ReadEncryptedPayloadAsync&lt;/b&gt;&#xa;Backend read → parse header → unwrap DEK → decrypt to plaintext stream&#xa;(honours compression suffix on stored blob)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="255" width="680" height="85" as="geometry" />
        </mxCell>
        <mxCell id="dr_s3" value="&lt;b&gt;3 · RewriteEncryptedFileAsync&lt;/b&gt;&#xa;Generate new DEK · encrypt plaintext · wrap with resolved target KEK/version&#xa;Replace stored object (same fileId) via streaming pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="680" height="95" as="geometry" />
        </mxCell>
        <mxCell id="dr_s4" value="&lt;b&gt;4 · SaveMetadataAsync&lt;/b&gt;&#xa;Update wrapped DEK · key refs · encrypted hash/size fields" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5dec5;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="475" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dr_s5" value="&lt;b&gt;5 · Per-file isolation + aggregate audit&lt;/b&gt;&#xa;Failure on one fileId does not stop the batch&#xa;DekMigrationResult-style counters · FileAuditOccurred(RotateDeks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="565" width="680" height="85" as="geometry" />
        </mxCell>
        <mxCell id="dr_note" value="Use &lt;b&gt;Migrate&lt;/b&gt; when only the KEK version changed and ciphertext can stay put.&#xa;Use &lt;b&gt;Rotate&lt;/b&gt; when policy requires a brand-new DEK per file or algorithm refresh." style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffffd0;strokeColor=#cbb300;size=18;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="165" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dr_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dr_start" target="dr_s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dr_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dr_s1" target="dr_s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dr_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dr_s2" target="dr_s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dr_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dr_s3" target="dr_s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dr_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="dr_s4" target="dr_s5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="ReadFlow" name="Read flow (decrypt · decompress)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="r_title" value="&lt;b&gt;Read flow&lt;/b&gt; — GetFileStreamAsync / GetFileAsync: availability gate → storage read → decrypt → decompress → hash verify" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r_s1" value="&lt;b&gt;1 · GetMetadataAsync&lt;/b&gt;&#xa;Load FileStoreResult · check tombstone · availability (PendingScan / Quarantined → FileNotAvailableException unless admin override)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_s2" value="&lt;b&gt;2 · ReadFromStorageAsync&lt;/b&gt;&#xa;Resolve key via persisted storage suffix (no N+1 suffix probes)&#xa;Local · S3 GetObject · Blob DownloadStreaming" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_s3" value="&lt;b&gt;3 · Decrypt (if encrypted)&lt;/b&gt;&#xa;Parse file header · unwrap DEK via IKeyStore · decrypt ciphertext stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="680" height="75" as="geometry" />
        </mxCell>
        <mxCell id="r_s4" value="&lt;b&gt;4 · Decompress (if compressed)&lt;/b&gt;&#xa;ICompressionService.Resolver from metadata CompressionAlgorithm&#xa;MaxDecompressedBytesReadStream enforces ceiling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="365" width="680" height="75" as="geometry" />
        </mxCell>
        <mxCell id="r_s5" value="&lt;b&gt;5 · HashVerifyingReadStream&lt;/b&gt;&#xa;Fixed-time compare of streamed hash vs metadata originalFileHash on EOF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="680" height="65" as="geometry" />
        </mxCell>
        <mxCell id="r_s6" value="&lt;b&gt;6 · Audit + event&lt;/b&gt;&#xa;FileAuditOccurred(FileRetrieved) · FileRetrieved event with redacted snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="545" width="680" height="65" as="geometry" />
        </mxCell>
        <mxCell id="r_alt" value="&lt;b&gt;Alternative: presigned read&lt;/b&gt;&#xa;GetPreSignedReadUrlAsync returns SAS/S3 URL (optional Content-Disposition/Type overrides)&#xa;Client reads directly from storage — service does not proxy bytes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0e6ff;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="70" width="640" height="90" as="geometry" />
        </mxCell>
        <mxCell id="r_e" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#558b54;" edge="1" parent="1" source="r_s1" target="r_s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="r_s2" target="r_s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="r_s3" target="r_s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="r_s4" target="r_s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="r_s5" target="r_s6"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="CopyFlow" name="Copy flow (server-side)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c_title" value="&lt;b&gt;Copy flow&lt;/b&gt; — CopyFileAsync clones metadata to a new Guid and copies stored bytes server-side (no download/re-upload through the host)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1420" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c_s1" value="&lt;b&gt;1 · GetMetadataAsync(sourceId)&lt;/b&gt;&#xa;Validate availability · read encryption/compression/suffix/pathPrefix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="680" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c_s2" value="&lt;b&gt;2 · Allocate new fileId&lt;/b&gt;&#xa;Clone FileStoreResult with new Guid · optional pathPrefix override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e0f5;strokeColor=#5d7ec0;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="680" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_s3" value="&lt;b&gt;3 · CopyServerSideAsync&lt;/b&gt;&#xa;S3 CopyObject · Blob SyncCopyFromUri · Local filesystem copy&#xa;Same stored representation (compressed/encrypted bytes copied verbatim)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="680" height="85" as="geometry" />
        </mxCell>
        <mxCell id="c_s4" value="&lt;b&gt;4 · SaveMetadataAsync(newId)&lt;/b&gt;&#xa;Persist cloned metadata pointing at new storage key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c5dec5;strokeColor=#5b9f5c;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="680" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_s5" value="&lt;b&gt;5 · FileSaved audit + return&lt;/b&gt;&#xa;New FileStoreResult for destination id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0ff;strokeColor=#4386c9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="680" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="c_s1" target="c_s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="c_s2" target="c_s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="c_s3" target="c_s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="c_s4" target="c_s5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

</mxfile>

@namespace Lyo.FileStorage.Web.Components.FileMetadata
@using Lyo.Web.Components.DataTablePreview

<LyoDialog>
    <ChildContent>
        @if (Sheets.Count == 0) {
            <MudAlert Severity="Severity.Warning" Dense="true">No tables found to preview.</MudAlert>
        }
        else if (Sheets.Count == 1) {
            <MudText Typo="Typo.subtitle2" Class="mb-2">@Sheets[0].Title</MudText>
            <DataTablePreview Table="@Sheets[0].Table" MaxHeightCss="60vh"/>
        }
        else {
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
                @foreach (var sheet in Sheets) {
                    <MudTabPanel Text="@sheet.Title">
                        <div class="pa-1">
                            <DataTablePreview Table="@sheet.Table" MaxHeightCss="60vh"/>
                        </div>
                    </MudTabPanel>
                }
            </MudTabs>
        }
    </ChildContent>
</LyoDialog>

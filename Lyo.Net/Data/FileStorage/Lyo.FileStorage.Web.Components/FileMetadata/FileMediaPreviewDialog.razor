@using Lyo.Web.Components.Media
@namespace Lyo.FileStorage.Web.Components.FileMetadata

<LyoDialog>
    <ChildContent>
        @if (Kind == FileMediaPreviewKind.Image) {
            <LyoImage Src="@Src" Alt="@(FileName ?? "")"/>
        }
        else if (Kind == FileMediaPreviewKind.Audio) {
            <LyoAudio Src="@Src"/>
        }
        else {
            <LyoVideo Src="@Src"/>
        }
    </ChildContent>
</LyoDialog>

@namespace Lyo.FileStorage.Web.Components.FileStorageManagement
@using Lyo.Web.Components.FileUpload
@implements IAsyncDisposable

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Help</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <LyoFileUpload MaxFiles="1"
                               ButtonText="Browse"
                               ButtonVariant="Variant.Outlined"
                               InlineLayout="true"
                               TempSession="_stagingSession"
                               OnClientFilePathReady="OnFileReadyAsync"
                               OnClientFilePathRemoved="OnFileRemovedAsync"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Original file name" @bind-Value="_originalFileName"/>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Path prefix" Placeholder="Optional" @bind-Value="_pathPrefix"/>
            </MudItem>
        </MudGrid>
        @if (Mode == FileStoreProtocolUploadMode.Staged || Mode == FileStoreProtocolUploadMode.Multipart) {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudSwitch T="bool" @bind-Value="_compress" Color="Color.Primary" Label="Compress"/>
                <MudSwitch T="bool" @bind-Value="_encrypt" Color="Color.Primary" Label="Encrypt"/>
                @if (_encrypt) {
                    <FileStoreKeyIdField Label="Key id" AutoSelectSingle="true" @bind-Value="_keyId"/>
                }
            </MudStack>
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary">@_status</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_busy || _file == null)" OnClick="RunAsync">
            @(_busy ? "Working..." : "Upload")
        </MudButton>
    </MudStack>
</MudPaper>

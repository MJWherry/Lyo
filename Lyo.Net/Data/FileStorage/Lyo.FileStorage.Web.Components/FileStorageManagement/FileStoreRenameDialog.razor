@namespace Lyo.FileStorage.Web.Components.FileStorageManagement

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Updates the display name in metadata only. The stored object key is unchanged.
            </MudText>
            <MudTextField T="string"
                          Label="Original file name"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          @bind-Value="_originalFileName"/>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirm" Disabled="@string.IsNullOrWhiteSpace(_originalFileName)">Rename</MudButton>
    </DialogActions>
</MudDialog>

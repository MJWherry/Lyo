@using Lyo.FileMetadataStore.Models
@namespace Lyo.FileStorage.Web.Components.FileStorageWorkbench

<MudDialog>
    <DialogContent>
        <FileStoreMetadataTable Metadata="Metadata"/>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public FileStoreResult? Metadata { get; set; }

    private void Close() => MudDialog.Close();

}

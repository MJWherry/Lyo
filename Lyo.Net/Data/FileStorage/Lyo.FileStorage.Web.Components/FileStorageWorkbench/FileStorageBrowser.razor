@namespace Lyo.FileStorage.Web.Components.FileStorageWorkbench
@using Lyo.Common.Records
@using Lyo.Web.Components.DataGrid
@implements IDisposable

<MudPaper Class="pa-4 mt-1" Outlined="true">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">File browser</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Postgres-backed rows from the Test API (<code>@Workbench.FileMetadataQueryRoute</code>/QueryProject), including soft-deleted tombstones.
            <strong>View</strong> works for deleted rows; other row actions are disabled when <strong>Deleted at</strong> is set.
            The expected-storage view builds object keys from metadata (<code>PathPrefix</code> + <code>SourceFileName</code>).
        </MudText>
        <MudTabs Rounded="true" KeepPanelsAlive="true" Elevation="0">
            <MudTabPanel Text="Metadata">
                <LyoDataGridProjected @ref="_metadataGrid"
                                      ApiClient="Workbench.ApiClient"
                                      GridKey="FileStorageBrowserMetadata"
                                      Route="@Workbench.FileMetadataQueryRoute"
                                      Features="@GridFeatures"
                                      GridClass="file-browser-grid-dense"
                                      KeySelector="@FileStorageGridRowHelper.GetFileRowKey"
                                      KeySelectFields="@FileKeySelectFields"
                                      RowMenuControls="@RowMenu(false)"
                                      BulkMenuItems="@MetadataBulkMenu">
                    <Columns>
                        <LyoProjectedColumn Field="DeletedAt" Title="Deleted at" FormattedValue="@FileStorageGridRowHelper.FormatDeletedAtCell"/>
                        <LyoProjectedColumn Field="OriginalFileName" Title="Name" QuickSearchPropertyName="OriginalFileName"/>
                        <LyoTypedProjectedColumn TValue="long" Field="OriginalFileSize" Title="Original size" Format="@(size => FileSizeUnitInfo.FormatBestFitAbbreviation(size))"/>
                        <LyoProjectedColumn Field="PathPrefix" Title="Path prefix" QuickSearchPropertyName="PathPrefix"/>
                        <LyoProjectedColumn Field="DataEncryptionKeyAlgorithm" Title="Encryption"/>
                        <LyoProjectedColumn Field="CompressionAlgorithm" Title="Compression"/>
                        <LyoProjectedColumn Field="Id" Title="Id" HiddenByDefault="true"/>
                        <LyoProjectedColumn Field="SourceFileName" Title="Stored as" QuickSearchPropertyName="SourceFileName" HiddenByDefault="true"/>
                        <LyoProjectedColumn Field="Timestamp" Title="Timestamp" HiddenByDefault="true"/>
                        <LyoProjectedColumn Field="IsEncrypted" Title="Encrypted" HiddenByDefault="true"/>
                        <LyoProjectedColumn Field="DataEncryptionKeyId" Title="DEK id" HiddenByDefault="true"/>
                    </Columns>
                </LyoDataGridProjected>
            </MudTabPanel>
            <MudTabPanel Text="Expected storage">
                <LyoDataGridProjected @ref="_storageGrid"
                                      ApiClient="Workbench.ApiClient"
                                      GridKey="FileStorageBrowserExpectedStorage"
                                      Route="@Workbench.FileMetadataQueryRoute"
                                      Features="@GridFeatures"
                                      GridClass="file-browser-grid-dense"
                                      KeySelector="@FileStorageGridRowHelper.GetFileRowKey"
                                      KeySelectFields="@FileKeySelectFields"
                                      RowMenuControls="@RowMenu(true)"
                                      BulkMenuItems="@StorageBulkMenu">
                    <Columns>
                        <TemplateColumn T="object?" Title="Expected key" Sortable="false" HeaderStyle="min-width: 18rem;" CellStyle="font-family: monospace; font-size: 0.8125rem;">
                            <CellTemplate Context="cell">
                                @(FileStorageGridRowHelper.GetExpectedStorageKey(cell.Item) ?? "—")
                            </CellTemplate>
                        </TemplateColumn>
                        @if (DiagnosticsAvailable) {
                            <TemplateColumn T="object?" Title="Exists" Sortable="false" HeaderStyle="width: 6rem;" CellStyle="text-align: center;">
                                <CellTemplate Context="cell">
                                    @{
                                        var expected = FileStorageGridRowHelper.GetExpectedStorageKey(cell.Item);
                                        var exists = KeyExists(expected);
                                    }
                                    <MudChip T="string" Size="Size.Small" Color="@(exists ? Color.Success : Color.Warning)">
                                        @(exists ? "Yes" : "No")
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                        }
                        <LyoProjectedColumn Field="PathPrefix" Title="Path prefix" QuickSearchPropertyName="PathPrefix"/>
                        <LyoProjectedColumn Field="SourceFileName" Title="Stored as" QuickSearchPropertyName="SourceFileName"/>
                        <LyoProjectedColumn Field="OriginalFileName" Title="Name" HiddenByDefault="true"/>
                        <LyoProjectedColumn Field="Id" Title="Id" HiddenByDefault="true"/>
                        <LyoProjectedColumn Field="DeletedAt" Title="Deleted at" FormattedValue="@FileStorageGridRowHelper.FormatDeletedAtCell" HiddenByDefault="true"/>
                    </Columns>
                </LyoDataGridProjected>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudPaper>

@code {

    private RenderFragment<object?> RowMenu(bool storageView)
        => row => {
            var deleted = FileStorageGridRowHelper.IsRowDeleted(row);
            var actions = _actions!;
            return @<span style="display:contents">
            <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => actions.ViewFromRowAsync(row))">View</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Link" Disabled="@deleted" OnClick="@(() => actions.AccessLinkFromRowAsync(row))">Access link…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.FileDownload" Disabled="@deleted" OnClick="@(() => actions.DownloadFromRowAsync(row))">Download</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" Disabled="@deleted" OnClick="@(() => actions.MoveFromRowAsync(row))">Move…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" Disabled="@deleted" OnClick="@(() => actions.CopyFromRowAsync(row))">Copy…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline" Disabled="@deleted" OnClick="@(() => actions.RenameFromRowAsync(row))">Rename…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.VpnKey" Disabled="@deleted" OnClick="@(() => actions.RotateDekFromRowAsync(row))">Rotate DEK…</MudMenuItem>
            @if (storageView) {
                <MudMenuItem Icon="@Icons.Material.Filled.ContentPaste" OnClick="@(() => actions.CopyExpectedKeyFromRowAsync(row))">Copy expected key</MudMenuItem>
            }
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" Disabled="@deleted" OnClick="@(() => actions.DeleteFromRowAsync(row))">Delete</MudMenuItem>
        </span>;
        };

    private RenderFragment MetadataBulkMenu
        => @<span style="display:contents">
            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="@(() => _actions!.BulkMoveAsync(SelectedRows(_metadataGrid)))">Move…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.VpnKey" OnClick="@(() => _actions!.BulkRotateDeksAsync(SelectedRows(_metadataGrid)))">Rotate DEKs…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => _actions!.BulkDeleteAsync(SelectedRows(_metadataGrid)))">Delete</MudMenuItem>
        </span>;

    private RenderFragment StorageBulkMenu
        => @<span style="display:contents">
            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="@(() => _actions!.BulkMoveAsync(SelectedRows(_storageGrid)))">Move…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.VpnKey" OnClick="@(() => _actions!.BulkRotateDeksAsync(SelectedRows(_storageGrid)))">Rotate DEKs…</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => _actions!.BulkDeleteAsync(SelectedRows(_storageGrid)))">Delete</MudMenuItem>
        </span>;

}

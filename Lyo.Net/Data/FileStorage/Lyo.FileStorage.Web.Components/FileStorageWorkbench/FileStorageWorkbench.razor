@namespace Lyo.FileStorage.Web.Components.FileStorageWorkbench

<CascadingValue Value="this">
    <MudStack Spacing="3">
        <FileStorageWorkbenchHeader Title="@Title" Description="@Description"/>
        <FileStorageRegistrationAlerts ApiHealthy="@ApiHealthy" StorageHealthy="@StorageHealthy" ApiHealthDescription="@ApiHealthDescription"/>
        <MudTabs Rounded="true" KeepPanelsAlive="true">
            <MudTabPanel Text="Files">
                <FileStoreFilesTab/>
            </MudTabPanel>
            <MudTabPanel Text="Tree">
                <FileStorageTreeBrowser/>
            </MudTabPanel>
            <MudTabPanel Text="Browser">
                <FileStorageBrowser/>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</CascadingValue>

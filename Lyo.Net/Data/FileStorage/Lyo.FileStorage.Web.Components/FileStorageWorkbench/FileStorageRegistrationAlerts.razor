@namespace Lyo.FileStorage.Web.Components.FileStorageWorkbench

<MudAlert Severity="@Severity" Dense="true" Variant="Variant.Outlined">
    File storage API: @(ApiHealthy ? "reachable" : "unreachable")<br/>
    <span>@ApiHealthDescription</span>
</MudAlert>

@code {

    [Parameter]
    public bool ApiHealthy { get; set; }

    [Parameter]
    public bool StorageHealthy { get; set; }

    [Parameter]
    public string ApiHealthDescription { get; set; } = "";

    private Severity Severity => !ApiHealthy ? Severity.Warning : StorageHealthy ? Severity.Success : Severity.Info;
}

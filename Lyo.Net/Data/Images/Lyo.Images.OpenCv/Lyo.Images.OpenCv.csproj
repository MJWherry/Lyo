<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Description>OpenCV (OpenCvSharp) helpers for image pipelines — ROI inpaint (Telea / Navier–Stokes) on PNG buffers via IOpenCvRoiInpaint.</Description>
        <PackageTags>images opencv inpaint telea navier-stokes opencvsharp di</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

{
  "id": "Lyo.Images.Web.Components",
  "name": "Lyo.Images.Web.Components",
  "area": "Data",
  "tagline": "Blazor / MudBlazor workbenches for `Lyo.Images`: `IImageService` tools plus a spritesheet animator/extractor on `ISpriteSheetExportService`.",
  "description": "Blazor / MudBlazor UI for [`Lyo.Images`](../Lyo.Images/README.md): an `IImageService` workbench and a spritesheet\nanimator/extractor on `ISpriteSheetExportService`.",
  "features": [],
  "examples": [
    {
      "title": "Services the host must register",
      "language": "csharp",
      "code": "using Lyo.Images;\n\nservices.AddImageSharpImageService(); // IImageService used by ImageWorkbench\nservices.AddSpriteSheetExportService(); // ISpriteSheetExportService used by SpriteSheetWorkbench"
    }
  ],
  "sections": [
    {
      "type": "table",
      "title": "Components",
      "headers": [
        "Component",
        "Purpose"
      ],
      "rows": [
        [
          "`<ImageWorkbench />`",
          "Upload an image, inspect metadata and palette, and call `IImageService` (resize, crop, rotate, watermark, convert, thumbnail, compress)."
        ],
        [
          "`<SpriteSheetWorkbench />`",
          "Two tabs. Animate a flat strip, or pull a grid spritesheet from an animated source (GIF/WebP/APNG) through `ISpriteSheetExportService`."
        ],
        [
          "`<SpriteSheetAnimateUploader />`",
          "Multi-sheet upload plus label/select chrome that `SpriteSheetWorkbench` uses."
        ],
        [
          "`<SpriteSheetImageInfo />`",
          "Short metadata readout (dimensions, format, byte size) for a loaded raster."
        ],
        [
          "`<SpriteSheetPlayer />`",
          "Plays a sliced strip in the browser with a canvas JS animator for live preview."
        ],
        [
          "`<SpriteSheetProcessor />`",
          "Slicing and parameter panel for spritesheets (frame size, padding, sample budget, FPS, grid)."
        ]
      ],
      "trail": "Supporting types sit in `SpriteSheetModels.cs` (`SpriteSheetEntry`, frame/grid state that drives the workbench)."
    },
    {
      "type": "paragraph",
      "title": "Services the host must register",
      "text": "Every consumer registers the image services from `Lyo.Images`. Snackbars, dialogs, and JS interop come from `Lyo.Web.Components` (MudBlazor, the Lyo file upload, and `IJsInterop`)."
    },
    {
      "type": "paragraph",
      "title": "Browser scripts",
      "text": "`wwwroot/` holds the JS `<SpriteSheetPlayer />` uses. Serve static web assets from the host the usual Razor Class Library way."
    }
  ],

<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))"/>

    <!-- Linux: symlink distro .so names into $(OutputPath)x64 and libdl.so next to $(OutputPath) (InteropDotNet / glibc libdl.so.2). Opt in per project: PrepareTesseractLinuxNativeLibs=true -->
    <Target Name="PrepareTesseractLinuxNativeLibs"
            AfterTargets="Build"
            Condition="'$(PrepareTesseractLinuxNativeLibs)' == 'true' AND $([MSBuild]::IsOSPlatform('Linux'))">
        <PropertyGroup>
            <_TesseractSetupScript>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'Lyo.Images.Ocr.Tesseract', 'scripts', 'setup_linux_tesseract_nuget_libs.py'))))</_TesseractSetupScript>
            <_TesseractOutDir>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutputPath)'))))</_TesseractOutDir>
        </PropertyGroup>
        <Exec Command="python3 &quot;$(_TesseractSetupScript)&quot; &quot;$(_TesseractOutDir)&quot;"/>
    </Target>
</Project>

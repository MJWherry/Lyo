<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>Service-collection registration for Lyo metrics: AddLyoMetrics in its four option shapes, AddLyoMetricsFromConfiguration, and AddNullMetrics. Split out so Lyo.Metrics itself stays free of the DI and configuration packages.</Description>
        <PackageTags>metrics dependencyinjection registration options</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Metrics\Lyo.Metrics.csproj"/>
        <ProjectReference Include="..\..\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
    </ItemGroup>

    <!-- The whole reason this package exists: Options.ConfigurationExtensions pulls in
         Configuration.Binder, which instrumentation-only consumers of IMetrics should not inherit. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
    </ItemGroup>

</Project>

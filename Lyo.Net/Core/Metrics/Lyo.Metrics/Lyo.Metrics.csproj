<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>Metrics collection and reporting library with support for counters, timers, and snapshots. Provides a pluggable metrics interface for integration with various metrics backends. Carries no NuGet dependencies, so instrumenting a package costs nothing beyond this reference; service registration lives in Lyo.Metrics.DependencyInjection.</Description>
        <PackageTags>metrics monitoring counters timers snapshots</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
    </ItemGroup>

</Project>
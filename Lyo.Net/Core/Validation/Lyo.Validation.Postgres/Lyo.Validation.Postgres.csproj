<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>PostgreSQL persistence for Lyo.Validation schemas (WhereClause JSONB) using Entity Framework Core.</Description>
        <PackageTags>validation postgres postgresql entityframework ef schema</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Validation\Lyo.Validation.csproj"/>
        <ProjectReference Include="..\..\Common\Lyo.Common\Lyo.Common.csproj"/>
        <ProjectReference Include="..\..\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
        <ProjectReference Include="..\..\..\Data\Postgres\Lyo.Postgres\Lyo.Postgres.csproj"/>
        <ProjectReference Include="..\..\..\Data\Query\Lyo.Query.Models\Lyo.Query.Models.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Validation.Postgres.Tests"/>
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>Dependency-free Lyo primitives: enums, scalar and string extensions, identifier generators (LyoGuid, Ksuid, Ulid, NanoId, Snowflake), cryptographic randomness, HTTP header and content-disposition constants, type conversion, path helpers, and temp-file spooling.</Description>
        <PackageTags>common primitives enums extensions identifiers conversion pathing</PackageTags>
    </PropertyGroup>

    <!-- System.Memory for the spans in LyoGuid/Ksuid/Ulid/CryptographicRandom; AsyncInterfaces for the
         IAsyncDisposable that Disposable.cs needs and that netstandard2.0 does not ship. ValueTask comes
         with it via System.Threading.Tasks.Extensions, so that one stays implicit. System.Text.Json for
         the JSON branch of TypeConversion. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Memory"/>
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces"/>
        <PackageReference Include="System.Text.Json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Common.Tests"/>
    </ItemGroup>

</Project>

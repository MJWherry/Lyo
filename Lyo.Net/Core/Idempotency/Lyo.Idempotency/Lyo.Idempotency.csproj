<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>Shared idempotency store. A scope and key claim one in-progress row; the same request hash replays the stored result, and a different hash does not run the work again.</Description>
        <PackageTags>idempotency replay scope key</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Idempotency.Tests"/>
        <InternalsVisibleTo Include="Lyo.Idempotency.Postgres"/>
        <InternalsVisibleTo Include="Lyo.Outbox.Postgres"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
        <ProjectReference Include="..\..\Common\Lyo.Common.Core\Lyo.Common.Core.csproj"/>
        <ProjectReference Include="..\..\Health\Lyo.Health\Lyo.Health.csproj"/>
        <ProjectReference Include="..\..\Metrics\Lyo.Metrics\Lyo.Metrics.csproj"/>
        <ProjectReference Include="..\..\..\Security\Hashing\Lyo.Hashing\Lyo.Hashing.csproj"/>
    </ItemGroup>

</Project>

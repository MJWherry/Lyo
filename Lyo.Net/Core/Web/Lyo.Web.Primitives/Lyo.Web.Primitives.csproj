<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Lyo.Web.Primitives</RootNamespace>
        <Description>MudBlazor UI primitives shared by every Lyo component package: chips, record cards, responsive layout, workbench shell, and browser interop.</Description>
        <PackageTags>blazor components web ui mudblazor primitives</PackageTags>
        <!-- Razor compiler emits #nullable disable in .g.cs while project has Nullable=enable (dotnet/razor#8720). -->
        <NoWarn>$(NoWarn);CS8669</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Web.Primitives.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
        <ProjectReference Include="..\..\Result\Lyo.Result\Lyo.Result.csproj"/>
        <ProjectReference Include="..\..\Validation\Lyo.Validation\Lyo.Validation.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MudBlazor"/>
    </ItemGroup>

</Project>

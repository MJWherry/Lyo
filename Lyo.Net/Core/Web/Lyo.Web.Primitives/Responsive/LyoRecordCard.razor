@namespace Lyo.Web.Primitives

<MudPaper Outlined="true" Elevation="0" Class="@CardCssClass">
    @if (HasHeader) {
        <div class="lyo-record-card-header">
            <div class="lyo-record-card-heading">
                @if (!string.IsNullOrWhiteSpace(Title)) {
                    <MudText Typo="Typo.subtitle2" Class="@TitleCssClass">@Title</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(Subtitle)) {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@Subtitle</MudText>
                }
                @TitleContent
            </div>
            @if (Actions is not null) {
                <div class="lyo-record-card-actions">
                    @Actions
                </div>
            }
        </div>
    }
    <dl class="lyo-record-card-fields">
        @ChildContent
    </dl>
</MudPaper>

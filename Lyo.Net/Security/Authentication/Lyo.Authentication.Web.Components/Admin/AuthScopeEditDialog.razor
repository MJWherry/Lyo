@namespace Lyo.Authentication.Web.Components
@using Lyo.Authentication.Models.Response

<MudDialog>
    <TitleContent>@(_isNew ? "Add scope" : "Edit scope")</TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Required="true"
                          HelperText="Authorization scope granted on issued JWTs, e.g. people.read"/>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@namespace Lyo.Authentication.Web.Components
@using Lyo.Authentication.Models
@using Lyo.Query.Models.Common
@using Lyo.Query.Models.Enums
@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="AuthUserGrid"
                      Route="@_route"
                      KeySelector="@(i => ProjectedGridKeys.GuidId(i))"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      Features="@LyoDataGridFeatureFlags.All">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <Columns>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false"
                        HeaderStyle="@LyoDataGridColumnStyles.QuickActionsHeaderStyle"
                        CellStyle="@LyoDataGridColumnStyles.QuickActionsCellStyle">
            <CellTemplate Context="cell">
                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" title="Open user" aria-label="Open user"
                               OnClick="@(() => OpenUser(cell.Item))"/>
            </CellTemplate>
        </TemplateColumn>
        <LyoProjectedColumn Field="DisplayName" Title="Name" QuickSearchPropertyName="DisplayName" MaxDisplayLength="@ChipLabelHelper.DefaultGridCellMaxLength"/>
        <LyoProjectedColumn Field="Email" Title="Email" QuickSearchPropertyName="Email"/>
        <LyoProjectedColumn Field="EmailVerified" Title="Verified" Align="Align.Center" HeaderStyle="width: 110px;">
            <CellContent Context="item">
                <LyoChip Spec="@LyoChips.FromBool(ProjectedValueHelper.GetDisplayValue(item, "EmailVerified") is "True" or "true", "Verified", "Unverified", Color.Success, Color.Default)"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="DisabledTimestamp" Title="Status" HeaderStyle="width: 110px;">
            <CellContent Context="item">
                @{
                    var disabled = LyoDateTimeDisplay.ToDateTime(ProjectedValueHelper.GetValue(item, "DisabledTimestamp")) is not null;
                }
                <LyoChip Spec="@LyoChips.FromBool(!disabled, "Active", "Disabled", Color.Success, Color.Error)"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="LastLoginTimestamp" Title="Last login" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Relative"/>
        <LyoProjectedColumn Field="CreatedTimestamp" Title="Created" HiddenByDefault="true" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Relative"/>
        <LyoProjectedColumn Field="Id" Title="ID" HiddenByDefault="true" HeaderStyle="width: 140px; min-width: 140px;" CellStyle="min-width: 140px;">
            <CellContent Context="item">
                <AuthProjectedGuid Item="item" Field="Id"/>
            </CellContent>
        </LyoProjectedColumn>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.OpenInNew" OnClick="@(() => OpenUser(item))">Open</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditUser(item))">Edit</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

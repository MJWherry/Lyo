<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Lyo.Authentication.Web.Components.Wasm</RootNamespace>
        <Description>Blazor WebAssembly host adapter for `Lyo.Authentication.Web.Components`. Pure-browser token flow: exchanges the API's handoff code in the WASM client, holds the resulting access/refresh tokens in `Blazored.LocalStorage`, and injects the bearer (with auto-refresh) into outbound `HttpClient` calls.</Description>
        <PackageTags>blazor webassembly authentication mudblazor jwt</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blazored.LocalStorage"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Authentication.Web.Components\Lyo.Authentication.Web.Components.csproj"/>
        <ProjectReference Include="..\..\..\Core\Diagnostic\Lyo.Diagnostic\Lyo.Diagnostic.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>

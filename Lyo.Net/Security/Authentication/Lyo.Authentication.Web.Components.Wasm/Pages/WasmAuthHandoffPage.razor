@page "/auth/handoff"

@inject WasmAuthApiClient AuthApi
@inject WasmAuthSessionStore Sessions
@inject WasmAuthStateProvider StateProvider
@inject NavigationManager Navigation

<PageTitle>Signing in...</PageTitle>

<LyoElementRoot DefaultId="LyoWasmAuthHandoffPage" ElementId="@ElementId">
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
        <MudPaper Class="pa-6" Elevation="3">
            <MudStack Spacing="3" AlignItems="AlignItems.Center">
                @if (_error is null) {
                    <MudProgressCircular Indeterminate="true"/>

                    <MudText Typo="Typo.body1">Completing sign-in...</MudText>
                }
                else {
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large"/>

                    <MudText Typo="Typo.h6">Sign-in failed</MudText>

                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_error</MudText>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/auth/login">Try again</MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudContainer>
</LyoElementRoot>

@code {

    /// <summary>The handoff code minted by the API. Bound from <c>?lyo_handoff=...</c>.</summary>
    [SupplyParameterFromQuery(Name = "lyo_handoff")]
    public string? HandoffCode { get; set; }

    /// <summary>Optional consumer-local return URL passed through from the sign-in launcher.</summary>
    [SupplyParameterFromQuery(Name = "return")]
    public string? Return { get; set; }

    /// <summary>Optional override for the root element id used by the element-id scheme.</summary>
    [Parameter]
    public string? ElementId { get; set; }

    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(HandoffCode)) {
            _error = "Missing handoff code.";
            return;
        }

        try {
            var tokens = await AuthApi.ExchangeHandoffAsync(HandoffCode!);
            if (tokens is null) {
                _error = "Handoff exchange was rejected by the API.";
                return;
            }

            await Sessions.SetAsync(new(tokens.AccessToken, tokens.RefreshToken, DateTime.UtcNow.AddSeconds(tokens.ExpiresIn)));
            StateProvider.NotifyChanged();
            Navigation.NavigateTo(NormalizeReturnUrl(Return) ?? "/", false);
        }
        catch (Exception ex) {
            _error = ex.Message;
        }
    }

    private static string? NormalizeReturnUrl(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
            return null;

        if (!raw!.StartsWith("/", StringComparison.Ordinal) || raw.StartsWith("//", StringComparison.Ordinal))
            return null;

        return raw;
    }

}

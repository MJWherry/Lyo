<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>Wire-shape data for Lyo.Authentication: records returned over the API (`LyoUser`, `LinkedIdentity`, `IssuedLyoJwt`, `IssuedApiToken`, `ApiTokenRecord`, `ApiTokenPrincipal`, `ApiTokenIssueRequest`), JWT claim-name constants, the Lyo JWT parser, Format-B token format helpers (`Base64Url`, `Base32Crockford`, `ApiToken`, `ApiTokenKind`, `ApiTokenRing`), audit-event taxonomy (`AuthAuditEvent`, `AuthAuditEventKind`), and the `Scope` record. Safe to reference from consumer-side libraries — including Blazor WebAssembly clients — because it carries no server-side issuers / validators / stores and depends on neither `Lyo.Keystore`, `Lyo.Hashing`, nor BouncyCastle.</Description>
        <PackageTags>authentication models records dtos jwt</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Text.Json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Core\Common\Lyo.Common\Lyo.Common.csproj"/>
        <ProjectReference Include="..\..\..\Core\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>
</Project>

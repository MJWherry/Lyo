<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>AES-CCM addon for Lyo.Encryption. Adds the AesCcmEncryptionService and its DI extensions; brings in BouncyCastle as a dependency so the core package stays slim on net10.</Description>
        <PackageTags>encryption security aes-ccm cryptography</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Encryption\Lyo.Encryption.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>

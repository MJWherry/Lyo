<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>AES-SIV (RFC 5297) addon for Lyo.Encryption. Adds the AesSivEncryptionService backed by Dorssel.Security.Cryptography.AesExtra plus matching DI extensions, keeping the core package free of that dependency.</Description>
        <PackageTags>encryption security aes-siv cryptography</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Encryption\Lyo.Encryption.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Dorssel.Security.Cryptography.AesExtra" Version="2.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>

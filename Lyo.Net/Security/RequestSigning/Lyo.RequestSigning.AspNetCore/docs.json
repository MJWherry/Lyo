{
  "id": "Lyo.RequestSigning.AspNetCore",
  "name": "Lyo.RequestSigning.AspNetCore",
  "area": "Security",
  "tagline": "ASP.NET Core middleware that checks a timestamped HMAC request signature.",
  "description": "Reads the body, checks Lyo-Signature, and returns 401 when the signature is missing, malformed, stale, or does not match. A valid signature calls the next middleware.",
  "features": [
    "**UseRequestSignature checks the header before the endpoint runs.** The body stream is rewound so the endpoint can still read it."
  ],
  "examples": [
    {
      "title": "Pipeline",
      "language": "csharp",
      "code": "app.UseRequestSignature();"
    }
  ],

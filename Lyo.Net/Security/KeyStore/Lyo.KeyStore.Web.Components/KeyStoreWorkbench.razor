@namespace Lyo.KeyStore.Web.Components

<MudStack Spacing="3">
    @if (KeyStore == null) {
        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined">
            No <code>IKeyStore</code> is registered on this host. Register <code>AddLocalKeyStore()</code> or an AWS keystore in-process. Key material is not loaded over HTTP.
        </MudAlert>
    }
    else {
        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
            In-process keystore (<code>@KeyStore.GetType().Name</code>). Raw key bytes are never shown.
        </MudAlert>
        @if (_inventory == null) {
            <MudAlert Severity="Severity.Warning" Dense="true">This store does not implement <code>IKeyInventoryStore</code>, so the id list is empty until you type a known key id.</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">Keys</MudText>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="RefreshAsync" Disabled="@_busy">Refresh</MudButton>
                        @if (_keyIds.Count == 0) {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">No key ids.</MudText>
                        }
                        else {
                            <MudList T="string" Dense="true">
                                @foreach (var keyId in _keyIds) {
                                    <MudListItem T="string" OnClick="@(() => SelectKeyAsync(keyId))" Class="@(_selectedKeyId == keyId ? "mud-primary-text" : null)">
                                        @keyId
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@(string.IsNullOrEmpty(_selectedKeyId) ? "Add or rotate" : _selectedKeyId)</MudText>
                        @if (!string.IsNullOrEmpty(_selectedKeyId)) {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Current version: @(_currentVersion ?? "—")</MudText>
                            <MudText Typo="Typo.caption">Versions: @string.Join(", ", _versions)</MudText>
                            @if (_metadata != null) {
                                <MudText Typo="Typo.caption">Selected version metadata: created @_metadata.CreatedAt.ToString("u"), algorithm @(_metadata.Algorithm ?? "—")</MudText>
                            }
                            <MudSelect T="string" Label="Inspect version" Value="_inspectVersion" ValueChanged="OnInspectVersionChanged">
                                @foreach (var version in _versions) {
                                    <MudSelectItem T="string" Value="@version">@version</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_inspectVersion))" OnClick="SetCurrentAsync">
                                Set current
                            </MudButton>
                        }

                        <MudDivider/>
                        <MudTextField T="string" Label="Key id" @bind-Value="_editKeyId"/>
                        <MudTextField T="string" Label="Version (add only)" HelperText="Leave blank when rotating; the store increments." @bind-Value="_editVersion"/>
                        <MudTextField T="string" Label="Key string" InputType="InputType.Password" @bind-Value="_editKeyString"/>
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="AddAsync">Add version</MudButton>
                            <MudButton Variant="Variant.Filled" Disabled="@_busy" OnClick="RotateAsync">Rotate (new version)</MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudStack>

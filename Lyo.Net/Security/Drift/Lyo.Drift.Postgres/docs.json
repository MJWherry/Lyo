{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Drift.Postgres",
  "name": "Lyo.Drift.Postgres",
  "area": "Security",
  "tagline": "PostgreSQL persistence for the Lyo Drift collector.",
  "description": "Schema `drift` stores agent instances (upserted by InstanceKey), file-tree and system-info structure snapshots, computed diffs, and live change batches. Payloads stay jsonb. Snapshots store content_hash (lowercase hex, varchar 128) plus content_hash_algorithm (Sha256 via Lyo.Hashing). HTTP mapping (`BuildDriftGroup`) lives in `Lyo.Drift.Api`. Identical (algorithm, hash) pairs reuse the latest snapshot in a lineage. Server DiffAgainst uses DTO DetectChanges for file trees and IObjectGraphDiffService on SystemInfoDriftProjection.",
  "features": [
    "**Upsert instances.** Re-registering the same InstanceKey keeps snapshot history on one row.",
    "**Named hash.** Dedupe compares content_hash_algorithm and content_hash together. Default digest is SHA-256.",
    "**Size cap.** Bodies over MaxSnapshotJsonBytes are rejected.",
    "**Retention.** AddDriftRetentionService prunes old snapshots/changes while keeping the latest per lineage."
  ],
  "examples": [
    {
      "title": "Register the store",
      "language": "csharp",
      "code": "services.AddLocalCache();\nservices.AddLyoQueryServices();\nservices.AddPostgresDriftManagementFromConfiguration(configuration);"
    }
  ],

@inject IDialogService DialogService

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="DriftDiffGrid"
                      Route="@_route"
                      KeySelector="@(i => ProjectedGridKeys.RawId(i))"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      Features="@LyoDataGridFeatureFlags.All">
    <Columns>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false"
                        HeaderStyle="@LyoDataGridColumnStyles.QuickActionsHeaderStyle"
                        CellStyle="@LyoDataGridColumnStyles.QuickActionsCellStyle">
            <CellTemplate Context="cell">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" title="View diff" aria-label="View stored diff"
                               OnClick="@(() => ViewDiff(cell.Item))"/>
            </CellTemplate>
        </TemplateColumn>
        <LyoProjectedColumn Field="Id" Title="ID" Identifier="true" HeaderStyle="width: 140px;" CellStyle="white-space: nowrap;"/>
        <LyoProjectedColumn Field="InstanceId" Title="Instance" Identifier="true" HeaderStyle="width: 140px;"/>
        <LyoProjectedColumn Field="FromSnapshotId" Title="From" Identifier="true" HeaderStyle="width: 140px;"/>
        <LyoProjectedColumn Field="ToSnapshotId" Title="To" Identifier="true" HeaderStyle="width: 140px;"/>
        <LyoProjectedColumn Field="Source" Title="Source" Align="Align.Center" HeaderStyle="width: 100px;">
            <CellContent Context="item">
                @{
                    var sourceText = ProjectedValueHelper.GetDisplayValue(item, "Source");
                }
                <LyoChip Spec="@(LyoChips.FromEnum<DriftDiffSource>(sourceText, DriftColorHelper.ForDiffSource))"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="ComputedAtUtc" Title="Computed" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Absolute"/>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => ViewDiff(item))">View</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

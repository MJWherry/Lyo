@namespace Lyo.Authorization.Web.Components

<MudDialog>
    <TitleContent>Add grant</TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField T="string" @bind-Value="_form.Subject" Label="Subject" Required="true" Disabled="@_lockSubject"/>
            <MudTextField T="string" @bind-Value="_form.Action" Label="Action" Required="true"/>
            <MudTextField T="string" @bind-Value="_form.ResourceType" Label="Resource type" Required="true"/>
            <MudTextField T="string" @bind-Value="_form.ResourceId" Label="Resource id" HelperText="Blank covers every id"/>
            <MudTextField T="string" @bind-Value="_form.TenantId" Label="Tenant" HelperText="Blank covers every tenant"/>
            <MudDatePicker @bind-Date="_form.ExpiresAt" Label="Expires" HelperText="UTC" Clearable="true"/>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

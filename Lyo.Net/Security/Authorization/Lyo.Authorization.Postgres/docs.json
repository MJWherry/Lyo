{
  "id": "Lyo.Authorization.Postgres",
  "name": "Lyo.Authorization.Postgres",
  "area": "Security",
  "tagline": "PostgreSQL grant store. Schema authorization, table grant.",
  "description": "One active row per subject, action, resource type, resource id, and tenant. The unique index uses NULLS NOT DISTINCT and ignores revoked rows. An expired row still occupies the index until Save revokes it and inserts the replacement. A losing concurrent insert becomes ConflictException. The provider exception is not surfaced.",
  "features": [
    "**Health name authorization.grants** probes with CanConnectAsync. The store opens a context per call."
  ],
  "examples": [
    {
      "title": "Register",
      "language": "csharp",
      "code": "services.AddPostgresAuthorization(new PostgresAuthorizationOptions {\n    ConnectionString = connectionString,\n    EnableAutoMigrations = true\n});"
    }
  ],

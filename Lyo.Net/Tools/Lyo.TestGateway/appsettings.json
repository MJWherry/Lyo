{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiClient": {
    "BaseUrl": "http://localhost:5251/",
    "AcceptEncodings": [
      "gzip",
      "deflate",
      "br"
    ],
    "EnableAutoResponseDecompression": true,
    "RequestCompression": "Brotli",
    "RequestCompressionMinBytes": 1024
  },
  "LyoAuthClient": {
    "AuthBaseUrl": "http://localhost:5251",
    "HandoffCallbackPath": "/auth/handoff",
    "SignInPath": "/auth/sign-in",
    "SignOutPath": "/auth/sign-out",
    "PostSignOutRedirectPath": "/",
    "CookieName": "lyo_session",
    "SessionAbsoluteExpiration": "30.00:00:00",
    "AccessTokenSkew": "00:00:30"
  },
  "LyoAuthWebComponents": {
    "EnablePasswordSignIn": true,
    "ShowRememberMe": true
  },
  "FileStorageWorkbench": {
    "ApiRoutePrefix": "Workbench/FileStorage",
    "StreamUploadRelativePath": "upload/file"
  },
  "AwsKeyStore": {
    "AccessKeyId": "replace-me",
    "SecretAccessKey": "replace-me",
    "Profile": null,
    "Region": "replace-me",
    "SecretNamePrefix": "replace-me"
  },
  "S3FileStorageOptions": {
    "BucketName": "replace-me",
    "Region": "replace-me",
    "AccessKeyId": "replace-me",
    "SecretAccessKey": "replace-me",
    "Profile": null,
    "EnableMetrics": true
  },
  "PostgresFileMetadataStore": {
    "ConnectionString": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=replace-me",
    "EnableAutoMigrations": false
  },
  "PostgresConfig": {
    "ConnectionString": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=replace-me",
    "EnableAutoMigrations": false
  },
  "AwsTranslationOptions": {
    "AccessKeyId": "replace-me",
    "SecretAccessKey": "replace-me",
    "Region": "replace-me"
  },
  "TypecastClient": {
    "BaseUrl": "https://typecast.ai",
    "ApiKey": "replace-me"
  },
  "TypecastOptions": {
    "DefaultModel": "ssfm-v3.0"
  },
  "EmailServiceOptions": {
    "Host": "replace-me",
    "Port": 587,
    "UseSsl": true,
    "DefaultFromAddress": "replace-me",
    "DefaultFromName": "replace-me",
    "Username": "replace-me",
    "Password": "replace-me",
    "EnableMetrics": true
  },
  "TwilioOptions": {
    "AccountSid": "replace-me",
    "AuthToken": "replace-me",
    "DefaultFromPhoneNumber": "replace-me",
    "EnableMetrics": true
  },
  "RabbitMqOptions": {
    "Host": "replace-me",
    "Port": 5672,
    "Username": "replace-me",
    "Password": "replace-me",
    "VirtualHost": "/",
    "AdminUrl": "http://localhost:15672",
    "EnableMetrics": true
  },
  "WebRenderOptions": {
    "EnableMetrics": true
  },
  "CacheOptions": {
    "Enabled": true,
    "EnableMetrics": true
  },
  "CompressionOptions": {
    "Policy": {
      "BuiltInDefaultsEnabled": true
    }
  },
  "JobDashboard": {
    "BaseApiUrl": "http://localhost:5251",
    "StatisticsApiUrl": null
  },
  "EndatoClient": {
    "BaseUrl": "https://api.endato.com",
    "ApName": "replace-me",
    "ApPassword": "replace-me"
  }
}

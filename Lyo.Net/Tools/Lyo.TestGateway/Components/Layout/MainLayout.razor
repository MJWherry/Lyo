@using System.Security.Claims
@using Lyo.Authentication.Models.Records
@using Lyo.Authentication.Web.Components.Abstractions
@using Lyo.Web.Components
@using Lyo.Web.Host
@using Constants = Constants
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthSignInLauncher SignInLauncher
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<LyoAppShell Title="@PageName">
    <DrawerHeader>
        <MudPaper Class="pa-4" Square="true" Style="min-height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <MudAvatar Size="Size.Large">@_initials</MudAvatar>
            <MudText Typo="Typo.subtitle1" Class="mt-2">@(_displayName ?? "Not signed in")</MudText>
            @if (!string.IsNullOrWhiteSpace(_email)) {
                <MudText Typo="Typo.caption">@_email</MudText>
            }
            <AuthorizeView>
                <Authorized>
                    <MudLink Href="auth/profile" Class="mt-2">
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.AccountCircle">
                            Profile
                        </MudButton>
                    </MudLink>
                </Authorized>
                <NotAuthorized>
                    <MudLink Href="auth/login" Class="mt-2">
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Login">
                            Sign in
                        </MudButton>
                    </MudLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudPaper>
    </DrawerHeader>
    <DrawerNav>
        <MudNavMenu Dense="true" Class="mt-2">
            <MudNavLink Href="AdminDashboard" Icon="@Icons.Material.Filled.AdminPanelSettings">Admin</MudNavLink>
            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Home</MudNavLink>
            <AuthorizeView>
                <Authorized>
                    <MudNavLink Href="auth/profile" Icon="@Icons.Material.Filled.Person">Profile</MudNavLink>
                    <MudNavLink Href="auth/tokens" Icon="@Icons.Material.Filled.VpnKey">API tokens</MudNavLink>
                    <MudNavLink Href="auth/admin" Icon="@Icons.Material.Filled.Security">Auth admin</MudNavLink>
                    <MudNavLink Href="auth/debug" Icon="@Icons.Material.Filled.BugReport">Auth debug</MudNavLink>
                </Authorized>
                <NotAuthorized>
                    <MudNavLink Href="auth/login" Icon="@Icons.Material.Filled.Login">Sign in</MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
            <MudNavLink Href="PeopleManagement" Icon="@Icons.Material.Filled.Contacts">People</MudNavLink>
            <MudNavLink Href="@Constants.Page.Endato" Icon="@Icons.Material.Filled.PersonSearch">Endato</MudNavLink>
            <MudNavLink Href="@Constants.Page.QueryBuilder" Icon="@Icons.Material.Filled.QueryBuilder">Query Builder</MudNavLink>
            <MudNavLink Href="@Constants.Page.IdGenerator" Icon="@Icons.Material.Filled.Tag">ID Generator</MudNavLink>
            <MudNavGroup Title="Communication"
                         Icon="@Icons.Material.Filled.Forum"
                         Expanded="@IsExpanded(Constants.Page.Messaging, Constants.Page.Translation, Constants.Page.Tts, Constants.Page.Profanity)">
                <MudNavLink Href="@Constants.Page.Messaging" Icon="@Icons.Material.Filled.Textsms">Sms/Email</MudNavLink>
                <MudNavLink Href="@Constants.Page.Translation" Icon="@Icons.Material.Filled.Translate">Translate</MudNavLink>
                <MudNavLink Href="@Constants.Page.Tts" Icon="@Icons.Material.Filled.AudioFile">TTS</MudNavLink>
                <MudNavLink Href="@Constants.Page.Profanity" Icon="@Icons.Material.Filled.Warning">Profanity</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Documents & Files"
                         Icon="@Icons.Material.Filled.Description"
                         Expanded="@IsExpanded(Constants.Page.FileService, Constants.Page.FileStorageWorkbench, Constants.Page.KeyStoreWorkbench, Constants.Page.HtmlToPdf, Constants.Page.PdfAnnotator, Constants.Page.QrCodeGenerator, Constants.Page.BarcodeGenerator, Constants.Page.RichTextEditor, Constants.Page.SpriteSheetAnimator, Constants.Page.ImageWorkbench, Constants.Page.TextDiff, Constants.Page.CsvXlsx, Constants.Page.Formatter)">
                <MudNavLink Href="@Constants.Page.CsvXlsx" Icon="@Icons.Material.Filled.TableChart">CSV / XLSX</MudNavLink>
                <MudNavLink Href="@Constants.Page.FileService" Icon="@Icons.Material.Filled.EnhancedEncryption">Encryption/Compression</MudNavLink>
                <MudNavLink Href="@Constants.Page.FileStorageWorkbench" Icon="@Icons.Material.Filled.Storage">File Storage Workbench</MudNavLink>
                <MudNavLink Href="@Constants.Page.KeyStoreWorkbench" Icon="@Icons.Material.Filled.VpnKey">Key Store</MudNavLink>
                <MudNavLink Href="@Constants.Page.HtmlToPdf" Icon="@Icons.Material.Filled.PictureAsPdf">Html -> Pdf</MudNavLink>
                <MudNavLink Href="@Constants.Page.PdfAnnotator" Icon="@Icons.Material.Filled.PictureAsPdf">Pdf Annotator</MudNavLink>
                <MudNavLink Href="@Constants.Page.QrCodeGenerator" Icon="@Icons.Material.Filled.QrCode">QRCode Generator</MudNavLink>
                <MudNavLink Href="@Constants.Page.BarcodeGenerator" Icon="@Icons.Material.Filled.ViewWeek">Barcode Generator</MudNavLink>
                <MudNavLink Href="@Constants.Page.SpriteSheetAnimator" Icon="@Icons.Material.Filled.Movie">Spritesheet Animator</MudNavLink>
                <MudNavLink Href="@Constants.Page.ImageWorkbench" Icon="@Icons.Material.Filled.Palette">Image Workbench</MudNavLink>
                <MudNavLink Href="@Constants.Page.TextDiff" Icon="@Icons.Material.Filled.CompareArrows">Text Diff Workbench</MudNavLink>
                <MudNavLink Href="@Constants.Page.Formatter" Icon="@Icons.Material.Filled.TextFields">Formatter</MudNavLink>
            </MudNavGroup>
            <MudNavGroup Title="Infrastructure"
                         Icon="@Icons.Material.Filled.SettingsEthernet"
                         Expanded="@IsExpanded(Constants.Page.RabbitMq, Constants.Page.Metrics, Constants.Page.Locks, Constants.Page.Cache, Constants.Page.Jobs, Constants.Page.Drift, Constants.Page.Reports, Constants.Page.ReportDesign, Constants.Page.Schedule, Constants.Page.Diagnostics, Constants.Page.PrivacyRedaction, Constants.Page.Config, Constants.Page.Seed, Constants.Page.Catalog)">
                <MudNavLink Href="@Constants.Page.Cache" Icon="@Icons.Material.Filled.Storage">Cache</MudNavLink>
                <MudNavLink Href="@Constants.Page.Config" Icon="@Icons.Material.Filled.Tune">Config</MudNavLink>
                <MudNavLink Href="@Constants.Page.Seed" Icon="@Icons.Material.Filled.Science">Seed</MudNavLink>
                <MudNavLink Href="@Constants.Page.Jobs" Icon="@Icons.Material.Filled.Work">Jobs</MudNavLink>
                <MudNavLink Href="@Constants.Page.Drift" Icon="@Icons.Material.Filled.CompareArrows">Drift</MudNavLink>
                <MudNavLink Href="@Constants.Page.Reports" Icon="@Icons.Material.Filled.Assessment">Reports</MudNavLink>
                <MudNavLink Href="@Constants.Page.ReportDesign" Icon="@Icons.Material.Filled.DashboardCustomize">Report design</MudNavLink>
                <MudNavLink Href="@Constants.Page.Locks" Icon="@Icons.Material.Filled.Lock">Locks</MudNavLink>
                <MudNavLink Href="@Constants.Page.RabbitMq" Icon="@Icons.Material.Filled.Message">RabbitMq</MudNavLink>
                <MudNavLink Href="@Constants.Page.Metrics" Icon="@Icons.Material.Filled.HourglassTop">Metrics</MudNavLink>
                <MudNavLink Href="@Constants.Page.Schedule" Icon="@Icons.Material.Filled.Schedule">Schedule</MudNavLink>
                <MudNavLink Href="@Constants.Page.Diagnostics" Icon="@Icons.Material.Filled.BugReport">Diagnostics</MudNavLink>
                <MudNavLink Href="@Constants.Page.PrivacyRedaction" Icon="@Icons.Material.Filled.PrivacyTip">Privacy redaction</MudNavLink>
                <MudNavLink Href="@Constants.Page.Catalog" Icon="@Icons.Material.Filled.Inventory2">Package catalog</MudNavLink>
            </MudNavGroup>
        </MudNavMenu>
        <LyoNavMenu ExcludeCategories="RegistrySkip"/>
    </DrawerNav>
    <AppBarEnd>
        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                         Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Class="ml-2">
                    <ActivatorContent Context="_">
                        <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="ml-2">@_initials</MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="auth/profile" Icon="@Icons.Material.Filled.Person">Profile</MudMenuItem>
                        <MudMenuItem Href="auth/tokens" Icon="@Icons.Material.Filled.VpnKey">API tokens</MudMenuItem>
                        <MudMenuItem Href="auth/admin" Icon="@Icons.Material.Filled.Security">Auth admin</MudMenuItem>
                        <MudMenuItem Href="auth/debug" Icon="@Icons.Material.Filled.BugReport">Auth debug</MudMenuItem>
                        <MudDivider/>
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">Sign out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="auth/login"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login"
                           Class="ml-2">
                    Sign in
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </AppBarEnd>
    <ChildContent>
        <CascadingValue Value="this">
            @Body
        </CascadingValue>
    </ChildContent>
</LyoAppShell>

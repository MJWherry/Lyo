@using System.Security.Claims
@using Lyo.Authentication.Models.Records
@using Lyo.Authentication.Web.Components.Abstractions
@using Lyo.Web.Components
@using Lyo.Web.Host
@using Constants = Constants
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthSignInLauncher SignInLauncher
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<LyoAppShell Title="@PageName">
    <DrawerHeader>
        <MudPaper Class="pa-4" Square="true" Style="min-height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <MudAvatar Size="Size.Large">@_initials</MudAvatar>
            <MudText Typo="Typo.subtitle1" Class="mt-2">@(_displayName ?? "Not signed in")</MudText>
            @if (!string.IsNullOrWhiteSpace(_email)) {
                <MudText Typo="Typo.caption">@_email</MudText>
            }
            <AuthorizeView>
                <Authorized>
                    <MudLink Href="auth/profile" Class="mt-2">
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.AccountCircle">
                            Profile
                        </MudButton>
                    </MudLink>
                </Authorized>
                <NotAuthorized>
                    <MudLink Href="auth/login" Class="mt-2">
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Login">
                            Sign in
                        </MudButton>
                    </MudLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudPaper>
    </DrawerHeader>
    <DrawerNav>
        <MudNavMenu Dense="true" Class="mt-2">
            <MudTextField @bind-Value="_navQuery"
                          Placeholder="Find a page"
                          Immediate="true"
                          Clearable="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Margin="Margin.Dense"
                          Variant="Variant.Text"
                          Class="px-3"/>
            @if (!HasVisibleNav) {
                <MudText Typo="Typo.caption" Class="px-4 py-2">No pages match.</MudText>
            }
            @foreach (var item in Visible(Pinned, group: null)) {
                <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="@item.Match">@item.Title</MudNavLink>
            }
            @if (ShowSignIn) {
                <MudNavLink Href="auth/login" Icon="@Icons.Material.Filled.Login">Sign in</MudNavLink>
            }
            @if (IsAuthenticated && Visible(AccountGroup.Items, AccountGroup.Title).Any()) {
                <MudNavGroup Title="@AccountGroup.Title" Icon="@AccountGroup.Icon" Expanded="@IsGroupOpen(AccountGroup)" ExpandedChanged="open => SetGroupOpen(AccountGroup, open)">
                    @foreach (var item in Visible(AccountGroup.Items, AccountGroup.Title)) {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="@item.Match">@item.Title</MudNavLink>
                    }
                </MudNavGroup>
            }
            @foreach (var group in NavGroups) {
                if (!Visible(group.Items, group.Title).Any())
                    continue;
                <MudNavGroup Title="@group.Title" Icon="@group.Icon" Expanded="@IsGroupOpen(group)" ExpandedChanged="open => SetGroupOpen(group, open)">
                    @foreach (var item in Visible(group.Items, group.Title)) {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon" Match="@item.Match">@item.Title</MudNavLink>
                    }
                </MudNavGroup>
            }
        </MudNavMenu>
        <LyoNavMenu ExcludeCategories="RegistrySkip"/>
    </DrawerNav>
    <AppBarEnd>
        <AuthorizeView>
            <Authorized>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                         Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Class="ml-2">
                    <ActivatorContent Context="_">
                        <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="ml-2">@_initials</MudAvatar>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="auth/profile" Icon="@Icons.Material.Filled.Person">Profile</MudMenuItem>
                        <MudMenuItem Href="auth/tokens" Icon="@Icons.Material.Filled.VpnKey">API tokens</MudMenuItem>
                        <MudMenuItem Href="auth/admin" Icon="@Icons.Material.Filled.Security">Auth admin</MudMenuItem>
                        <MudMenuItem Href="auth/debug" Icon="@Icons.Material.Filled.BugReport">Auth debug</MudMenuItem>
                        <MudDivider/>
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="SignOutAsync">Sign out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="auth/login"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login"
                           Class="ml-2">
                    Sign in
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </AppBarEnd>
    <ChildContent>
        <CascadingValue Value="this">
            @Body
        </CascadingValue>
    </ChildContent>
</LyoAppShell>

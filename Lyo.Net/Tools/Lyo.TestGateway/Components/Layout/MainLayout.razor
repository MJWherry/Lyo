                </MudButton>
                <MudSpacer/>
                <MudSwitch T="bool" Value="_isDarkMode" ValueChanged="Callback" Color="Color.Default" Label="Dark Mode"/>
                <AuthorizeView>
                    <Authorized>
                        <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                                 Color="Color.Inherit"
                                 AnchorOrigin="Origin.BottomRight"
                                 TransformOrigin="Origin.TopRight"

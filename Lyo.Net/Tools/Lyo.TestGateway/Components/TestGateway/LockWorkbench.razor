@using System.Diagnostics
@using Lyo.Lock.Abstractions
@using Lyo.Metrics
@using LockConstants = Lyo.Lock.Constants
@implements IAsyncDisposable
@inject ILockService LockService
@inject IMetrics Metrics
@inherits LyoWorkbenchBase

<MudTabs Rounded="true" KeepPanelsAlive="true" ApplyEffectsToContainer="true">
    <MudTabPanel Text="Lock Service" Icon="@Icons.Material.Filled.Lock">
        <MudPaper Class="pa-4">
            <MudStack Spacing="3">
                <div>
                    <MudText Typo="Typo.h5">Local Lock Workbench</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Exercise `Lyo.Lock` from the gateway by manually holding a key, forcing timed contention, and comparing locked vs unlocked worker bursts.
                    </MudText>
                </div>

                <MudGrid>
                    <MudItem xs="12" md="5">
                        <MudStack Spacing="3">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.h6">Configuration</MudText>
                                    <MudTextField T="string" Label="Lock key" @bind-Value="_lockKey"/>
                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int" Label="Workers" Min="1" Max="20" @bind-Value="_workerCount"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int" Label="Hold ms" Min="10" Max="10000" @bind-Value="_holdMilliseconds"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudNumericField T="int" Label="Timeout ms" Min="10" Max="20000" @bind-Value="_timeoutMilliseconds"/>
                                        </MudItem>
                                    </MudGrid>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Locked runs should keep max concurrent work at `1`, while unlocked runs will usually overlap.
                                    </MudText>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4" Outlined="true">
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.h6">Manual Lock Handle</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Hold the lock yourself, then verify a competing acquire times out against the same key.
                                    </MudText>
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                                        <MudButton Variant="Variant.Filled" OnClick="AcquireHeldLockAsync" Disabled="@(_busy || _heldLock != null)">Acquire</MudButton>
                                        <MudButton Variant="Variant.Outlined" OnClick="TryCompetingAcquireAsync" Disabled="@(_busy || _heldLock == null)">Competing Acquire
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ReleaseHeldLockAsync" Disabled="@(_busy || _heldLock == null)">Release
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4" Outlined="true">
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.h6">Burst Demo</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Launch several workers at once to show how the lock serializes access to the critical section.
                                    </MudText>
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunLockedDemoAsync" Disabled="@(_busy || _heldLock != null)">Run With
                                            Lock
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="RunUnlockedDemoAsync" Disabled="@_busy">Run Without Lock</MudButton>
                                        <MudButton Variant="Variant.Text" OnClick="RefreshMetricsAsync" Disabled="@_busy">Refresh Metrics</MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearEvents">Clear Events</MudButton>
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="7">
                        <MudStack Spacing="3">
                            <MudPaper Class="pa-4" Outlined="true">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                                        <LyoChip Spec="@LyoChips.FromBool(_heldLock != null, "Handle Held", "No Handle Held", Color.Success, Color.Default)"/>
                                        <LyoChip Spec="@LyoChips.FromBool(_busy, "Busy", "Idle", Color.Warning, Color.Success)"/>
                                        <LyoChip Spec="@LyoChips.FromBool(MetricsStore != null, "Metrics Enabled", "Metrics Unavailable", Color.Success, Color.Warning)"/>
                                    </MudStack>

                                    <LyoWorkbenchStatus Message="@StatusMessage" Severity="@StatusSeverity"/>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Latest Run</MudText>

                                @if (_lastRun == null) {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Run one of the burst demos to inspect how much concurrency reached the critical section.
                                    </MudText>
                                }
                                else {
                                    <MudGrid>
                                        <MudItem xs="6" sm="3">
                                            <MudPaper Class="pa-3" Outlined="true">
                                                <MudText Typo="Typo.subtitle2">Mode</MudText>
                                                <MudText Typo="Typo.h6">@(_lastRun.UsedLock ? "Locked" : "Unlocked")</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudPaper Class="pa-3" Outlined="true">
                                                <MudText Typo="Typo.subtitle2">Completed</MudText>
                                                <MudText Typo="Typo.h6">@_lastRun.Completed / @_lastRun.WorkerCount</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudPaper Class="pa-3" Outlined="true">
                                                <MudText Typo="Typo.subtitle2">Timeouts</MudText>
                                                <MudText Typo="Typo.h6">@_lastRun.TimedOut</MudText>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="6" sm="3">
                                            <MudPaper Class="pa-3" Outlined="true">
                                                <MudText Typo="Typo.subtitle2">Max Concurrent</MudText>
                                                <MudText Typo="Typo.h6">@_lastRun.MaxConcurrent</MudText>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>

                                    <MudSimpleTable Dense="true" Class="mt-3">
                                        <tbody>
                                        <tr>
                                            <td><strong>Started</strong></td>
                                            <td>@_lastRun.StartedAt.ToString("u")</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Elapsed</strong></td>
                                            <td>@_lastRun.Elapsed.TotalMilliseconds.ToString("0") ms</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Summary</strong></td>
                                            <td>@_lastRun.Summary</td>
                                        </tr>
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            </MudPaper>

                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Lock Metrics For Current Key</MudText>

                                @if (MetricsStore == null) {
                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        The current `IMetrics` implementation is not `MetricsService`, so live lock metrics are not available here.
                                    </MudAlert>
                                }
                                else {
                                    <MudSimpleTable Dense="true">
                                        <tbody>
                                        <tr>
                                            <td><strong>Key</strong></td>
                                            <td>@_lockKey</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Acquire Success</strong></td>
                                            <td>@_acquireSuccess</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Acquire Failure</strong></td>
                                            <td>@_acquireFailure</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Acquire Duration Samples</strong></td>
                                            <td>@_acquireDurationCount (@_acquireDurationAverageMs.ToString("0.##") ms avg)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Release Duration Samples</strong></td>
                                            <td>@_releaseDurationCount (@_releaseDurationAverageMs.ToString("0.##") ms avg)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Execute Duration Samples</strong></td>
                                            <td>@_executeDurationCount (@_executeDurationAverageMs.ToString("0.##") ms avg)</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Last Refresh</strong></td>
                                            <td>@(_lastMetricsRefresh == default ? "(not loaded)" : _lastMetricsRefresh.ToString("u"))</td>
                                        </tr>
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            </MudPaper>

                            <MudPaper Class="pa-4" Outlined="true">
                                <MudText Typo="Typo.h6" Class="mb-3">Recent Events</MudText>

                                @if (VisibleEvents.Count == 0) {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        Acquire a handle or run a demo to populate the event log.
                                    </MudText>
                                }
                                else {
                                    <LyoResponsiveTable>
                                        <TableContent>
                                            <MudSimpleTable Dense="true" Hover="true">
                                                <thead>
                                                <tr>
                                                    <th>Timestamp</th>
                                                    <th>Stage</th>
                                                    <th>Details</th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                @foreach (var entry in VisibleEvents) {
                                                    <tr>
                                                        <td>@entry.Timestamp.ToString("HH:mm:ss.fff")</td>
                                                        <td>@entry.Stage</td>
                                                        <td style="white-space: pre-wrap; word-break: break-word;">@entry.Message</td>
                                                    </tr>
                                                }
                                                </tbody>
                                            </MudSimpleTable>
                                        </TableContent>
                                        <CardContent>
                                            @foreach (var entry in VisibleEvents) {
                                                <LyoRecordCard Title="@entry.Stage" Subtitle="@entry.Timestamp.ToString("HH:mm:ss.fff")">
                                                    <LyoRecordField Label="Details">
                                                        <div style="white-space: pre-wrap; word-break: break-word;">@entry.Message</div>
                                                    </LyoRecordField>
                                                </LyoRecordCard>
                                            }
                                        </CardContent>
                                    </LyoResponsiveTable>
                                }
                            </MudPaper>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudStack>
        </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="Semaphore" Icon="@Icons.Material.Filled.Traffic">
        <SemaphoreWorkbench/>
    </MudTabPanel>
</MudTabs>

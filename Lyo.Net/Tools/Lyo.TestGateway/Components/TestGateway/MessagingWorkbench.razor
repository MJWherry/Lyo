@using Lyo.Email.Web.Components
@using Lyo.Sms.Web.Components
@inject IApiClient ApiClient

<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <div>
            <MudText Typo="Typo.h5">Messaging</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Email and SMS workbenches are now hosted from reusable component libraries.
            </MudText>
        </div>

        <MudTabs Rounded="true" Elevation="0" Outlined="true">
            <MudTabPanel Text="Email">
                <div class="mt-3">
                    <EmailWorkbench/>
                </div>
            </MudTabPanel>
            <MudTabPanel Text="SMS / MMS">
                <div class="mt-3">
                    <MudStack Spacing="4">
                        <SmsWorkbench/>
                        <div>
                            <MudText Typo="Typo.h6" Class="mb-2">SMS message log</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                                Messages stored in the Twilio SMS Postgres log.
                            </MudText>
                            <TwilioSmsLogGrid ApiClient="ApiClient"/>
                        </div>
                    </MudStack>
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudPaper>

@using Lyo.Web.Components.DataGrid
@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@using Lyo.Web.Components.Models
@using Constants = Lyo.TestGateway.Models.Constants
@inject IApiClient ApiClient

<LyoDataGridProjected ApiClient="ApiClient"
                      GridKey="EndatoPsAddressGrid"
                      Route="@Constants.EndatoPs.Address"
                      KeySelector="@GetKey"
                      FilterPropertyDefinitions="@_propertyDefinitions">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <Columns>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 140px;" CellStyle="white-space: nowrap;" Identifier="true"/>
        <LyoProjectedColumn Field="EndatoPersonId" Title="Person ID"/>
        <LyoProjectedColumn Field="FullAddress" Title="Full Address" QuickSearchPropertyName="FullAddress"/>
        <LyoProjectedColumn Field="City" Title="City" QuickSearchPropertyName="City"/>
        <LyoProjectedColumn Field="State" Title="State"/>
        <LyoProjectedColumn Field="Zipcode" Title="Zip"/>
        <LyoProjectedColumn Field="IsDeliverable" Title="Deliverable" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="OrderNumber" Title="Order" HiddenByDefault="true"/>
    </Columns>
</LyoDataGridProjected>

@code {
    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("FullAddress"), new("City"), new("State"), new("Zipcode")];

    private static object[] GetKey(object? item)
    {
        if (item == null)
            return [];

        var id = ProjectedValueHelper.GetValue(item, "Id");
        return id != null ? [id] : [];
    }

}

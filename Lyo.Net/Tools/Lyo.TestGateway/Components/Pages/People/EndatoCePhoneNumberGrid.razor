@using Lyo.Web.Components.DataGrid
@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@using Lyo.Web.Components.Models
@using Constants = Lyo.TestGateway.Models.Constants
@inject IApiClient ApiClient

<LyoDataGridProjected ApiClient="ApiClient"
                      GridKey="EndatoCePhoneNumberGrid"
                      Route="@Constants.EndatoCe.PhoneNumber"
                      KeySelector="@(i => ProjectedGridKeys.RawId(i))"
                      FilterPropertyDefinitions="@_propertyDefinitions">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <Columns>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 140px;" CellStyle="white-space: nowrap;" Identifier="true"/>
        <LyoProjectedColumn Field="EndatoCePersonId" Title="Person ID"/>
        <LyoProjectedColumn Field="Number" Title="Number" QuickSearchPropertyName="Number"/>
        <LyoProjectedColumn Field="Type" Title="Type"/>
        <LyoProjectedColumn Field="IsConnected" Title="Connected"/>
    </Columns>
</LyoDataGridProjected>

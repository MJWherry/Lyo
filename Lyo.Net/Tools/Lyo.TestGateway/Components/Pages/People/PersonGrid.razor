@using Lyo.Api.Models.Common.Response
@using Lyo.Query.Models.Common.Request
@using Lyo.Web.Components.DataGrid
@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@using Lyo.Web.Components.Models
@using Constants = Lyo.TestGateway.Models.Constants
@inject IApiClient ApiClient
@inject IDialogService DialogService

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="PersonGrid"
                      Route="@Constants.Person.Route"
                      KeySelector="@(GetKey)"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      RowMenuControls="@GetRowMenuControls()">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <Columns>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false"
                        HeaderStyle="@LyoDataGridColumnStyles.QuickActionsHeaderStyle"
                        CellStyle="@LyoDataGridColumnStyles.QuickActionsCellStyle">
            <CellTemplate Context="cell">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" title="Open person"
                               OnClick="@(() => OpenPerson(cell.Item))"/>
            </CellTemplate>
        </TemplateColumn>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 140px;" CellStyle="white-space: nowrap;" Identifier="true"/>
        <LyoProjectedColumn Field="FirstName" Title="Firstname" QuickSearchPropertyName="Firstname"/>
        <LyoProjectedColumn Field="MiddleName" Title="Middlename"/>
        <LyoProjectedColumn Field="LastName" Title="Lastname" QuickSearchPropertyName="Lastname"/>
        <LyoProjectedColumn Field="DateOfBirth" Title="DoB"/>
        <LyoProjectedColumn Field="ContactAddresses.Count" Title="Addresses"/>
        <LyoProjectedColumn Field="ContactEmailAddresses.Count" Title="Email Addresses"/>
        <LyoProjectedColumn Field="ContactPhoneNumbers.Count" Title="Phone Numbers"/>
        <LyoProjectedColumn Field="SourceEntityType" Title="Source"/>
    </Columns>
</LyoDataGridProjected>

@code {
    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("FirstName"), FilterPropertyDefinition.FromDatabase("LastName", "last_name", "person", "people")];

    private LyoDataGridProjected? _dataGrid;

    private static readonly string[] PersonIncludes = ["ContactAddresses.Address", "ContactPhoneNumbers.PhoneNumber", "ContactEmailAddresses.EmailAddress"];

    private static object[] GetKey(object? item)
    {
        if (item == null)
            return [];

        var id = ProjectedValueHelper.GetValue(item, "Id");
        return id != null ? [id] : [];
    }

    private RenderFragment<object?> GetRowMenuControls()
        => person => @<MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenPerson(person))">Open</MudMenuItem>;

    private async Task OpenPerson(object? person)
    {
        var personRes = await LoadPerson(person);
        if (personRes == null)
            return;

        var parameters = new DialogParameters<PersonView> { { d => d.Person, personRes } };
        var dialog = await DialogService.ShowAsync<PersonView>(personRes.FullName, parameters, LyoDialogPresets.Large);
        var result = await dialog.Result;
        if (result is { Canceled: false } && _dataGrid is not null)
            await _dataGrid.RefreshData();
    }

    private async Task<PersonRes?> LoadPerson(object? person)
    {
        if (person == null)
            return null;

        var id = ProjectedValueHelper.GetValue(person, "Id");
        if (id == null)
            return null;

        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<PersonRes>>(
            $"{Constants.Person.Route}/QueryConcrete",
            new() { Keys = [[id]], Amount = 1, Include = [..PersonIncludes] });
        return res?.Items?.FirstOrDefault() ?? await ApiClient.GetAsAsync<PersonRes>($"{Constants.Person.Route}/{id}");
    }

}

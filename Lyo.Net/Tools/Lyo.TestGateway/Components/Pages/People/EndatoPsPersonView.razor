<LyoDialog DebugData="@Person">
    <TitleContent>
        <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(Person.FullName) ? "Endato person" : Person.FullName)</MudText>
    </TitleContent>
    <TitleChips>
        @if (PersonViewHelpers.Age(Person.DateOfBirth) is { } age) {
            <LyoChip Variant="Variant.Outlined" Label="@($"Age {age}")"/>
        }
        <LyoChip Variant="Variant.Outlined" Label="@($"{Person.Addresses.Count} addresses")"/>
        <LyoChip Variant="Variant.Outlined" Label="@($"{Person.PhoneNumbers.Count} phones")"/>
        <LyoChip Variant="Variant.Outlined" Label="@($"{Person.EmailAddresses.Count} emails")"/>
    </TitleChips>
    <ChildContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Overview">
                <div class="pa-2">
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true" Dense="true">
                        <MudExpansionPanel Text="Name" Expanded="true">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="2">
                                    <MudTextField T="string" Label="Prefix" Value="@PersonViewHelpers.Field(Person.Prefix)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField T="string" Label="First Name" Value="@PersonViewHelpers.Field(Person.FirstName)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="2">
                                    <MudTextField T="string" Label="Middle Name" Value="@PersonViewHelpers.Field(Person.MiddleName)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField T="string" Label="Last Name" Value="@PersonViewHelpers.Field(Person.LastName)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="2">
                                    <MudTextField T="string" Label="Suffix" Value="@PersonViewHelpers.Field(Person.Suffix)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="Info">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField T="string" Label="DoB" Value="@PersonViewHelpers.FormatDate(Person.DateOfBirth)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField T="string" Label="Age" Value="@PersonViewHelpers.AgeLabel(Person.DateOfBirth)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="Metadata">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="6">
                                    <LyoIdField Label="ID" Value="@Person.Id"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="6">
                                    <LyoIdField Label="Query ID" Value="@Person.QueryId"/>
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Addresses ({Person.Addresses.Count})")">
                <div class="pa-2">
                    @if (Person.Addresses.Count == 0) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No addresses</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @foreach (var address in Person.Addresses.OrderBy(a => a.OrderNumber)) {
                                <LyoExpandableCard>
                                    <Summary>
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="ID" Value="@address.Id"/>
                                        </MudItem>
                                        <MudItem xs="12" md="9">
                                            <MudTextField T="string" Label="Address" Value="@PersonViewHelpers.Field(address.FullAddress)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                    </Summary>
                                    <ChildContent>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="City" Value="@PersonViewHelpers.Field(address.City)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="3" md="2">
                                            <MudTextField T="string" Label="State" Value="@PersonViewHelpers.Field(address.State)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="3" md="2">
                                            <MudTextField T="string" Label="ZIP" Value="@PersonViewHelpers.Field(address.Zipcode)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="ZIP+4" Value="@PersonViewHelpers.Field(address.Zipcode4)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="County" Value="@PersonViewHelpers.Field(address.County)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="Unit" Value="@PersonViewHelpers.Field(address.Unit)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="Unit Type" Value="@PersonViewHelpers.Field(address.UnitType)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="House Number" Value="@PersonViewHelpers.Field(address.HouseNumber)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Street Name" Value="@PersonViewHelpers.Field(address.StreetName)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="Street Type" Value="@PersonViewHelpers.Field(address.StreetType)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Coordinates" Value="@PersonViewHelpers.FormatCoordinates(address.Coordinates)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Address Hash" Value="@PersonViewHelpers.Field(address.AddressHash)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Reported" Value="@PersonViewHelpers.FormatDateRange(address.FirstReportedDate, address.LastReportedDate)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Public First Seen" Value="@PersonViewHelpers.FormatDate(address.PublicFirstSeenDate)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="Person ID" Value="@address.EndatoPersonId"/>
                                        </MudItem>
                                        <MudItem xs="12" Class="d-flex flex-wrap gap-1 align-center">
                                            @if (address.IsDeliverable) {
                                                <LyoChip Variant="Variant.Outlined" Color="Color.Success" Label="Deliverable"/>
                                            }
                                            @if (address.IsPublic) {
                                                <LyoChip Variant="Variant.Outlined" Label="Public"/>
                                            }
                                            @if (address.IsMergedAddress) {
                                                <LyoChip Variant="Variant.Outlined" Label="Merged"/>
                                            }
                                        </MudItem>
                                    </ChildContent>
                                </LyoExpandableCard>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Phones ({Person.PhoneNumbers.Count})")">
                <div class="pa-2">
                    @if (Person.PhoneNumbers.Count == 0) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No phone numbers</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @foreach (var phone in Person.PhoneNumbers.OrderBy(p => p.OrderNumber)) {
                                <LyoExpandableCard>
                                    <Summary>
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="ID" Value="@phone.Id"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="5">
                                            <MudTextField T="string" Label="Number" Value="@PersonViewHelpers.FormatPhone(phone.Number)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudSelect T="string" Label="Type" Value="@phone.Type" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                @foreach (var type in PhoneTypes) {
                                                    <MudSelectItem Value="@type">@type</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    </Summary>
                                    <ChildContent>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Company" Value="@PersonViewHelpers.Field(phone.Company)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Location" Value="@PersonViewHelpers.Field(phone.Location)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Reported" Value="@PersonViewHelpers.FormatDateRange(phone.FirstReportedDate, phone.LastReportedDate)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Coordinates" Value="@PersonViewHelpers.FormatCoordinates(phone.Coordinates)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="Person ID" Value="@phone.EndatoPersonId"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="6" Class="d-flex flex-wrap gap-1 align-end">
                                            <LyoChip Spec="@LyoChips.FromBool(phone.IsConnected, "Connected", "Disconnected", Color.Success, Color.Default)" Variant="Variant.Outlined"/>
                                            @if (phone.IsPublic) {
                                                <LyoChip Variant="Variant.Outlined" Label="Public"/>
                                            }
                                        </MudItem>
                                    </ChildContent>
                                </LyoExpandableCard>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Emails ({Person.EmailAddresses.Count})")">
                <div class="pa-2">
                    @if (Person.EmailAddresses.Count == 0) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No email addresses</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @foreach (var email in Person.EmailAddresses.OrderBy(e => e.OrderNumber)) {
                                <LyoExpandableCard>
                                    <Summary>
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="ID" Value="@email.Id"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="9">
                                            <MudTextField T="string" Label="Email" Value="@PersonViewHelpers.Field(email.Address)" Placeholder="@PersonViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                    </Summary>
                                    <ChildContent>
                                        <MudItem xs="12" sm="6" md="4">
                                            <LyoIdField Label="Person ID" Value="@email.EndatoPersonId"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="8" Class="d-flex flex-wrap gap-1 align-end">
                                            @if (email.IsPremium) {
                                                <LyoChip Variant="Variant.Outlined" Color="Color.Info" Label="Premium"/>
                                            }
                                            @if (email.NonBusiness) {
                                                <LyoChip Variant="Variant.Outlined" Label="Non-business"/>
                                            }
                                        </MudItem>
                                    </ChildContent>
                                </LyoExpandableCard>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
    </ChildContent>
</LyoDialog>

@code {

    [Parameter]
    [EditorRequired]
    public EndatoPsPersonRes Person { get; set; } = null!;

    private IReadOnlyList<string> PhoneTypes => PersonViewHelpers.PhoneTypeOptions(null, Person.PhoneNumbers.Select(p => p.Type));

}

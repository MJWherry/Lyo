@using Lyo.Web.Components.DataGrid
@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@using Lyo.Web.Components.Models
@using Constants = Lyo.Gateway.Models.Constants
@inject IApiClient ApiClient

<LyoDataGridProjected ApiClient="ApiClient"
                      GridKey="EndatoCeAddressGrid"
                      Route="@Constants.EndatoCe.Address"
                      KeySelector="@GetKey"
                      FilterPropertyDefinitions="@_propertyDefinitions">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <Columns>
        <LyoProjectedColumn Field="Id" Title="ID"/>
        <LyoProjectedColumn Field="EndatoCePersonId" Title="Person ID"/>
        <LyoProjectedColumn Field="Street" Title="Street" QuickSearchPropertyName="Street"/>
        <LyoProjectedColumn Field="Unit" Title="Unit" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="City" Title="City" QuickSearchPropertyName="City"/>
        <LyoProjectedColumn Field="State" Title="State"/>
        <LyoProjectedColumn Field="Zipcode" Title="Zip"/>
    </Columns>
</LyoDataGridProjected>

@code {
    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("Street"), new("City"), new("State"), new("Zipcode")];

    private static object[] GetKey(object? item)
    {
        if (item == null)
            return [];

        var id = ProjectedValueHelper.GetValue(item, "Id");
        return id != null ? [id] : [];
    }
}

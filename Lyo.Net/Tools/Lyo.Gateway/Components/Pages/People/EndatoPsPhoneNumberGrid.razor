@using Lyo.Web.Components.DataGrid
@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@using Lyo.Web.Components.Models
@using Constants = Lyo.Gateway.Models.Constants
@inject IApiClient ApiClient

<LyoDataGridProjected ApiClient="ApiClient"
                      GridKey="EndatoPsPhoneNumberGrid"
                      Route="@Constants.EndatoPs.PhoneNumber"
                      KeySelector="@GetKey"
                      FilterPropertyDefinitions="@_propertyDefinitions">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <Columns>
        <LyoProjectedColumn Field="Id" Title="ID"/>
        <LyoProjectedColumn Field="EndatoPersonId" Title="Person ID"/>
        <LyoProjectedColumn Field="Number" Title="Number" QuickSearchPropertyName="Number"/>
        <LyoProjectedColumn Field="Type" Title="Type"/>
        <LyoProjectedColumn Field="IsConnected" Title="Connected"/>
        <LyoProjectedColumn Field="Company" Title="Company" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="Location" Title="Location" HiddenByDefault="true"/>
    </Columns>
</LyoDataGridProjected>

@code {
    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("Number"), new("Type")];

    private static object[] GetKey(object? item)
    {
        if (item == null)
            return [];

        var id = ProjectedValueHelper.GetValue(item, "Id");
        return id != null ? [id] : [];
    }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "ServiceName": "Lyo.TestApi",
    "Protocol": "grpc",
    "MetricExportIntervalMs": 1000
  },
  "AwsKeyStore": {
    "AccessKeyId": null,
    "SecretAccessKey": null,
    "Profile": null,
    "Region": "us-east-2",
    "SecretNamePrefix": null
  },
  "S3FileStorageOptions": {
    "BucketName": null,
    "Region": "us-east-2",
    "AccessKeyId": null,
    "SecretAccessKey": null,
    "Profile": null,
    "EnableMetrics": true,
    "HealthCheckMode": "Lightweight"
  },
  "PostgresFileMetadataStore": {
    "ConnectionString": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=replace-me",
    "EnableAutoMigrations": false
  },
  "QueryOptions": {
    "CacheQueryResultsAsUtf8Payload": true,
    "EnableSplitQueries": true
  },
  "JobScheduler": {
    "PollingIntervalSeconds": 30,
    "JobApiBaseUrl": "http://localhost:5251"
  },
  "JobMqOptions": {
    "WorkerTypes": [
      "example"
    ]
  },
  "CacheOptions": {
    "Enabled": true,
    "DefaultExpiration": "00:3:00",
    "QueryCacheTagGranularity": "Broad",
    "EnableMetrics": false,
    "Payload": {
      "AutoCompress": true,
      "AutoCompressMinSizeBytes": 4096
    }
  },
  "CompressionOptions": {
    "Policy": {
      "BuiltInDefaultsEnabled": true
    }
  },
  "ApiClient": {
    "AcceptEncodings": [
      "gzip",
      "deflate",
      "br"
    ],
    "EnableAutoResponseDecompression": true,
    "RequestCompression": "Brotli",
    "RequestCompressionMinBytes": 1024
  },
  "LyoOidcBff": {
    "AllowedReturnOrigins": [
      "http://localhost:5138",
      "https://localhost:5138",
      "https://localhost:7116",
      "http://localhost:7116"
    ],
    "DefaultReturnUrl": "/",
    "HandoffCodeTtl": "00:00:30"
  },
  "WebRenderOptions": {
    "EnableMetrics": true
  }
}

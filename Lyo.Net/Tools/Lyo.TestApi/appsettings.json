{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AwsKeyStore": {
    "AccessKeyId": null,
    "SecretAccessKey": null,
    "Profile": null,
    "Region": "us-east-2",
    "SecretNamePrefix": null
  },
  "S3FileStorageOptions": {
    "BucketName": null,
    "Region": "us-east-2",
    "AccessKeyId": null,
    "SecretAccessKey": null,
    "Profile": null,
    "EnableMetrics": true
  },
  "PostgresFileMetadataStore": {
    "ConnectionString": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=replace-me",
    "EnableAutoMigrations": false
  },
  "QueryOptions": {
    "CacheQueryResultsAsUtf8Payload": true,
    "EnableSplitQueries": true
  },
  "JobScheduler": {
    "PollingIntervalSeconds": 30,
    "JobApiBaseUrl": "http://localhost:5251"
  },
  "CacheOptions": {
    "Enabled": true,
    "DefaultExpiration": "00:3:00",
    "QueryCacheTagGranularity": "Broad",
    "EnableMetrics": false,
    "Payload": {
      "AutoCompress": true,
      "AutoCompressMinSizeBytes": 4096
    }
  },
  "CompressionOptions": {
    "Policy": {
      "BuiltInDefaultsEnabled": true
    }
  },
  "ApiClient": {
    "AcceptEncodings": [
      "gzip",
      "deflate",
      "br"
    ],
    "EnableAutoResponseDecompression": true,
    "RequestCompression": "Brotli",
    "RequestCompressionMinBytes": 1024
  }
}

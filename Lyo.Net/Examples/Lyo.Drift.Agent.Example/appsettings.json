{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "DriftAgent": {
    "ApiBaseUrl": "http://localhost:5099",
    "InstanceKey": "drift-example",
    "CollectSystemInfo": true,
    "SystemInfo": {
      "Include": []
    },
    "SystemInfoInterval": "00:05:00",
    "PostLiveChanges": true,
    "ComputeDiffsLocally": true,
    "Watches": [
      {
        "Path": "/home/matt/Git",
        "IncludeSubdirectories": true,
        "IncludePatterns": [ "\\.json$", "\\.txt$" ],
        "ExcludePatterns": [ "(^|/)\\.git(/|$)", "(^|/)bin(/|$)", "(^|/)obj(/|$)" ],
        "EnableFileHashing": true,
        "DebounceTimerDelay": 250
      }
    ]
  }
}

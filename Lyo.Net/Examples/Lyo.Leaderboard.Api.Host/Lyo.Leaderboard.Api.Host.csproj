<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Description>Standalone ASP.NET host for Lyo.Leaderboard.Api. Prefer embedding AddLeaderboardApi / MapLeaderboardApiEndpoints in another host when composing APIs.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Scalar.AspNetCore"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Data\Json\Lyo.Json\Lyo.Json.csproj"/>
        <ProjectReference Include="..\..\Apps\Leaderboard\Lyo.Leaderboard.Api\Lyo.Leaderboard.Api.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
    </ItemGroup>
</Project>

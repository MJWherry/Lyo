<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Description>Standalone example job worker. Subscribes to job.run.example and reports lifecycle back to the Job API (typically Lyo.TestApi).</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Core\Common\Lyo.Common.Metadata\Lyo.Common.Metadata.csproj"/>
        <ProjectReference Include="..\..\Communication\MessageQueue\Lyo.MessageQueue.RabbitMq\Lyo.MessageQueue.RabbitMq.csproj"/>
        <ProjectReference Include="..\..\Core\Metrics\Lyo.Metrics\Lyo.Metrics.csproj"/>
        <ProjectReference Include="..\..\Core\Metrics\Lyo.Metrics.DependencyInjection\Lyo.Metrics.DependencyInjection.csproj"/>
        <ProjectReference Include="..\..\Apps\Api\Lyo.Api.Client\Lyo.Api.Client.csproj"/>
        <ProjectReference Include="..\..\Apps\Http\Lyo.Http.Client\Lyo.Http.Client.csproj"/>
        <ProjectReference Include="..\..\Apps\Job\Lyo.Job.Client\Lyo.Job.Client.csproj"/>
        <ProjectReference Include="..\..\Apps\Job\Lyo.Job.Worker\Lyo.Job.Worker.csproj"/>
        <ProjectReference Include="..\..\Core\Parameters\Lyo.Parameters\Lyo.Parameters.csproj"/>
    </ItemGroup>

</Project>

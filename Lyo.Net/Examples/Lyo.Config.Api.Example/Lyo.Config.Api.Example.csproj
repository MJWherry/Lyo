<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <Description>Example ASP.NET host for Lyo.Config.Api. Prefer embedding AddConfigApi / MapConfigApiEndpoints in another host when composing APIs. Not packed to NuGet.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Scalar.AspNetCore"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Data\Json\Lyo.Json\Lyo.Json.csproj"/>
        <ProjectReference Include="..\..\Apps\Config\Lyo.Config.Api\Lyo.Config.Api.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <DependentUpon>appsettings.json</DependentUpon>
        </Content>
    </ItemGroup>

</Project>

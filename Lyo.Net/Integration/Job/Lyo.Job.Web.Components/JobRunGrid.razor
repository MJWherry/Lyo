@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJsInterop Js

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="JobRunGrid"
                      Route="@_runRoute"
                      KeySelector="@GetKey"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      BeforeQuery="@ApplyQuery"
                      Features="@LyoDataGridFeatureFlags.All">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <LeftControls>
        <MudButton OnClick="@OpenCreateRunDialog"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   Variant="Variant.Outlined"
                   Color="Color.Default">
            Create Job Run
        </MudButton>
        @if (DefinitionId is { } defId) {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                     OnClose="@ClearDefinitionFilter" CloseIcon="@Icons.Material.Filled.Close">
                Definition: @(DefinitionName ?? defId.ToString()[..8])
            </MudChip>
        }
    </LeftControls>
    <Columns>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 110px;" CellStyle="white-space: nowrap;">
            <CellContent Context="item">
                @{
                    var idText = ProjectedValueHelper.GetDisplayValue(item, "Id");
                }
                <MudStack Row Spacing="0" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@Shorten(idText)</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy ID"
                                   OnClick="@(() => CopyToClipboard(idText))"/>
                </MudStack>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="JobDefinition.Name" Title="Definition"/>
        <LyoProjectedColumn Field="State" Title="State" Align="Align.Center" HeaderStyle="width: 110px;">
            <CellContent Context="item">
                @{
                    var stateText = ProjectedValueHelper.GetDisplayValue(item, "State");
                }
                @if (Enum.TryParse<JobState>(stateText, out var state)) {
                    <MudChip T="string" Size="Size.Small" Color="@JobColorHelper.ForState(state)" Icon="@JobColorHelper.StateIcon(state)">@state</MudChip>
                }
                else {
                    @stateText
                }
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Result" Title="Result" Align="Align.Center" HeaderStyle="width: 110px;">
            <CellContent Context="item">
                @{
                    var resultText = ProjectedValueHelper.GetDisplayValue(item, "Result");
                }
                @if (Enum.TryParse<JobRunResult>(resultText, out var result)) {
                    <MudChip T="string" Size="Size.Small" Color="@JobColorHelper.ForResult(result)" Icon="@JobColorHelper.ResultIcon(result)">@result</MudChip>
                }
                else {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">-</MudText>
                }
            </CellContent>
        </LyoProjectedColumn>
        <TemplateColumn T="object?" Title="Progress" Sortable="false" Hideable="true" HeaderStyle="width: 140px;">
            <CellTemplate Context="cell">
                @{
                    var percent = ProjectedValueHelper.ConvertTo<int?>(ProjectedValueHelper.GetValue(cell.Item, "ProgressPercent"));
                }
                @if (percent is int p) {
                    <MudStack Spacing="0">
                        <MudProgressLinear Color="Color.Primary" Value="@p" Class="my-1"/>
                        <MudText Typo="Typo.caption">@p% @(ProjectedValueHelper.GetDisplayValue(cell.Item, "ProgressMessage"))</MudText>
                    </MudStack>
                }
                else {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">-</MudText>
                }
            </CellTemplate>
        </TemplateColumn>
        <LyoProjectedColumn Field="ProgressPercent" Title="Progress %" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="CreatedTimestamp" Title="Created" CellStyle="white-space: nowrap;"/>
        <LyoProjectedColumn Field="StartedTimestamp" Title="Started" CellStyle="white-space: nowrap;"/>
        <LyoProjectedColumn Field="FinishedTimestamp" Title="Finished" CellStyle="white-space: nowrap;"/>
        <LyoProjectedColumn Field="RetryAttempt" Title="Retry #" Align="Align.Center" HeaderStyle="width: 80px;" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="JobRunResults.Count" Title="Results" Align="Align.Center" HeaderStyle="width: 80px;"/>
        <LyoProjectedColumn Field="JobRunLogs.Count" Title="Logs" Align="Align.Center" HeaderStyle="width: 80px;"/>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false" HeaderStyle="width: 110px;" CellStyle="white-space: nowrap;">
            <CellTemplate Context="cell">
                <MudStack Row Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" title="View details"
                                   OnClick="@(() => ViewRun(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Color="Color.Primary" title="Re-run"
                                   OnClick="@(() => RerunJob(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Color="Color.Error" title="Cancel run"
                                   OnClick="@(() => CancelRun(cell.Item))"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => ViewRun(item))">View Details</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Refresh" OnClick="@(() => RerunJob(item))">Re-Run</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Cancel" OnClick="@(() => CancelRun(item))">Cancel</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteRun(item))">Delete</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

@code {

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string BaseRoute { get; set; } = "Job";

    /// <summary>When set, the grid only shows runs of this definition and displays a removable filter chip. Supports two-way binding so the chip's close button clears the host's state.</summary>
    [Parameter]
    public Guid? DefinitionId { get; set; }

    [Parameter]
    public EventCallback<Guid?> DefinitionIdChanged { get; set; }

    /// <summary>Display name for the definition filter chip; falls back to the truncated id.</summary>
    [Parameter]
    public string? DefinitionName { get; set; }

    private string _runRoute => $"{BaseRoute.TrimEnd('/')}/Run";

    private string _definitionRoute => $"{BaseRoute.TrimEnd('/')}/Definition";

    private LyoDataGridProjected? _dataGrid;

    private Guid? _appliedDefinitionId;

    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("JobDefinition.Name", "Definition"), new("State"), new("Result")];

    protected override async Task OnParametersSetAsync()
    {
        if (_appliedDefinitionId == DefinitionId)
            return;

        _appliedDefinitionId = DefinitionId;
        if (_dataGrid != null)
            await _dataGrid.RefreshData();
    }

    private void ApplyQuery(ProjectionQueryReqBuilder q)
    {
        q.AddIncludes("JobDefinition", "JobRunLogs", "JobRunResults", "JobRunParameters", "JobSchedule", "ReRanFromJobRun");
        if (DefinitionId is { } defId)
            q.AddWhere(new ConditionClause("JobDefinitionId", ComparisonOperatorEnum.Equals, defId));
    }

    private async Task ClearDefinitionFilter()
    {
        DefinitionId = null;
        _appliedDefinitionId = null;
        if (DefinitionIdChanged.HasDelegate)
            await DefinitionIdChanged.InvokeAsync(null);

        if (_dataGrid != null)
            await _dataGrid.RefreshData();
    }

    private static object[] GetKey(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        return id != null ? [id] : [];
    }

    private static string Shorten(string id) => id.Length > 8 ? id[..8] : id;

    private async Task CopyToClipboard(string text)
    {
        await Js.SendToClipboard(text);
        Snackbar.Add("Copied to clipboard", Severity.Info);
    }

    private async Task OpenCreateRunDialog()
    {
        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<JobDefinitionRes>>($"{_definitionRoute}/QueryConcrete", new() { Amount = 200, Include = ["JobParameters"] });
        var parameters = new DialogParameters<RunJobDialog> { { d => d.JobDefinitions, res?.Items ?? [] }, { d => d.RunRoute, _runRoute } };
        var dialog = await DialogService.ShowAsync<RunJobDialog>("Create Job Run", parameters, LyoDialogPresets.Medium);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await _dataGrid!.RefreshData();
    }

    private async Task ViewRun(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (id == null)
            return;

        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<JobRunRes>>($"{_runRoute}/QueryConcrete", new() { Keys = [[id]], Amount = 1, Include = ["JobDefinition", "JobRunLogs", "JobRunResults", "JobRunParameters", "JobSchedule"] });
        var run = res?.Items?.FirstOrDefault();
        if (run == null)
            return;

        var parameters = new DialogParameters<JobRunDetailView> { { d => d.JobRun, run }, { d => d.RunRoute, _runRoute } };
        var dialog = await DialogService.ShowAsync<JobRunDetailView>("Job Run Details", parameters, LyoDialogPresets.Large);
        var r = await dialog.Result;
        if (r is { Canceled: false })
            await _dataGrid!.RefreshData();
    }

    private async Task RerunJob(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (id == null)
            return;

        try {
            await ApiClient.PostAsAsync<object>($"{_runRoute}/{id}/Rerun");
            Snackbar.Add("Re-run queued", Severity.Success);
            await _dataGrid!.RefreshData();
        }
        catch (Exception ex) {
            Snackbar.Add($"Re-run failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task CancelRun(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (id == null)
            return;

        try {
            await ApiClient.PostAsAsync<object>($"{_runRoute}/{id}/Cancel");
            Snackbar.Add("Cancel requested", Severity.Info);
            await _dataGrid!.RefreshData();
        }
        catch (Exception ex) {
            Snackbar.Add($"Cancel failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteRun(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (id == null)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync("Confirm Delete", $"Delete job run {id?.ToString()?[..8]}...?", "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try {
            await ApiClient.DeleteAsAsync<object>($"{_runRoute}/{id}");
            Snackbar.Add("Job run deleted", Severity.Success);
            await _dataGrid!.RefreshData();
        }
        catch (Exception ex) {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

}

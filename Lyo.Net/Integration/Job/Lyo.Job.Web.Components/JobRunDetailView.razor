@using Lyo.Common.Extensions
@inject ISnackbar Snackbar

<LyoDialog>
    <TitleContent>
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h6">@(JobRun?.JobDefinition?.Name ?? "Job Run")</MudText>
            @if (JobRun != null) {
                <MudChip T="string" Size="Size.Small" Color="@JobColorHelper.ForState(JobRun.State)" Icon="@JobColorHelper.StateIcon(JobRun.State)">@JobRun.State</MudChip>
                @if (JobRun.Result is { } result) {
                    <MudChip T="string" Size="Size.Small" Color="@JobColorHelper.ForResult(result)" Icon="@JobColorHelper.ResultIcon(result)">@result</MudChip>
                }
            }
        </MudStack>
    </TitleContent>
    <ExtraActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Rerun"
                   StartIcon="@Icons.Material.Filled.Refresh">Re-Run
        </MudButton>
        @if (JobRun?.State == JobState.Running) {
            <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Cancel"
                       StartIcon="@Icons.Material.Filled.Cancel">Cancel
            </MudButton>
        }
    </ExtraActions>
    <ChildContent>
        <MudTabs Elevation="0" Rounded ApplyEffectsToContainer>
            <MudTabPanel Text="Summary">
                <MudGrid Class="pa-4">
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>ID:</b> @JobRun?.Id.Truncated()</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>Definition:</b> @(JobRun?.JobDefinition?.Name ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>State:</b> @JobRun?.State</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>Result:</b> @(JobRun?.Result?.ToString() ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>Created:</b> @JobRun?.CreatedTimestamp.ToString("g")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>Started:</b> @(JobRun?.StartedTimestamp?.ToString("g") ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>Finished:</b> @(JobRun?.FinishedTimestamp?.ToString("g") ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>Retry #:</b> @JobRun?.RetryAttempt</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudText Typo="Typo.body2"><b>Trace ID:</b> @(JobRun?.TraceId ?? "-")</MudText>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2"><b>SLA:</b></MudText>
                            @if (JobRun?.SlaBreached == true) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Breached</MudChip>
                            }
                            else {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">OK</MudChip>
                            }
                        </MudStack>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2"><b>Alerts:</b></MudText>
                            @if (JobRun?.JobDefinition?.AlertOnFailure == true) {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">On Failure</MudChip>
                            }
                            else {
                                <MudText Typo="Typo.body2">-</MudText>
                            }
                        </MudStack>
                    </MudItem>
                    @if (JobRun?.ProgressPercent is int progress) {
                        <MudItem xs="12">
                            <MudText Typo="Typo.body2" Class="mb-1"><b>Progress:</b> @progress%</MudText>
                            <MudProgressLinear Color="Color.Primary" Value="@progress"/>
                            @if (!string.IsNullOrWhiteSpace(JobRun.ProgressMessage)) {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@JobRun.ProgressMessage</MudText>
                            }
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="@($"Parameters ({JobRun?.JobRunParameters?.Count ?? 0})")">
                <MudSimpleTable Dense Class="pa-2">
                    <thead>
                    <tr>
                        <th>Key</th>
                        <th>Type</th>
                        <th>Value</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in JobRun?.JobRunParameters ?? []) {
                        <tr>
                            <td>@p.Key</td>
                            <td>@p.Type</td>
                            <td>@p.Value</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            </MudTabPanel>
            <MudTabPanel Text="@($"Results ({JobRun?.JobRunResults?.Count ?? 0})")">
                <MudSimpleTable Dense Class="pa-2">
                    <thead>
                    <tr>
                        <th>Key</th>
                        <th>Type</th>
                        <th>Value</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var r in JobRun?.JobRunResults ?? []) {
                        <tr>
                            <td>@r.Key</td>
                            <td>@r.Type</td>
                            <td>@r.Value</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            </MudTabPanel>
            <MudTabPanel Text="@($"Logs ({JobRun?.JobRunLogs?.Count ?? 0})")">
                <MudStack Spacing="1" Class="pa-2" Style="max-height: 400px; overflow-y: auto;">
                    @foreach (var log in JobRun?.JobRunLogs ?? []) {
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Start">
                            <MudChip T="string" Size="Size.Small" Color="@GetLogColor(log.Level)">@log.Level</MudChip>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@log.Timestamp.ToString("HH:mm:ss")</MudText>
                            <MudText Typo="Typo.body2">@log.Message</MudText>
                        </MudStack>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </ChildContent>
</LyoDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public JobRunRes? JobRun { get; set; }

    [Parameter]
    [EditorRequired]
    public string RunRoute { get; set; } = "";

    [Inject]
    IApiClient ApiClient { get; set; } = null!;

    private async Task Rerun()
    {
        try {
            await ApiClient.PostAsAsync<object>($"{RunRoute}/{JobRun!.Id}/Rerun");
            Snackbar.Add("Re-run queued", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) {
            Snackbar.Add($"Re-run failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task Cancel()
    {
        try {
            await ApiClient.PostAsAsync<object>($"{RunRoute}/{JobRun!.Id}/Cancel");
            Snackbar.Add("Cancel requested", Severity.Info);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) {
            Snackbar.Add($"Cancel failed: {ex.Message}", Severity.Error);
        }
    }

    private static Color GetLogColor(JobLogLevel level)
        => level switch {
            JobLogLevel.Error or JobLogLevel.Critical => Color.Error,
            JobLogLevel.Warning => Color.Warning,
            JobLogLevel.Debug => Color.Default,
            var _ => Color.Info
        };

}

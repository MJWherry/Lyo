@inject ISnackbar Snackbar

<LyoDialog>
    <TitleContent>
        <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">@(JobRun?.JobDefinition?.Name ?? "Job Run")</MudText>
            @if (JobRun != null) {
                <MudChip T="string" Size="Size.Small" Color="@JobColorHelper.ForState(JobRun.State)" Icon="@JobColorHelper.StateIcon(JobRun.State)">@JobRun.State</MudChip>
                @if (JobRun.Result is { } result) {
                    <MudChip T="string" Size="Size.Small" Color="@JobColorHelper.ForResult(result)" Icon="@JobColorHelper.ResultIcon(result)">@result</MudChip>
                }
                <MudChip T="string" Size="Size.Small" Color="@(JobRun.SlaBreached ? Color.Error : Color.Success)">
                    @(JobRun.SlaBreached ? "SLA breached" : "SLA OK")
                </MudChip>
                @if (JobRun.StartedTimestamp is not null) {
                    <MudChip T="string" Size="Size.Small" Color="@JobColorHelper.ForDuration(JobRun.StartedTimestamp, JobRun.FinishedTimestamp)"
                             Icon="@(JobRun.FinishedTimestamp is null ? Icons.Material.Filled.Timer : null)">
                        @JobColorHelper.FormatDurationFromDates(JobRun.StartedTimestamp, JobRun.FinishedTimestamp)
                    </MudChip>
                }
            }
        </MudStack>
    </TitleContent>
    <ExtraActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Rerun" StartIcon="@Icons.Material.Filled.Refresh">Re-Run</MudButton>
        @if (JobRun?.State == JobState.Running) {
            <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="Cancel" StartIcon="@Icons.Material.Filled.Cancel">Cancel</MudButton>
        }
    </ExtraActions>
    <ChildContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Summary">
                <MudGrid Class="pa-1" Spacing="1">
                    <MudItem xs="12" sm="6" md="3">
                        <LyoIdField Label="ID" Value="@JobRun?.Id"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <LyoIdField Label="Definition ID" Value="@JobRun?.JobDefinitionId"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" Label="Definition" Value="@(JobRun?.JobDefinition?.Name ?? "-")" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <LyoIdField Label="Trace ID" Text="@JobRun?.TraceId"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" Label="Created" Value="@(JobRun?.CreatedTimestamp.ToString("g") ?? "-")" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" Label="Started" Value="@(JobRun?.StartedTimestamp?.ToString("g") ?? "-")" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" Label="Finished" Value="@(JobRun?.FinishedTimestamp?.ToString("g") ?? "-")" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" Label="Retry #" Value="@(JobRun?.RetryAttempt.ToString() ?? "0")" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudTextField T="string" Label="Alerts" Value="@AlertText" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    </MudItem>
                    @if (JobRun?.ProgressPercent is int progress) {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Class="mb-1">Progress @progress%</MudText>
                            <MudProgressLinear Color="Color.Primary" Value="@progress"/>
                            @if (!string.IsNullOrWhiteSpace(JobRun.ProgressMessage)) {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@JobRun.ProgressMessage</MudText>
                            }
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>
            <MudTabPanel Text="@($"Parameters ({JobRun?.JobRunParameters?.Count ?? 0})")">
                @if (JobRun?.JobRunParameters is { Count: > 0 }) {
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                        <tr>
                            <th>Key</th>
                            <th>Value</th>
                            <th>Description</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in JobRun.JobRunParameters) {
                            <tr>
                                <td>
                                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                        <span>@p.Key</span>
                                        <MudChip T="string" Size="Size.Small">@p.Type</MudChip>
                                    </MudStack>
                                </td>
                                <td><LyoTruncatedText Text="@p.Value"/></td>
                                <td><LyoTruncatedText Text="@p.Description"/></td>
                            </tr>
                        }
                        </tbody>
                    </MudSimpleTable>
                }
                else {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">No parameters</MudText>
                }
            </MudTabPanel>
            <MudTabPanel Text="@($"Results ({JobRun?.JobRunResults?.Count ?? 0})")">
                @if (JobRun?.JobRunResults is { Count: > 0 }) {
                    <MudSimpleTable Dense="true" Hover="true">
                        <thead>
                        <tr>
                            <th>Key</th>
                            <th>Value</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var r in JobRun.JobRunResults) {
                            <tr>
                                <td>
                                    <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                                        <span>@r.Key</span>
                                        <MudChip T="string" Size="Size.Small">@r.Type</MudChip>
                                    </MudStack>
                                </td>
                                <td><LyoTruncatedText Text="@r.Value"/></td>
                            </tr>
                        }
                        </tbody>
                    </MudSimpleTable>
                }
                else {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">No results</MudText>
                }
            </MudTabPanel>
            <MudTabPanel Text="@($"Logs ({JobRun?.JobRunLogs?.Count ?? 0})")">
                <MudStack Spacing="1" Style="max-height: 400px; overflow-y: auto;">
                    @foreach (var log in JobRun?.JobRunLogs ?? []) {
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Start">
                            <MudChip T="string" Size="Size.Small" Color="@JobColorHelper.ForLogLevel(log.Level)">@log.Level</MudChip>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@log.Timestamp.ToString("HH:mm:ss")</MudText>
                            <MudText Typo="Typo.body2">@log.Message</MudText>
                        </MudStack>
                    }
                </MudStack>
            </MudTabPanel>
        </MudTabs>
    </ChildContent>
</LyoDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public JobRunRes? JobRun { get; set; }

    [Parameter]
    [EditorRequired]
    public string RunRoute { get; set; } = "";

    [Inject]
    IApiClient ApiClient { get; set; } = null!;

    private string AlertText
        => JobRun?.JobDefinition?.AlertOnFailure == true ? "On failure" : "—";

    private async Task Rerun()
    {
        try {
            await ApiClient.PostAsAsync<object>($"{RunRoute}/{JobRun!.Id}/Rerun");
            Snackbar.Add("Re-run queued", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) {
            Snackbar.Add($"Re-run failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task Cancel()
    {
        try {
            await ApiClient.PostAsAsync<object>($"{RunRoute}/{JobRun!.Id}/Cancel");
            Snackbar.Add("Cancel requested", Severity.Info);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) {
            Snackbar.Add($"Cancel failed: {ex.Message}", Severity.Error);
        }
    }

}

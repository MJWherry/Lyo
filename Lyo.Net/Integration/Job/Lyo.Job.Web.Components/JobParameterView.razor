@inject ISnackbar Snackbar

<MudStack Spacing="2">
    <JobParameterTable Title="Job Parameters" Items="@_rows" ShowRequired ShowAllowMultiple ShowOptionsEditor ApiClient="ApiClient"
                       OnChanged="@(() => _dirty = true)"/>

    @if (_dirty) {
        <div>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="SaveChanges" StartIcon="@Icons.Material.Filled.Save">
                Save Parameters
            </MudButton>
        </div>
    }
</MudStack>

@code {

    [Parameter]
    public IReadOnlyList<JobParameterRes>? JobParameters { get; set; }

    [Parameter]
    public Guid JobDefinitionId { get; set; }

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string DefinitionRoute { get; set; } = "";

    private string ParameterRoute => $"{DefinitionRoute}/Parameter";

    private List<JobParameterEditRow> _rows = [];
    private bool _dirty;
    private bool _loaded;

    protected override void OnParametersSet()
    {
        if (_loaded)
            return;

        _rows = (JobParameters ?? []).Select(p => new JobParameterEditRow {
                Id = p.Id,
                Key = p.Key,
                Type = p.Type,
                Value = p.Value,
                Description = p.Description,
                Required = p.Required,
                AllowMultiple = p.AllowMultiple,
                IsEncrypted = p.EncryptedValue is { Length: > 0 },
                AllowedValues = p.AllowedValues,
                Options = p.Options
            })
            .ToList();

        _dirty = false;
        _loaded = true;
    }

    private async Task SaveChanges()
    {
        try {
            var existing = (JobParameters ?? []).ToDictionary(p => p.Id);
            foreach (var removed in existing.Values.Where(e => _rows.All(d => d.Id != e.Id)))
                await ApiClient.DeleteAsAsync<object>($"{ParameterRoute}/{removed.Id}");

            foreach (var newRow in _rows.Where(d => d.IsNew)) {
                var created = await ApiClient.PostAsAsync<JobParameterReq, CreateResult<JobParameterRes>>(
                    ParameterRoute, new() {
                        JobDefinitionId = JobDefinitionId,
                        Key = newRow.Key,
                        Type = newRow.Type,
                        Value = newRow.Value,
                        Description = newRow.Description,
                        Required = newRow.Required,
                        AllowMultiple = newRow.AllowMultiple,
                        AllowedValues = newRow.AllowedValues,
                        Options = newRow.Options
                    });

                if (created?.Data is { } data) {
                    newRow.Id = data.Id;
                    newRow.IsNew = false;
                    newRow.Options = data.Options;
                    newRow.AllowedValues = data.AllowedValues;
                    newRow.Value = data.Value;
                }
            }

            foreach (var existingRow in _rows.Where(d => !d.IsNew && d.Id.HasValue)) {
                JobParameterReq data = new() {
                    JobDefinitionId = JobDefinitionId,
                    Key = existingRow.Key,
                    Type = existingRow.Type,
                    Value = existingRow.Value,
                    Description = existingRow.Description,
                    Required = existingRow.Required,
                    AllowMultiple = existingRow.AllowMultiple,
                    AllowedValues = existingRow.AllowedValues,
                    Options = existingRow.Options
                };

                await ApiClient.PostAsAsync<UpdateRequest<JobParameterReq>, UpdateResult<JobParameterRes>>($"{ParameterRoute}/Update", new(data, existingRow.Id!.Value));
            }

            Snackbar.Add("Parameters saved", Severity.Success);
            _dirty = false;
        }
        catch (Exception ex) {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }

}

@using Lyo.Query.Models.Parameters
@using Lyo.Web.Components.ChipInput
@using Lyo.Web.Components.ParamOptions

<MudStack Spacing="2">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddRow">
            Add Parameter
        </MudButton>
    </MudStack>

    @if (Items.Count == 0) {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">No parameters defined</MudText>

        return;
    }

    <MudSimpleTable Dense Hover Elevation="0" Style="table-layout: fixed; width: 100%;">
        <thead>
        <tr>
            @if (HasDetails) {
                <th style="width: 40px;"></th>
            }
            <th style="width: 18%;">Key</th>
            <th style="width: 110px;">Type</th>
            <th>Value</th>
            <th style="width: 22%;">Description</th>
            <th style="width: 56px;"></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Items) {
            var expanded = IsExpanded(row);
            <tr>
                @if (HasDetails) {
                    <td style="text-align: center;">
                        <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                       Size="Size.Small"
                                       title="@(expanded ? "Collapse details" : "Expand details")"
                                       OnClick="@(() => ToggleExpanded(row))"/>
                    </td>
                }
                <td>
                    <MudTextField T="string" Value="@row.Key" ValueChanged="@(v => Set(() => row.Key = v))"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </td>
                <td>
                    <MudSelect T="JobParameterType" Value="@row.Type" ValueChanged="@(v => Set(() => row.Type = v))"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        @foreach (var t in Enum.GetValues<JobParameterType>()) {
                            <MudSelectItem Value="t">@t</MudSelectItem>
                        }
                    </MudSelect>
                </td>
                <td>
                    @if (row.IsEncrypted) {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Encrypted</MudChip>
                    }
                    else if (HasPicker(row) && ApiClient is not null) {
                        <LyoParameterOptionsSelect ApiClient="ApiClient"
                                                   OptionsJson="@row.Options"
                                                   AllowedValues="@row.AllowedValues"
                                                   SiblingValues="SiblingMap"
                                                   AllowMultiple="@row.AllowMultiple"
                                                   ListKind="@ToListKind(row.Type)"
                                                   Label="@row.Key"
                                                   Value="@row.Value"
                                                   ValueChanged="@(v => Set(() => row.Value = v))"/>
                    }
                    else {
                        <JobParameterValueInput Type="@row.Type"
                                                Value="@row.Value"
                                                ValueChanged="@(v => Set(() => row.Value = v))"
                                                AllowMultiple="@row.AllowMultiple"/>
                    }
                </td>
                <td>
                    <MudTextField T="string" Value="@row.Description" ValueChanged="@(v => Set(() => row.Description = v))"
                                  Variant="Variant.Outlined" Margin="Margin.Dense"/>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                    @if (row.IsNew) {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">New</MudChip>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Delete parameter"
                                   OnClick="@(() => DeleteRow(row))"/>
                </td>
            </tr>
            @if (HasDetails && expanded) {
                <tr>
                    <td colspan="@ColSpan">
                        <MudPaper Outlined="true" Class="pa-3" Elevation="0">
                        <MudStack Spacing="2">
                            <MudStack Row Spacing="3" Wrap="Wrap.Wrap" AlignItems="AlignItems.Start">
                                @if (ShowRequired) {
                                    <MudCheckBox T="bool" Value="@row.Required" ValueChanged="@(v => Set(() => row.Required = v))"
                                                 Label="Required" Dense="true" Class="ma-0 mt-2"/>
                                }
                                @if (ShowAllowMultiple) {
                                    <MudCheckBox T="bool" Value="@row.AllowMultiple" ValueChanged="@(v => Set(() => row.AllowMultiple = v))"
                                                 Label="Allow multiple" Dense="true" Class="ma-0 mt-2"/>
                                }
                                @if (ShowEnabled) {
                                    <MudCheckBox T="bool" Value="@row.Enabled" ValueChanged="@(v => Set(() => row.Enabled = v))"
                                                 Label="Enabled" Dense="true" Class="ma-0 mt-2"/>
                                }
                                @if (ShowOptionsEditor) {
                                    <MudStack Spacing="0" Class="flex-grow-1" Style="min-width: 220px;">
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">Allowed values</MudText>
                                        <LyoChipInput Values="@ParameterListJson.Parse(row.AllowedValues)"
                                                      ValuesChanged="@(v => Set(() => row.AllowedValues = ParameterListJson.Serialize(v, ToListKind(row.Type))))"
                                                      Placeholder="Type and press Enter"/>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                                            Optional server validation list; also used as a simple select when Options is empty
                                        </MudText>
                                    </MudStack>
                                }
                            </MudStack>
                            @if (ShowOptionsEditor) {
                                <MudSelect T="ParameterOptionsKind?"
                                           Value="@ParameterOptionsJson.TryGetKind(row.Options)"
                                           ValueChanged="@(v => SetOptionsKind(row, v))"
                                           Label="Options kind"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           Dense="true"
                                           Clearable="true"
                                           HelperText="Leave empty for no picker (typed Value input only)"
                                           Style="max-width: 280px;">
                                    <MudSelectItem T="ParameterOptionsKind?" Value="ParameterOptionsKind.Static">Static</MudSelectItem>
                                    <MudSelectItem T="ParameterOptionsKind?" Value="ParameterOptionsKind.Query">Root query</MudSelectItem>
                                </MudSelect>
                                @if (ParameterOptionsJson.TryGetKind(row.Options) is not null) {
                                    <LyoParameterOptionsEditor ShowKindSelect="false"
                                                               OptionsJson="@row.Options"
                                                               OptionsJsonChanged="@(v => Set(() => row.Options = v))"/>
                                }
                            }
                        </MudStack>
                        </MudPaper>
                    </td>
                </tr>
            }
        }
        </tbody>
    </MudSimpleTable>
</MudStack>

@code {

    /// <summary>Heading shown above the table (e.g. "Job Parameters", "Schedule Parameters").</summary>
    [Parameter]
    public string Title { get; set; } = "Parameters";

    /// <summary>Rows edited in place; the parent owns the list and persists it with its own Save action.</summary>
    [Parameter]
    [EditorRequired]
    public List<JobParameterEditRow> Items { get; set; } = [];

    /// <summary>
    /// Show Required in the expansion panel (definition parameters). Marks the param as required at run time only;
    /// the definition Value/default picker is never validated as required here.
    /// </summary>
    [Parameter]
    public bool ShowRequired { get; set; }

    /// <summary>Show Allow Multiple in the expansion panel (definition parameters).</summary>
    [Parameter]
    public bool ShowAllowMultiple { get; set; }

    /// <summary>Show Enabled in the expansion panel (schedule parameters).</summary>
    [Parameter]
    public bool ShowEnabled { get; set; }

    /// <summary>Show Options kind / AllowedValues / options details in the expansion panel (definition parameters).</summary>
    [Parameter]
    public bool ShowOptionsEditor { get; set; }

    /// <summary>Required when rendering Options-backed Value selects (definition editor).</summary>
    [Parameter]
    public IApiClient? ApiClient { get; set; }

    /// <summary>Raised after any edit, add, or delete so the parent can mark itself dirty.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private readonly HashSet<JobParameterEditRow> _expanded = [];

    private bool HasDetails => ShowRequired || ShowAllowMultiple || ShowEnabled || ShowOptionsEditor;

    private int ColSpan => (HasDetails ? 1 : 0) + 5;

    private Dictionary<string, string?> SiblingMap
        => Items.ToDictionary(r => r.Key, r => r.Value, StringComparer.OrdinalIgnoreCase);

    private static bool HasPicker(JobParameterEditRow row)
        => !string.IsNullOrWhiteSpace(row.Options) || !string.IsNullOrWhiteSpace(row.AllowedValues);

    private static ParameterListJsonKind ToListKind(JobParameterType type)
        => type switch {
            JobParameterType.Int or JobParameterType.Long or JobParameterType.Decimal => ParameterListJsonKind.Number,
            JobParameterType.Bool => ParameterListJsonKind.Bool,
            var _ => ParameterListJsonKind.String
        };

    private bool IsExpanded(JobParameterEditRow row) => _expanded.Contains(row);

    private void ToggleExpanded(JobParameterEditRow row)
    {
        if (!_expanded.Add(row))
            _expanded.Remove(row);
    }

    private async Task Set(Action apply)
    {
        apply();
        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private Task SetOptionsKind(JobParameterEditRow row, ParameterOptionsKind? kind)
    {
        if (ParameterOptionsJson.TryGetKind(row.Options) == kind)
            return Task.CompletedTask;

        return Set(() => row.Options = ParameterOptionsJson.CreateDefaultForKind(kind));
    }

    private async Task AddRow()
    {
        var row = new JobParameterEditRow { IsNew = true, Key = $"Param{Items.Count + 1}", Type = JobParameterType.String };
        Items.Add(row);
        if (HasDetails)
            _expanded.Add(row);
        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

    private async Task DeleteRow(JobParameterEditRow row)
    {
        Items.Remove(row);
        _expanded.Remove(row);
        if (OnChanged.HasDelegate)
            await OnChanged.InvokeAsync();
    }

}

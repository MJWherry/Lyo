@using Lyo.Common.Extensions
@inject ISnackbar Snackbar

<LyoDialog Busy="@_submitting" OnSave="Submit" SaveDisabled="@(!IsValid())" SaveText="Create Job Run" CloseText="Cancel" DebugData="@_selectedDef">
    <MudStack Spacing="2">
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="JobDefinitionRes"
                           Value="_selectedDef"
                           ValueChanged="OnDefinitionChanged"
                           Label="Job Definition"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           ToStringFunc="@(d => d?.Name ?? "")"
                           Required>
                    @foreach (var def in (JobDefinitions ?? []).Where(d => d.Enabled)) {
                        <MudSelectItem T="JobDefinitionRes" Value="def">
                            <MudText Typo="Typo.body1">@def.Name</MudText>
                            @if (!string.IsNullOrEmpty(def.Description)) {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@def.Description</MudText>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_createdBy" Label="Created By" Variant="Variant.Outlined" Margin="Margin.Dense" Required MaxLength="50"/>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center">
                <MudSwitch T="bool" @bind-Value="_allowTriggers" Label="Allow Triggers" Color="Color.Primary" Size="Size.Small"/>
            </MudItem>
        </MudGrid>

        @if (_paramModels.Any()) {
            <MudDivider/>

            <MudText Typo="Typo.subtitle1">Parameters</MudText>

            <MudGrid Spacing="2">
                @foreach (var p in _paramModels) {
                    <MudItem xs="12" md="@(p.Param.Type is JobParameterType.Json or JobParameterType.Xml ? 12 : 6)">
                        <MudStack Spacing="0">
                            @if (p.Encrypted) {
                                <MudTextField T="string" Value="@p.Value" ValueChanged="@(v => SetParamValue(p, v))" Label="@ParamLabel(p)" Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              InputType="InputType.Password" Required="@p.Param.Required"/>
                            }
                            else if (HasOptions(p.Param)) {
                                <LyoParameterOptionsSelect ApiClient="ApiClient"
                                                           OptionsJson="@p.Param.Options"
                                                           AllowedValues="@p.Param.AllowedValues"
                                                           SiblingValues="_siblingMap"
                                                           AllowMultiple="@p.Param.AllowMultiple"
                                                           ListKind="@ToListKind(p.Param.Type)"
                                                           Required="@p.Param.Required"
                                                           Label="@ParamLabel(p)"
                                                           Value="@p.Value"
                                                           ValueChanged="@(v => SetParamValue(p, v))"/>
                            }
                            else {
                                <JobParameterValueInput Type="@p.Param.Type"
                                                        Value="@p.Value"
                                                        ValueChanged="@(v => SetParamValue(p, v))"
                                                        Label="@ParamLabel(p)"
                                                        AllowMultiple="@p.Param.AllowMultiple"/>
                            }
                            <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                @if (!string.IsNullOrEmpty(p.Param.Description)) {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.Param.Description</MudText>
                                }
                                else {
                                    <span/>
                                }
                                <MudSwitch T="bool" @bind-Value="p.Encrypted" Label="Encrypt" Color="Color.Warning" Size="Size.Small"/>
                            </MudStack>
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
</LyoDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public IEnumerable<JobDefinitionRes>? JobDefinitions { get; set; }

    [Parameter]
    public JobDefinitionRes? SelectedJobDefinition { get; set; }

    [Parameter]
    [EditorRequired]
    public string RunRoute { get; set; } = "";

    [Inject]
    IApiClient ApiClient { get; set; } = null!;

    private JobDefinitionRes? _selectedDef;
    private string _createdBy = "gateway";
    private bool _allowTriggers = true;
    private bool _submitting;
    private List<ParamModel> _paramModels = [];
    private Dictionary<string, string?> _siblingMap = new(StringComparer.OrdinalIgnoreCase);

    private class ParamModel
    {
        public JobParameterRes Param { get; init; } = null!;

        public string? Value { get; set; }

        public bool Encrypted { get; set; }

        public bool IsEmpty() => Param.Type != JobParameterType.Bool && string.IsNullOrWhiteSpace(Value);
    }

    private static string ParamLabel(ParamModel p) => p.Param.Required ? $"{p.Param.Key} *" : p.Param.Key;

    private static bool HasOptions(JobParameterRes p) => !string.IsNullOrWhiteSpace(p.Options) || !string.IsNullOrWhiteSpace(p.AllowedValues);

    private static ParameterListJsonKind ToListKind(JobParameterType type)
        => type switch {
            JobParameterType.Int or JobParameterType.Long or JobParameterType.Decimal => ParameterListJsonKind.Number,
            JobParameterType.Bool => ParameterListJsonKind.Bool,
            var _ => ParameterListJsonKind.String
        };

    protected override void OnInitialized()
    {
        if (SelectedJobDefinition != null)
            OnDefinitionChanged(SelectedJobDefinition);
    }

    private void OnDefinitionChanged(JobDefinitionRes? def)
    {
        _selectedDef = def;
        _paramModels = (def?.JobParameters ?? []).Select(p => new ParamModel { Param = p, Value = !string.IsNullOrEmpty(p.Value) ? p.Value : p.Type == JobParameterType.Bool ? "false" : null }).ToList();
        RebuildSiblingMap();
    }

    private void SetParamValue(ParamModel p, string? value)
    {
        p.Value = value;
        RebuildSiblingMap();
    }

    private void RebuildSiblingMap() => _siblingMap = _paramModels.ToDictionary(p => p.Param.Key, p => p.Value, StringComparer.OrdinalIgnoreCase);

    private bool IsValid()
    {
        if (_selectedDef == null || string.IsNullOrWhiteSpace(_createdBy))
            return false;

        return _paramModels.Where(p => p.Param.Required).All(p => !p.IsEmpty());
    }

    private async Task Submit()
    {
        if (_selectedDef == null)
            return;

        _submitting = true;
        try {
            var runParams = new List<JobRunParameterReq>();
            foreach (var p in _paramModels) {
                if (p.Param.AllowMultiple) {
                    var parts = ParameterListJson.Parse(p.Value);
                    if (parts.Count > 0) {
                        foreach (var part in parts) {
                            runParams.Add(
                                new() {
                                    Key = p.Param.Key,
                                    Type = p.Param.Type,
                                    Value = part,
                                    Description = p.Param.Description
                                });
                        }

                        continue;
                    }
                }

                runParams.Add(
                    new() {
                        Key = p.Param.Key,
                        Type = p.Param.Type,
                        Value = p.Value,
                        Description = p.Param.Description
                    });
            }

            var req = new JobRunReq {
                JobDefinitionId = _selectedDef.Id,
                CreatedBy = _createdBy,
                AllowTriggers = _allowTriggers,
                JobRunParameters = runParams
            };

            var result = await ApiClient.PostAsAsync<JobRunReq, CreateResult<JobRunRes>>(RunRoute + "/Create", req);
            Snackbar.Add($"Job run {result?.Data?.Id.Truncated() ?? "?"} created", Severity.Success);
            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (Exception ex) {
            Snackbar.Add($"Failed: {ex.Message}", Severity.Error);
        }
        finally {
            _submitting = false;
        }
    }

}

@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="JobDefinitionGrid"
                      Route="@_definitionRoute"
                      KeySelector="@GetKey"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      BeforeQuery="@(q => q.AddIncludes("JobSchedules.JobScheduleParameters", "JobTriggerTriggersJobDefinitions", "JobParameters"))"
                      Features="@LyoDataGridFeatureFlags.All">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <LeftControls>
        <MudButton OnClick="@OpenCreateRunDialog"
                   StartIcon="@Icons.Material.Filled.Add"
                   Size="Size.Small"
                   Variant="Variant.Outlined"
                   Color="Color.Default">
            Create Job Run
        </MudButton>
    </LeftControls>
    <BulkMenuItems>
        <MudMenuItem OnClick="@(() => BulkToggle(true))">Enable</MudMenuItem>
        <MudMenuItem OnClick="@(() => BulkToggle(false))">Disable</MudMenuItem>
    </BulkMenuItems>
    <Columns>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false"
                        HeaderStyle="@LyoDataGridColumnStyles.QuickActionsHeaderStyle"
                        CellStyle="@LyoDataGridColumnStyles.QuickActionsCellStyle">
            <CellTemplate Context="cell">
                <MudStack Row Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" title="Run now"
                                   OnClick="@(() => RunJob(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit definition"
                                   OnClick="@(() => ViewDefinition(cell.Item))"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <LyoProjectedColumn Field="Enabled" Title="Enabled" Align="Align.Center" HeaderStyle="width: 110px;">
            <CellContent Context="item">
                @{
                    var enabled = GetEnabled(item);
                }
                <MudChip T="string" Size="Size.Small" Color="@(enabled ? Color.Success : Color.Default)"
                         Style="cursor: pointer;"
                         OnClick="@(() => ToggleDefinition(item))">
                    @(enabled ? "Enabled" : "Disabled")
                </MudChip>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 140px;" CellStyle="white-space: nowrap;">
            <CellContent Context="item">
                <LyoIdField Compact="true" Text="@ProjectedValueHelper.GetDisplayValue(item, "Id")"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Name" Title="Name" QuickSearchPropertyName="Name" MaxDisplayLength="@ChipLabelHelper.DefaultGridCellMaxLength"/>
        <LyoProjectedColumn Field="Description" Title="Description" QuickSearchPropertyName="Description" MaxDisplayLength="@ChipLabelHelper.DefaultGridCellMaxLength"/>
        <LyoProjectedColumn Field="Type" Title="Type" QuickSearchPropertyName="Type"/>
        <LyoProjectedColumn Field="WorkerType" Title="Worker Type"/>
        <LyoProjectedColumn Field="JobRuns.CreatedTimestamp" Title="Last Run" Sortable="false" CellStyle="white-space: nowrap;"
                            Timestamp="LyoTimestampKind.Absolute" TimestampLatest="true"/>
        <LyoProjectedColumn Field="JobSchedules.Count" Title="Schedules" Align="Align.Center" HeaderStyle="width: 90px;"/>
        <LyoProjectedColumn Field="JobParameters.Count" Title="Parameters" Align="Align.Center" HeaderStyle="width: 90px;"/>
        <LyoProjectedColumn Field="CreatedTimestamp" Title="Created" HiddenByDefault="true" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Absolute"/>
        <LyoProjectedColumn Field="UpdatedTimestamp" Title="Updated" HiddenByDefault="true" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Absolute"/>
        <LyoProjectedColumn Field="MaxRetryCount" Title="Max Retries" Align="Align.Center" HeaderStyle="width: 90px;" HiddenByDefault="true"/>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => ViewDefinition(item))">Edit</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => RunJob(item))">Run</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.History" OnClick="@(() => ViewRuns(item))">View Runs</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.ToggleOn" OnClick="@(() => ToggleDefinition(item))">Toggle Enabled</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

@code {

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string BaseRoute { get; set; } = "Job";

    /// <summary>Raised when the user asks to see the runs of a definition (id + name). Hosts typically switch to the Runs tab filtered to that definition.</summary>
    [Parameter]
    public EventCallback<(Guid Id, string? Name)> OnViewRuns { get; set; }

    private string _definitionRoute => $"{BaseRoute.TrimEnd('/')}/Definition";

    private string _runRoute => $"{BaseRoute.TrimEnd('/')}/Run";

    private string _scheduleRoute => $"{BaseRoute.TrimEnd('/')}/Schedule";

    private string _triggerRoute => $"{BaseRoute.TrimEnd('/')}/Trigger";

    private LyoDataGridProjected? _dataGrid;

    // Optimistic overrides for the inline Enabled switch so a toggle does not force a full grid refresh.
    private readonly Dictionary<Guid, bool> _enabledOverrides = [];

    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("Name"), new("Type"), new("WorkerType", "Worker Type"), new("Enabled", type: FilterPropertyType.Bool)];

    private static object[] GetKey(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        return ProjectedValueHelper.TryGetGuid(id, out var guid) ? [guid] : id != null ? [id] : [];
    }

    private bool GetEnabled(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (ProjectedValueHelper.TryGetGuid(id, out var guid) && _enabledOverrides.TryGetValue(guid, out var overridden))
            return overridden;

        var enabledVal = ProjectedValueHelper.GetValue(item, "Enabled");
        return enabledVal is true || enabledVal?.ToString() == "True";
    }

    private async Task SetEnabledAsync(object? item, bool value)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (!ProjectedValueHelper.TryGetGuid(id, out var guid))
            return;

        try {
            var patch = new PatchRequestBuilder().WithKey(guid).SetProperty("Enabled", value).Build();
            await ApiClient.PatchAsAsync<PatchRequest, PatchResult<object>>(_definitionRoute, patch);
            _enabledOverrides[guid] = value;
            Snackbar.Add($"Definition {(value ? "enabled" : "disabled")}", Severity.Success);
        }
        catch (Exception ex) {
            Snackbar.Add($"Toggle failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task<JobDefinitionRes?> FetchDefinition(object? id, string[]? includes = null)
    {
        if (!ProjectedValueHelper.TryGetGuid(id, out var guid))
            return null;

        var req = new QueryConcreteReq { Keys = [[guid]], Amount = 1 };
        if (includes != null)
            req.Include.AddRange(includes);

        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<JobDefinitionRes>>($"{_definitionRoute}/QueryConcrete", req);
        return res?.Items?.FirstOrDefault();
    }

    private async Task OpenCreateRunDialog()
    {
        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<JobDefinitionRes>>($"{_definitionRoute}/QueryConcrete", new() { Amount = 200, Include = ["JobParameters"] });
        var parameters = new DialogParameters<RunJobDialog> { { d => d.JobDefinitions, res?.Items ?? [] }, { d => d.RunRoute, _runRoute } };
        var dialog = await DialogService.ShowAsync<RunJobDialog>("Create Job Run", parameters, LyoDialogPresets.Medium);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await RefreshAsync();
    }

    private async Task ViewDefinition(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (id == null)
            return;

        var def = await FetchDefinition(id, JobDefinitionEditorQuery.Includes);
        if (def == null)
            return;

        var parameters = new DialogParameters<JobDefinitionView> {
            { d => d.JobDefinition, def },
            { d => d.DefinitionRoute, _definitionRoute },
            { d => d.ScheduleRoute, _scheduleRoute },
            { d => d.TriggerRoute, _triggerRoute }
        };

        var dialog = await DialogService.ShowAsync<JobDefinitionView>("Job Definition", parameters, LyoDialogPresets.Large);
        var r = await dialog.Result;
        if (r is { Canceled: false })
            await RefreshAsync();
    }

    private async Task RunJob(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (id == null)
            return;

        var def = await FetchDefinition(id, ["JobParameters"]);
        if (def == null)
            return;

        var parameters = new DialogParameters<RunJobDialog> { { d => d.JobDefinitions, new List<JobDefinitionRes> { def } }, { d => d.SelectedJobDefinition, def }, { d => d.RunRoute, _runRoute } };
        var dialog = await DialogService.ShowAsync<RunJobDialog>("Create Job Run", parameters, LyoDialogPresets.Medium);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await RefreshAsync();
    }

    private async Task ViewRuns(object? item)
    {
        if (item == null || !OnViewRuns.HasDelegate)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (!ProjectedValueHelper.TryGetGuid(id, out var guid))
            return;

        var name = ProjectedValueHelper.GetDisplayValue(item, "Name");
        await OnViewRuns.InvokeAsync((guid, string.IsNullOrWhiteSpace(name) ? null : name));
    }

    private async Task ToggleDefinition(object? item)
    {
        if (item == null)
            return;

        await SetEnabledAsync(item, !GetEnabled(item));
    }

    private async Task BulkToggle(bool value)
    {
        if (_dataGrid?.SelectedItems is not { Count: > 0 } selected)
            return;

        var ids = selected.Select(i => ProjectedValueHelper.GetValue(i, "Id")).Select(v => ProjectedValueHelper.TryGetGuid(v, out var g) ? g : (Guid?)null).Where(g => g.HasValue).Select(g => g!.Value).ToList();
        var patch = new PatchRequestBuilder().WithOneOfIdentifier("Id", ids).SetProperty("Enabled", value).AllowMultiple().Build();
        await ApiClient.PatchAsAsync<PatchRequest, PatchBulkResult<object>>($"{_definitionRoute}/Bulk", patch);
        Snackbar.Add($"{(value ? "Enabled" : "Disabled")} {ids.Count} definition(s)", Severity.Success);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _enabledOverrides.Clear();
        await _dataGrid!.RefreshData();
    }

}

@using Lyo.Query.Models.Parameters
@using Lyo.Web.Components.ParamOptions
@inject ISnackbar Snackbar

<LyoDialog Busy="@_busy" OnSave="Submit" SaveDisabled="@(_selected is null || !IsValid())" SaveText="Generate" CloseText="Cancel">
    <MudStack Spacing="2">
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="ReportDefinitionRes"
                           Value="_selected"
                           ValueChanged="OnDefinitionChanged"
                           Label="Report Definition"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           ToStringFunc="@(d => d?.Name ?? "")"
                           Required>
                    @foreach (var def in (Definitions ?? []).Where(d => d.IsActive)) {
                        <MudSelectItem T="ReportDefinitionRes" Value="def">
                            <MudText Typo="Typo.body1">@def.Name</MudText>
                            @if (!string.IsNullOrEmpty(def.Description)) {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@def.Description</MudText>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="ReportFormat?"
                           @bind-Value="_formatOverride"
                           Label="Format override"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var f in Enum.GetValues<ReportFormat>()) {
                        <MudSelectItem T="ReportFormat?" Value="@f">@f</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_fileName" Label="File name (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"/>
            </MudItem>
        </MudGrid>

        @if (_paramModels.Any()) {
            <MudDivider/>

            <MudText Typo="Typo.subtitle1">Parameters</MudText>

            <MudGrid Spacing="2">
                @foreach (var p in _paramModels) {
                    <MudItem xs="12" md="@(p.Param.Type is ReportParameterType.Json or ReportParameterType.Xml ? 12 : 6)">
                        <MudStack Spacing="0">
                            @if (HasOptions(p.Param)) {
                                <LyoParameterOptionsSelect ApiClient="ApiClient"
                                                           OptionsJson="@p.Param.Options"
                                                           AllowedValues="@p.Param.AllowedValues"
                                                           SiblingValues="_siblingMap"
                                                           AllowMultiple="@p.Param.AllowMultiple"
                                                           ListKind="@ToListKind(p.Param.Type)"
                                                           Required="@p.Param.Required"
                                                           Label="@ParamLabel(p)"
                                                           Value="@p.StringValue"
                                                           ValueChanged="@(v => SetStringValue(p, v))"/>
                            }
                            else {
                                <ReportParameterValueInput Type="@p.Param.Type"
                                                           Value="@p.StringValue"
                                                           ValueChanged="@(v => SetStringValue(p, v))"
                                                           Label="@ParamLabel(p)"
                                                           AllowMultiple="@p.Param.AllowMultiple"
                                                           Required="@p.Param.Required"/>
                            }
                            @if (!string.IsNullOrEmpty(p.Param.Description)) {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@p.Param.Description</MudText>
                            }
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudStack>
</LyoDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public IEnumerable<ReportDefinitionRes>? Definitions { get; set; }

    [Parameter]
    public ReportDefinitionRes? SelectedDefinition { get; set; }

    [Parameter]
    [EditorRequired]
    public string GenerateRoute { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    private ReportDefinitionRes? _selected;
    private ReportFormat? _formatOverride;
    private string? _fileName;
    private bool _busy;
    private List<ParamModel> _paramModels = [];
    private Dictionary<string, string?> _siblingMap = new(StringComparer.OrdinalIgnoreCase);

    private sealed class ParamModel
    {
        public ReportDefinitionParameterRes Param { get; init; } = null!;

        public string? StringValue { get; set; }

        public bool IsEmpty()
            => Param.Type == ReportParameterType.Bool
                ? false
                : string.IsNullOrWhiteSpace(StringValue);
    }

    private static string ParamLabel(ParamModel p) => p.Param.Required ? $"{p.Param.Key} *" : p.Param.Key;

    private static bool HasOptions(ReportDefinitionParameterRes p)
        => !string.IsNullOrWhiteSpace(p.Options) || !string.IsNullOrWhiteSpace(p.AllowedValues);

    private static ParameterListJsonKind ToListKind(ReportParameterType type)
        => type switch {
            ReportParameterType.Int or ReportParameterType.Long or ReportParameterType.Decimal => ParameterListJsonKind.Number,
            ReportParameterType.Bool => ParameterListJsonKind.Bool,
            var _ => ParameterListJsonKind.String
        };

    protected override void OnParametersSet()
    {
        if (_selected is null && (SelectedDefinition is not null || Definitions is not null))
            OnDefinitionChanged(SelectedDefinition ?? Definitions?.FirstOrDefault(d => d.IsActive));
    }

    private void OnDefinitionChanged(ReportDefinitionRes? def)
    {
        _selected = def;
        _paramModels = (def?.Parameters ?? []).Select(p => new ParamModel {
                Param = p,
                StringValue = !string.IsNullOrEmpty(p.Value)
                    ? p.Value
                    : p.Type == ReportParameterType.Bool
                        ? "false"
                        : null
            })
            .ToList();
        RebuildSiblingMap();
    }

    private void SetStringValue(ParamModel p, string? value)
    {
        p.StringValue = value;
        RebuildSiblingMap();
    }

    private void RebuildSiblingMap()
        => _siblingMap = _paramModels.ToDictionary(p => p.Param.Key, p => p.StringValue, StringComparer.OrdinalIgnoreCase);

    private bool IsValid() => _selected is not null && _paramModels.Where(p => p.Param.Required).All(p => !p.IsEmpty());

    private async Task Submit()
    {
        if (_selected is null)
            return;

        _busy = true;
        try {
            var parameters = new List<ReportGenerationParameterReq>();
            foreach (var p in _paramModels) {
                var value = p.StringValue;
                if (p.Param.AllowMultiple) {
                    var parts = ParameterListJson.Parse(value);
                    if (parts.Count > 0) {
                        foreach (var part in parts) {
                            parameters.Add(new ReportGenerationParameterReq {
                                Key = p.Param.Key,
                                Type = p.Param.Type,
                                Value = part,
                                Description = p.Param.Description
                            });
                        }
                        continue;
                    }
                }

                parameters.Add(new ReportGenerationParameterReq {
                    Key = p.Param.Key,
                    Type = p.Param.Type,
                    Value = value,
                    Description = p.Param.Description
                });
            }

            var req = new GenerateReportReq {
                ReportDefinitionId = _selected.Id,
                Format = _formatOverride,
                FileName = string.IsNullOrWhiteSpace(_fileName) ? null : _fileName,
                Parameters = parameters
            };

            var result = await ApiClient.PostAsAsync<GenerateReportReq, ReportGenerationRes>(GenerateRoute, req);
            if (result.Status == ReportGenerationStatus.Succeeded)
                Snackbar.Add($"Report generated ({result.Format}).", Severity.Success);
            else
                Snackbar.Add($"Generation finished with status {result.Status}.", Severity.Warning);

            MudDialog.Close(DialogResult.Ok(result));
        }
        catch (Exception ex) {
            Snackbar.Add($"Generate failed: {ex.Message}", Severity.Error);
        }
        finally {
            _busy = false;
        }
    }

}

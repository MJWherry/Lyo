@inject ISnackbar Snackbar

<MudStack Spacing="2">
    <ReportParameterTable Title="Report Parameters"
                          Items="@_rows"
                          ApiClient="ApiClient"
                          OnChanged="@(() => _dirty = true)"/>

    @if (_dirty) {
        <div>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="SaveChanges" StartIcon="@Icons.Material.Filled.Save">
                Save Parameters
            </MudButton>
        </div>
    }
</MudStack>

@code {

    [Parameter]
    public IReadOnlyList<ReportDefinitionParameterRes>? Parameters { get; set; }

    [Parameter]
    public Guid ReportDefinitionId { get; set; }

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string DefinitionRoute { get; set; } = "";

    private string ParameterRoute => $"{DefinitionRoute.TrimEnd('/')}/Parameter";

    private List<ReportParameterEditRow> _rows = [];
    private bool _dirty;
    private bool _loaded;

    protected override void OnParametersSet()
    {
        if (_loaded)
            return;

        _rows = (Parameters ?? []).Select(p => new ReportParameterEditRow {
                Id = p.Id,
                Key = p.Key,
                Type = p.Type,
                Value = p.Value,
                Description = p.Description,
                Required = p.Required,
                AllowMultiple = p.AllowMultiple,
                AllowedValues = p.AllowedValues,
                Options = p.Options,
                EncryptedValue = p.EncryptedValue,
                IsEncrypted = p.EncryptedValue is { Length: > 0 }
            })
            .ToList();

        _dirty = false;
        _loaded = true;
    }

    private async Task SaveChanges()
    {
        try {
            var existing = (Parameters ?? []).ToDictionary(p => p.Id);
            foreach (var removed in existing.Values.Where(e => _rows.All(d => d.Id != e.Id)))
                await ApiClient.DeleteAsAsync<object>($"{ParameterRoute}/{removed.Id}");

            foreach (var newRow in _rows.Where(d => d.IsNew)) {
                var created = await ApiClient.PostAsAsync<ReportDefinitionParameterReq, CreateResult<ReportDefinitionParameterRes>>(
                    ParameterRoute, new() {
                        ReportDefinitionId = ReportDefinitionId,
                        Key = newRow.Key,
                        Type = newRow.Type,
                        Value = newRow.Value,
                        Description = newRow.Description,
                        Required = newRow.Required,
                        AllowMultiple = newRow.AllowMultiple,
                        AllowedValues = newRow.AllowedValues,
                        Options = newRow.Options
                    });

                if (created?.Data is { } data) {
                    newRow.Id = data.Id;
                    newRow.IsNew = false;
                    newRow.Options = data.Options;
                    newRow.AllowedValues = data.AllowedValues;
                    newRow.Value = data.Value;
                }
            }

            foreach (var existingRow in _rows.Where(d => !d.IsNew && d.Id.HasValue)) {
                ReportDefinitionParameterReq data = new() {
                    ReportDefinitionId = ReportDefinitionId,
                    Key = existingRow.Key,
                    Type = existingRow.Type,
                    Value = existingRow.Value,
                    Description = existingRow.Description,
                    Required = existingRow.Required,
                    AllowMultiple = existingRow.AllowMultiple,
                    AllowedValues = existingRow.AllowedValues,
                    Options = existingRow.Options
                };

                // Do not round-trip masked EncryptedValue (API returns null for ciphertext).
                if (existingRow.EncryptedValue is { Length: > 0 })
                    data.EncryptedValue = existingRow.EncryptedValue;

                await ApiClient.PostAsAsync<UpdateRequest<ReportDefinitionParameterReq>, UpdateResult<ReportDefinitionParameterRes>>($"{ParameterRoute}/Update", new(data, existingRow.Id!.Value));
            }

            Snackbar.Add("Parameters saved.", Severity.Success);
            _dirty = false;
        }
        catch (Exception ex) {
            Snackbar.Add($"Failed to save parameters: {ex.Message}", Severity.Error);
        }
    }

}

@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@inject IJsInterop Js

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="ReportGenerationGrid"
                      Route="@_generationRoute"
                      KeySelector="@GetKey"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      Features="@LyoDataGridFeatureFlags.All">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <Columns>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 110px;" CellStyle="white-space: nowrap;">
            <CellContent Context="item">
                @{
                    var idText = ProjectedValueHelper.GetDisplayValue(item, "Id");
                }
                <MudStack Row Spacing="0" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@Shorten(idText)</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy ID"
                                   OnClick="@(() => CopyToClipboard(idText))"/>
                </MudStack>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="ReportDefinitionId" Title="Definition" HeaderStyle="width: 110px;" CellStyle="white-space: nowrap;">
            <CellContent Context="item">
                @{
                    var defId = ProjectedValueHelper.GetDisplayValue(item, "ReportDefinitionId");
                }
                <MudText Typo="Typo.body2" Style="font-family: monospace;">@Shorten(defId)</MudText>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Format" Title="Format" Align="Align.Center" HeaderStyle="width: 90px;">
            <CellContent Context="item">
                @{
                    var formatText = ProjectedValueHelper.GetDisplayValue(item, "Format");
                }
                @if (Enum.TryParse<ReportFormat>(formatText, out var format)) {
                    <MudChip T="string" Size="Size.Small" Color="@ReportColorHelper.ForFormat(format)">@format</MudChip>
                }
                else {
                    @formatText
                }
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Status" Title="Status" Align="Align.Center" HeaderStyle="width: 110px;">
            <CellContent Context="item">
                @{
                    var statusText = ProjectedValueHelper.GetDisplayValue(item, "Status");
                }
                @if (Enum.TryParse<ReportGenerationStatus>(statusText, out var status)) {
                    <MudChip T="string" Size="Size.Small" Color="@ReportColorHelper.ForStatus(status)">@status</MudChip>
                }
                else {
                    @statusText
                }
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="CreatedBy" Title="Created By"/>
        <LyoProjectedColumn Field="CreatedTimestamp" Title="Created"/>
        <LyoProjectedColumn Field="StartedTimestamp" Title="Started" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="FinishedTimestamp" Title="Finished"/>
        <LyoProjectedColumn Field="OriginalFileName" Title="File"/>
        <LyoProjectedColumn Field="OutputFileId" Title="Output File" HiddenByDefault="true"/>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false" HeaderStyle="width: 100px;" CellStyle="white-space: nowrap;">
            <CellTemplate Context="cell">
                <MudStack Row Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" title="View details"
                                   OnClick="@(() => ViewGeneration(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Primary" title="Open output"
                                   Disabled="@(!HasOutput(cell.Item))"
                                   OnClick="@(() => ViewOutput(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small" title="Download output"
                                   Disabled="@(!HasOutput(cell.Item))"
                                   OnClick="@(() => DownloadOutput(cell.Item))"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => ViewGeneration(item))">Details</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.OpenInNew" OnClick="@(() => ViewOutput(item))" Disabled="@(!HasOutput(item))">View</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Download" OnClick="@(() => DownloadOutput(item))" Disabled="@(!HasOutput(item))">Download</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

@code {

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string BaseRoute { get; set; } = "Reporting";

    [Parameter]
    public Func<Guid, CancellationToken, Task>? DownloadFileAsync { get; set; }

    [Parameter]
    public Func<Guid, CancellationToken, Task<string?>>? ViewFileUrlAsync { get; set; }

    private string _generationRoute => $"{BaseRoute.TrimEnd('/')}/Generation";

    private LyoDataGridProjected? _dataGrid;

    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("Status"), new("Format"), new("CreatedBy", "Created By")];

    private static object[] GetKey(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        return ProjectedValueHelper.TryGetGuid(id, out var guid) ? [guid] : id != null ? [id] : [];
    }

    private static string Shorten(string id) => id.Length > 8 ? id[..8] : id;

    private async Task CopyToClipboard(string text)
    {
        await Js.SendToClipboard(text);
        Snackbar.Add("Copied to clipboard", Severity.Info);
    }

    private static bool HasOutput(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "OutputFileId");
        return ProjectedValueHelper.TryGetGuid(id, out var _);
    }

    private async Task<ReportGenerationRes?> FetchGeneration(object? id)
    {
        if (!ProjectedValueHelper.TryGetGuid(id, out var guid))
            return null;

        var req = new QueryConcreteReq { Keys = [[guid]], Amount = 1, Include = ["Parameters"] };
        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<ReportGenerationRes>>($"{_generationRoute}/QueryConcrete", req);
        return res?.Items?.FirstOrDefault();
    }

    private async Task ViewGeneration(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        var gen = await FetchGeneration(id);
        if (gen is null) {
            Snackbar.Add("Generation not found.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ReportGenerationView> { { d => d.Generation, gen }, { d => d.DownloadFileAsync, DownloadFileAsync }, { d => d.ViewFileUrlAsync, ViewFileUrlAsync } };
        await DialogService.ShowAsync<ReportGenerationView>("Report Generation", parameters, LyoDialogPresets.Large);
    }

    private async Task ViewOutput(object? item)
    {
        var formatText = ProjectedValueHelper.GetDisplayValue(item, "Format");
        if (Enum.TryParse<ReportFormat>(formatText, out var format) && format is ReportFormat.Csv or ReportFormat.Xlsx) {
            var id = ProjectedValueHelper.GetValue(item, "Id");
            var gen = await FetchGeneration(id);
            if (gen is null) {
                Snackbar.Add("Generation not found.", Severity.Warning);
                return;
            }

            await ShowTabularPreviewAsync(gen);
            return;
        }

        var fileId = ProjectedValueHelper.GetValue(item, "OutputFileId");
        if (!ProjectedValueHelper.TryGetGuid(fileId, out var guid)) {
            Snackbar.Add("No output file on this generation.", Severity.Info);
            return;
        }

        if (ViewFileUrlAsync is null) {
            Snackbar.Add("Host ViewFileUrlAsync is not configured.", Severity.Warning);
            return;
        }

        var url = await ViewFileUrlAsync(guid, CancellationToken.None);
        if (string.IsNullOrWhiteSpace(url)) {
            Snackbar.Add("No view URL available.", Severity.Warning);
            return;
        }

        await JsRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task ShowTabularPreviewAsync(ReportGenerationRes gen)
    {
        try {
            var sheets = ReportGridDataTableMapper.FromReportDataJson(gen.ReportDataJson);
            if (gen.Format == ReportFormat.Csv && sheets.Count > 1)
                sheets = [sheets[0]];

            if (sheets.Count == 0) {
                Snackbar.Add("No grids found to preview.", Severity.Warning);
                return;
            }

            var title = string.IsNullOrWhiteSpace(gen.OriginalFileName) ? $"{gen.Format} preview" : gen.OriginalFileName!;
            var parameters = new DialogParameters<ReportTabularPreviewDialog> { { d => d.Sheets, sheets } };
            await DialogService.ShowAsync<ReportTabularPreviewDialog>(title, parameters, LyoDialogPresets.Large);
        }
        catch (Exception ex) {
            Snackbar.Add($"Preview failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DownloadOutput(object? item)
    {
        var fileId = ProjectedValueHelper.GetValue(item, "OutputFileId");
        if (!ProjectedValueHelper.TryGetGuid(fileId, out var guid)) {
            Snackbar.Add("No output file on this generation.", Severity.Info);
            return;
        }

        if (DownloadFileAsync is null) {
            Snackbar.Add("Host DownloadFileAsync is not configured.", Severity.Warning);
            return;
        }

        await DownloadFileAsync(guid, CancellationToken.None);
        Snackbar.Add("Download started.", Severity.Success);
    }

}

@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJsInterop Js

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="ReportDefinitionGrid"
                      Route="@_definitionRoute"
                      KeySelector="@GetKey"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      Features="@LyoDataGridFeatureFlags.All">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <LeftControls>
        <MudButton OnClick="@OpenRunDialog"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   Size="Size.Small"
                   Variant="Variant.Outlined"
                   Color="Color.Default">
            Run Report
        </MudButton>
    </LeftControls>
    <Columns>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false"
                        HeaderStyle="@LyoDataGridColumnStyles.QuickActionsHeaderStyle"
                        CellStyle="@LyoDataGridColumnStyles.QuickActionsCellStyle">
            <CellTemplate Context="cell">
                <MudStack Row Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" title="Run report"
                                   OnClick="@(() => RunDefinition(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" title="Edit definition"
                                   OnClick="@(() => ViewDefinition(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Delete definition"
                                   OnClick="@(() => DeleteDefinition(cell.Item))"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <LyoProjectedColumn Field="IsActive" Title="Active" Align="Align.Center" HeaderStyle="width: 96px;">
            <CellContent Context="item">
                @{
                    var active = GetActive(item);
                }
                <LyoChip Spec="@LyoChips.FromBool(active, "Active", "Off", Color.Success, Color.Default)"
                         Style="cursor: pointer;"
                         OnClick="@(() => ToggleActiveAsync(item))"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 110px;" CellStyle="white-space: nowrap;">
            <CellContent Context="item">
                @{
                    var idText = ProjectedValueHelper.GetDisplayValue(item, "Id");
                }
                <MudStack Row Spacing="0" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@Shorten(idText)</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy ID"
                                   OnClick="@(() => CopyToClipboard(idText))"/>
                </MudStack>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Name" Title="Name" QuickSearchPropertyName="Name" MaxDisplayLength="@ChipLabelHelper.DefaultGridCellMaxLength"/>
        <LyoProjectedColumn Field="Description" Title="Description" QuickSearchPropertyName="Description" MaxDisplayLength="@ChipLabelHelper.DefaultGridCellMaxLength"/>
        <LyoProjectedColumn Field="DefaultFormat" Title="Format" Align="Align.Center" HeaderStyle="width: 100px;">
            <CellContent Context="item">
                @{
                    var formatText = ProjectedValueHelper.GetDisplayValue(item, "DefaultFormat");
                }
                <LyoChip Spec="@(LyoChips.FromEnum<ReportFormat>(formatText, ReportColorHelper.ForFormat))"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="GenerationProfileKey" Title="Profile"/>
        <LyoProjectedColumn Field="Generations.CreatedTimestamp" Title="Last Generation" Sortable="false" CellStyle="white-space: nowrap;"
                            Timestamp="LyoTimestampKind.Relative" TimestampLatest="true"/>
        <LyoProjectedColumn Field="CreatedBy" Title="Created By" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="CreatedTimestamp" Title="Created" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Absolute"/>
        <LyoProjectedColumn Field="UpdatedTimestamp" Title="Updated" HiddenByDefault="true" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Absolute"/>
        <LyoProjectedColumn Field="Tags" Title="Tags" HiddenByDefault="true"/>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => ViewDefinition(item))">Edit</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => RunDefinition(item))">Run</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteDefinition(item))">Delete</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

@code {

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string BaseRoute { get; set; } = "Reporting";

    [Parameter]
    public Func<Guid, string?, CancellationToken, Task>? DownloadFileAsync { get; set; }

    /// <summary>Host callback returning a browser URL to view HTML/PDF output. Forwarded when a generation view is opened after generate.</summary>
    [Parameter]
    public Func<Guid, CancellationToken, Task<string?>>? ViewFileUrlAsync { get; set; }

    /// <summary>Raised after a successful generate so the host can switch tabs. When unset, this grid opens the generation view itself.</summary>
    [Parameter]
    public EventCallback<ReportGenerationRes> Generated { get; set; }

    private string _definitionRoute => $"{BaseRoute.TrimEnd('/')}/Definition";

    private string _generationRoute => $"{BaseRoute.TrimEnd('/')}/Generation";

    private LyoDataGridProjected? _dataGrid;

    private readonly Dictionary<Guid, bool> _activeOverrides = [];

    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("Name"), new("GenerationProfileKey", "Profile"), new("IsActive", "Active", FilterPropertyType.Bool)];

    private static object[] GetKey(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        return ProjectedValueHelper.TryGetGuid(id, out var guid) ? [guid] : id != null ? [id] : [];
    }

    private static string Shorten(string id) => id.Length > 8 ? id[..8] : id;

    private async Task CopyToClipboard(string text)
    {
        await Js.SendToClipboard(text);
        Snackbar.Add("Copied to clipboard", Severity.Info);
    }

    private bool GetActive(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (ProjectedValueHelper.TryGetGuid(id, out var guid) && _activeOverrides.TryGetValue(guid, out var overridden))
            return overridden;

        var activeVal = ProjectedValueHelper.GetValue(item, "IsActive");
        return activeVal is true || string.Equals(activeVal?.ToString(), "True", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ToggleActiveAsync(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (!ProjectedValueHelper.TryGetGuid(id, out var guid))
            return;

        var value = !GetActive(item);
        try {
            var patch = new PatchRequestBuilder().WithKey(guid).SetProperty("IsActive", value).Build();
            await ApiClient.PatchAsAsync<PatchRequest, PatchResult<object>>(_definitionRoute, patch);
            _activeOverrides[guid] = value;
            Snackbar.Add($"Definition {(value ? "enabled" : "disabled")}", Severity.Success);
        }
        catch (Exception ex) {
            Snackbar.Add($"Toggle failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task<ReportDefinitionRes?> FetchDefinition(object? id)
    {
        if (!ProjectedValueHelper.TryGetGuid(id, out var guid))
            return null;

        var req = new QueryConcreteReq { Keys = [[guid]], Amount = 1, Include = ["Parameters"] };
        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<ReportDefinitionRes>>($"{_definitionRoute}/QueryConcrete", req);
        return res?.Items?.FirstOrDefault();
    }

    private async Task OpenRunDialog()
    {
        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<ReportDefinitionRes>>($"{_definitionRoute}/QueryConcrete", new() { Amount = 200, Include = ["Parameters"] });
        var parameters = new DialogParameters<RunReportDialog> { { d => d.Definitions, res?.Items ?? [] }, { d => d.GenerateRoute, $"{_generationRoute}/Generate" }, { d => d.ApiClient, ApiClient } };
        var dialog = await DialogService.ShowAsync<RunReportDialog>("Run Report", parameters, LyoDialogPresets.Medium);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ReportGenerationRes gen })
            await AfterGeneratedAsync(gen);
        else if (result is { Canceled: false })
            await _dataGrid!.RefreshData();
    }

    private async Task ViewDefinition(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        var def = await FetchDefinition(id);
        if (def is null) {
            Snackbar.Add("Definition not found.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ReportDefinitionView> { { d => d.Definition, def }, { d => d.DefinitionRoute, _definitionRoute } };
        await DialogService.ShowAsync<ReportDefinitionView>("Report Definition", parameters, LyoDialogPresets.Medium);
    }

    private async Task RunDefinition(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        var def = await FetchDefinition(id);
        if (def is null) {
            Snackbar.Add("Definition not found.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<RunReportDialog> {
            { d => d.Definitions, [def] },
            { d => d.SelectedDefinition, def },
            { d => d.GenerateRoute, $"{_generationRoute}/Generate" },
            { d => d.ApiClient, ApiClient }
        };

        var dialog = await DialogService.ShowAsync<RunReportDialog>("Run Report", parameters, LyoDialogPresets.Medium);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ReportGenerationRes gen })
            await AfterGeneratedAsync(gen);
    }

    private async Task AfterGeneratedAsync(ReportGenerationRes gen)
    {
        await _dataGrid!.RefreshData();
        if (Generated.HasDelegate)
            await Generated.InvokeAsync(gen);
        else
            await ShowGenerationViewAsync(gen);
    }

    private Task ShowGenerationViewAsync(ReportGenerationRes gen)
    {
        var parameters = new DialogParameters<ReportGenerationView> {
            { d => d.Generation, gen },
            { d => d.DownloadFileAsync, DownloadFileAsync },
            { d => d.ViewFileUrlAsync, ViewFileUrlAsync },
            { d => d.OpenOutput, true }
        };
        return DialogService.ShowAsync<ReportGenerationView>("Report Generation", parameters, LyoDialogPresets.Medium);
    }

    private async Task DeleteDefinition(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        if (id == null)
            return;

        var name = ProjectedValueHelper.GetDisplayValue(item, "Name");
        if (string.IsNullOrWhiteSpace(name))
            name = Shorten(id.ToString() ?? string.Empty);

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete definition", $"Delete '{name}' and all of its generations? Stored output files are removed too.", "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        try {
            await ApiClient.DeleteAsAsync<object>($"{_definitionRoute}/{id}");
            Snackbar.Add("Definition deleted", Severity.Success);
            await _dataGrid!.RefreshData();
        }
        catch (Exception ex) {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
        }
    }

}

@using Lyo.Web.Components.Export
@using Lyo.Web.Components.Export.Csv
@using Lyo.Web.Components.Export.Xlsx
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJsInterop Js

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="ReportDefinitionGrid"
                      Route="@_definitionRoute"
                      KeySelector="@GetKey"
                      FilterPropertyDefinitions="@_propertyDefinitions"
                      Features="@LyoDataGridFeatureFlags.All">
    <BulkExportControls>
        <LyoDataGridExportMenu Host="context">
            <ExportCsvMenuItem Host="context"/>
            <ExportJsonMenuItem Host="context"/>
            <ExportXlsxMenuItem Host="context"/>
        </LyoDataGridExportMenu>
    </BulkExportControls>
    <LeftControls>
        <MudButton OnClick="@OpenRunDialog"
                   StartIcon="@Icons.Material.Filled.PlayArrow"
                   Size="Size.Small"
                   Variant="Variant.Outlined"
                   Color="Color.Default">
            Run Report
        </MudButton>
    </LeftControls>
    <Columns>
        <LyoProjectedColumn Field="Id" Title="ID" HeaderStyle="width: 110px;" CellStyle="white-space: nowrap;">
            <CellContent Context="item">
                @{
                    var idText = ProjectedValueHelper.GetDisplayValue(item, "Id");
                }
                <MudStack Row Spacing="0" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@Shorten(idText)</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" title="Copy ID"
                                   OnClick="@(() => CopyToClipboard(idText))"/>
                </MudStack>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Name" Title="Name" QuickSearchPropertyName="Name"/>
        <LyoProjectedColumn Field="Description" Title="Description" QuickSearchPropertyName="Description"/>
        <LyoProjectedColumn Field="DefaultFormat" Title="Format" Align="Align.Center" HeaderStyle="width: 100px;">
            <CellContent Context="item">
                @{
                    var formatText = ProjectedValueHelper.GetDisplayValue(item, "DefaultFormat");
                }
                @if (Enum.TryParse<ReportFormat>(formatText, out var format)) {
                    <MudChip T="string" Size="Size.Small" Color="@ReportColorHelper.ForFormat(format)">@format</MudChip>
                }
                else {
                    @formatText
                }
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="GenerationProfileKey" Title="Profile"/>
        <LyoProjectedColumn Field="IsActive" Title="Active" Align="Align.Center" HeaderStyle="width: 90px;">
            <CellContent Context="item">
                @{
                    var active = ProjectedValueHelper.GetValue(item, "IsActive") is true
                                 || string.Equals(ProjectedValueHelper.GetDisplayValue(item, "IsActive"), "True", StringComparison.OrdinalIgnoreCase);
                }
                <MudChip T="string" Size="Size.Small" Color="@(active ? Color.Success : Color.Default)">@(active ? "Active" : "Off")</MudChip>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="CreatedBy" Title="Created By" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="CreatedTimestamp" Title="Created"/>
        <LyoProjectedColumn Field="UpdatedTimestamp" Title="Updated" HiddenByDefault="true"/>
        <LyoProjectedColumn Field="Tags" Title="Tags" HiddenByDefault="true"/>
        <TemplateColumn T="object?" Title="" Sortable="false" Hideable="false" HeaderStyle="width: 80px;" CellStyle="white-space: nowrap;">
            <CellTemplate Context="cell">
                <MudStack Row Spacing="0">
                    <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Color="Color.Primary" title="Run report"
                                   OnClick="@(() => RunDefinition(cell.Item))"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" title="View definition"
                                   OnClick="@(() => ViewDefinition(cell.Item))"/>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <RowMenuControls Context="item">
        <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => ViewDefinition(item))">View</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => RunDefinition(item))">Run</MudMenuItem>
    </RowMenuControls>
</LyoDataGridProjected>

@code {

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string BaseRoute { get; set; } = "Reporting";

    [Parameter]
    public Func<Guid, CancellationToken, Task>? DownloadFileAsync { get; set; }

    private string _definitionRoute => $"{BaseRoute.TrimEnd('/')}/Definition";

    private string _generationRoute => $"{BaseRoute.TrimEnd('/')}/Generation";

    private LyoDataGridProjected? _dataGrid;

    private readonly List<FilterPropertyDefinition> _propertyDefinitions = [new("Name"), new("GenerationProfileKey", "Profile"), new("IsActive", "Active", FilterPropertyType.Bool)];

    private static object[] GetKey(object? item)
    {
        var id = ProjectedValueHelper.GetValue(item, "Id");
        return ProjectedValueHelper.TryGetGuid(id, out var guid) ? [guid] : id != null ? [id] : [];
    }

    private static string Shorten(string id) => id.Length > 8 ? id[..8] : id;

    private async Task CopyToClipboard(string text)
    {
        await Js.SendToClipboard(text);
        Snackbar.Add("Copied to clipboard", Severity.Info);
    }

    private async Task<ReportDefinitionRes?> FetchDefinition(object? id)
    {
        if (!ProjectedValueHelper.TryGetGuid(id, out var guid))
            return null;

        var req = new QueryConcreteReq { Keys = [[guid]], Amount = 1, Include = ["Parameters"] };
        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<ReportDefinitionRes>>($"{_definitionRoute}/QueryConcrete", req);
        return res?.Items?.FirstOrDefault();
    }

    private async Task OpenRunDialog()
    {
        var res = await ApiClient.PostAsAsync<QueryConcreteReq, QueryRes<ReportDefinitionRes>>($"{_definitionRoute}/QueryConcrete", new() { Amount = 200, Include = ["Parameters"] });
        var parameters = new DialogParameters<RunReportDialog> { { d => d.Definitions, res?.Items ?? [] }, { d => d.GenerateRoute, $"{_generationRoute}/Generate" }, { d => d.ApiClient, ApiClient } };
        var dialog = await DialogService.ShowAsync<RunReportDialog>("Run Report", parameters, LyoDialogPresets.Medium);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await _dataGrid!.RefreshData();
    }

    private async Task ViewDefinition(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        var def = await FetchDefinition(id);
        if (def is null) {
            Snackbar.Add("Definition not found.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ReportDefinitionView> { { d => d.Definition, def }, { d => d.DefinitionRoute, _definitionRoute } };
        await DialogService.ShowAsync<ReportDefinitionView>("Report Definition", parameters, LyoDialogPresets.Large);
    }

    private async Task RunDefinition(object? item)
    {
        if (item == null)
            return;

        var id = ProjectedValueHelper.GetValue(item, "Id");
        var def = await FetchDefinition(id);
        if (def is null) {
            Snackbar.Add("Definition not found.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<RunReportDialog> {
            { d => d.Definitions, [def] },
            { d => d.SelectedDefinition, def },
            { d => d.GenerateRoute, $"{_generationRoute}/Generate" },
            { d => d.ApiClient, ApiClient }
        };

        var dialog = await DialogService.ShowAsync<RunReportDialog>("Run Report", parameters, LyoDialogPresets.Medium);
        await dialog.Result;
    }

}

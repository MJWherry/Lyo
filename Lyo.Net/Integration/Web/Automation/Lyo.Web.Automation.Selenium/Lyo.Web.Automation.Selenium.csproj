<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>Selenium WebDriver automation: sessions, polling, tab/frame/alert/keyboard helpers, options and DI registration (Microsoft.Extensions), JSON automation plans, and scripted (delegate) steps.</Description>
        <PackageTags>selenium webdriver browser-automation web-automation</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
        <PackageReference Include="Selenium.Support"/>
        <PackageReference Include="Selenium.WebDriver"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Text.Json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lyo.Web.Automation\Lyo.Web.Automation.csproj"/>
        <ProjectReference Include="..\..\..\..\Data\IOTemp\Lyo.IO.Temp\Lyo.IO.Temp.csproj"/>
    </ItemGroup>

</Project>

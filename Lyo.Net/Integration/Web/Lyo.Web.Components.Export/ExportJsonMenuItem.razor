@namespace Lyo.Web.Components.Export
@using Lyo.Api.Models.Enums
@using Lyo.Web.Components.DataGrid

<MudMenuItem Icon="@Icons.Material.Filled.DataObject"
             Disabled="@(ExportHost is null || !ExportHost.CanExport)"
             OnClick="@ExportJsonAsync">
    Export as JSON
</MudMenuItem>

@code {

    [Inject]
    private DataGridExportService ExportService { get; set; } = null!;

    [CascadingParameter(Name = "LyoDataGridExportHost")]
    private IDataGridExportHost? ExportHost { get; set; }

    private async Task ExportJsonAsync()
    {
        if (ExportHost is null)
            return;

        await ExportService.ExportAsync(ExportHost, ExportFormat.Json, showColumnSelector: false, ExportHost.CancellationToken);
    }

}

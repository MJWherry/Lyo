{
  "id": "Lyo.Web.Components.Export",
  "name": "Lyo.Web.Components.Export",
  "area": "Integration",
  "tagline": "Export menu items for Lyo data grids. Reference this package (plus optional format packages) and add items to `BulkExportControls`.",
  "description": "Export menu items for Lyo data grids. Reference this package (plus optional format packages) and add items to `BulkExportControls`.",
  "features": [],
  "examples": [
    {
      "title": "Setup",
      "language": "csharp",
      "code": "builder.Services.AddLyoDataGridExport();"
    },
    {
      "title": "Grid usage",
      "language": "razor",
      "code": "@using Lyo.Web.Components.Export\n@using Lyo.Web.Components.Export.Csv\n@using Lyo.Web.Components.Export.Xlsx\n\n<LyoDataGridProjected Route=\"Person\" ...>\n    <BulkExportControls>\n        <LyoDataGridExportMenu>\n            <ExportCsvMenuItem />\n            <ExportJsonMenuItem />\n            <ExportXlsxMenuItem />\n        </LyoDataGridExportMenu>\n    </BulkExportControls>\n</LyoDataGridProjected>"
    }
  ],
  "sections": [
    {
      "type": "paragraph",
      "title": "Grid usage",
      "text": "Register matching API export addons on the server (`AddLyoApiExport`, `AddCsvExport`, `AddXlsxExport`)."
    }
  ],

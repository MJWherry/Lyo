@typeparam T
@using System.Linq.Expressions
@using Lyo.Web.Components.Form
@typeparam TProperty

<PropertyColumn T="T" TProperty="TProperty"
                Property="@Property"
                Title="@Title"
                Sortable="@Sortable"
                InitialDirection="@InitialDirection"
                Hideable="@Hideable"
                Resizable="@Resizable"
                HeaderStyle="@EffectiveHeaderStyle"
                CellStyle="@EffectiveCellStyle"
                Hidden="@_hidden"
                HiddenChanged="@(h => _hidden = h)">
    <CellTemplate Context="cell">
        @{
            object? rawValue = Property != null ? Property.Compile()!.Invoke(cell.Item) : null;
            var displayText = rawValue?.ToString() ?? string.Empty;
        }
        @if (Identifier) {
            <LyoIdField Compact="true" Text="@displayText"/>
        }
        else if (!string.IsNullOrEmpty(QuickSearchPropertyName) && !string.IsNullOrEmpty(QuickSearchText)) {
            <MudHighlighter Text="@displayText" HighlightedText="@QuickSearchText"/>
        }
        else {
            @displayText
        }
    </CellTemplate>
</PropertyColumn>

@code {

    [CascadingParameter(Name = "LyoDataGridQuickSearchText")]
    public string? QuickSearchText { get; set; }

    [CascadingParameter(Name = "LyoDataGridPropertyColumnRegistry")]
    public ProjectedColumnRegistry? ColumnRegistry { get; set; }

    /// <summary>When set, this column participates in quick search. Property name used for API query.</summary>
    [Parameter]
    public string? QuickSearchPropertyName { get; set; }

    [Parameter]
    public Expression<Func<T, TProperty>>? Property { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool Sortable { get; set; } = true;

    [Parameter]
    public SortDirection InitialDirection { get; set; } = SortDirection.None;

    [Parameter]
    public bool Hideable { get; set; } = true;

    /// <summary>When true, the column starts hidden; the user can show it from the columns panel.</summary>
    [Parameter]
    public bool HiddenByDefault { get; set; }

    /// <summary>When true, the cell renders compact <c>LyoIdField</c> instead of the property's default string.</summary>
    [Parameter]
    public bool Identifier { get; set; }

    [Parameter]
    public bool Resizable { get; set; } = true;

    [Parameter]
    public Align Align { get; set; } = Align.Inherit;

    private bool _hidden;
    private bool _hiddenSeeded;

    protected override void OnParametersSet()
    {
        if (!_hiddenSeeded) {
            _hidden = HiddenByDefault;
            _hiddenSeeded = true;
        }

        ColumnRegistry?.Register(PropertyPath(Property) ?? "", Title, QuickSearchPropertyName, HiddenByDefault);
    }

    private static string? PropertyPath(LambdaExpression? expr)
    {
        if (expr == null)
            return null;

        var body = expr.Body;
        if (body is UnaryExpression unary && unary.NodeType == ExpressionType.Convert)
            body = unary.Operand;

        var parts = new List<string>();
        while (body is MemberExpression member) {
            parts.Insert(0, member.Member.Name);
            body = member.Expression!;
            if (body is UnaryExpression nested && nested.NodeType == ExpressionType.Convert)
                body = nested.Operand;
        }

        return parts.Count == 0 ? null : string.Join(".", parts);
    }

    private string EffectiveHeaderStyle => MergeAlignStyle(null, Align);

    private string EffectiveCellStyle => MergeAlignStyle(null, Align);

    private static string MergeAlignStyle(string? style, Align align)
        => align switch {
            Align.Center => AppendStyle(style, "text-align: center;"),
            Align.Right => AppendStyle(style, "text-align: right;"),
            Align.Left => AppendStyle(style, "text-align: left;"),
            var _ => style ?? string.Empty
        };

    private static string AppendStyle(string? style, string snippet) => string.IsNullOrEmpty(style) ? snippet : $"{style.TrimEnd()} {snippet}";

}

{
  "id": "Lyo.Job.Client",
  "name": "Lyo.Job.Client",
  "area": "Integration",
  "tagline": "Typed HTTP client for the Lyo Job API. Wraps `IApiClient` with run lifecycle and worker-instance endpoints from `Lyo.Job.Models.Constants.Rest.Job`.",
  "description": "Typed HTTP client for the Lyo Job API. Wraps `IApiClient` with run lifecycle and worker-instance endpoints from `Lyo.Job.Models.Constants.Rest.Job`.",
  "features": [],
  "examples": [
    {
      "title": "Register with DI",
      "language": "csharp",
      "code": "services.AddSingleton<MyApiClient>();\nservices.AddJobClient<MyApiClient>();\n\n// Or with an explicit route prefix (when not using HttpClient.BaseAddress):\nservices.AddJobClient(sp => sp.GetRequiredService<IApiClient>(), new JobClientOptions { RoutePrefix = apiBaseUrl });"
    },
    {
      "title": "Sub-client on a host API client",
      "language": "csharp",
      "code": "public class MyApiClient : ApiClient\n{\n    public JobClient Jobs { get; }\n\n    public MyApiClient(MyApiClientOptions options, ...) : base(...)\n    {\n        Jobs = new JobClient(this);\n    }\n}\n\n// Usage\nawait myClient.Jobs.Runs.StartAsync(runId);\nawait myClient.Jobs.Runs.LogAsync(runId, new JobRunLogReq(...));\nawait myClient.Jobs.Runs.FinishAsync(runId, results);\nawait myClient.Jobs.Runs.RequeueAsync(runId); // Running -> Queued hand-back (graceful worker shutdown)\nawait myClient.Jobs.Runs.ResyncQueuedAsync(); // republish due Queued runs missing from RabbitMQ"
    }
  ],
  "sections": [
    {
      "type": "paragraph",
      "title": "Route prefix",
      "text": "When `JobClientOptions.RoutePrefix` is set (e.g. `https://localhost:5074`), all routes are built as `{prefix}/Job/Run/...`. When empty, routes are relative and rely on `HttpClient.BaseAddress`."
    }
  ],

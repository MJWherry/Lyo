@namespace Lyo.Web.Components.Cache
@using System.Collections
@using System.Text.Json
@using Lyo.Api.Client
@using Lyo.Api.Models.Common.Request
@using Lyo.Api.Models.Common.Response
@using Lyo.Api.Models.Enums
@using Lyo.Common.Conversion
@using Lyo.Common.Records
@using Lyo.Web.Components.DataGrid
@using Lyo.Web.Components.Models
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" Icon="@Icons.Material.Filled.Memory">
    L1 only: this API process's in-memory cache. Redis L2 keys written by other services are not listed.
</MudAlert>

<LyoDataGridProjected @ref="_dataGrid"
                      ApiClient="ApiClient"
                      GridKey="@GridKey"
                      Route="@Route"
                      Features="@GridFeatures"
                      KeySelector="GetKey"
                      KeySelectFields="@KeyFields"
                      QuickSearchProperties="@QuickSearchFields"
                      FilterPropertyDefinitions="@_filters"
                      RowMenuControls="@GetRowMenuControls()">
    <LeftControls>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.DeleteSweep"
                   OnClick="ClearAllAsync">
            Clear all
        </MudButton>
    </LeftControls>
    <Columns>
        <LyoProjectedColumn Field="Type" Title="Type">
            <CellContent Context="item">
                @{
                    var typeText = ProjectedValueHelper.GetDisplayValue(item, "Type");
                }
                <LyoChip Spec="@(LyoChips.FromEnum<CacheItemTypeEnum>(typeText, CacheColorHelper.ForType, CacheColorHelper.TypeIcon))"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Name" Title="Name" QuickSearchPropertyName="Name" MaxDisplayLength="150"/>
        <LyoProjectedColumn Field="Tags" Title="Tags" Sortable="false">
            <CellContent Context="item">
                @{
                    var tags = GetTags(item);
                }
                @if (tags.Count == 0) {
                    <span>—</span>
                }
                else {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var tag in tags) {
                            <LyoChip Spec="@LyoChips.Of(tag, Color.Tertiary, Icons.Material.Filled.LocalOffer)"/>
                        }
                    </div>
                }
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Encrypted" Title="Encrypted">
            <CellContent Context="item">
                @{
                    var encrypted = GetNullableBool(item, "Encrypted");
                }
                <LyoChip Spec="@(LyoChips.FromBool(encrypted, "Yes", "No", Color.Warning, Color.Default))" Icon="@CacheColorHelper.EncryptedIcon(encrypted)"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Compressed" Title="Compressed">
            <CellContent Context="item">
                @{
                    var compressed = GetNullableBool(item, "Compressed");
                }
                <LyoChip Spec="@(LyoChips.FromBool(compressed, "Yes", "No", Color.Info, Color.Default))" Icon="@CacheColorHelper.CompressedIcon(compressed)"/>
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="SizeBytes" Title="Size">
            <CellContent Context="item">
                @FormatSize(item)
            </CellContent>
        </LyoProjectedColumn>
        <LyoProjectedColumn Field="Created" Title="Created" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Relative"/>
        <LyoProjectedColumn Field="Expires" Title="Expires" CellStyle="white-space: nowrap;" Timestamp="LyoTimestampKind.Relative"/>
    </Columns>
    <NoRecordsContent>
        <div class="d-flex flex-column align-center pa-4">
            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Class="mb-2"/>
            <MudText Typo="Typo.h6">@(_dataGrid?.QueryError is not null ? "Unable to load cache items" : "No cache items")</MudText>
        </div>
    </NoRecordsContent>
</LyoDataGridProjected>

@code {
    private static readonly string[] KeyFields = ["Type", "Name"];
    private static readonly string[] QuickSearchFields = ["Name"];
    private const LyoDataGridFeatureFlags GridFeatures =
        LyoDataGridFeatureFlags.Filterable | LyoDataGridFeatureFlags.Searchable | LyoDataGridFeatureFlags.AutoRefresh
        | LyoDataGridFeatureFlags.BulkMenu | LyoDataGridFeatureFlags.BulkDelete;

    private readonly List<FilterPropertyDefinition> _filters = [
        new("Type", "Type"),
        new("Name", "Name"),
        new("Tags", "Tags"),
        new("Encrypted", "Encrypted"),
        new("Compressed", "Compressed"),
        new("SizeBytes", "Size"),
        new("Created", "Created"),
        new("Expires", "Expires")
    ];

    private LyoDataGridProjected? _dataGrid;

    [Parameter]
    [EditorRequired]
    public IApiClient ApiClient { get; set; } = null!;

    [Parameter]
    public string Route { get; set; } = "Cache";

    [Parameter]
    public string GridKey { get; set; } = "CacheGrid";

    private static object[] GetKey(object? item)
    {
        if (item == null)
            return [];

        var type = ProjectedValueHelper.GetValue(item, "Type");
        var name = ProjectedValueHelper.GetValue(item, "Name");
        return type == null || name == null ? [] : [type, name];
    }

    private static IReadOnlyList<string> GetTags(object? item)
    {
        var raw = ProjectedValueHelper.GetValue(item, "Tags");
        if (raw is null)
            return [];

        var tags = new List<string>();
        foreach (var value in EnumerateTagValues(raw)) {
            if (!string.IsNullOrWhiteSpace(value))
                tags.Add(value);
        }

        return tags;
    }

    private static IEnumerable<string> EnumerateTagValues(object raw)
    {
        if (raw is string s) {
            yield return s;
            yield break;
        }

        if (raw is JsonElement je) {
            if (je.ValueKind == JsonValueKind.String) {
                var text = je.GetString();
                if (text != null)
                    yield return text;
            }
            else if (je.ValueKind == JsonValueKind.Array) {
                foreach (var el in je.EnumerateArray()) {
                    var text = el.ValueKind == JsonValueKind.String ? el.GetString() : el.ToString();
                    if (text != null)
                        yield return text;
                }
            }

            yield break;
        }

        if (raw is IEnumerable enumerable) {
            foreach (var el in enumerable) {
                var text = el?.ToString();
                if (text != null)
                    yield return text;
            }
        }
    }

    private static bool? GetNullableBool(object? item, string field)
    {
        var raw = ProjectedValueHelper.GetValue(item, field);
        if (raw is null)
            return null;
        if (raw is bool b)
            return b;
        if (raw is JsonElement je) {
            if (je.ValueKind is JsonValueKind.True)
                return true;
            if (je.ValueKind is JsonValueKind.False)
                return false;
            if (je.ValueKind is JsonValueKind.Null)
                return null;
        }

        return TypeConversion.TryConvertTo<bool>(raw, out var converted) ? converted : null;
    }

    private static string FormatSize(object? item)
    {
        var raw = ProjectedValueHelper.GetValue(item, "SizeBytes");
        return ProjectedValueHelper.TryGetInt64(raw, out var size)
            ? FileSizeUnitInfo.FormatBestFitAbbreviation(size, lowercaseAbbreviation: false)
            : "—";
    }

    private RenderFragment<object?> GetRowMenuControls()
        => row => @<MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteRowAsync(row))">Delete</MudMenuItem>;

    private async Task ClearAllAsync()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Clear cache", "Remove every L1 entry this API process is tracking?", yesText: "Clear", cancelText: "Cancel");
        if (confirmed != true)
            return;

        var result = await ApiClient.PostAsAsync<CacheMutationRes>($"{Route.TrimEnd('/')}/Clear");
        Snackbar.Add($"Cleared {result.RemovedCount} cache item(s).", Severity.Success);
        if (_dataGrid != null)
            await _dataGrid.RefreshData();
    }

    private async Task DeleteRowAsync(object? row)
    {
        var key = GetKey(row);
        var name = ProjectedValueHelper.GetDisplayValue(row, "Name");
        if (key.Length == 0 || _dataGrid == null)
            return;

        var confirmed = await DialogService.ShowMessageBoxAsync("Delete", $"Remove '{name}'?", yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;

        await ApiClient.DeleteAsAsync<DeleteRequest, DeleteResult<object?>>(Route.TrimEnd('/'), new() { Keys = [key] });
        Snackbar.Add("Deleted.", Severity.Success);
        await _dataGrid.RefreshData();
    }
}

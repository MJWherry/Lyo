@using Lyo.Query.Models.Enums
@using Lyo.Web.Components.QueryNodeEditor
<LyoElementRoot ElementId="@ElementId" DefaultId="lyo-query-root-form">
    <MudStack Spacing="4">
        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6">Root /Query (From + Joins)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                Posts to
                <c>{host}/{route}/Query</c>
                — use the dynamic CRUD base route (no
                <c>{entityType}</c>
                segment).
                Outer where/sort must use the From alias; filter join sides via nested join query (JSON editor) for now.
            </MudText>
        </MudPaper>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudPaper Elevation="1" Class="pa-3 h-100">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Pagination</MudText>
                    <StartAmountFields Start="@Request.Start"
                                       Amount="@Request.Amount"
                                       ValueChanged="@OnStartAmountChanged"/>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Elevation="1" Class="pa-3 h-100">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">Options</MudText>
                    <MudSelect T="QueryTotalCountMode"
                               Value="@Request.Options.TotalCountMode"
                               ValueChanged="@OnTotalCountModeChanged"
                               Label="Total Count Mode"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="min-width: 140px;">
                        <MudSelectItem Value="@QueryTotalCountMode.Exact">Exact</MudSelectItem>
                        <MudSelectItem Value="@QueryTotalCountMode.None">None</MudSelectItem>
                        <MudSelectItem Value="@QueryTotalCountMode.HasMore">HasMore</MudSelectItem>
                    </MudSelect>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Elevation="1" Class="pa-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2">From</MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                <MudTextField T="string"
                              Value="@Request.From.Alias"
                              ValueChanged="@OnFromAliasChanged"
                              Label="Alias"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="min-width: 100px;"/>
                <MudTextField T="string"
                              Value="@Request.From.EntityType"
                              ValueChanged="@OnFromEntityTypeChanged"
                              Label="EntityType"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="min-width: 180px;"/>
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-3">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1">Joins</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@AddJoin">Add join</MudButton>
            </MudStack>
            @if (Request.Joins.Count == 0) {
                <MudText Typo="Typo.caption" Color="Color.Secondary">No joins — Select fields from the From alias only.</MudText>
            }
            @foreach (var join in Request.Joins) {
                <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-2">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                            <MudTextField T="string"
                                          Value="@join.Alias"
                                          ValueChanged="@(v => OnJoinAliasChanged(join, v))"
                                          Label="Alias"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="min-width: 90px;"/>
                            <MudTextField T="string"
                                          Value="@join.EntityType"
                                          ValueChanged="@(v => OnJoinEntityTypeChanged(join, v))"
                                          Label="EntityType"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="min-width: 160px;"/>
                            <MudTextField T="string"
                                          Value="@(join.As ?? "")"
                                          ValueChanged="@(v => OnJoinAsChanged(join, v))"
                                          Label="As (optional)"
                                          HelperText="Response bag name; defaults to Alias"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Style="min-width: 120px;"/>
                            <MudSelect T="JoinType"
                                       Value="@join.Type"
                                       ValueChanged="@(t => OnJoinTypeChanged(join, t))"
                                       Label="Type"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Style="min-width: 110px;">
                                <MudSelectItem Value="@JoinType.Left">Left</MudSelectItem>
                                <MudSelectItem Value="@JoinType.Inner">Inner</MudSelectItem>
                            </MudSelect>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => RemoveJoin(join))" aria-label="Remove join"/>
                        </MudStack>
                        <MudText Typo="Typo.caption">ON</MudText>
                        @foreach (var on in join.On.ToList()) {
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudTextField T="string"
                                              Value="@on.From"
                                              ValueChanged="@(v => OnOnFromChanged(on, v))"
                                              Label="From"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Style="min-width: 160px;"/>
                                <MudText Typo="Typo.body2">=</MudText>
                                <MudTextField T="string"
                                              Value="@on.To"
                                              ValueChanged="@(v => OnOnToChanged(on, v))"
                                              Label="To"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Style="min-width: 160px;"/>
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => RemoveOn(join, on))"/>
                            </MudStack>
                        }
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => AddOn(join))">Add ON</MudButton>
                    </MudStack>
                </MudPaper>
            }
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Select (alias.property)</MudText>
            <SelectList Select="@(Request.Select ?? [])"
                        SelectAll="@(SelectAll ?? Request.Select ?? [])"
                        SelectChanged="@OnSelectChanged"
                        SelectAllChanged="@OnSelectAllChanged"/>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Computed Fields</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                SmartFormat over Select paths. From-only templates become a root scalar; any join placeholder
                (e.g. &#123;p.FirstName&#125;&#123;c.StartDate&#125;) is written on each bag of the deepest join alias only.
                Mustache &#123;&#123;p.FirstName&#125;&#125; is also accepted.
            </MudText>
            <ComputedFieldsList Items="@(Request.ComputedFields ?? [])"
                                ItemsChanged="@OnComputedFieldsChanged"/>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Sort By (From alias only)</MudText>
            <SortByList Items="@(Request.SortBy ?? [])"
                        ItemsChanged="@OnSortByChanged"/>
        </MudPaper>

        <MudPaper Elevation="1" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-3">Filter (From alias only)</MudText>
            <QueryNodeEditorPanel WhereClause="@Request.WhereClause"
                                  PropertyDefinitions="@PropertyDefinitions"
                                  WhereClauseChanged="@OnWhereClauseChanged"
                                  SelectedNodeChanged="@OnSelectedWhereClauseChanged"
                                  AllowDragDrop="@AllowFilterDragDrop"
                                  AutoSelectNewNode="@AutoSelectNewFilterNode"/>
        </MudPaper>
    </MudStack>
</LyoElementRoot>

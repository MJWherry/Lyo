@namespace Lyo.Web.Components.Dialog

<MudDialog Class="lyo-dialog" TitleContent="@GetTitleContent()">
    <DialogContent>
        <div class="lyo-dialog-content" style="@ContentStyle">
            @ChildContent
        </div>
    </DialogContent>
    <DialogActions>
        @if (Busy) {
            <MudProgressCircular Size="Size.Small" Indeterminate Color="Color.Primary" Class="mr-2"/>
        }
        @ExtraActions
        <MudButton OnClick="Close" Variant="Variant.Text" Disabled="@Busy">@CloseText</MudButton>
        @if (OnSave.HasDelegate) {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="OnSave" Disabled="@(Busy || SaveDisabled)">@SaveText</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialogInstance { get; set; } = null!;

    /// <summary>Optional title rendered inside the dialog header. When null (and <see cref="TitleContent" /> is null), the title passed to <c>ShowAsync</c> is used.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Custom header markup; takes precedence over <see cref="Title" />. Use for status chips next to the title.</summary>
    [Parameter]
    public RenderFragment? TitleContent { get; set; }

    /// <summary>Dialog body. Rendered inside a scrollable region capped to the viewport height so long content never pushes the actions off-screen.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Extra buttons rendered before the Close button (e.g. Re-Run, Cancel Run).</summary>
    [Parameter]
    public RenderFragment? ExtraActions { get; set; }

    /// <summary>Additional inline style applied to the scrollable content region.</summary>
    [Parameter]
    public string? ContentStyle { get; set; }

    /// <summary>When set, a primary Save button is rendered that invokes this callback. The dialog is not closed automatically; close it from the callback on success.</summary>
    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>Disables the Save button (e.g. while the form has no changes).</summary>
    [Parameter]
    public bool SaveDisabled { get; set; }

    /// <summary>Shows a progress indicator and disables the action buttons while a save/load is in flight.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Label of the dismiss button. Defaults to "Close".</summary>
    [Parameter]
    public string CloseText { get; set; } = "Close";

    /// <summary>Label of the primary button. Defaults to "Save".</summary>
    [Parameter]
    public string SaveText { get; set; } = "Save";

    private RenderFragment? GetTitleContent()
    {
        if (TitleContent != null)
            return TitleContent;

        if (Title == null)
            return null;

        return @<MudText Typo="Typo.h6">@Title</MudText>;
    }

    private void Close() => MudDialogInstance.Cancel();

}

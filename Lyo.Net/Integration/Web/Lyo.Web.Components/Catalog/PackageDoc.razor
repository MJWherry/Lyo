@using System.Net.Http.Json
@using Lyo.Exceptions
@using Microsoft.Extensions.Logging
@namespace Lyo.Web.Components.Catalog
@inject HttpClient Http
@inject ILogger<PackageDoc> Logger

@if (_loading) {
    <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>

    return;
}

@if (!string.IsNullOrEmpty(_error)) {
    <MudAlert Severity="Severity.Warning">@_error</MudAlert>

    return;
}

@if (_doc is null) {
    <MudAlert Severity="Severity.Info">No catalog entry for <code>@PackageId</code>.</MudAlert>

    return;
}

<MudStack Spacing="3">
    <div>
        <MudText Typo="Typo.overline">@_doc.Area</MudText>
        <MudText Typo="Typo.h4">@_doc.Name</MudText>
        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">@_doc.Tagline</MudText>
    </div>

    <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@_doc.Description</MudText>

    @if (_doc.Features.Count > 0) {
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Features</MudText>
            <ul class="lyo-catalog-list">
                @foreach (var f in _doc.Features) {
                    <li>@f</li>
                }
            </ul>
        </MudPaper>
    }

    @if (_doc.Examples.Count > 0) {
        <MudText Typo="Typo.h5">Examples</MudText>

        @foreach (var ex in _doc.Examples) {
            <div>
                <MudText Typo="Typo.h6" Class="mb-2">@ex.Title</MudText>
                <MudPaper Class="pa-3 mud-background-gray" Elevation="0" Outlined="true">
                    <pre style="margin:0; overflow:auto; font-size:0.85rem;"><code>@ex.Code</code></pre>
                </MudPaper>
            </div>
        }
    }

    @if (_doc.Benchmarks is not null) {
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Benchmarks</MudText>
            @if (!string.IsNullOrWhiteSpace(_doc.Benchmarks.Headline)) {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@_doc.Benchmarks.Headline</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(_doc.Benchmarks.Suite)) {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">suite: @_doc.Benchmarks.Suite</MudChip>
            }
            <ul class="lyo-catalog-list">
                @foreach (var item in _doc.Benchmarks.Items) {
                    <li>
                        <strong>@item.Label</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Note)) {
                            <span> — @item.Note</span>
                        }
                        <div class="mud-text-secondary" style="font-size:0.8rem;">@item.Href</div>
                    </li>
                }
            </ul>
        </MudPaper>
    }

    <CatalogSectionList Sections="_doc.Sections"/>

    @if (_doc.Links.Count > 0) {
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6" Class="mb-2">Links</MudText>
            <ul class="lyo-catalog-list">
                @foreach (var link in _doc.Links) {
                    <li><a href="@link.Href" target="_blank" rel="noopener noreferrer">@link.Label</a></li>
                }
            </ul>
        </MudPaper>
    }
</MudStack>

@code {

    /// <summary>Package id (e.g. <c>Lyo.Cache</c>). Loads <c>_content/Lyo.Web.Components/catalog/packages/{id}.json</c>.</summary>
    [Parameter][EditorRequired]
    public string PackageId { get; set; } = "";

    /// <summary>Optional base path override. Default uses RCL static assets: <c>_content/Lyo.Web.Components/catalog</c>.</summary>
    [Parameter]
    public string CatalogBasePath { get; set; } = "_content/Lyo.Web.Components/catalog";

    private CatalogPackageDoc? _doc;
    private bool _loading = true;
    private string? _error;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _doc = null;
        try {
            ArgumentHelpers.ThrowIfNullOrWhiteSpace(PackageId);
            var url = $"{CatalogBasePath.TrimEnd('/')}/packages/{Uri.EscapeDataString(PackageId)}.json";
            _doc = await Http.GetFromJsonAsync<CatalogPackageDoc>(url, CatalogJson.Options);
        }
        catch (Exception ex) {
            Logger.LogWarning(ex, "Failed to load catalog package {PackageId}", PackageId);
            _error = $"Could not load docs for {PackageId}.";
        }
        finally {
            _loading = false;
        }
    }

}

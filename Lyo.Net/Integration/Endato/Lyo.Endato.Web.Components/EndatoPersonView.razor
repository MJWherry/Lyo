@using Lyo.Web.Components
@using PersonResult = Lyo.Endato.Client.Models.Person.Response.Person
@inject IDialogService DialogService

<LyoDialog DebugData="@Person">
    <TitleContent>
        <MudText Typo="Typo.h6">@(string.IsNullOrWhiteSpace(Person.FullName) ? "Endato person" : Person.FullName)</MudText>
    </TitleContent>
    <TitleChips>
        <LyoChip Variant="Variant.Outlined" Label="@($"Age {Person.Age}")"/>
        @if (Person.IsPremium) {
            <LyoChip Color="Color.Info" Label="Premium"/>
        }
        <LyoChip Spec="@LyoChips.FromBool(Person.IsPublic, "Public", "Private", Color.Success, Color.Default)" Variant="Variant.Outlined"/>
        @if (Person.IsOptedOut) {
            <LyoChip Color="Color.Warning" Label="Opted out"/>
        }
    </TitleChips>
    <ExtraActions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DataObject" OnClick="ShowPersonJson">View JSON</MudButton>
    </ExtraActions>
    <ChildContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Overview">
                <div class="pa-2">
                    <MudExpansionPanels MultiExpansion="true" Elevation="0" Outlined="true" Dense="true">
                        <MudExpansionPanel Text="Name" Expanded="true">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="2">
                                    <MudTextField T="string" Label="Prefix" Value="@EndatoViewHelpers.Field(Person.Name.Prefix)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField T="string" Label="First Name" Value="@EndatoViewHelpers.Field(Person.Name.FirstName)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="2">
                                    <MudTextField T="string" Label="Middle Name" Value="@EndatoViewHelpers.Field(Person.Name.MiddleName)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="3">
                                    <MudTextField T="string" Label="Last Name" Value="@EndatoViewHelpers.Field(Person.Name.LastName)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="2">
                                    <MudTextField T="string" Label="Suffix" Value="@EndatoViewHelpers.Field(Person.Name.Suffix)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="Info">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="2">
                                    <MudTextField T="string" Label="DoB" Value="@EndatoViewHelpers.FormatDate(Person.Dob)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="2">
                                    <MudTextField T="string" Label="Age" Value="@Person.Age.ToString()" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField T="string" Label="DoB First Seen" Value="@EndatoViewHelpers.FormatDate(Person.DobFirstSeen)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" sm="6" md="4">
                                    <MudTextField T="string" Label="DoB Last Seen" Value="@EndatoViewHelpers.FormatDate(Person.DobLastSeen)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string" Label="Locations" Value="@LocationText" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                </MudItem>
                                @if (Indicators.Count > 0) {
                                    <MudItem xs="12">
                                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                            @foreach (var indicator in Indicators) {
                                                <LyoChip Variant="Variant.Outlined" Label="@($"{indicator.Label} {indicator.Count}")"/>
                                            }
                                        </MudStack>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="Metadata">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6" md="4">
                                    <LyoIdField Label="Tahoe ID" Text="@Person.TahoeId"/>
                                </MudItem>
                            </MudGrid>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Addresses ({Person.Addresses?.Count ?? 0})")">
                <div class="pa-2">
                    @if (Person.Addresses is not { Count: > 0 }) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No addresses</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @foreach (var address in Person.Addresses.OrderBy(a => a.AddressOrder)) {
                                <LyoExpandableCard>
                                    <Summary>
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="ID" Text="@address.AddressHash"/>
                                        </MudItem>
                                        <MudItem xs="12" md="9">
                                            <MudTextField T="string" Label="Address" Value="@EndatoViewHelpers.Field(address.FullAddress)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                    </Summary>
                                    <ChildContent>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="City" Value="@EndatoViewHelpers.Field(address.City)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="3" md="2">
                                            <MudTextField T="string" Label="State" Value="@EndatoViewHelpers.Field(address.State)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="6" sm="3" md="2">
                                            <MudTextField T="string" Label="ZIP" Value="@EndatoViewHelpers.Field(address.Zip)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="ZIP+4" Value="@EndatoViewHelpers.Field(address.Zip4)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="County" Value="@EndatoViewHelpers.Field(address.County)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="Unit" Value="@EndatoViewHelpers.Field(address.Unit)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="House Number" Value="@EndatoViewHelpers.Field(address.HouseNumber)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Street Name" Value="@EndatoViewHelpers.Field(address.StreetName)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="Street Type" Value="@EndatoViewHelpers.Field(address.StreetType)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Coordinates" Value="@EndatoViewHelpers.FormatCoordinates(address.Latitude, address.Longitude)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Reported" Value="@EndatoViewHelpers.FormatDateRange(address.FirstReportedDate, address.LastReportedDate)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Source" Value="@EndatoViewHelpers.Field(address.SourceSummary)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" Class="d-flex flex-wrap gap-1">
                                            @if (address.IsDeliverable) {
                                                <LyoChip Variant="Variant.Outlined" Color="Color.Success" Label="Deliverable"/>
                                            }
                                            @if (address.IsPublic) {
                                                <LyoChip Variant="Variant.Outlined" Label="Public"/>
                                            }
                                            @if (address.IsMergedAddress) {
                                                <LyoChip Variant="Variant.Outlined" Label="Merged"/>
                                            }
                                        </MudItem>
                                    </ChildContent>
                                </LyoExpandableCard>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Phones ({Person.PhoneNumbers?.Count ?? 0})")">
                <div class="pa-2">
                    @if (Person.PhoneNumbers is not { Count: > 0 }) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No phone numbers</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @foreach (var phone in Person.PhoneNumbers.OrderBy(p => p.PhoneOrder)) {
                                <LyoExpandableCard>
                                    <Summary>
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="ID" Text="@phone.PhoneNumber"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="5">
                                            <MudTextField T="string" Label="Number" Value="@EndatoViewHelpers.FormatPhone(phone.PhoneNumber)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudSelect T="string" Label="Type" Value="@phone.PhoneType" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                @foreach (var type in PhoneTypes) {
                                                    <MudSelectItem Value="@type">@type</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                    </Summary>
                                    <ChildContent>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Company" Value="@EndatoViewHelpers.Field(phone.Company)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Location" Value="@EndatoViewHelpers.Field(phone.Location)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Reported" Value="@EndatoViewHelpers.FormatDateRange(phone.FirstReportedDate, phone.LastReportedDate)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Coordinates" Value="@EndatoViewHelpers.FormatCoordinates(phone.Latitude, phone.Longitude)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="3">
                                            <MudTextField T="string" Label="Source" Value="@EndatoViewHelpers.Field(phone.SourceSummary)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="6" Class="d-flex flex-wrap gap-1 align-end">
                                            <LyoChip Spec="@LyoChips.FromBool(phone.IsConnected, "Connected", "Disconnected", Color.Success, Color.Default)" Variant="Variant.Outlined"/>
                                            @if (phone.IsPublic) {
                                                <LyoChip Variant="Variant.Outlined" Label="Public"/>
                                            }
                                        </MudItem>
                                    </ChildContent>
                                </LyoExpandableCard>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Emails ({Person.EmailAddresses?.Count ?? 0})")">
                <div class="pa-2">
                    @if (Person.EmailAddresses is not { Count: > 0 }) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No email addresses</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @foreach (var email in Person.EmailAddresses.OrderBy(e => e.EmailOrdinal)) {
                                <LyoExpandableCard>
                                    <Summary>
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="ID" Text="@email.EmailAddress"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="9">
                                            <MudTextField T="string" Label="Email" Value="@EndatoViewHelpers.Field(email.EmailAddress)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                    </Summary>
                                    <ChildContent>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Source" Value="@EndatoViewHelpers.Field(email.SourceSummary)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        @if (email.EmailEngagementData is { } engagement) {
                                            <MudItem xs="12" sm="6" md="2">
                                                <MudTextField T="string" Label="Engagement" Value="@engagement.EngagementScore.ToString()" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudTextField T="string" Label="Best Day" Value="@EndatoViewHelpers.Field(engagement.BestDayOfTheWeek)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="3">
                                                <MudTextField T="string" Label="Best Time" Value="@EndatoViewHelpers.Field(engagement.BestTimeOfTheDay)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                            </MudItem>
                                        }
                                        <MudItem xs="12" Class="d-flex flex-wrap gap-1 align-end">
                                            @if (email.IsPremium) {
                                                <LyoChip Variant="Variant.Outlined" Color="Color.Info" Label="Premium"/>
                                            }
                                            @if (email.NonBusiness != 0) {
                                                <LyoChip Variant="Variant.Outlined" Label="Non-business"/>
                                            }
                                        </MudItem>
                                    </ChildContent>
                                </LyoExpandableCard>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Associates ({AssociateCount})")">
                <div class="pa-2">
                    @if (Person.AssociateSummaries is { Count: > 0 }) {
                        <MudStack Spacing="2">
                            @foreach (var associate in Person.AssociateSummaries.OrderByDescending(a => a.Score)) {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="Tahoe ID" Text="@associate.TahoeId"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Name" Value="@EndatoViewHelpers.FormatName(associate.Prefix, associate.FirstName, associate.MiddleName, associate.LastName, associate.Suffix)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="DoB" Value="@EndatoViewHelpers.FormatDate(associate.Dob)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="1">
                                            <MudTextField T="string" Label="Score" Value="@associate.Score.ToString()" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2" Class="d-flex flex-wrap gap-1 align-end">
                                            @if (associate.IsDeceased) {
                                                <LyoChip Color="Color.Error" Label="Deceased"/>
                                            }
                                            @if (associate.IsPrivate) {
                                                <LyoChip Variant="Variant.Outlined" Label="Private"/>
                                            }
                                            @if (associate.IsOptedOut) {
                                                <LyoChip Color="Color.Warning" Label="Opted out"/>
                                            }
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    else if (Person.Associates is { Count: > 0 }) {
                        <MudStack Spacing="2">
                            @foreach (var associate in Person.Associates) {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="Tahoe ID" Text="@associate.TahoeId"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="9">
                                            <MudTextField T="string" Label="Name" Value="@EndatoViewHelpers.FormatName(associate.Name)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    else {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No associates</MudText>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Relatives ({Person.RelativesSummary?.Count ?? 0})")">
                <div class="pa-2">
                    @if (Person.RelativesSummary is not { Count: > 0 }) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No relatives</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @foreach (var relative in Person.RelativesSummary) {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="3">
                                            <LyoIdField Label="Tahoe ID" Text="@relative.TahoeId"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="Name" Value="@EndatoViewHelpers.FormatName(relative.Prefix, relative.FirstName, relative.MiddleName, relative.LastName, relative.Suffix)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="Type" Value="@EndatoViewHelpers.Field(relative.RelativeType)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="1">
                                            <MudTextField T="string" Label="Level" Value="@EndatoViewHelpers.Field(relative.RelativeLevel)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="2">
                                            <MudTextField T="string" Label="DoB" Value="@EndatoViewHelpers.FormatDate(relative.Dob)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Names ({AkaCount})")">
                <div class="pa-2">
                    @if (AkaCount == 0) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No alternate names</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @if (Person.Akas is { Count: > 0 }) {
                                @foreach (var aka in Person.Akas) {
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" sm="6" md="2">
                                                <LyoChip Variant="Variant.Outlined" Label="AKA"/>
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="6">
                                                <MudTextField T="string" Label="Name" Value="@EndatoViewHelpers.FormatName(aka)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                            </MudItem>
                                            <MudItem xs="12" sm="6" md="4">
                                                <MudTextField T="string" Label="First Seen" Value="@EndatoViewHelpers.FormatDate(aka.PublicFirstSeenDate)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                }
                            }
                            @foreach (var merged in Person.MergedNames ?? []) {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="2">
                                            <LyoChip Variant="Variant.Outlined" Label="Merged"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="6">
                                            <MudTextField T="string" Label="Name" Value="@EndatoViewHelpers.FormatName(merged)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="4">
                                            <MudTextField T="string" Label="First Seen" Value="@EndatoViewHelpers.FormatDate(merged.PublicFirstSeenDate)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@($"Death records ({Person.DeathRecords?.Count ?? 0})")">
                <div class="pa-2">
                    @if (Person.DeathRecords is not { Count: > 0 }) {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No death records</MudText>
                    }
                    else {
                        <MudStack Spacing="2">
                            @foreach (var record in Person.DeathRecords) {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                    <MudGrid Spacing="2">
                                        <MudItem xs="12" sm="6" md="3" Class="d-flex align-end">
                                            <LyoChip Spec="@LyoChips.FromBool(record.IsDeceased, "Deceased", "Not deceased", Color.Error, Color.Default)"/>
                                        </MudItem>
                                        <MudItem xs="12" sm="6" md="9">
                                            <MudTextField T="string" Label="Source" Value="@EndatoViewHelpers.Field(record.SourceSummary)" Placeholder="@EndatoViewHelpers.NullPlaceholder" ReadOnly Variant="Variant.Outlined" Margin="Margin.Dense"/>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </div>
            </MudTabPanel>
        </MudTabs>
    </ChildContent>
</LyoDialog>

@code {

    /// <summary>Live Endato Person Search result to display.</summary>
    [Parameter]
    [EditorRequired]
    public PersonResult Person { get; set; } = null!;

    private IReadOnlyList<(string Label, int Count)> Indicators => EndatoViewHelpers.ActiveIndicators(Person.Indicators);

    private int AssociateCount => Person.AssociateSummaries is { Count: > 0 } summaries ? summaries.Count : Person.Associates?.Count ?? 0;

    private int AkaCount => (Person.Akas?.Count ?? 0) + (Person.MergedNames?.Count ?? 0);

    private IReadOnlyList<string> PhoneTypes => EndatoViewHelpers.PhoneTypeOptions(null, Person.PhoneNumbers?.Select(p => p.PhoneType) ?? []);

    private string LocationText
        => Person.Locations is { Count: > 0 } ? string.Join("; ", Person.Locations.Select(l => $"{l.City}, {l.State}")) : "";

    private async Task ShowPersonJson()
    {
        var parameters = new DialogParameters<JsonViewDialog<PersonResult>> { { i => i.Data, Person } };
        await DialogService.ShowAsync(typeof(JsonViewDialog<PersonResult>), Person.FullName, parameters, LyoDialogPresets.Medium);
    }

}

@using Lyo.Web.Components
@inject IDialogService DialogService

@if (Response == null) {
    <MudText Typo="Typo.body2" Color="Color.Secondary">Run contact enrichment to see results.</MudText>
}
else {
    <MudStack Spacing="2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary">Identity score @Response.IdentityScore</MudChip>
            <MudChip T="string" Size="Size.Small" Color="Color.Default">@Response.TotalRequestExecutionTimeMs ms</MudChip>
            @if (Response.IsError) {
                <MudChip T="string" Size="Size.Small" Color="Color.Error">Error</MudChip>
            }
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ShowResponseJson">View full response JSON</MudButton>
        </MudStack>

        @if (Response.Error?.InputErrors is { Count: > 0 }) {
            <MudAlert Severity="Severity.Error" Dense="true">
                @string.Join("; ", Response.Error.InputErrors)
            </MudAlert>
        }

        @if (Response.Person == null) {
            <MudAlert Severity="Severity.Info" Dense="true">No enriched person returned.</MudAlert>
        }
        else {
            var person = Response.Person;
            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">@person.Name.FirstName @person.Name.MiddleName @person.Name.LastName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Age @person.Age</MudText>

                    @if (person.Phones.Count > 0) {
                        <MudText Typo="Typo.subtitle2">Phones</MudText>

                        <MudText Typo="Typo.body2">@EndatoContactFormatter.FormatEnrichmentPhones(person.Phones)</MudText>
                    }

                    @if (person.Emails.Count > 0) {
                        <MudText Typo="Typo.subtitle2">Emails</MudText>

                        <MudText Typo="Typo.body2">@EndatoContactFormatter.FormatEnrichmentEmails(person.Emails)</MudText>
                    }

                    @if (person.Addresses.Count > 0) {
                        <MudText Typo="Typo.subtitle2">Addresses</MudText>

                        <MudList T="string" Dense="true">
                            @foreach (var address in person.Addresses) {
                                <MudListItem T="string">@address.Street @address.Unit — @address.City, @address.State @address.Zip</MudListItem>
                            }
                        </MudList>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}

@code {

    [Parameter]
    public EnrichmentResponse? Response { get; set; }

    private async Task ShowResponseJson()
    {
        if (Response == null)
            return;

        await Task.Yield();
        var parameters = new DialogParameters<JsonViewDialog<EnrichmentResponse>> { { i => i.Data, Response } };
        await DialogService.ShowAsync(typeof(JsonViewDialog<EnrichmentResponse>), "Enrichment Response", parameters, LyoDialogPresets.Medium);
    }

}

@using Lyo.Web.Components
@using PersonResult = Lyo.Endato.Client.Models.Person.Response.Person
@inject IDialogService DialogService

@if (Response == null) {
    <MudText Typo="Typo.body2" Color="Color.Secondary">Run a person search to see results.</MudText>
}
else {
    <MudStack Spacing="2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudChip T="string" Size="Size.Small" Color="Color.Default">@Response.Persons.Count person(s)</MudChip>
            @if (Response.Pagination != null) {
                <MudChip T="string" Size="Size.Small" Color="Color.Info">Page @Response.Pagination.CurrentPageNumber / @Response.Pagination.TotalPages</MudChip>
            }
            @if (Response.Counts != null) {
                <MudChip T="string" Size="Size.Small" Color="Color.Default">Expected @Response.Counts.ExpectedCount</MudChip>
            }
            <MudChip T="string" Size="Size.Small" Color="Color.Default">@Response.TotalRequestExecutionTimeMs ms</MudChip>
            @if (Response.IsError) {
                <MudChip T="string" Size="Size.Small" Color="Color.Error">Error</MudChip>
            }
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Response.RequestId</MudText>
        </MudStack>

        @if (Response.Error?.InputErrors is { Count: > 0 }) {
            <MudAlert Severity="Severity.Error" Dense="true">
                @string.Join("; ", Response.Error.InputErrors)
            </MudAlert>
        }

        @if (Response.Persons.Count == 0) {
            <MudAlert Severity="Severity.Info" Dense="true">No persons returned.</MudAlert>
        }
        else {
            <MudTable Items="@Response.Persons" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Age</MudTh>
                    <MudTh>DoB</MudTh>
                    <MudTh>Tahoe ID</MudTh>
                    <MudTh>Contacts</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.FullName</MudTd>
                    <MudTd DataLabel="Age">@context.Age</MudTd>
                    <MudTd DataLabel="DoB">@context.Dob</MudTd>
                    <MudTd DataLabel="Tahoe ID">@context.TahoeId</MudTd>
                    <MudTd DataLabel="Contacts">
                        @context.PhoneNumbers.Count phones, @context.EmailAddresses.Count emails, @context.Addresses.Count addresses
                    </MudTd>
                    <MudTd>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                            <MudMenuItem OnClick="@(() => ShowPersonJson(context))">View JSON</MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
                <ChildRowContent>
                    <MudTr>
                        <td colspan="6">
                            <MudStack Spacing="2" Class="pa-2">
                                @if (context.Locations is { Count: > 0 }) {
                                    <MudText Typo="Typo.caption"><strong>Locations:</strong> @string.Join("; ", context.Locations.Select(l => $"{l.City}, {l.State}"))</MudText>
                                }
                                @if (context.PhoneNumbers.Count > 0) {
                                    <MudText Typo="Typo.caption"><strong>Mobile phones:</strong> @EndatoContactFormatter.FormatPossibleNumbers(context.PhoneNumbers)</MudText>
                                }
                                @if (context.EmailAddresses.Count > 0) {
                                    <MudText Typo="Typo.caption"><strong>Emails:</strong> @EndatoContactFormatter.FormatPossibleEmails(context.EmailAddresses)</MudText>
                                }
                                @if (context.Addresses.Count > 0) {
                                    <MudText Typo="Typo.caption"><strong>Top address:</strong> @context.Addresses[0].FullAddress</MudText>
                                }
                                @if (context.Associates?.Count > 0) {
                                    <MudText Typo="Typo.caption"><strong>Associates:</strong> @context.Associates.Count</MudText>
                                }
                            </MudStack>
                        </td>
                    </MudTr>
                </ChildRowContent>
            </MudTable>
        }
    </MudStack>
}

@code {

    [Parameter]
    public PersonQueryResponse? Response { get; set; }

    private async Task ShowPersonJson(PersonResult person)
    {
        await Task.Yield();
        var parameters = new DialogParameters<JsonViewDialog<PersonResult>> { { i => i.Data, person } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync(typeof(JsonViewDialog<PersonResult>), person.FullName, parameters, options);
    }

}

        <RootNamespace>Lyo.Discord.Postgres</RootNamespace>
        <Description>PostgreSQL persistence for Discord entities (EF Core, schema discord).</Description>
        <PackageTags>discord postgres postgresql entityframework ef</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Mapster"/>

{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.HomeInventory.Api",
  "name": "Lyo.HomeInventory.Api",
  "area": "Apps",
  "tagline": "HTTP mapping for the Lyo HomeInventory API (`BuildHomeInventoryGroup`).",
  "description": "Maps CRUD on `HomeInventoryDbContext` entities (categories, locations, items, movements) via `Lyo.Api` `CreateBuilder` with entity-as-both DTOs. Stock rows use a composite key and are not mapped. Register with `AddHomeInventoryApiFromConfiguration`, then call `BuildHomeInventoryGroup`. Standalone host: `Lyo.HomeInventory.Api.Host`.",
  "features": [
    "`BuildHomeInventoryGroup` maps CRUD for categories, locations, items, and movements.",
    "`AddHomeInventoryApiFromConfiguration` registers the Postgres store, CRUD services, and an identity `ILyoMapper` for entity-as-both mapping."
  ],
  "examples": [
    {
      "title": "Map the HomeInventory API",
      "language": "csharp",
      "code": "services.AddLocalCache();\nservices.AddLyoQueryServices();\nservices.AddHomeInventoryApiFromConfiguration(configuration);\nvar app = builder.Build();\napp.BuildHomeInventoryGroup();"
    }
  ],

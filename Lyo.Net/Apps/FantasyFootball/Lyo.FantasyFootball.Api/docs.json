{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.FantasyFootball.Api",
  "name": "Lyo.FantasyFootball.Api",
  "area": "Apps",
  "tagline": "HTTP API that syncs fantasy football chats and trades.",
  "description": "Reads come from `IFantasyFootballStore`. Refresh and writes call `FantasyFootballClient`, then upsert what ESPN returns. ESPN cookies stay on the host. `AddFantasyFootballApiForWorkbench` registers the store with automatic migrations. `MapFantasyFootballApi` maps group `FantasyFootball`. A production host should require auth: these routes can post chat messages and trades.",
  "features": [
    "`POST /{leagueId}/{seasonId}/refresh` loads the league, roster, chats, and trades.",
    "Chat routes list topics, list messages, post to a topic, and post to an existing direct message.",
    "Trade routes list, propose, and respond with accept, decline, uphold, or veto."
  ],
  "examples": [
    {
      "title": "Embed in a workbench host",
      "language": "csharp",
      "code": "services.AddFantasyFootballClientFromConfiguration(configuration);\nservices.AddFantasyFootballApiForWorkbench(connectionString);\napp.MapFantasyFootballApi(allowAnonymous: true);"
    }
  ],

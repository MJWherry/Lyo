<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Lyo.Job.Workers.Notification</RootNamespace>
        <Description>Job workers that send notifications as workflow steps: webhook POST, email, and SMS. A send failure fails the job run so the queue's retry, backoff, and DLQ apply.</Description>
        <PackageTags>jobs workflow notifications webhook email sms workers</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Job.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\Communication\Email\Lyo.Email\Lyo.Email.csproj"/>
        <ProjectReference Include="..\..\..\Communication\Sms\Lyo.Sms\Lyo.Sms.csproj"/>
        <ProjectReference Include="..\..\Http\Lyo.Http.Client\Lyo.Http.Client.csproj"/>
        <ProjectReference Include="..\Lyo.Job.Client\Lyo.Job.Client.csproj"/>
        <ProjectReference Include="..\Lyo.Job.Worker\Lyo.Job.Worker.csproj"/>
    </ItemGroup>

</Project>

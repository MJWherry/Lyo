@namespace Lyo.Web.Components.Export.Yaml

@* Host must be a Parameter — MudMenu popovers do not reliably receive cascading values *@
<MudMenuItem Icon="@Icons.Material.Filled.Subject"
             Disabled="@(ExportHost is null || !ExportHost.CanExport)"
             OnClick="@ExportYamlAsync">
    Export as YAML
</MudMenuItem>

@namespace Lyo.Web.Components.Catalog

@if (Sections is { Count: > 0 }) {
    @foreach (var sec in Sections) {
        @if (!string.IsNullOrWhiteSpace(sec.Title)) {
            <MudText Typo="Typo.h6" Class="mt-4 mb-2">@sec.Title</MudText>
        }

        @switch (sec.Type) {
            case "paragraph":
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space: pre-wrap;">@sec.Text</MudText>

                break;
            case "list":
                @if (sec.Ordered == true) {
                    <ol class="lyo-catalog-list">
                        @foreach (var item in sec.Items ?? []) {
                            <li>@((MarkupString)FormatInline(item))</li>
                        }
                    </ol>
                }
                else {
                    <ul class="lyo-catalog-list">
                        @foreach (var item in sec.Items ?? []) {
                            <li>@((MarkupString)FormatInline(item))</li>
                        }
                    </ul>
                }

                break;
            case "code":
                <MudPaper Class="pa-3 mb-3 mud-background-gray" Elevation="0" Outlined="true">
                    <pre style="margin:0; overflow:auto; font-size:0.85rem;"><code>@sec.Code</code></pre>
                </MudPaper>

                break;
            case "table":
                @if (!string.IsNullOrWhiteSpace(sec.Lead)) {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2" Style="white-space: pre-wrap;">@sec.Lead</MudText>
                }

                <MudSimpleTable Dense="true" Bordered="true" Striped="true" Class="mb-2">
                    <thead>
                    <tr>
                        @foreach (var header in sec.Headers ?? []) {
                            <th>@header</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in sec.Rows ?? []) {
                        <tr>
                            @foreach (var cell in row) {
                                <td style="white-space: pre-wrap;">@cell</td>
                            }
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>

                @if (!string.IsNullOrWhiteSpace(sec.Trail)) {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space: pre-wrap;">@sec.Trail</MudText>
                }

                break;
            case "markdown":
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="white-space: pre-wrap;">@sec.Body</MudText>

                break;
        }
    }
}

@namespace Lyo.Web.Components.ParamTable
@using Microsoft.AspNetCore.Components.Web

<div class="@DropClass"
     style="@DragStyle"
     @ondragover:preventDefault="AllowReorder"
     @ondragenter="@(() => OnDragEnter.InvokeAsync())"
     @ondrop="@(() => OnDrop.InvokeAsync())"
     @ondrop:preventDefault="AllowReorder">
    <MudPaper Outlined="true" Elevation="0" Class="pa-3">
        <MudStack Spacing="2">
            <MudStack Row Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                @if (AllowReorder) {
                    <span draggable="true" title="Drag to reorder" class="lyo-param-card-handle"
                          @ondragstart="@(e => OnDragStart.InvokeAsync(e))"
                          @ondragend="@(() => OnDragEnd.InvokeAsync())">
                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" Class="mud-text-secondary"/>
                    </span>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@(Item.Order + 1)</MudText>
                }
                <MudIconButton Icon="@(Expanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                               Size="Size.Small"
                               title="@(Expanded ? "Collapse details" : "Expand details")"
                               OnClick="@(() => OnToggleExpanded.InvokeAsync())"/>
                <div class="lyo-param-card-key">
                    <LyoParameterKeyField Key="@Item.Key" KeyChanged="KeyChanged" InheritFrom="InheritFrom" Label="Key"/>
                </div>
                <LyoTypeChip TypeName="@Item.Type" Variant="Variant.Outlined"/>
                @if (Item.IsNew) {
                    <LyoChip Color="Color.Success" Label="New"/>
                }
                <MudSpacer/>
                <LyoParameterFlags Item="Item"
                                   Horizontal="true"
                                   ShowRequired="ShowRequired"
                                   ShowEncrypt="ShowEncrypt"
                                   ShowEnabled="ShowEnabled"
                                   RequiredChanged="RequiredChanged"
                                   EncryptChanged="EncryptChanged"
                                   EnabledChanged="EnabledChanged"/>
                <MudStack Row Spacing="0" AlignItems="AlignItems.Center">
                    @if (AllowReorder) {
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" title="Move up"
                                       Disabled="@(!CanMoveUp)" OnClick="@(() => OnMoveUp.InvokeAsync())"/>
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" title="Move down"
                                       Disabled="@(!CanMoveDown)" OnClick="@(() => OnMoveDown.InvokeAsync())"/>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" title="Delete parameter"
                                   OnClick="@(() => OnDelete.InvokeAsync())"/>
                </MudStack>
            </MudStack>
            @if (Expanded) {
                <LyoParameterDetails Item="Item"
                                     ShowType="true"
                                     ShowOptionsEditor="ShowOptionsEditor"
                                     ShowDefaultKind="ShowDefaultKind"
                                     ApiClient="ApiClient"
                                     SiblingValues="SiblingValues"
                                     DefaultValueHint="@DefaultValueHint"
                                     FormatterContext="@FormatterContext"
                                     TypeChanged="TypeChanged"
                                     OnChanged="OnChanged"/>
            }
        </MudStack>
    </MudPaper>
</div>

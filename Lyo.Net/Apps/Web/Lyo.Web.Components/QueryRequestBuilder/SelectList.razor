@using Lyo.Web.Primitives.ChipInput
<LyoElementRoot ElementId="@ElementId" DefaultId="lyo-select-list">
    <MudStack Spacing="1">
        <MudText Typo="Typo.body2" Color="Color.Secondary">Select</MudText>
        <LyoChipInput Values="@SelectAll"
                      ValuesChanged="@OnValuesChanged"
                      SelectedValues="@Select"
                      SelectedValuesChanged="@OnSelectedChanged"
                      SelectableChips="true"
                      ValidationPattern="^[A-Za-z]+(\[(?:\d+|\d*:\d*)\])?(?:\.[A-Za-z]+(\[(?:\d+|\d*:\d*)\])?)*$"
                      ValidationErrorMessage="Only letters (a-z, A-Z), dots, and a window ([n], [start:], [:end], [start:end], [:]) are allowed."
                      Placeholder="Property path (e.g. Id, JobDefinition.Name, or LastName[0]), press Enter to add"/>
    </MudStack>
</LyoElementRoot>


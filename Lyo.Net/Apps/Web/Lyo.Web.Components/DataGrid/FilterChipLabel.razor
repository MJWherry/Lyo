@using LyoHoverPopover = Lyo.Web.Components.Popover.LyoHoverPopover
@namespace Lyo.Web.Components.DataGrid

<LyoElementRoot RootTag="span"
                ElementId="@ElementId"
                DefaultId="lyo-filter-chip-label"
                class="d-inline-flex align-center lyo-filter-chip-label"
                style="gap: 2px; min-width: 0; max-width: 100%;">
    @if (ChipLabelHelper.ShouldTruncate(Text, MaxLength)) {
        <LyoHoverPopover Text="@DialogBodyText" Title="Filter" Pinnable="false">
            <span
                style="display:inline-block;min-width:0;max-width:100%;white-space:nowrap;overflow:hidden;vertical-align:bottom;">@ChipLabelHelper.TruncateLabel(Text, MaxLength)</span>
        </LyoHoverPopover>

        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                       Size="Size.Small"
                       Class="ma-0 pa-0 lyo-filter-chip-view-btn"
                       Color="Color.Inherit"
                       aria-label="View full filter"

                       @onclick:stopPropagation="true"/>
    }
    else {
        <span style="min-width:0;">@Text</span>
    }
</LyoElementRoot>

<MudDialog @bind-Visible="_viewDialogOpen" Options="_viewDialogOptions">
    <TitleContent>Filter</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; word-break: break-word; max-height: 65vh; overflow: auto;">@DialogBodyText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _viewDialogOpen = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

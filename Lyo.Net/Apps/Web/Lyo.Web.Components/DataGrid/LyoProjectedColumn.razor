@using Lyo.Web.Components.Form

<TemplateColumn T="object?"
                Title="@Title"
                Sortable="@Sortable"
                SortBy="@GetSortValue"
                InitialDirection="@InitialDirection"
                Hideable="@Hideable"
                Resizable="@Resizable"
                Tag="@GetApiSortKey()"
                HeaderStyle="@EffectiveHeaderStyle"
                HeaderClass="@EffectiveHeaderClass"
                CellStyle="@EffectiveCellStyle"
                CellClass="@EffectiveCellClass"
                Hidden="@(VisibilityBinder?.IsHidden(Field) ?? false)"
                HiddenChanged="@OnHiddenChanged">
    <CellTemplate Context="cell">
        @Cell(cell.Item)
    </CellTemplate>
</TemplateColumn>

@code {

    /// <summary>Cell markup for one row, rendered by the table cell and by the mobile card layout so a value looks the same in both.</summary>
    internal RenderFragment<object?> Cell => item =>
        @<text>
            @if (CellContent != null) {
                @CellContent(item)
            }
            else if (Timestamp is { } kind) {
                var raw = ProjectedValueHelper.GetValue(item, Field);
                var value = TimestampLatest ? LyoDateTimeDisplay.Latest(raw) : raw;
                <LyoTimestamp Value="@value" Kind="@kind" RelativeWindow="@TimestampRelativeWindow"/>
            }
            else if (Identifier) {
                <LyoIdField Compact="true" Text="@ProjectedValueHelper.GetDisplayValue(item, Field)"/>
            }
            else {
                string displayText;
                if (FormattedValue != null) {
                    var raw = ProjectedValueHelper.GetValue(item, Field);
                    displayText = FormattedValue(item, raw);
                }
                else {
                    displayText = ProjectedValueHelper.GetDisplayValue(item, Field);
                }

                @if (MaxDisplayLength is int maxLen) {
                    <LyoTruncatedText Text="@displayText" MaxLength="@maxLen" Title="@Title"/>
                }
                else if (!string.IsNullOrEmpty(QuickSearchPropertyName) && !string.IsNullOrEmpty(QuickSearchText)) {
                    <MudHighlighter Text="@displayText" HighlightedText="@QuickSearchText"/>
                }
                else {
                    @displayText
                }
            }
        </text>;

}

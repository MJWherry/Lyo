{
  "$schema": "../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.HomeInventory.Api.Example",
  "name": "Lyo.HomeInventory.Api.Example",
  "area": "Examples",
  "tagline": "Example ASP.NET host for the Lyo HomeInventory API.",
  "description": "Runnable example: `AddHomeInventoryApiFromConfiguration` and `BuildHomeInventoryGroup`, plus a keyed local-disk FileStorage API at `FileStorage` (`AddHomeInventoryFileStorage`). Demo wiring (local cache, OpenAPI/Scalar, auto-migrate). Prefer embedding those calls in another host when composing APIs. Not packed to NuGet. Binds http://localhost:5102 (see Properties/launchSettings.json).",
  "features": [
    "OpenAPI and Scalar in Development only.",
    "Local cache + query services as required by HomeInventory CRUD.",
    "Keyed local `IFileStorageService` at `FileStorage` and `DiskFileStorage:RootDirectoryPath`."
  ],
  "examples": [
    {
      "title": "Start the example host",
      "language": "bash",
      "code": "dotnet run --project Lyo.Net/Examples/Lyo.HomeInventory.Api.Example"
    }
  ],

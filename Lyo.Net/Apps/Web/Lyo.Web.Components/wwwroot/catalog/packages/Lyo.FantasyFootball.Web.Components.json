{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.FantasyFootball.Web.Components",
  "name": "Lyo.FantasyFootball.Web.Components",
  "area": "Plugins",
  "tagline": "Blazor workbench for fantasy football chats and trades.",
  "description": "`FantasyFootballWorkbench` injects `IApiClient` and talks to the FantasyFootball HTTP API. Pass `LeagueId`, `SeasonId`, and an optional `RoutePrefix` (default `FantasyFootball`).",
  "features": [
    "Refresh pulls ESPN through the API, then reloads chats and trades from the store.",
    "Chats lists league chat and direct messages, then posts to the open topic.",
    "Trades lists recent and pending proposals and proposes from the stored roster."
  ],
  "examples": [
    {
      "title": "Host the workbench",
      "language": "razor",
      "code": "<FantasyFootballWorkbench LeagueId=\"leagueId\" SeasonId=\"seasonId\" />"
    }
  ],

{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Web.Automation.Client",
  "name": "Lyo.Web.Automation.Client",
  "area": "Apps",
  "tagline": "Typed HTTP client for automation plans and runs. The browser stays on the API host.",
  "description": "Wraps `IApiClient` for the automation routes in `Lyo.Web.Automation.Core.Constants.Rest`. The browser stays on the API host. This client lists, creates, reads, and saves plans, then posts a run and reads status, finished steps, the transcript, viewport snapshots, and one step screenshot.",
  "features": [],
  "examples": [
    {
      "title": "Wire into DI",
      "language": "csharp",
      "code": "services.AddLyoApiClient();\nservices.AddAutomationPlanClient<ApiClient>();\n\nvar client = sp.GetRequiredService<IAutomationPlanClient>();\nvar accepted = await client.StartAsync(new AutomationRunReq {\n    Plan = plan,\n    Headless = true\n});"
    }
  ],
  "sections": [
    {
      "type": "paragraph",
      "title": "Prefix on routes",
      "text": "If `AutomationPlanClientOptions.RoutePrefix` is set, every route is `{prefix}/Automation/...`, including `Plan` and `Run`. An empty prefix keeps routes relative and uses `HttpClient.BaseAddress`."
    }
  ],

{
  "id": "Lyo.Law.Web.Components",
  "name": "Lyo.Law.Web.Components",
  "area": "Plugins",
  "tagline": "Blazor grid and reader for state statute nodes.",
  "description": "`LawNodeGrid` lists nodes with QueryProject and does not select body. `LawNodeView` shows the citation, an encoded body, notes, and child headings, and saves through `ILawClient`. This package has no `AddXxx` DI registration.",
  "features": [
    "`LawNodeGrid` filters by state, code, kind, label, citation, and heading.",
    "`LawNodeView` loads one node and upserts heading, body, and notes."
  ],
  "examples": [
    {
      "title": "Host page",
      "language": "razor",
      "code": "<LawNodeGrid ApiClient=\"ApiClient\" LawClient=\"LawClient\" />"
    }
  ],

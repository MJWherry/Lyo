{
  "id": "Lyo.Docx",
  "name": "Lyo.Docx",
  "area": "Data",
  "tagline": "Read Word documents and fill {Token} placeholders.",
  "description": "Opens a .docx, returns paragraph and table text, and writes SmartFormat {Token} replacements back into the package. A token split across runs is joined before it is replaced.",
  "features": [
    "ReadText returns paragraph and table text.",
    "Fill replaces {Token} placeholders and leaves unknown tokens in place."
  ],
  "examples": [
    {
      "title": "Fill a name token",
      "language": "csharp",
      "code": "var docx = new DocxService(new FormatterService());\nvar filled = docx.Fill(bytes, new { Name = \"Ada\" });"
    }
  ],
  "readmePath": "Lyo.Net/Data/Docx/Lyo.Docx/README.md",

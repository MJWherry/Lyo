{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Algorithms.Client",
  "name": "Lyo.Algorithms.Client",
  "area": "Apps",
  "tagline": "Typed HTTP client for the Lyo algorithm catalog API.",
  "description": "Calls list, get, revision append, revert, label, delete, and preview routes on `Lyo.Algorithms.Api`. Sit it on an `IApiClient`. `DeleteAsync` removes one key. `PreviewAsync` is the one remote run and does not persist. Saved keys still execute in-process on `IAlgorithmRegistry`.",
  "features": [
    "`IAlgorithmClient` methods match `BuildAlgorithmsGroup` routes and return `*Res` types. `PreviewAsync` posts `AlgorithmPreviewReq`.",
    "`AddAlgorithmClient`, the options instance, and `AddAlgorithmClientFromConfiguration` (section `AlgorithmClientOptions`)."
  ],
  "examples": [
    {
      "title": "Register the client",
      "language": "csharp",
      "code": "services.AddLyoApiClient();\nservices.AddAlgorithmClient<ApiClient>();"
    }
  ],

{
  "id": "Lyo.HomeInventory.Web.Components",
  "name": "Lyo.HomeInventory.Web.Components",
  "area": "Plugins",
  "tagline": "Blazor / MudBlazor workbench for household inventory.",
  "description": "Drop `HomeInventoryManagement` on a host page for Items, Locations (rooms), Categories, and Movements. The Locations tab is a selectable room tree plus inspector (items in the selected room). Item editor is a medium dialog with category, product-key rows, stock, notes, `LyoChipInput` tags, and `LyoFileUpload` attachments via FileStorage `save-stream`. Uses an injected `IApiClient`. This package has no `AddXxx` DI registration.",
  "features": [
    "`HomeInventoryManagement` tab shell.",
    "`HomeLocationTree` selectable rooms with inspector items (name-then-add child room).",
    "`HomeItemView` dense editor: category select, product-key kind/value/note rows, `LyoChipInput` tags, `LyoFileUpload` attachments."
  ],
  "examples": [
    {
      "title": "Host page",
      "language": "razor",
      "code": "<HomeInventoryManagement BaseRoute=\"HomeInventory\" FileStorageApiRoutePrefix=\"Workbench/FileStorage\" />"
    }
  ],
  "sections": [],
  "links": [],

{
  "id": "Lyo.Audiobook.Postgres",
  "name": "Lyo.Audiobook.Postgres",
  "area": "Plugins",
  "tagline": "PostgreSQL and EF Core implementation of `Lyo.Audiobook.IAudiobookStore`.",
  "description": "PostgreSQL and EF Core implementation of `Lyo.Audiobook.IAudiobookStore` (`PostgresAudiobookStore`) via `AudiobookDbContext`, schema `audiobook`, and `AddPostgresMigrations`. `PostgresAudiobookStore` implements `Lyo.Health.IHealth`.",
  "features": [
    "**Schema `audiobook`.** Works, chapters, credits, identifiers, genres, and series.",
    "**Constraints.** Unique slug, identifier `(scheme, normalized value)`, and chapter number per work.",
    "**Text.** Stored `tsvector` columns and GIN indexes on work and chapter transcripts.",
    "**DI.** `AddAudiobookDbContextFactory` / `AddPostgresAudiobookStore` and `FromConfiguration` overloads (section `PostgresAudiobook`)."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "services.AddPostgresAudiobookStore(o => {\n    o.ConnectionString = connStr;\n    o.EnableAutoMigrations = true;\n});"
    }
  ],

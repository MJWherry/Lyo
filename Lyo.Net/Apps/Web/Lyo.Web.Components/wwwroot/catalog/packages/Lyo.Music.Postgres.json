{
  "id": "Lyo.Music.Postgres",
  "name": "Lyo.Music.Postgres",
  "area": "Plugins",
  "tagline": "PostgreSQL and EF Core implementation of `Lyo.Music.IMusicStore` via `MusicDbContext` and `PostgresMusicOptions`.",
  "description": "PostgreSQL and EF Core implementation of `Lyo.Music.IMusicStore` (`PostgresMusicStore`) via `MusicDbContext`, schema `music`, and `AddPostgresMigrations`. `PostgresMusicStore` implements `Lyo.Health.IHealth`.",
  "features": [
    "**Schema `music`.** Release groups, releases, tracks, credits, identifiers, genres, formats, and recordings.",
    "**Constraints.** Unique slug, catalog-wide `(scheme, normalized_value)`, track position, and filtered unique ISRC.",
    "**Text.** Stored `tsvector` and a GIN index on track lyrics.",
    "**DI.** `AddMusicDbContextFactory` / `AddPostgresMusicStore` and `FromConfiguration` overloads (section `PostgresMusic`)."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "services.AddPostgresMusicStore(o => {\n    o.ConnectionString = connStr;\n    o.EnableAutoMigrations = true;\n});"
    }
  ],

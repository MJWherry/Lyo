{
  "id": "Lyo.Recipe.Postgres",
  "name": "Lyo.Recipe.Postgres",
  "area": "Plugins",
  "tagline": "PostgreSQL and EF Core implementation of `Lyo.Recipe.IRecipeStore` via `RecipeDbContext` and `PostgresRecipeOptions`.",
  "description": "PostgreSQL and EF Core implementation of `Lyo.Recipe.IRecipeStore` (`PostgresRecipeStore`) via `RecipeDbContext`, `PostgresRecipeOptions`, and `AddPostgresMigrations<RecipeDbContext, PostgresRecipeOptions>`. `PostgresRecipeStore` implements `Lyo.Health.IHealth` (`recipe-postgres`).",
  "features": [
    "**DI.** `AddRecipeDbContextFactory` / `AddPostgresRecipeStore` and `FromConfiguration` overloads (section `PostgresRecipe`).",
    "Schema `recipe`. Unique slug per tenant. Units are unique by abbreviation. Ingredient lines link to steps through `ingredient_line_step`. Replacing steps keeps sent ids and deletes attachments for omitted steps."
  ],
  "examples": [
    {
      "title": "Register the store",
      "language": "csharp",
      "code": "services.AddPostgresRecipeStore(new PostgresRecipeOptions {\n    ConnectionString = \"...\",\n    EnableAutoMigrations = true\n});"
    }
  ],

{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Reporting.Seed",
  "name": "Lyo.Reporting.Seed",
  "area": "Plugins",
  "tagline": "EF seed of the report design sample definitions and one succeeded generation each.",
  "description": "`ReportingEfSeedContributor` writes `ReportDesignTemplates.Samples` as report definitions, including their parameters, into schema `reporting`. Each definition gets one succeeded generation whose `ReportDataJson` is copied from the definition, and one generation parameter per definition parameter. `SeedOptions.Count` is ignored. `OnClear` deletes generations and parameters before definitions so `--replace` can run.",
  "features": [
    "**Samples.** The same starter compositions the design workbench and the Test Gateway API seed use.",
    "**Replace.** `OnClear` deletes generation parameters, generations, definition parameters, then definitions."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "services.AddLyoSeed();\nservices.AddSeedContributor<ReportingEfSeedContributor>();"
    }
  ],

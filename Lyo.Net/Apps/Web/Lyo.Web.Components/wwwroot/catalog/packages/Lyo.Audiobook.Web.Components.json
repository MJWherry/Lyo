{
  "id": "Lyo.Audiobook.Web.Components",
  "name": "Lyo.Audiobook.Web.Components",
  "area": "Plugins",
  "tagline": "Blazor search and detail for audiobooks.",
  "description": "Blazor components for browsing an audiobook catalog. `AudiobookSearch` asks the host to search. `AudiobookDetail` shows overview, credits, and chapters. Cover URLs and tag lists come from the host. Components do not take a database context.",
  "features": [
    "**Search.** Title, year, and an optional tag list. The catalog store does not apply tags; the host does.",
    "**Detail.** Runtime, overview, credits, and chapters in the order the host loaded them."
  ],
  "examples": [
    {
      "title": "Host wiring",
      "language": "razor",
      "code": "<AudiobookSearch SearchFunc=\"SearchAsync\" AvailableTags=\"@_tags\" ResolveCoverUrlFunc=\"CoverUrl\" OnWorkOpen=\"OpenAsync\" />\n<AudiobookDetail Work=\"@_work\" CoverImageUrl=\"@CoverUrl(_work)\" />"
    }
  ],

{
  "id": "Lyo.Law.Api",
  "name": "Lyo.Law.Api",
  "area": "Apps",
  "tagline": "HTTP mapping for state statutes (`BuildLawGroup`).",
  "description": "Maps jurisdiction and code CRUD, query-only nodes, annotations, and revisions, plus node upsert and lookup. Register with `AddLawApiFromConfiguration`, then call `BuildLawGroup`. The host still calls `AddLyoQueryServices`. Node list queries cannot select `Body`.",
  "features": [
    "`BuildLawGroup` maps `Law/Jurisdictions` and `Law/Codes` CRUD.",
    "`Law/Nodes`, `Law/Annotations`, and `Law/Revisions` are query endpoints. Node query denies `Body`.",
    "`PUT Law/Nodes/by-source` upserts a node. `GET` by id, citation, children, and ancestors read through `ILawStore`."
  ],
  "examples": [
    {
      "title": "Map the Law API",
      "language": "csharp",
      "code": "services.AddLocalCache();\nservices.AddLyoQueryServices();\nservices.AddLawApiFromConfiguration(configuration);\nvar app = builder.Build();\napp.BuildLawGroup();"
    }
  ],

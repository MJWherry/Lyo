{
  "id": "Lyo.Recipe.Models",
  "name": "Lyo.Recipe.Models",
  "area": "Plugins",
  "tagline": "Shared request/response DTOs, enums, and route constants for Recipe HTTP and Blazor clients.",
  "description": "Wire types for the household recipe API. `Request/` and `Response/` types are used by `Lyo.Recipe.Api` and `Lyo.Recipe.Web.Components`. Enums live here so the store contract and HTTP surface share one vocabulary. This package has no DI registration.",
  "features": [
    "Enums for status, difficulty, and attachment role.",
    "`Constants.Rest.Recipe` route prefixes.",
    "`RecipeFilePaths` FileStorage PathPrefix helpers (`recipe/recipes/{id}`, `recipe/steps/{id}`).",
    "`RecipeEntityTypes` stable EntityRef type names for Note/Tag composition."
  ],
  "examples": [
    {
      "title": "Route constants",
      "language": "csharp",
      "code": "var recipes = Constants.Rest.Recipe.Recipes;\nvar prefix = RecipeFilePaths.ForRecipe(recipeId);"
    }
  ],

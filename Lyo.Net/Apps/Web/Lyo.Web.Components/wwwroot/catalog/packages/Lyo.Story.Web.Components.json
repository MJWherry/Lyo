{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Story.Web.Components",
  "name": "Lyo.Story.Web.Components",
  "area": "Plugins",
  "tagline": "Blazor story builder for the Lyo Story API: library, computed play graph, and playthrough.",
  "description": "Blazor / MudBlazor story builder. Drop `StoryManagement` on a host page to list graphs for a tenant and optional game, then author the open graph. The graph is a tested layout drawn as SVG: boxes are 220 by 72 with a 96 column gap and a 20 row gap. Choice arrows follow the last `gotoNode` effect. The host must already register `IStoryClient`. This package has no `Add*` registration.",
  "features": [
    "**Library.** `StoryManagement` lists graph headers, then creates, opens, duplicates, and deletes.",
    "**Workbench.** `StoryBuilderWorkbench` has Visual, Request JSON, and Play tabs. Save stays disabled while checks fail. The open graph autosaves in `ClientStore`.",
    "**Graph.** `StoryGraphView` draws the layout from `StoryGraphLayout` through `Lyo.Diagram`. Click a node to select it.",
    "**Editors.** Node, choice, effect list, variable, action, and reaction editors. Conditions use the where-clause builder with `var.*`, `chose.*`, and `visited.*` fields."
  ],
  "examples": [
    {
      "title": "Host page",
      "language": "razor",
      "code": "@using Lyo.Story.Web.Components\n\n<StoryManagement StoryClient=\"StoryClient\" BaseRoute=\"Story\" TenantId=\"tenantId\" GameKey=\"heist\" />"
    }
  ],
  "sections": [
    {
      "type": "table",
      "title": "Parameters",
      "headers": [
        "Parameter",
        "Notes"
      ],
      "rows": [
        [
          "`StoryClient`",
          "`IStoryClient`. Required. The client already carries its route prefix."
        ],
        [
          "`BaseRoute`",
          "Route prefix shown to the host. Defaults to `\"Story\"`."
        ],
        [
          "`TenantId`",
          "Tenant whose stories are listed. Null lists stories with no tenant."
        ],
        [
          "`GameKey`",
          "Optional game filter."
        ]
      ]
    },
    {
      "type": "table",
      "title": "Component catalog",
      "headers": [
        "Component",
        "Role"
      ],
      "rows": [
        [
          "`StoryManagement`",
          "Library of graph headers. Create, open, duplicate, delete. Opens the workbench."
        ],
        [
          "`StoryBuilderWorkbench`",
          "Tabs: Visual, Request JSON, Play."
        ],
        [
          "`StoryGraphView`",
          "SVG of the computed layout. Click a node to select it."
        ],
        [
          "`StoryNodeEditor`",
          "Key, title, scene, presentation (none / text / cutscene), body, media, start, ending."
        ],
        [
          "`StoryChoiceEditor`",
          "Prompt, order, `visibleWhen` and `enabledWhen`."
        ],
        [
          "`StoryEffectListEditor`",
          "Set, unset, increment, goto, end playthrough, invoke action. Reorder."
        ],
        [
          "`StoryVariableEditor`",
          "Boolean, integer, string, default."
        ],
        [
          "`StoryActionEditor`",
          "Named action and its effect list."
        ],
        [
          "`StoryReactionEditor`",
          "Trigger, scope node or variable, once, when, effects."
        ],
        [
          "`StoryPlayView`",
          "Start, current node, enabled choices, Advance, variable bag, event log, causes for one variable."
        ]
      ]
    }
  ],

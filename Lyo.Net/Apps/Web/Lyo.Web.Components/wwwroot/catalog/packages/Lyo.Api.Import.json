{
  "id": "Lyo.Api.Import",
  "name": "Lyo.Api.Import",
  "area": "Apps",
  "tagline": "Import API. JSON is built in. The endpoint returns rows and does not write a store.",
  "description": "Validates an import request and dispatches to a format handler. JSON (array, wrapped rows path, NDJSON) is built in. YAML, XML, TOML, CSV, and XLSX are addon packages. A file over the row or byte cap fails the document and returns no rows.",
  "features": [
    "Built-in JSON import that round-trips a file written by JSON export when the column map is empty.",
    "Partial success: a bad element is an issue and the other rows stay.",
    "Duplicate target properties fail the document before any row is read."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "builder.Services.AddLyoApiImport();\nbuilder.Services.AddYamlImport();\nbuilder.Services.AddXmlImport();\nbuilder.Services.AddTomlImport();\nbuilder.Services.AddCsvImport();\nbuilder.Services.AddXlsxImport();\napp.MapLyoImport();"
    }
  ],
  "readmePath": "Lyo.Net/Apps/Api/Import/Lyo.Api.Import/README.md",

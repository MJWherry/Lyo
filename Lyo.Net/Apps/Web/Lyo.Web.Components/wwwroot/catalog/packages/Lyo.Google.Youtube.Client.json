{
  "id": "Lyo.Google.Youtube.Client",
  "name": "Lyo.Google.Youtube.Client",
  "area": "Integration",
  "tagline": "YouTube Data API client. Returns `Lyo.Google.Youtube.Models` DTOs.",
  "description": "Calls the YouTube Data API v3 and returns models from `Lyo.Google.Youtube.Models`. Does not reference `Lyo.Video`. The host receives models and passes a `YoutubeVideoLink` into the video store. There is no YouTube schema and no sync worker.",
  "features": [
    "**Reads.** `GetVideoAsync`, `ListChannelUploadsAsync`, and `ListPlaylistItemsAsync`.",
    "**DI.** `AddGoogleYoutubeClient`, the options-instance overload, and `AddGoogleYoutubeClientFromConfiguration` (section `GoogleYoutube`). `ApiKey` is required."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "services.AddGoogleYoutubeClient(o => o.ApiKey = apiKey);\nvar video = await client.GetVideoAsync(videoId, ct);"
    }
  ],

  "id": "Lyo.Leaderboard.Api.Client",
  "name": "Lyo.Leaderboard.Api.Client",
  "area": "Apps",
  "tagline": "Typed HTTP client for the Leaderboard API.",
  "description": "Calls board, property, invite, entry, adjustment, and standing routes. `RedeemInviteAsync` and `CreateEntryAsync` can send the guest actor header. Bind section `LeaderboardApi`.",
  "features": [
    "`AddLeaderboardApiClientFromConfiguration` registers `ILeaderboardApiClient`.",
    "204 responses use `PostExpectingNoContentAsync`."
  ],
  "examples": [
    {
      "title": "Register the client",
      "language": "csharp",
      "code": "services.AddLeaderboardApiClientFromConfiguration(configuration);"
    }
  ],

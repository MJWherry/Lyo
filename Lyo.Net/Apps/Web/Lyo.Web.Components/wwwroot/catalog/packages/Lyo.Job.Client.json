{
  "id": "Lyo.Job.Client",
  "name": "Lyo.Job.Client",
  "area": "Apps",
  "tagline": "Typed HTTP client for the Lyo Job API. Wraps `IApiClient` and exposes run-lifecycle methods (`StartAsync`, `LogAsync`, `FinishAsync`, `RequeueAsync`) plus worker-instance endpoints from `Lyo.Job.Models.Constants.Rest.Job`.",
  "description": "Wraps `IApiClient` as a typed client for the Lyo Job API, exposing run-lifecycle methods (`StartAsync`, `LogAsync`, `FinishAsync`, `RequeueAsync`) and worker-instance endpoints from `Lyo.Job.Models.Constants.Rest.Job`.",
  "features": [],
  "examples": [
    {
      "title": "Wire into DI",
      "language": "csharp",
      "code": "services.AddSingleton<MyApiClient>();\nservices.AddJobClient<MyApiClient>();\n\n// Or with an explicit route prefix (when not using HttpClient.BaseAddress):\nservices.AddJobClient(sp => sp.GetRequiredService<IApiClient>(), new JobClientOptions { RoutePrefix = apiBaseUrl });"
    },
    {
      "title": "Host API client sub-client",
      "language": "csharp",
      "code": "public class MyApiClient : ApiClient\n{\n    public JobClient Jobs { get; }\n\n    public MyApiClient(MyApiClientOptions options, ...) : base(...)\n    {\n        Jobs = new JobClient(this);\n    }\n}\n\n// Usage\nawait myClient.Jobs.Runs.StartAsync(runId);\nawait myClient.Jobs.Runs.LogAsync(runId, new JobRunLogReq(...));\nawait myClient.Jobs.Runs.FinishAsync(runId, results);\nawait myClient.Jobs.Runs.RequeueAsync(runId); // Running -> Queued hand-back (graceful worker shutdown)\nawait myClient.Jobs.Runs.ResyncQueuedAsync(); // republish due Queued runs missing from RabbitMQ"
    }
  ],
  "sections": [
    {
      "type": "paragraph",
      "title": "Prefix on routes",
      "text": "If `JobClientOptions.RoutePrefix` is set (e.g. `https://localhost:5074`), every route is `{prefix}/Job/Run/...`. An empty prefix keeps routes relative and uses `HttpClient.BaseAddress`."
    }
  ],
  "links": [],

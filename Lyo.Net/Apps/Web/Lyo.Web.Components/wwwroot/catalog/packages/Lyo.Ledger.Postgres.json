{
  "id": "Lyo.Ledger.Postgres",
  "name": "Lyo.Ledger.Postgres",
  "area": "Plugins",
  "tagline": "EF Core implementation of `ILedgerStore` in PostgreSQL schema `ledger`.",
  "description": "PostgreSQL storage for Lyo.Ledger. Schema constant: `PostgresLedgerOptions.Schema = \"ledger\"`. Configuration section: `PostgresLedger`. Journal lines store optional `client_id` without a cross-schema FK.",
  "features": [],
  "examples": [
    {
      "title": "Register the store",
      "language": "csharp",
      "code": "services.AddPostgresLedgerStore(new PostgresLedgerOptions {\n    ConnectionString = \"...\",\n    EnableAutoMigrations = true\n});"
    },
    {
      "title": "Migrations",
      "language": "bash",
      "code": "export LEDGER_CONNECTION_STRING=\"Host=localhost;Database=lyo;Username=postgres;Password=postgres\"\ndotnet ef migrations add MigrationName --project Plugins/Ledger/Lyo.Ledger.Postgres"
    }
  ],
  "sections": [
    {
      "type": "list",
      "title": "See also",

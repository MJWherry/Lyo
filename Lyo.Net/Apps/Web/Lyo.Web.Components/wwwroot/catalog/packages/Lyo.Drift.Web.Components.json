{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Drift.Web.Components",
  "name": "Lyo.Drift.Web.Components",
  "area": "Security",
  "tagline": "Blazor workbench for Drift collector instances, snapshots, diffs, and live changes.",
  "description": "Drop DriftManagement on a host page for instance registry (stop/delete), structure snapshots (payload viewer + DiffAgainst), stored diffs, and live change events. Uses injected IApiClient and a configurable BaseRoute. Grids do not Select jsonb payload columns.",
  "features": [
    "**Off-grid payloads.** Snapshot JSON is loaded on demand into JsonViewDialog.",
    "**Named hash.** Snapshot grid shows content_hash_algorithm (sha256) plus a truncated hex digest.",
    "**Actions.** Stop and delete instances; DiffAgainst two snapshots of the same kind."
  ],
  "examples": [
    {
      "title": "Host",
      "language": "razor",
      "code": "@using Lyo.Drift.Web.Components\n\n<DriftManagement BaseRoute=\"http://localhost:5251/Drift\" />"
    }
  ],

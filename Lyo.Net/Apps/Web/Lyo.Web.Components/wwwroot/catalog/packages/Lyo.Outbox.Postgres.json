{
  "id": "Lyo.Outbox.Postgres",
  "name": "Lyo.Outbox.Postgres",
  "area": "Core",
  "tagline": "Postgres outbox. Enqueue writes kind=outbox through the shared idempotency store on the caller's transaction.",
  "description": "AddPostgresOutbox requires PostgresIdempotencyStore. The stored scope is outbox/{destination}/{callerScope}. There is no second table and no published_at column. Unpublished means kind=outbox and state=in_progress.",
  "features": [
    "**Health name outbox** checks the idempotency store, not the broker."
  ],
  "examples": [
    {
      "title": "Register",
      "language": "csharp",
      "code": "services.AddPostgresIdempotency(options);\nservices.AddPostgresOutbox();"
    }
  ],

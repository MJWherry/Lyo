{
  "id": "Lyo.Law.Postgres",
  "name": "Lyo.Law.Postgres",
  "area": "Plugins",
  "tagline": "PostgreSQL storage for US state statutes.",
  "description": "EF Core implementation of `ILawStore` in schema `law`. Register with `AddPostgresLawStore` or `AddPostgresLawStoreFromConfiguration` (section `PostgresLaw`). `PostgresLawStore` implements `Lyo.Health.IHealth` (`law-postgres`). Federal jurisdiction key `US` is rejected before insert.",
  "features": [
    "Tables `jurisdiction`, `code`, `node`, `annotation`, and `revision`.",
    "Unique source key and citation per code. Citation uniqueness ignores nulls.",
    "A changed node hash inserts a revision, then replaces the heading, body, and notes."
  ],
  "examples": [
    {
      "title": "Register the store",
      "language": "csharp",
      "code": "services.AddPostgresLawStore(new PostgresLawOptions {\n    ConnectionString = \"...\",\n    EnableAutoMigrations = true\n});"
    }
  ],

  "id": "Lyo.Api.Import.Xlsx",
  "name": "Lyo.Api.Import.Xlsx",
  "area": "Apps",
  "tagline": "XLSX handler for Lyo.Api.Import.",
  "description": "Registers an XLSX import handler. A null sheet name uses the first worksheet. A missing sheet is a document error.",
  "features": [
    "AddXlsxImport registers IXlsxService and the XLSX handler."
  ],
  "examples": [
    {
      "title": "Registration",
      "language": "csharp",
      "code": "services.AddLyoApiImport();\nservices.AddXlsxImport();"
    }

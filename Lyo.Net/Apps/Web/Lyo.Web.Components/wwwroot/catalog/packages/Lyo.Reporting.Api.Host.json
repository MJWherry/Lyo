{
  "$schema": "../../../../docs/catalog/schema/package.schema.json",
  "id": "Lyo.Reporting.Api.Host",
  "name": "Lyo.Reporting.Api.Host",
  "area": "Apps",
  "tagline": "Standalone ASP.NET host for the Lyo Reporting API.",
  "description": "Thin host: `AddReportingApiFromConfiguration`, `AddIOTempService`, `AddReportingMaintenanceWorker`, and `BuildReportingGroup`. Maps surfaces with `EndpointAuth.Anonymous()` so the host can run without an identity stack; production embeddings should pass `ReportingApiOptions` with real policies. Prefer embedding those calls in another host when composing APIs. Binds http://localhost:5098 (see Properties/launchSettings.json). HTML/PDF needs `AddReportingWebRenderer` from `Lyo.Reporting.Web` plus a web renderer on the host.",
  "features": [
    "OpenAPI and Scalar in Development only.",
    "Local cache + query services as required by reporting CRUD.",
    "CSV/XLSX/JSON renderers from `AddPostgresReportingManagement`. Download is not mapped (no `DownloadStreamFactory`)."
  ],
  "examples": [
    {
      "title": "Start the standalone host",
      "language": "bash",
      "code": "dotnet run --project Lyo.Net/Apps/Reporting/Lyo.Reporting.Api.Host"
    }
  ],

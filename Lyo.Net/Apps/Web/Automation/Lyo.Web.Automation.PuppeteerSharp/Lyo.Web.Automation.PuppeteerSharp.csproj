<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Description>PuppeteerSharp automation: Chromium sessions, tabs, frames, dialogs, keyboard helpers, JSON automation plans, DI registration, and metrics (aligned with Lyo.Web.Automation.Playwright).</Description>
        <PackageTags>puppeteersharp browser-automation web-automation chromium</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Web.Automation.PuppeteerSharp.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="PuppeteerSharp"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces"/>
        <PackageReference Include="System.Text.Json"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\..\Core\Common\Lyo.Common.Core\Lyo.Common.Core.csproj"/>
        <ProjectReference Include="..\Lyo.Web.Automation\Lyo.Web.Automation.csproj"/>
        <ProjectReference Include="..\..\..\..\Data\IO\Temp\Lyo.IO.Temp\Lyo.IO.Temp.csproj"/>
    </ItemGroup>

</Project>

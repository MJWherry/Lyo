{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=lyo;Username=lyo;Password=lyo"
  },
  "PostgresConfig": {
    "ConnectionString": "Host=localhost;Port=5432;Database=lyo;Username=lyo;Password=lyo",
    "EnableAutoMigrations": true
  },
  "PostgresUser": {
    "ConnectionString": "Host=localhost;Port=5432;Database=lyo;Username=lyo;Password=lyo",
    "EnableAutoMigrations": true
  },
  "PostgresFileMetadataStore": {
    "ConnectionString": "Host=localhost;Port=5432;Database=lyo;Username=lyo;Password=lyo",
    "EnableAutoMigrations": true
  },
  "LocalFileStorage": {
    "RootDirectoryPath": "./portfolio-files"
  },
  "PortfolioFileEncryption": {
    "KeyId": "portfolio-files",
    "KeySecret": "change-me-in-production"
  },
  "QueryOptions": {
    "CacheQueryResultsAsUtf8Payload": true,
    "EnableSplitQueries": true
  },
  "CacheOptions": {
    "Enabled": true,
    "DefaultExpiration": "00:03:00",
    "QueryCacheTagGranularity": "Broad",
    "EnableMetrics": false
  },
  "CompressionOptions": {
    "Policy": {
      "BuiltInDefaultsEnabled": true
    }
  },
  "RabbitMqOptions": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "AdminUrl": "http://localhost:15672"
  },
  "LyoAuthentication": {
    "Ring": "live"
  },
  "LyoJwt": {
    "Issuer": "https://auth.lyo",
    "Audience": "lyo-api",
    "SigningKeyId": "lyo-sig"
  },
  "GoogleAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5251/auth/callback/google"
  },
  "LyoOidcBff": {
    "AllowedReturnOrigins": [
      "http://localhost:3100",
      "http://localhost:5138",
      "https://localhost:5138"
    ],
    "DefaultReturnUrl": "/",
    "HandoffCodeTtl": "00:00:30"
  },
  "ConfigApiHosting": {
    "PollIntervalAdvisoryMilliseconds": 15000
  },
  "ConfigApiSecurity": {
    "RequireApiKey": false,
    "ApiKey": ""
  }
}

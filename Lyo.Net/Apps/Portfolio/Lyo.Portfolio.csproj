        <ProjectReference Include="..\..\Security\Hashing\Lyo.Hashing\Lyo.Hashing.csproj"/>
        <ProjectReference Include="..\..\Security\Encryption\Lyo.Keystore\Lyo.Keystore.csproj"/>
        <ProjectReference Include="..\..\Core\Schedule\Lyo.Schedule.Web.Components\Lyo.Schedule.Web.Components.csproj"/>
        <ProjectReference Include="..\..\Core\Diagnostic\Lyo.Diagnostic.Web.Components\Lyo.Diagnostic.Web.Components.csproj"/>
        <ProjectReference Include="..\..\Core\Privacy\Lyo.Privacy.Web.Components\Lyo.Privacy.Web.Components.csproj"/>

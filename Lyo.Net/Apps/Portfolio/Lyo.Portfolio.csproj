<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <!-- Treat .pdb 404s as warnings, not fatal errors in the WASM boot loader -->
        <WasmIgnorePdbLoadErrors>true</WasmIgnorePdbLoadErrors>
        <!-- Removes ICU data (.dat) files from the WASM boot — the dev server cannot serve
             .dat files (no registered MIME type). Invariant mode is fine for a portfolio app. -->
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blazored.LocalStorage"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly"/>
        <PackageReference Include="MudBlazor"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Core web components (IdWorkbench, LyoTextDiffViewer, LyoRichTextEditor, etc.) -->
        <ProjectReference Include="..\..\Integration\Web\Lyo.Web.Components\Lyo.Web.Components.csproj"/>

        <!-- Self-contained (WASM-compatible) -->
        <ProjectReference Include="..\..\Data\Csv\Lyo.Csv\Lyo.Csv.csproj"/>
        <ProjectReference Include="..\..\Data\Xlsx\Lyo.Xlsx\Lyo.Xlsx.csproj"/>
        <ProjectReference Include="..\..\Data\Compression\Lyo.Compression\Lyo.Compression.csproj"/>
        <ProjectReference Include="..\..\Data\Compression\Lyo.Compression.BZip2\Lyo.Compression.BZip2.csproj"/>
        <ProjectReference Include="..\..\Data\Compression\Lyo.Compression.LZ4\Lyo.Compression.LZ4.csproj"/>
        <ProjectReference Include="..\..\Data\Compression\Lyo.Compression.LZMA\Lyo.Compression.LZMA.csproj"/>
        <ProjectReference Include="..\..\Data\Compression\Lyo.Compression.Snappier\Lyo.Compression.Snappier.csproj"/>
        <ProjectReference Include="..\..\Data\Compression\Lyo.Compression.XZ\Lyo.Compression.XZ.csproj"/>
        <ProjectReference Include="..\..\Data\Compression\Lyo.Compression.Zstd\Lyo.Compression.Zstd.csproj"/>
        <ProjectReference Include="..\..\Security\Encryption\Lyo.Encryption\Lyo.Encryption.csproj"/>
        <ProjectReference Include="..\..\Security\Encryption\Lyo.Encryption.AesCcm\Lyo.Encryption.AesCcm.csproj"/>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Lyo.Desktop.Components</RootNamespace>
        <Description>Shared Avalonia controls for Lyo desktop apps. Tool windows dock inside a window. A window can dock to a screen edge.</Description>
        <PackageTags>avalonia components dock desktop</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Lyo.Avalonia.Components.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Desktop\Lyo.Desktop\Lyo.Desktop.csproj"/>
        <ProjectReference Include="..\..\..\Core\Diagnostic\Lyo.Diagnostic\Lyo.Diagnostic.csproj"/>
        <ProjectReference Include="..\..\..\Core\Exceptions\Lyo.Exceptions\Lyo.Exceptions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
    </ItemGroup>

</Project>

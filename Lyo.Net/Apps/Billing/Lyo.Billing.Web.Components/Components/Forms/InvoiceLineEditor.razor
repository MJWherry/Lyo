@namespace Lyo.Billing.Web.Components.Components.Forms

<MudStack Spacing="2">
    <MudTable Items="_lines" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Pricing</MudTh>
            <MudTh>Qty</MudTh>
            <MudTh>Rate</MudTh>
            <MudTh>Amount</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Pricing">@PricingLabel(context.Pricing)</MudTd>
            <MudTd DataLabel="Qty">@QtyDisplay(context.Quantity)</MudTd>
            <MudTd DataLabel="Rate">@UnitDisplay(context)</MudTd>
            <MudTd DataLabel="Amount">@BillingMoney.Format(context.Amount, null)</MudTd>
            <MudTd>
                @if (AllowEdit) {
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Remove.InvokeAsync(context))"/>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
    @if (AllowEdit) {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
            <MudSelect T="InvoiceLinePricing" @bind-Value="_draft.Pricing" Label="Pricing" Style="max-width: 12rem;">
                <MudSelectItem Value="@InvoiceLinePricing.Amount">Amount</MudSelectItem>
                <MudSelectItem Value="@InvoiceLinePricing.Discount">Fixed discount</MudSelectItem>
                <MudSelectItem Value="@InvoiceLinePricing.PercentDiscount">Percent discount</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_draft.Title" Label="Title" Style="max-width: 14rem;"/>
            <MudTextField @bind-Value="_draft.Description" Label="Description" Class="flex-grow-1"/>
            @if (_draft.Pricing == InvoiceLinePricing.Amount) {
                <MudNumericField @bind-Value="_draft.Quantity" Label="Qty" Min="0.01m" Step="0.25m" Style="max-width: 7rem;"/>
            }
            <MudNumericField @bind-Value="_draft.UnitAmount" Label="@UnitLabel" Min="@UnitMin" Max="@UnitMax" Step="@UnitStep" Style="max-width: 8rem;"/>
            <MudButton Variant="Variant.Outlined" OnClick="AddManualAsync" Disabled="@string.IsNullOrWhiteSpace(_draft.Title)">Add line</MudButton>
        </MudStack>
    }
</MudStack>

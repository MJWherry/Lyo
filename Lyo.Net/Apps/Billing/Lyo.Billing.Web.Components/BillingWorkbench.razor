@inject IPaymentCollector Collector
@inject IApiClient ApiClient
@inject IBillingClient Billing
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudStack Spacing="3">
    <MudPaper Class="pa-4" Outlined="true">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h5">Billing workbench</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Writes go through TestApi. Collect uses the in-process <code>InternalPaymentCollector</code> (no Stripe); the host then records the payment so the ledger posts. PDF is generated by the Reporting host.
            </MudText>
            <MudTextField @bind-Value="_displayName" Label="Client display name"/>
            <MudStack Row="true" Spacing="2">
                <MudNumericField @bind-Value="_hours" Label="Hours" Min="0.25m" Step="0.25m"/>
                <MudNumericField @bind-Value="_rate" Label="Rate" Min="0m" Step="1m"/>
                <MudNumericField @bind-Value="_taxRate" Label="Tax rate" Min="0m" Max="1m" Step="0.01m"/>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="RunDemoAsync">Invoice and collect</MudButton>
                @if (_invoiceId is { } id) {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@Billing.InvoicePdfHref(id)" Target="_blank">Open PDF</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="ViewInvoiceAsync">View invoice</MudButton>
                }
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(_status)) {
                <MudText Typo="Typo.body2">@_status</MudText>
            }
        </MudStack>
    </MudPaper>
</MudStack>

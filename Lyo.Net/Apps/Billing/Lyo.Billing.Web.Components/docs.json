{
  "id": "Lyo.Billing.Web.Components",
  "name": "Lyo.Billing.Web.Components",
  "area": "Apps",
  "tagline": "Reusable Blazor billing dashboard: clients, charges, invoices, payments, and ledger.",
  "description": "`BillingDashboard` is a product UI (not a workbench) hosted by TestGateway at `/billing`. Grids reuse `LyoDataGridProjected`, chips, dialogs, and forms. Compose a draft (manual lines or unbilled charges), issue, Internal-pay, void, and open the invoice PDF via `IBillingClient.InvoicePdfHref`. Invoice view, void, PDF, and draft delete open from the grid in a Large dialog — not a tab page-swap. Bulk PDF, void, and delete-drafts live on the invoice grid. `BillingWorkbench` remains in the package unused.",
  "features": [
    "Section nav: Overview KPIs (`GET /Billing/Summary`), Clients, Charges, Invoices (composer + detail dialogs), Payments, Ledger.",
    "New widgets only where Lyo has no primitive: invoice line editor, composer, money helper, client picker, KPI strip.",
    "Pay/void/delete-draft use `LyoDialog` + confirm; Internal collection stays on the host via `AddInternalPaymentCollector()`.",
    "Invoice grid: Large-dialog view (not a page swap), row + bulk PDF/void/delete drafts. Generic QueryProject BulkDelete/BulkPatch stay off because invoices are ReadOnly.",
    "PDF link uses `IBillingClient.InvoicePdfHref` (`GET /Reporting/Invoices/{id}/pdf` on TestApi). Draft and Void are rejected."
  ],

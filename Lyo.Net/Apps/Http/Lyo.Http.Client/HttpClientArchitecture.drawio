        <mxCell id="l3" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="900" y="88" as="sourcePoint" />
            <mxPoint x="900" y="760" as="targetPoint" />

        <mxCell id="e1ab" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#444444;" edge="1" parent="1" source="s1a" target="s1b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1bc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#444444;" edge="1" parent="1" source="s1b" target="s1c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1cd" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#444444;" edge="1" parent="1" source="s1c" target="s1d"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- step 2 -->
        <mxCell id="s2n" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="184" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s2a" value="MergeSolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="176" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2b" value="UA = solver Chrome&#xa;jar += cf_clearance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="168" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#3d8539;" edge="1" parent="1" source="s2a" target="s2b"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- step 3 -->
        <mxCell id="s3n" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="264" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s3a" value="CreateSession overlay&#xa;ApplyProxy + PinUserAgent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="56" y="248" width="168" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s3b" value="must be Chromium&#xa;else throw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="248" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s3c" value="clone config options&#xa;stamp UA[0] + ProxyUrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="248" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e3a" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#5947a3;" edge="1" parent="1" source="s3a" target="s3c"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- step 4 -->
        <mxCell id="s4n" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="344" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s4a" value="StartBrowserAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="56" y="336" width="168" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s4b" value="launch Chromium&#xa;context UA + proxy + screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="328" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#5947a3;" edge="1" parent="1" source="s4a" target="s4b"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- step 5 -->
        <mxCell id="s5n" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="424" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s5a" value="ApplyCookiesAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="56" y="416" width="168" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s5b" value="export jar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="416" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s5c" value="context.AddCookiesAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="416" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e5ab" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#3d8539;" edge="1" parent="1" source="s5a" target="s5b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5bc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#5947a3;" edge="1" parent="1" source="s5b" target="s5c"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- step 6 -->
        <mxCell id="s6n" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="16" y="504" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="s6a" value="NavigateToAsync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="56" y="496" width="168" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s6b" value="GotoAsync&#xa;DOMContentLoaded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5c9f5;strokeColor=#7a5abf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1080" y="488" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s6c" value="same IP + UA + cookies&#xa;JS / XHR run in page" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1390" y="488" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="e6ab" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#5947a3;" edge="1" parent="1" source="s6a" target="s6b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6bc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="s6b" target="s6c"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- same IP -->
        <mxCell id="ip" value="Same IP on all three hops: FlaredHttpOptions.ProxyUrl → solver + LyoHttpClientHandler + Playwright context. Docker FlareSolverr is not the host VPN exit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1600" height="40" as="geometry" />
        </mxCell>

        <!-- firefox + do not as two short cards, not walls -->
        <mxCell id="fx" value="&lt;b&gt;Firefox / WebKit&lt;/b&gt; — not handoff. Do not PinUserAgent or copy Flared cookies. Engine UA is used. No --window-size (Playwright treats it as a URL)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eae4ff;strokeColor=#8670c4;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="800" height="56" as="geometry" />
        </mxCell>
        <mxCell id="no" value="&lt;b&gt;Do not&lt;/b&gt; embed FlareSolverr in Playwright · spoof WebGL · --disable-gpu · waitUntil=Load on CF · new PlaywrightSessionOptions() just to pin UA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="640" width="780" height="56" as="geometry" />
        </mxCell>

        <mxCell id="order" value="Order that matters: solve → pin UA → start browser → cookies → navigate. Reverse any of those and clearance will not stick." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=12;fontColor=#444444;" vertex="1" parent="1">

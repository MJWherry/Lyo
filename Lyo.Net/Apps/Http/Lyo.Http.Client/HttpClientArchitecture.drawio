        <mxCell id="s1b" value="ThroughSolver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="104" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1c" value="/v1 challenge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="104" width="200" height="40" as="geometry" />

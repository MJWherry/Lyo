        <mxCell id="s1d" value="cf_clearance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1390" y="104" width="200" height="40" as="geometry" />

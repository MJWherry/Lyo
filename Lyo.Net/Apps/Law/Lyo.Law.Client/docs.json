{
  "id": "Lyo.Law.Client",
  "name": "Lyo.Law.Client",
  "area": "Apps",
  "tagline": "Typed HTTP client for Law upsert and lookup routes.",
  "description": "`ILawClient` wraps node upsert, detail, citation lookup, children, and ancestors. Jurisdiction, code, node, annotation, and revision queries stay on `IApiClient`. Register with `AddLawClient<TApiClient>`. `LawClientOptions.RoutePrefix` is a path prefix, not an absolute URL.",
  "features": [
    "`UpsertBySourceAsync` PUTs `Law/Nodes/by-source`.",
    "`GetByCitationAsync` GETs `Law/Nodes/by-citation` with jurisdiction, code, and citation.",
    "`GetChildrenAsync` and `GetAncestorsAsync` read the outline around one node."
  ],
  "examples": [
    {
      "title": "Register on an existing IApiClient",
      "language": "csharp",
      "code": "services.AddLawClient<ApiClient>();\nvar saved = await law.UpsertBySourceAsync(request);"
    }
  ],

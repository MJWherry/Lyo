{
  "id": "Lyo.Api.Import.Csv",
  "name": "Lyo.Api.Import.Csv",
  "area": "Apps",
  "tagline": "CSV handler for Lyo.Api.Import.",
  "description": "Registers a CSV import handler. Header renames run before the typed CSV binder. Row numbers in issues are 1-based file rows.",

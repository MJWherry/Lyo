@using Lyo.Health
<MudPaper Class="pa-4" Outlined="true" Style="height: 100%;">
    <MudText Typo="Typo.h6" Class="mb-2">Result</MudText>

    <MudStack Row="true" Spacing="2" Class="mb-3">
        <LyoChip Spec="@LyoChips.FromBool(Connected, "Connected", "Disconnected", Color.Success, Color.Default)"/>
        @if (LastHealth != null) {
            <LyoChip Spec="@LyoChips.FromBool(LastHealth.IsHealthy, "Healthy", "Unhealthy", Color.Success, Color.Warning)"/>
        }
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(StatusMessage)) {
        <MudAlert Severity="@StatusSeverity" Dense="true" Class="mb-3">@StatusMessage</MudAlert>
    }

    @if (Details.Count == 0) {
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Run a queue operation to inspect the latest result here.
        </MudText>
    }
    else {
        <MudSimpleTable Dense="true">
            <tbody>
            @foreach (var detail in Details) {
                <tr>
                    <td><strong>@detail.Key</strong></td>
                    <td>@detail.Value</td>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    }

    @if (PeekedMessages.Count > 0) {
        <MudDivider Class="my-3"/>

        <MudText Typo="Typo.subtitle1" Class="mb-2">Peeked Messages</MudText>

        <LyoResponsiveTable>
            <TableContent>
                <MudSimpleTable Dense="true">
                    <thead>
                    <tr>
                        <th>Payload</th>
                        <th>Routing Key</th>
                        <th>Exchange</th>
                        <th>Remaining</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var message in PeekedMessages) {
                        <tr>
                            <td style="white-space:pre-wrap;word-break:break-word;">@message.Payload</td>
                            <td>@(message.RoutingKey ?? "(none)")</td>
                            <td>@(message.Exchange ?? "(none)")</td>
                            <td>@(message.MessageCount?.ToString() ?? "(unknown)")</td>
                        </tr>
                    }
                    </tbody>
                </MudSimpleTable>
            </TableContent>
            <CardContent>
                @foreach (var message in PeekedMessages) {
                    <LyoRecordCard Title="@(message.RoutingKey ?? "(none)")" Subtitle="@(message.Exchange ?? "(no exchange)")">
                        <LyoRecordField Label="Payload">
                            <div style="white-space:pre-wrap;word-break:break-word;">@message.Payload</div>
                        </LyoRecordField>
                        <LyoRecordField Label="Remaining" Value="@(message.MessageCount?.ToString() ?? "(unknown)")"/>
                    </LyoRecordCard>
                }
            </CardContent>
        </LyoResponsiveTable>
    }
</MudPaper>

{
  "id": "Lyo.Outbox.Dispatcher",
  "name": "Lyo.Outbox.Dispatcher",
  "area": "Communication",
  "tagline": "Publishes due outbox rows through IMqService. Delivery is at-least-once.",
  "description": "AddOutboxDispatcher claims due rows, commits the lease, then calls SendToQueue. It does not reference a RabbitMQ package. A crash after a successful send and before complete publishes again after the lease expires. Consumers dedupe on the row id.",
  "features": [
    "**The lease is committed before publish.** A second worker cannot claim the row until lease_until. A stale worker whose lease was stolen does not clear the new token.",
    "**Max attempts marks the row failed.** ReplayFailedAsync returns that outbox row to in progress. It does not change API rows."
  ],
  "examples": [
    {
      "title": "Register",
      "language": "csharp",
      "code": "services.AddOutboxDispatcher(new OutboxDispatcherOptions {\n    Lease = TimeSpan.FromSeconds(30),\n    MaxAttempts = 5\n});"
    }
  ],

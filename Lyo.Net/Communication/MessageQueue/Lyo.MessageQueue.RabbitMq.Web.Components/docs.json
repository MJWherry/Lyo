{
  "id": "Lyo.MessageQueue.RabbitMq.Web.Components",
  "name": "Lyo.MessageQueue.RabbitMq.Web.Components",
  "area": "Communication",
  "tagline": "Blazor components for RabbitMQ exchanges, bindings, and broker workbenches.",
  "description": "Blazor components for RabbitMQ exchanges, bindings, and broker workbenches.",
  "features": [],
  "examples": [],
  "sections": [
    {
      "type": "table",
      "title": "RabbitMqWorkbench",
      "headers": [
        "Tab",
        "Operations"
      ],
      "rows": [
        [
          "**Exchange**",
          "Create/delete exchanges, bind queues"
        ],
        [
          "**Queue**",
          "Create (optionally with DLQ + `x-max-priority`), peek, clear, delete; single-queue info via management API"
        ],
        [
          "**Publish**",
          "Send to queue/exchange (envelope wrap, priority, delayed delivery)"
        ],
        [
          "**Stats**",
          "All-queue statistics with optional name filter, manual refresh, and auto-refresh polling"
        ]
      ],
      "lead": "`RabbitMqWorkbench.razor` is an internal dashboard for the full `IRabbitMqService` API:",
      "trail": "Queue creation supports:\n\n- **`x-max-priority`.** Numeric max priority (same pattern as job workers use for `job.run.{workerType}` queues).\n- **DLQ auto-wiring.** `CreateQueueWithDlq` with optional custom DLQ name.\n\nPublishing supports:\n\n- **`SendToQueueWithPriority`.** Envelope publish with priority (requires a priority-enabled queue).\n- **`SendToQueueDelayed`.** Broker-side delay via TTL + dead-letter wait queues."
    }
  ],

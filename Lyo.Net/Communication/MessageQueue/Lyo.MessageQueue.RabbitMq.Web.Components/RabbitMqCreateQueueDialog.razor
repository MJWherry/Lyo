@namespace Lyo.MessageQueue.RabbitMq.Web.Components
@inject ISnackbar Snackbar

<LyoDialog Busy="false" OnSave="Save" SaveDisabled="@(!CanSave)" SaveText="Create" DebugData="_request">
    <TitleContent>
        <MudText Typo="Typo.h6">Create queue</MudText>
    </TitleContent>
    <ChildContent>
        <MudStack Spacing="3">
            <MudTextField T="string" Label="Queue" Immediate="true" @bind-Value="_request.Name"/>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                <LyoChip Label="Durable"
                         Color="@RabbitMqColorHelper.ToggleColor(_request.Durable, Color.Success)"
                         Variant="@RabbitMqColorHelper.ToggleVariant(_request.Durable)"
                         OnClick="@(() => _request.Durable = !_request.Durable)"/>
                <LyoChip Label="Exclusive"
                         Color="@RabbitMqColorHelper.ToggleColor(_request.Exclusive, Color.Warning)"
                         Variant="@RabbitMqColorHelper.ToggleVariant(_request.Exclusive)"
                         OnClick="@(() => _request.Exclusive = !_request.Exclusive)"/>
                <LyoChip Label="Auto-delete"
                         Color="@RabbitMqColorHelper.ToggleColor(_request.AutoDelete, Color.Warning)"
                         Variant="@RabbitMqColorHelper.ToggleVariant(_request.AutoDelete)"
                         OnClick="@(() => _request.AutoDelete = !_request.AutoDelete)"/>
                <LyoChip Label="Create with DLQ"
                         Color="@RabbitMqColorHelper.ToggleColor(_request.CreateWithDlq, Color.Tertiary)"
                         Variant="@RabbitMqColorHelper.ToggleVariant(_request.CreateWithDlq)"
                         OnClick="@(() => _request.CreateWithDlq = !_request.CreateWithDlq)"/>
            </MudStack>
            <MudNumericField T="int"
                             Label="Max priority (x-max-priority)"
                             Min="0"
                             Max="255"
                             HelperText="0 = no priority support"
                             @bind-Value="_request.MaxPriority"/>
            @if (_request.CreateWithDlq) {
                <MudTextField T="string" Label="DLQ name (optional)" HelperText="Defaults to {queue}.dlq" @bind-Value="_request.DlqName"/>
            }
        </MudStack>
    </ChildContent>
</LyoDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = null!;

    private readonly RabbitMqCreateQueueRequest _request = new();

    private bool CanSave => !string.IsNullOrWhiteSpace(_request.Name);

    private void Save()
    {
        if (!CanSave) {
            Snackbar.Add("Enter a queue name.", Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(_request));
    }

}

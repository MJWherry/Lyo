@namespace Lyo.MessageQueue.RabbitMq.Web.Components
@inject IJsInterop Js
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
        <MudAutocomplete T="MessageQueueInfo"
                         Placeholder="Queue"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Dense="true"
                         Clearable="true"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         OpenOnFocus="true"
                         MaxItems="200"
                         Style="min-width: 320px; flex-grow: 1;"
                         Value="@SelectedQueue"
                         ValueChanged="OnQueueChanged"
                         ToStringFunc="QueueName"
                         SearchFunc="SearchQueues">
            <ItemTemplate>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center" Style="width: 100%;">
                    <MudText Typo="Typo.body2">@context.Name</MudText>
                    <MudSpacer/>
                    <LyoChip Spec="@RabbitMqColorHelper.DurableChip(context.AdditionalProperties)"/>
                    @if (RabbitMqColorHelper.StateChip(context.State) is { } state) {
                        <LyoChip Spec="@state"/>
                    }
                    @if (RabbitMqColorHelper.QueueTypeChip(context.Type) is { } type) {
                        <LyoChip Spec="@type"/>
                    }
                    @if (RabbitMqColorHelper.DlqChip(context.AdditionalProperties) is { } dlq) {
                        <LyoChip Spec="@dlq"/>
                    }
                </MudStack>
            </ItemTemplate>
        </MudAutocomplete>
        <MudNumericField T="int"
                         Placeholder="Refresh s"
                         Min="2"
                         Max="120"
                         Margin="Margin.Dense"
                         Variant="Variant.Outlined"
                         Style="width: 110px;"
                         Value="@RefreshIntervalSeconds"
                         ValueChanged="RefreshIntervalSecondsChanged"/>
        <MudSwitch T="bool"
                   Color="Color.Primary"
                   Label="Auto refresh"
                   Value="@AutoRefresh"
                   ValueChanged="AutoRefreshChanged"/>
        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnRefresh"
                   Disabled="@Busy">Refresh</MudButton>
    </MudStack>

    @if (Queues.Count == 0) {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No queues. Create one on Manage.</MudText>
    }

    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4" AlignItems="AlignItems.Start">
        <MudStack Spacing="1" Style="min-width: 240px; flex: 1;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Info</MudText>
            @if (SelectedQueue is { } selected) {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    <LyoChip Spec="@RabbitMqColorHelper.DurableChip(selected.AdditionalProperties)"/>
                    @if (RabbitMqColorHelper.ExclusiveChip(selected.AdditionalProperties) is { } exclusive) {
                        <LyoChip Spec="@exclusive"/>
                    }
                    @if (RabbitMqColorHelper.AutoDeleteChip(selected.AdditionalProperties) is { } autoDelete) {
                        <LyoChip Spec="@autoDelete"/>
                    }
                    @if (RabbitMqColorHelper.StateChip(selected.State) is { } state) {
                        <LyoChip Spec="@state"/>
                    }
                    @if (RabbitMqColorHelper.QueueTypeChip(selected.Type) is { } type) {
                        <LyoChip Spec="@type"/>
                    }
                    @if (RabbitMqColorHelper.DlqChip(selected.AdditionalProperties) is { } dlq) {
                        <LyoChip Spec="@dlq" Title="@RabbitMqColorHelper.DeadLetterRoutingKey(selected.AdditionalProperties)"/>
                    }
                    @if (RabbitMqColorHelper.MaxPriorityChip(selected.AdditionalProperties) is { } priority) {
                        <LyoChip Spec="@priority"/>
                    }
                </MudStack>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ready</MudText>
                        <MudText Typo="Typo.subtitle2">@selected.MessagesReady</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Unacked</MudText>
                        <MudText Typo="Typo.subtitle2">@selected.MessagesUnacknowledged</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Consumers</MudText>
                        <MudText Typo="Typo.subtitle2">@selected.Consumers</MudText>
                    </MudStack>
                </MudStack>
            }
            else {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pick a queue.</MudText>
            }
        </MudStack>
        <MudStack Spacing="1">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Quick actions</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                <MudNumericField T="int"
                                 Placeholder="Peek count"
                                 Min="1"
                                 Max="50"
                                 Margin="Margin.Dense"
                                 Variant="Variant.Outlined"
                                 Style="width: 110px;"
                                 Disabled="@(SelectedQueue is null)"
                                 Value="@PeekCount"
                                 ValueChanged="PeekCountChanged"/>
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           Disabled="@(Busy || SelectedQueue is null)"
                           OnClick="@PeekSelectedAsync">Peek</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           Disabled="@(Busy || SelectedQueue is null)"
                           OnClick="@ClearSelectedAsync">Clear</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Disabled="@(Busy || SelectedQueue is null)"
                           OnClick="@DeleteSelectedAsync">Delete</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                               Size="Size.Small"
                               title="Copy name"
                               Disabled="@(SelectedQueue is null)"
                               OnClick="@CopySelectedNameAsync"/>
            </MudStack>
        </MudStack>
    </MudStack>

    <MudTabs Rounded="true" Elevation="0" Outlined="true">
        <MudTabPanel Text="Send">
            <MudStack Spacing="3" Class="pt-3">
                @if (string.IsNullOrWhiteSpace(SelectedName)) {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Pick a queue to publish.</MudText>
                }
                else {
                    @DetailContent
                }
            </MudStack>
        </MudTabPanel>
        <MudTabPanel Text="Manage">
            <MudStack Spacing="3" Class="pt-3">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="OnCreate" Disabled="@Busy">Create queue</MudButton>
                <MudDivider/>
                <MudText Typo="Typo.subtitle2">Bind to exchange</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                    <MudAutocomplete T="string"
                                     Placeholder="Exchange"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Dense="true"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="false"
                                     OpenOnFocus="true"
                                     MaxItems="200"
                                     Style="min-width: 220px;"
                                     Value="@BindExchangeName"
                                     ValueChanged="BindExchangeNameChanged"
                                     SearchFunc="SearchBindExchanges"/>
                    <MudTextField T="string"
                                  Placeholder="Routing key"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width: 160px;"
                                  Value="@RoutingKey"
                                  ValueChanged="RoutingKeyChanged"/>
                    <MudButton Variant="Variant.Outlined"
                               Disabled="@(Busy || SelectedQueue is null)"
                               OnClick="OnBind">Bind</MudButton>
                </MudStack>
            </MudStack>
        </MudTabPanel>
    </MudTabs>
</MudStack>

@namespace Lyo.MessageQueue.RabbitMq.Web.Components
@inject IJsInterop Js
@inject ISnackbar Snackbar

<MudStack Spacing="3">
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
        <MudAutocomplete T="MessageQueueInfo"
                         Placeholder="Queue"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Dense="true"
                         Clearable="true"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         OpenOnFocus="true"
                         MaxItems="200"
                         Style="min-width: 320px; flex-grow: 1;"
                         Value="@SelectedQueue"
                         ValueChanged="OnQueueChanged"
                         ToStringFunc="QueueName"
                         SearchFunc="SearchQueues">
            <ItemTemplate>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" AlignItems="AlignItems.Center" Style="width: 100%;">
                    <MudText Typo="Typo.body2">@context.Name</MudText>
                    <MudSpacer/>
                    <LyoChip Spec="@RabbitMqColorHelper.DurableChip(context.AdditionalProperties)"/>
                    @if (RabbitMqColorHelper.StateChip(context.State) is { } state) {
                        <LyoChip Spec="@state"/>
                    }
                    @if (RabbitMqColorHelper.QueueTypeChip(context.Type) is { } type) {
                        <LyoChip Spec="@type"/>
                    }
                    @if (RabbitMqColorHelper.DlqChip(context.AdditionalProperties) is { } dlq) {
                        <LyoChip Spec="@dlq"/>
                    }
                </MudStack>
            </ItemTemplate>
        </MudAutocomplete>
        <MudNumericField T="int"
                         Placeholder="Refresh s"
                         Min="2"
                         Max="120"
                         Margin="Margin.Dense"
                         Variant="Variant.Outlined"
                         Style="width: 110px;"
                         Value="@RefreshIntervalSeconds"
                         ValueChanged="RefreshIntervalSecondsChanged"/>
        <MudSwitch T="bool"
                   Color="Color.Primary"
                   Label="Auto refresh"
                   Value="@AutoRefresh"
                   ValueChanged="AutoRefreshChanged"/>
        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="OnRefresh"
                   Disabled="@Busy">Refresh</MudButton>
    </MudStack>

    @if (Queues.Count == 0) {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No queues. Create one on Manage.</MudText>
    }

    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4" AlignItems="AlignItems.Start">
        <MudStack Spacing="1" Style="min-width: 240px; flex: 1;">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Info</MudText>
            @if (SelectedQueue is { } selected) {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                    <LyoChip Spec="@RabbitMqColorHelper.DurableChip(selected.AdditionalProperties)"/>
                    @if (RabbitMqColorHelper.ExclusiveChip(selected.AdditionalProperties) is { } exclusive) {
                        <LyoChip Spec="@exclusive"/>
                    }
                    @if (RabbitMqColorHelper.AutoDeleteChip(selected.AdditionalProperties) is { } autoDelete) {
                        <LyoChip Spec="@autoDelete"/>
                    }
                    @if (RabbitMqColorHelper.StateChip(selected.State) is { } state) {
                        <LyoChip Spec="@state"/>
                    }
                    @if (RabbitMqColorHelper.QueueTypeChip(selected.Type) is { } type) {
                        <LyoChip Spec="@type"/>
                    }
                    @if (RabbitMqColorHelper.DlqChip(selected.AdditionalProperties) is { } dlq) {
                        <LyoChip Spec="@dlq" Title="@RabbitMqColorHelper.DeadLetterRoutingKey(selected.AdditionalProperties)"/>
                    }
                    @if (RabbitMqColorHelper.MaxPriorityChip(selected.AdditionalProperties) is { } priority) {
                        <LyoChip Spec="@priority"/>
                    }
                </MudStack>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ready</MudText>
                        <MudText Typo="Typo.subtitle2">@selected.MessagesReady</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Unacked</MudText>
                        <MudText Typo="Typo.subtitle2">@selected.MessagesUnacknowledged</MudText>
                    </MudStack>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Consumers</MudText>
                        <MudText Typo="Typo.subtitle2">@selected.Consumers</MudText>
                    </MudStack>
                </MudStack>
            }
            else {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pick a queue.</MudText>
            }
        </MudStack>
        <MudStack Spacing="1">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Quick actions</MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                <MudNumericField T="int"
                                 Placeholder="Peek count"
                                 Min="1"
                                 Max="50"
                                 Margin="Margin.Dense"
                                 Variant="Variant.Outlined"
                                 Style="width: 110px;"
                                 Disabled="@(SelectedQueue is null)"
                                 Value="@PeekCount"
                                 ValueChanged="PeekCountChanged"/>
                <MudButton Variant="Variant.Filled"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           Disabled="@(Busy || SelectedQueue is null)"
                           OnClick="@PeekSelectedAsync">Peek</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.ClearAll"
                           Disabled="@(Busy || SelectedQueue is null)"
                           OnClick="@ClearSelectedAsync">Clear</MudButton>
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           Disabled="@(Busy || SelectedQueue is null)"
                           OnClick="@DeleteSelectedAsync">Delete</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                               Size="Size.Small"
                               title="Copy name"
                               Disabled="@(SelectedQueue is null)"
                               OnClick="@CopySelectedNameAsync"/>
            </MudStack>
        </MudStack>
    </MudStack>

    <MudTabs Rounded="true" Elevation="0" Outlined="true">
        <MudTabPanel Text="Send">
            <MudStack Spacing="3" Class="pt-3">
                @if (string.IsNullOrWhiteSpace(SelectedName)) {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Pick a queue to publish.</MudText>
                }
                else {
                    @DetailContent
                }
            </MudStack>
        </MudTabPanel>
        <MudTabPanel Text="Manage">
            <MudStack Spacing="3" Class="pt-3">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="OnCreate" Disabled="@Busy">Create queue</MudButton>
                <MudDivider/>
                <MudText Typo="Typo.subtitle2">Bind to exchange</MudText>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                    <MudAutocomplete T="string"
                                     Placeholder="Exchange"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense"
                                     Dense="true"
                                     Clearable="true"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="false"
                                     OpenOnFocus="true"
                                     MaxItems="200"
                                     Style="min-width: 220px;"
                                     Value="@BindExchangeName"
                                     ValueChanged="BindExchangeNameChanged"
                                     SearchFunc="SearchBindExchanges"/>
                    <MudTextField T="string"
                                  Placeholder="Routing key"
                                  Margin="Margin.Dense"
                                  Variant="Variant.Outlined"
                                  Style="min-width: 160px;"
                                  Value="@RoutingKey"
                                  ValueChanged="RoutingKeyChanged"/>
                    <MudButton Variant="Variant.Outlined"
                               Disabled="@(Busy || SelectedQueue is null)"
                               OnClick="OnBind">Bind</MudButton>
                </MudStack>
            </MudStack>
        </MudTabPanel>
    </MudTabs>
</MudStack>

@code {

    /// <summary>Live queue snapshots from the management API.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<MessageQueueInfo> Queues { get; set; } = [];

    /// <summary>Named exchanges for the bind dropdown.</summary>
    [Parameter]
    public IReadOnlyList<string> ExchangeNames { get; set; } = [];

    /// <summary>Selected queue name. Empty when none is selected.</summary>
    [Parameter]
    public string SelectedName { get; set; } = "";

    /// <summary>Raised when the selected queue changes.</summary>
    [Parameter]
    public EventCallback<string> SelectedNameChanged { get; set; }

    /// <summary>Peek batch size.</summary>
    [Parameter]
    public int PeekCount { get; set; } = 10;

    /// <summary>Raised when peek count changes.</summary>
    [Parameter]
    public EventCallback<int> PeekCountChanged { get; set; }

    /// <summary>Auto-refresh interval in seconds.</summary>
    [Parameter]
    public int RefreshIntervalSeconds { get; set; } = 5;

    /// <summary>Raised when the refresh interval changes.</summary>
    [Parameter]
    public EventCallback<int> RefreshIntervalSecondsChanged { get; set; }

    /// <summary>When true, the workbench polls queue stats.</summary>
    [Parameter]
    public bool AutoRefresh { get; set; }

    /// <summary>Raised when auto-refresh is toggled.</summary>
    [Parameter]
    public EventCallback<bool> AutoRefreshChanged { get; set; }

    /// <summary>Disables toolbar and row actions while an operation is in flight.</summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>Exchange name used by the bind form.</summary>
    [Parameter]
    public string BindExchangeName { get; set; } = "";

    /// <summary>Raised when the bind exchange name changes.</summary>
    [Parameter]
    public EventCallback<string> BindExchangeNameChanged { get; set; }

    /// <summary>Routing key used by the bind form.</summary>
    [Parameter]
    public string RoutingKey { get; set; } = "";

    /// <summary>Raised when the routing key changes.</summary>
    [Parameter]
    public EventCallback<string> RoutingKeyChanged { get; set; }

    /// <summary>Publish editor rendered on the Send tab.</summary>
    [Parameter]
    public RenderFragment? DetailContent { get; set; }

    /// <summary>Refresh the queue list.</summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    /// <summary>Open the create-queue dialog.</summary>
    [Parameter]
    public EventCallback OnCreate { get; set; }

    /// <summary>Peek the selected queue.</summary>
    [Parameter]
    public EventCallback<MessageQueueInfo> OnPeek { get; set; }

    /// <summary>Clear the selected queue (parent confirms).</summary>
    [Parameter]
    public EventCallback<MessageQueueInfo> OnClear { get; set; }

    /// <summary>Delete the selected queue (parent confirms).</summary>
    [Parameter]
    public EventCallback<MessageQueueInfo> OnDelete { get; set; }

    /// <summary>Bind the selected queue to the bind-form exchange.</summary>
    [Parameter]
    public EventCallback OnBind { get; set; }

    private MessageQueueInfo? SelectedQueue
        => string.IsNullOrWhiteSpace(SelectedName) ? null : Queues.FirstOrDefault(q => q.Name == SelectedName);

    private Task OnQueueChanged(MessageQueueInfo? queue)
        => SelectedNameChanged.InvokeAsync(queue?.Name ?? "");

    private Task PeekSelectedAsync()
        => SelectedQueue is { } queue ? OnPeek.InvokeAsync(queue) : Task.CompletedTask;

    private Task ClearSelectedAsync()
        => SelectedQueue is { } queue ? OnClear.InvokeAsync(queue) : Task.CompletedTask;

    private Task DeleteSelectedAsync()
        => SelectedQueue is { } queue ? OnDelete.InvokeAsync(queue) : Task.CompletedTask;

    private async Task CopySelectedNameAsync()
    {
        if (SelectedQueue is null)
            return;

        await Js.SendToClipboard(SelectedQueue.Name);
        Snackbar.Add("Copied queue name", Severity.Info);
    }

    private Task<IEnumerable<MessageQueueInfo>> SearchQueues(string? value, CancellationToken ct)
    {
        IEnumerable<MessageQueueInfo> items = Queues;
        if (!string.IsNullOrWhiteSpace(value)) {
            var term = value.Trim();
            items = items.Where(q => q.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(items);
    }

    private Task<IEnumerable<string>> SearchBindExchanges(string? value, CancellationToken ct)
        => Task.FromResult(FilterNames(ExchangeNames, value));

    private static IEnumerable<string> FilterNames(IEnumerable<string> names, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return names;

        var term = value.Trim();
        return names.Where(n => n.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static string QueueName(MessageQueueInfo? queue) => queue?.Name ?? "";

}
